  m_Script: {fileID: 11500000, guid: d03038af81819cd46b24eff87a25452b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::OXQuizManager
  row:
    oTile: {fileID: 1230327369}
    xTile: {fileID: 763371451}
  questions:
  - questionText: Food goes down the esophagus because of gravity.
    correctAnswerIsO: 0
    explanationText: The esophagus pushes food down with muscle movements, so you
      can even swallow upside down.
  - questionText: Digestion happens in the esophagus.
    correctAnswerIsO: 0
    explanationText: The esophagus mainly moves food to the stomach.
  - questionText: The esophagus is always open.
    correctAnswerIsO: 0
    explanationText: It normally stays closed and only opens when food passes through.
  - questionText: The esophagus only moves food downward.
    correctAnswerIsO: 0
    explanationText: During vomiting, food can move upward instead.
  - questionText: There is a muscle between the esophagus and stomach that helps
      stop acid reflux.
    correctAnswerIsO: 1
    explanationText: The lower esophageal sphincter helps keep stomach acid from
      coming back up.
  - questionText: Esophageal cancer is easy to detect early.
    correctAnswerIsO: 0
    explanationText: It often has few symptoms at first, so it may be found late.
  - questionText: Hiccups are caused by the esophagus.
    correctAnswerIsO: 0
    explanationText: Hiccups happen when the diaphragm suddenly contracts.
  - questionText: The esophagus can move even when there is no food inside.
    correctAnswerIsO: 1
    explanationText: Small muscle movements can still happen in the esophagus.
  - questionText: The esophagus can also move air.
    correctAnswerIsO: 1
    explanationText: Air moves through the esophagus when you burp.
  - questionText: Water can stay in the esophagus for a short time.
    correctAnswerIsO: 1
    explanationText: Water also moves down through muscle movements.
  - questionText: The esophagus controls when to open and close by itself.
    correctAnswerIsO: 1
    explanationText: Its movements are automatically controlled by the nervous system.
  - questionText: The esophagus gets ready to move just by smelling food.
    correctAnswerIsO: 1
    explanationText: The brain activates the digestive system when it expects food.
  - questionText: A pill can feel stuck in your throat even after it has gone down.
    correctAnswerIsO: 1
    explanationText: Irritation in the esophagus can make your brain still feel something
      there.
  questionsPerRun: 5
  answerTimeLimit: 5
  correctAnswerDelay: 3
  wrongDamage: 1
  playerOverlapLayers:
    serializedVersion: 2
    m_Bits: 384
  barrierDoor: {fileID: 240463070}
  OnQuestionReady:
    m_PersistentCalls:
      m_Calls: []
  OnTimerTick:
