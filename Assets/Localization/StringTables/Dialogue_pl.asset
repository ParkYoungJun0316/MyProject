%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogue_pl
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: pl
  m_SharedData: {fileID: 11400000, guid: 043bf15b2a6a41c48971e11c678f419c, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 472199573504
    m_Localized: "Dlaczego zjad\u0142e\u015B KKUL-TTEOK zamiast tych wszystkich pysznych
      owoc\xF3w i s\u0142odyczy?!"
    m_Metadata:
      m_Items: []
  - m_Id: 334352332992512
    m_Localized: "Na pod\u0142odze pojawi\u0105 si\u0119 kolorowe p\u0142ytki.\nPost\xF3j
      na niej 2 sekundy, a wynik wzro\u015Bnie."
    m_Metadata:
      m_Items: []
  - m_Id: 334425666203648
    m_Localized: "Bia\u0142e i czarne p\u0142ytki mo\u017Ce zdepta\u0107 ka\u017Cdy,
      ale te w unikalnym kolorze licz\u0105 punkty tylko dla tego koloru.\nNie blokujcie
      drogi, ruszajcie si\u0119 szybko!"
    m_Metadata:
      m_Items: []
  - m_Id: 335182629023744
    m_Localized: "Co\u015B si\u0119 rusza pod naszymi stopami... uwa\u017Cajcie!\nNadchodzi
      atak j\u0119zykiem!"
    m_Metadata:
      m_Items: []
  - m_Id: 335185439207424
    m_Localized: "J\u0119zyk zniszczy platform\u0119 na \u015Brodku i zablokuje drog\u0119.\nKrzyczcie
      wszyscy okrzyk dru\u017Cyny, \u017Ceby opad\u0142 z powrotem, a zniszczona
      droga si\u0119 naprawi\u0142a."
    m_Metadata:
      m_Items: []
  - m_Id: 335887280484352
    m_Localized: "Chyba w\u0142a\u015Bnie \u0107wiczy! Oddech nagle zrobi\u0142 si\u0119
      ci\u0119\u017Cki."
    m_Metadata:
      m_Items: []
  - m_Id: 335890795311104
    m_Localized: "Ha\u0142... ha\u0142... jeszcze troch\u0119 wytrzyma\u0107 i chyba
      uda nam si\u0119 wyj\u015B\u0107 st\u0105d \u017Cywi..."
    m_Metadata:
      m_Items: []
  - m_Id: 337052009345024
    m_Localized: "...W \u015Brodku zrobi\u0142o si\u0119 cicho.\nCzy\u017Cby\u015Bmy
      wreszcie mogli uciec...?"
    m_Metadata:
      m_Items: []
  - m_Id: 337056501444608
    m_Localized: .....(CHRUP!)
    m_Metadata:
      m_Items: []
  - m_Id: 337060553142272
    m_Localized: "O nie, zostajemy po\u0142kni\u0119ci...!!"
    m_Metadata:
      m_Items: []
  - m_Id: 337070598500352
    m_Localized: "Zostali\u015Bmy po\u0142kni\u0119ci i wyl\u0105dowali\u015Bmy w
      prze\u0142yku...\nW takiej sytuacji nie ma innego wyj\u015Bcia, jak zej\u015B\u0107
      ni\u017Cej i uciec."
    m_Metadata:
      m_Items: []
  - m_Id: 337897539088384
    m_Localized: "Prze\u0142yk b\u0119dzie si\u0119 \u015Bciska\u0142 w losowych
      odst\u0119pach.\nJak tylko pojawi si\u0119 ostrze\u017Cenie, krzyczcie wszyscy
      okrzyk dru\u017Cyny, \u017Ceby to zatrzyma\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 337902496755712
    m_Localized: "Z obu stron b\u0119d\u0105 napiera\u0107 kolorowe \u015Bciany.\nJe\u015Bli
      \u015Bciana pokazuje tw\xF3j kolor, walnij w ni\u0105 prosto \u2014 odskoczy
      do ty\u0142u."
    m_Metadata:
      m_Items: []
  - m_Id: 337904153505792
    m_Localized: "Zapami\u0119tajcie tylko \u015Bwiec\u0105ce p\u0142ytki. Nadepniecie
      na z\u0142\u0105 \u2014 to natychmiastowa \u015Bmier\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 337904874926080
    m_Localized: "Tym razem b\u0119dzie pokazywa\u0107 po kolorach. Musisz koniecznie
      trafi\u0107 w sw\xF3j kolor!\nNawet je\u015Bli kolor si\u0119 zgadza, i tak
      zginiesz, je\u015Bli b\u0119dzie czarno-bia\u0142e."
    m_Metadata:
      m_Items: []
  - m_Id: 337906154188800
    m_Localized: "Ka\u017Cda strefa ma przypisany kolor. Droga staje si\u0119 bezpieczna
      tylko wtedy, gdy ten kolor przejdzie pierwszy!\nKoniecznie trzymajcie si\u0119
      kolejno\u015Bci!"
    m_Metadata:
      m_Items: []
  - m_Id: 337906812694528
    m_Localized: "\u0141apcie krwinki czerwone, kt\xF3re biegaj\u0105 wok\xF3\u0142
      \u2014 zadajmy temu cia\u0142u jakie\u015B obra\u017Cenia.\nNie mo\u017Cemy
      tylko ci\u0105gle oberwa\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 337907517337600
    m_Localized: "Skoro z\u0142apali\u015Bmy krwinki czerwone, krwinki bia\u0142e
      uzna\u0142y nas za wrog\xF3w!\nBiegnijcie i przetrwajcie!"
    m_Metadata:
      m_Items: []
  - m_Id: 339357207212032
    m_Localized: "To ostatni odcinek prze\u0142yku...\nTam w dole musi by\u0107 pe\u0142no
      kwasu \u017Co\u0142\u0105dkowego. Zej\u015Bcie bez przygotowania jest zbyt
      ryzykowne."
    m_Metadata:
      m_Items: []
  - m_Id: 339360646541312
    m_Localized: "Ten cukierek z wcze\u015Bniej opada z sufitu i robi si\u0119 coraz
      wi\u0119kszy.\nMusimy zbudowa\u0107 pod\u0142og\u0119, zanim dotknie dna.\nInaczej
      zniesie nas razem z nim."
    m_Metadata:
      m_Items: []
  - m_Id: 339362018078720
    m_Localized: "Za ka\u017Cdy pokonany odcinek powstaje kawa\u0142ek pod\u0142ogi.
      Szybko, budujcie j\u0105, \u017Ceby to zablokowa\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 340094578438144
    m_Localized: "Uff... jako\u015B uda\u0142o si\u0119 to zatrzyma\u0107... teraz
      pomy\u015Blmy. Jak bezpiecznie zej\u015B\u0107 st\u0105d."
    m_Metadata:
      m_Items: []
  - m_Id: 340096402960384
    m_Localized: "Chlup... chlup... co to za d\u017Awi\u0119k...?"
    m_Metadata:
      m_Items: []
  - m_Id: 340097782886400
    m_Localized: "Gard\u0142o mu si\u0119 zatka\u0142o i zacz\u0119\u0142o pi\u0107
      wod\u0119! Cukierek rozwala pod\u0142og\u0119!!"
    m_Metadata:
      m_Items: []
  - m_Id: 335177390338048
    m_Localized: "Gdy tw\xF3j kolor pojawi si\u0119 na pod\u0142odze, wci\u015Bnij
      <color=#FFD24D><b>Space</b></color>.\nBia\u0142y mo\u017Ce wcisn\u0105\u0107
      ka\u017Cdy, ale czarnego nie wciskajcie!\nPrzy czarnym po 1 sekundzie automatycznie
      przechodzi do nast\u0119pnej tury."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000001
    m_Localized: "Podobno nawet w jaskini tygrysa mo\u017Cna prze\u017Cy\u0107, je\u015Bli
      zachowa si\u0119 zimn\u0105 krew..!\nOd teraz my\u015Blimy tylko o przetrwaniu."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000002
    m_Localized: "Zapami\u0119tajcie dobrze, gdzie s\u0105 kolorowe pyski wok\xF3\u0142
      nas.\nJak nadepniesz na p\u0142ytk\u0119, pysk tego koloru wyskoczy i zmia\u017Cd\u017Cy
      z\u0119by."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000003
    m_Localized: "Naraz podnosi si\u0119 tylko jeden kolor.\nNie ma sensu depta\u0107
      razem wszystkim."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000004
    m_Localized: "Je\u015Bli to zacznie si\u0119 zamyka\u0107... krzyczcie wszyscy
      okrzyk dru\u017Cyny!\nInaczej nic nie b\u0119dziecie widzie\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000005
    m_Localized: "Wejd\u017Acie do bezpiecznej strefy pokazanej na ekranie!"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000006
    m_Localized: "Chyba zjad\u0142o co\u015B ostrego, zanim mnie po\u0142kn\u0119\u0142o..?\nZ
      pod\u0142ogi ci\u0105gle wyp\u0142ywa \u015Blina."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000007
    m_Localized: "Pod\u0142oga jest \u015Bliska od \u015Bliny.\nKrzyczcie wszyscy
      okrzyk dru\u017Cyny, \u017Ceby j\u0105 usun\u0105\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000008
    m_Localized: "Teraz \u015Blina kapie te\u017C z g\xF3ry!\nNa pewno zjad\u0142o
      co\u015B ostrego, a do tego co\u015B kwa\u015Bnego.\nNa pewno pr\xF3buje to
      zneutralizowa\u0107 KKUL-TTEOKIEM!"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000009
    m_Localized: "Niekt\xF3re z opadaj\u0105cych kropel celuj\u0105 we mnie \u2013
      wci\u015Bnij <color=#FFD24D><b>Ctrl</b></color>, \u017Ceby dopasowa\u0107 kolor
      pod\u0142ogi do swojego i zdj\u0105\u0107 namierzanie."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000010
    m_Localized: "Od teraz b\u0119dzie wida\u0107 tylko jedn\u0105 p\u0142ytk\u0119
      do przodu.\nZapami\u0119tajcie j\u0105 dobrze!"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000011
    m_Localized: "Tutaj te\u017C co\u015B we mnie celuje.\nWci\u015Bnij <color=#FFD24D><b>Ctrl</b></color>,
      \u017Ceby dopasowa\u0107 kolor pod\u0142ogi do swojego i zdj\u0105\u0107 namierzanie."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000012
    m_Localized: "Tym razem j\u0119zyk zniszczy ca\u0142\u0105 pod\u0142og\u0119
      po lewej albo po prawej.\nKrzyczcie okrzyk dru\u017Cyny, \u017Ceby to zablokowa\u0107
      \u2013 je\u015Bli si\u0119 nie uda, po prostu si\u0119 zniszczy."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000013
    m_Localized: "Naprawi si\u0119 tylko wtedy, gdy krzykniecie okrzyk dru\u017Cyny
      w trakcie ostrze\u017Cenia.\nGdy pod\u0142oga ju\u017C si\u0119 zniszczy, trzeba
      wytrzyma\u0107 do nast\u0119pnego ostrze\u017Cenia."
    m_Metadata:
      m_Items: []
  - m_Id: 12337130970394624
    m_Localized: "...ten d\u017Awi\u0119k czego\u015B, co si\u0119 kot\u0142uje?\nTylko
      nie m\xF3wcie, \u017Ce to ten sam cukierek?! Biegnijcie, je\u015Bli nie chcecie
      zosta\u0107 rozgnieceni!!"
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531968
    m_Localized: "Odbicie zatrzyma\u0142o si\u0119 w prze\u0142yku... gaz zaczyna
      si\u0119 gromadzi\u0107.\nJak zrobi si\u0119 tak g\u0119sto, \u017Ce nic nie
      wida\u0107, krzyczcie okrzyk dru\u017Cyny, \u017Ceby go rozgoni\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531969
    m_Localized: "Uwa\u017Cajcie na pod\u0142og\u0119. Musi mie\u0107 refluks \u2014
      podchodzi kwas \u017Co\u0142\u0105dkowy!"
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531970
    m_Localized: "Ataki kolcami b\u0119d\u0105 nadchodzi\u0107 z miejsc, kt\xF3rych
      nie wida\u0107. B\u0105d\u017Acie stale czujni."
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531971
    m_Localized: "\u015Aciany po obu stronach zmieni\u0105 si\u0119 na czarno-bia\u0142e.\nDopasuj
      kolor i uderz w \u015Bcian\u0119, \u017Ceby odeprze\u0107 nap\xF3r!"
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531972
    m_Localized: "To pewnie reakcja alergiczna \u2014 w ca\u0142ym prze\u0142yku
      powsta\u0142y obrz\u0119ki.\nUderzycie w jeden z nich, i zostaniecie odrzuceni."
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531973
    m_Localized: "Uderzysz w \u015Bcian\u0119 i zostaniesz odrzucony.\nMo\u017Ce
      da si\u0119 to wykorzysta\u0107, \u017Ceby uciec, co?"
    m_Metadata:
      m_Items: []
  - m_Id: 12337131037503488
    m_Localized: AAAAAAAAAH...!!
    m_Metadata:
      m_Items: []
  - m_Id: 13504475839442944
    m_Localized: "Na pod\u0142odze zapal\u0105 si\u0119 kolorowe pola.\nJe\u015Bli
      wypadnie tw\xF3j kolor, sta\u0144 tylko na tym polu.\nJe\u015Bli nie \u2014
      wytrzymaj na czarnym lub bia\u0142ym, wed\u0142ug swojego."
    m_Metadata:
      m_Items: []
  - m_Id: 13504475885580288
    m_Localized: "Kolor postaci te\u017C musisz dopasowa\u0107!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
