MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogue_pl
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: pl
  m_SharedData: {fileID: 11400000, guid: 043bf15b2a6a41c48971e11c678f419c, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 472199573504
    m_Localized: "Zostali\u015Bmy zjedzeni. Od teraz my\u015Bl tylko o tym, jak przetrwa\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 334352332992512
    m_Localized: "Od teraz na pod\u0142odze b\u0119dzie losowo pojawia\u0107 si\u0119
      p\u0142ytka w twoim kolorze."
    m_Metadata:
      m_Items: []
  - m_Id: 334425666203648
    m_Localized: "Musisz na ni\u0105 wej\u015B\u0107, zanim sko\u0144czy si\u0119
      czas."
    m_Metadata:
      m_Items: []
  - m_Id: 334428463804416
    m_Localized: "Je\u015Bli nie zd\u0105\u017Cysz... z\u0119by z sufitu zaczn\u0105
      spada\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 335182629023744
    m_Localized: "Na bia\u0142y mo\u017Ce wcisn\u0105\u0107 ka\u017Cdy, ale na czarny
      nigdy nie wciskaj!"
    m_Metadata:
      m_Items: []
  - m_Id: 335185439207424
    m_Localized: "B\u0142\u0119dne wci\u015Bni\u0119cie kosztuje czas, wi\u0119c
      uwa\u017Caj!"
    m_Metadata:
      m_Items: []
  - m_Id: 335887280484352
    m_Localized: "Wejd\u017A na p\u0142ytk\u0119 swojego koloru i trzymaj si\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 335890795311104
    m_Localized: "To ju\u017C ostatni odcinek w ustach."
    m_Metadata:
      m_Items: []
  - m_Id: 335893903290368
    m_Localized: "Je\u015Bli jeszcze troch\u0119 wytrzymamy, chyba zdo\u0142amy si\u0119
      wydosta\u0107..."
    m_Metadata:
      m_Items: []
  - m_Id: 337052009345024
    m_Localized: "W ustach zapad\u0142a cisza... czy to znaczy, \u017Ce wszystko
      si\u0119 zatrzyma\u0142o?"
    m_Metadata:
      m_Items: []
  - m_Id: 337056501444608
    m_Localized: "To znaczy, \u017Ce mo\u017Cemy ju\u017C uciec...?"
    m_Metadata:
      m_Items: []
  - m_Id: 337060553142272
    m_Localized: "\u2026\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 337068631371776
    m_Localized: "O nie, znowu nas prze\u0142ykaj\u0105...!!"
    m_Metadata:
      m_Items: []
  - m_Id: 337070598500352
    m_Localized: "Czy przeszli\u015Bmy do prze\u0142yku...?"
    m_Metadata:
      m_Items: []
  - m_Id: 337897539088384
    m_Localized: "Wydaje mi si\u0119, \u017Ce co\u015B nadje\u017Cd\u017Ca z ty\u0142u..."
    m_Metadata:
      m_Items: []
  - m_Id: 337902496755712
    m_Localized: Biegnij!!!
    m_Metadata:
      m_Items: []
  - m_Id: 337904153505792
    m_Localized: "Jeden b\u0142\u0119dny krok i to natychmiastowa \u015Bmier\u0107.
      Zapami\u0119taj tylko \u015Bwiec\u0105ce pola."
    m_Metadata:
      m_Items: []
  - m_Id: 337904874926080
    m_Localized: "Tym razem poka\u017Ce si\u0119 wed\u0142ug kolor\xF3w. Koniecznie
      dopasuj do w\u0142asnego koloru!"
    m_Metadata:
      m_Items: []
  - m_Id: 337905520848896
    m_Localized: "Nawet je\u015Bli kolor si\u0119 zgadza, czarno-bia\u0142e ci\u0119
      zabije."
    m_Metadata:
      m_Items: []
  - m_Id: 337906154188800
    m_Localized: "Ka\u017Cda strefa ma odpowiedzialny kolor. Droga staje si\u0119
      bezpieczna tylko wtedy, gdy ten kolor przejdzie pierwszy."
    m_Metadata:
      m_Items: []
  - m_Id: 337906812694528
    m_Localized: "Z\u0142ap uciekaj\u0105ce czerwone krwinki!"
    m_Metadata:
      m_Items: []
  - m_Id: 337907517337600
    m_Localized: "Uciekaj przed przeciwcia\u0142ami i przetrwaj!"
    m_Metadata:
      m_Items: []
  - m_Id: 339357207212032
    m_Localized: "Dotarli\u015Bmy do ko\u0144ca prze\u0142yku."
    m_Metadata:
      m_Items: []
  - m_Id: 339360646541312
    m_Localized: "Mo\u017Ce dlatego, \u017Ce to ostatni odcinek... nacisk czuje si\u0119
      inaczej."
    m_Metadata:
      m_Items: []
  - m_Id: 339362018078720
    m_Localized: "Nie zatrzymuj si\u0119, ruszaj si\u0119 dalej!"
    m_Metadata:
      m_Items: []
  - m_Id: 340094578438144
    m_Localized: "Ucisk usta\u0142. Uff... w ko\u0144cu przetrwali\u015Bmy."
    m_Metadata:
      m_Items: []
  - m_Id: 340096402960384
    m_Localized: "Ale z pod\u0142og\u0105 jest co\u015B nie tak..."
    m_Metadata:
      m_Items: []
  - m_Id: 340097782886400
    m_Localized: "Zaczyna si\u0119 zawala\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 335177390338048
    m_Localized: "Wci\u015Bnij <b><color=#FFC400>spacj\u0119</color></b>, gdy tw\xF3j
      kolor pojawi si\u0119 na pod\u0142odze."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
