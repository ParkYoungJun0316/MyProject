  m_SharedData: {fileID: 11400000, guid: 240b9339ac6f60941bcab9ac03699409, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1040822272
    m_Localized: "D\xE9placement"
    m_Metadata:
      m_Items: []
  - m_Id: 1086959616
    m_Localized: "Pouss\xE9e (0 d\xE9g\xE2ts)"
    m_Metadata:
      m_Items: []
  - m_Id: 1086959617
    m_Localized: Noir et blanc
    m_Metadata:
      m_Items: []
  - m_Id: 1086959618
    m_Localized: Ta couleur
    m_Metadata:
      m_Items: []
  - m_Id: 1091153920
    m_Localized: Changer de bonus
    m_Metadata:
      m_Items: []
  - m_Id: 1091153921
    m_Localized: Encouragement perso
    m_Metadata:
      m_Items: []
  - m_Id: 1091153922
    m_Localized: "Crie ton propre nom pour activer ton bonus.\nAppuie sur E pour
      d\xE9finir ton pseudo.\nPense bien \xE0 le tester !"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153923
    m_Localized: "Encouragement d'\xE9quipe"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153924
    m_Localized: "Quand l'ic\xF4ne d'alerte appara\xEEt, criez tous ensemble le mot
      d'\xE9quipe.\nCela annule la menace que la bouche ou l'\u0153sophage vient
      de vous infliger.\nSeul l'h\xF4te peut d\xE9finir le mot d'\xE9quipe : mettez-vous
      d'accord \xE0 l'avance."
    m_Metadata:
      m_Items: []
  - m_Id: 1091153925
    m_Localized: Nom d'encouragement
    m_Metadata:
      m_Items: []
  - m_Id: 1091153926
    m_Localized: "Le nom d'encouragement ne peut \xEAtre \xE9crit qu'en anglais.\nPlus
      le mot est naturel \xE0 prononcer, mieux il est reconnu !\nPas de micro, ou
      la reconnaissance qui bugue ? Active les encouragements au clavier num\xE9rique
      dans le menu \xC9chap.\n(1 = encouragement perso, 2 = encouragement d'\xE9quipe
      \u2014 mais crier, c'est quand m\xEAme plus fun !)"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153927
    m_Localized: "Entra\xEEnement \xE0 l'encouragement d'\xE9quipe"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153928
    m_Localized: "Appuie sur [E] pour d\xE9clencher une fausse alerte de menace :\nla
      bouche du dessus se ferme.\nCriez tous ensemble le mot d'\xE9quipe pour la
      rouvrir.\nUn c\u0153ur appara\xEEt au-dessus de la t\xEAte de celui qui a cri\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 1091153929
    m_Localized: C'est parti pour la partie
    m_Metadata:
      m_Items: []
  - m_Id: 1091153930
    m_Localized: "La zone de d\xE9part se trouve sur le sol jaune.\nD\xE8s que toute
      l'\xE9quipe s'y retrouve, un compte \xE0 rebours d\xE9marre puis la partie
      commence.\nTon nom d'encouragement est fig\xE9 au moment o\xF9 le compte \xE0
      rebours se termine,\nalors assurez-vous d'avoir tout choisi avant."
    m_Metadata:
      m_Items: []
  - m_Id: 24992255946752
    m_Localized: Choisis ton nom d'encouragement
    m_Metadata:
      m_Items: []
  - m_Id: 24992293695488
    m_Localized: "\xC7a, \xE7a ne marche pas\n\xB7 Insultes/mots interdits (ex. :
      fuck)\n\xB7 Mots r\xE9serv\xE9s (admin, host, cheer)\n\xB7 Chiffres, tiret
      bas (_), cor\xE9en, \xE9mojis, une seule lettre\n\xB7 2 \xE0 12 caract\xE8res,
      lettres minuscules (alphabet latin) uniquement\n\nUne fois confirm\xE9, pense
      \xE0 tester si c'est bien reconnu !"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889792
    m_Localized: 'ex. : happy'
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889793
    m_Localized: 'ex. : fighting'
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889794
    m_Localized: Confirmer
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889795
    m_Localized: Fermer
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889796
    m_Localized: "Choisis le mot que toute l'\xE9quipe criera ensemble (par d\xE9faut
      : FIGHTING)"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889797
    m_Localized: "Mot d'\xE9quipe : {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647744
    m_Localized: Utilise entre 2 et 12 lettres minuscules (alphabet latin) uniquement.
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647745
    m_Localized: "Ce nom est un mot r\xE9serv\xE9 par le syst\xE8me, tu ne peux pas
      l'utiliser."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647746
    m_Localized: "Ce mot est r\xE9serv\xE9 par le syst\xE8me, tu ne peux pas l'utiliser."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647747
    m_Localized: "Cela contient un mot qui ne peut pas \xEAtre utilis\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647748
    m_Localized: "Un autre co\xE9quipier utilise d\xE9j\xE0 ce nom."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647749
    m_Localized: "Un co\xE9quipier l'utilise d\xE9j\xE0 comme nom d'encouragement."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647750
    m_Localized: Impossible de confirmer ce nom.
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647751
    m_Localized: "Impossible de confirmer le mot d'\xE9quipe."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647752
    m_Localized: "Seul l'h\xF4te peut d\xE9finir le mot d'\xE9quipe."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647753
    m_Localized: "V\xE9rification\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647754
    m_Localized: "Pas de r\xE9ponse. R\xE9essaie."
    m_Metadata:
      m_Items: []
  - m_Id: 53793039953920
    m_Localized: Changer de nom
    m_Metadata:
      m_Items: []
  - m_Id: 53793073508352
    m_Localized: "Tu peux changer ton nom et le mot d'\xE9quipe une derni\xE8re fois
      ici.\nSi tu rates \xE7a, tu ne pourras plus les changer avant la fin de la
      partie,\nalors si tu veux les changer, fais-le maintenant sur le panneau."
    m_Metadata:
      m_Items: []
  - m_Id: 56930631004160
    m_Localized: "[E] D\xE9finir le nom"
    m_Metadata:
      m_Items: []
  - m_Id: 56930635198464
    m_Localized: "[E] Test d'encouragement d'\xE9quipe"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
