  m_TableData:
  - m_Id: 1040822272
    m_Localized: "D\xE9placement"
    m_Metadata:
      m_Items: []
  - m_Id: 1086959616
    m_Localized: "Pouss\xE9e (sans d\xE9g\xE2ts)"
    m_Metadata:
      m_Items: []
  - m_Id: 1086959617
    m_Localized: Couleur N/B
    m_Metadata:
      m_Items: []
  - m_Id: 1086959618
    m_Localized: Couleur perso
    m_Metadata:
      m_Items: []
  - m_Id: 1091153920
    m_Localized: "Bonus perso : Q pour changer \xB7 Espace pour activer (d\xE9fense
      \u2194 vitesse)"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153923
    m_Localized: "Encouragement d'\xE9quipe"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153924
    m_Localized: "Quand l'ic\xF4ne d'alerte appara\xEEt, criez tous ensemble le mot
      d'\xE9quipe pour annuler la menace.\nAppuie sur [E] ici pour t'entra\xEEner
      tout de suite."
    m_Metadata:
      m_Items: []
  - m_Id: 1091153925
    m_Localized: "Mot d'\xE9quipe"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153926
    m_Localized: "Seul l'h\xF4te peut d\xE9finir le TeamCheerWord.\nPlus le mot est
      naturel \xE0 prononcer, mieux il est reconnu. (2 \xE0 12 lettres, minuscules
      latines uniquement)\nPas de micro, ou la reconnaissance qui bugue\_? Active
      les encouragements \xE0 la touche T dans Options \u2192 G\xE9n\xE9ral, puis
      appuie sur T quand l'alerte appara\xEEt."
    m_Metadata:
      m_Items: []
  - m_Id: 1091153929
    m_Localized: C'est parti pour la partie
    m_Metadata:
      m_Items: []
  - m_Id: 1091153930
    m_Localized: "La zone de d\xE9part se trouve sur le sol jaune.\nD\xE8s que toute
      l'\xE9quipe s'y retrouve, un compte \xE0 rebours d\xE9marre puis la partie
      commence.\nLe mot d'\xE9quipe est fig\xE9 au moment o\xF9 le compte \xE0 rebours
      se termine,\nalors assurez-vous que l'h\xF4te l'a bien d\xE9fini."
    m_Metadata:
      m_Items: []
  - m_Id: 24992255946752
    m_Localized: "Choisis le mot d'\xE9quipe"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889793
    m_Localized: 'ex. : fighting'
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889794
    m_Localized: Confirmer
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889795
    m_Localized: Fermer
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889796
    m_Localized: "Choisis le mot que toute l'\xE9quipe criera ensemble (par d\xE9faut
      : FIGHTING)"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889797
    m_Localized: "Mot d'\xE9quipe : {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647744
    m_Localized: Utilise entre 2 et 12 lettres minuscules (alphabet latin) uniquement.
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647746
    m_Localized: "Ce mot est r\xE9serv\xE9 par le syst\xE8me, tu ne peux pas l'utiliser."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647747
    m_Localized: "Cela contient un mot qui ne peut pas \xEAtre utilis\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647751
    m_Localized: "Impossible de confirmer le mot d'\xE9quipe."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647752
    m_Localized: "Seul l'h\xF4te peut d\xE9finir le mot d'\xE9quipe."
    m_Metadata:
      m_Items: []
  - m_Id: 53793039953920
    m_Localized: "Changer le mot d'\xE9quipe"
    m_Metadata:
      m_Items: []
  - m_Id: 53793073508352
    m_Localized: "Vous pouvez changer le mot d'\xE9quipe une derni\xE8re fois ici.\nSi
      vous laissez passer cette chance, il restera fig\xE9 jusqu'\xE0 la fin de la
      partie,\nalors si tu veux le changer, fais-le maintenant sur le panneau."
    m_Metadata:
      m_Items: []
  - m_Id: 56930631004160
    m_Localized: "[E] D\xE9finir le mot d'\xE9quipe"
    m_Metadata:
      m_Items: []
  - m_Id: 56930635198464
    m_Localized: "[E] Test d'encouragement d'\xE9quipe"
    m_Metadata:
      m_Items: []
  - m_Id: 1395064601948160
    m_Localized: "La d\xE9fense bloque aussi les d\xE9g\xE2ts de round."
    m_Metadata:
      m_Items: []
  - m_Id: 1395064700000001
    m_Localized: "R\xE9animer (maintiens [E] pr\xE8s d'un co\xE9quipier \xE0 terre)"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
