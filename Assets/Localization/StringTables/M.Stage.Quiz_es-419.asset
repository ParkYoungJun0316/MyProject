MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: M.Stage.Quiz_es-419
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: es-419
  m_SharedData: {fileID: 11400000, guid: 05362dd87941b804c948c6c4f45df573, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 994491084800
    m_Localized: "Los adultos producen m\xE1s de 1 litro de saliva al d\xEDa."
    m_Metadata:
      m_Items: []
  - m_Id: 994524639232
    m_Localized: "Los adultos producen entre 1 y 1.5 litros de saliva al d\xEDa."
    m_Metadata:
      m_Items: []
  - m_Id: 994524639233
    m_Localized: Las distintas partes de la lengua solo pueden percibir ciertos sabores.
    m_Metadata:
      m_Items: []
  - m_Id: 994524639234
    m_Localized: "Todas las partes de la lengua pueden detectar todos los sabores
      b\xE1sicos."
    m_Metadata:
      m_Items: []
  - m_Id: 994524639235
    m_Localized: Los patrones de la lengua son diferentes en cada persona.
    m_Metadata:
      m_Items: []
  - m_Id: 994524639236
    m_Localized: "Los patrones de la superficie de la lengua son tan \xFAnicos que
      se estudian para tecnolog\xEDa biom\xE9trica."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833536
    m_Localized: "Los labios no tienen gl\xE1ndulas sudor\xEDparas como la piel normal."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833537
    m_Localized: "Los labios se secan f\xE1cilmente porque no tienen gl\xE1ndulas
      sudor\xEDparas ni seb\xE1ceas."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833538
    m_Localized: Con la edad, muchas personas empiezan a tolerar mejor los alimentos
      amargos.
    m_Metadata:
      m_Items: []
  - m_Id: 994528833539
    m_Localized: Esto pasa por cambios en el gusto y la experiencia repetida con
      la comida.
    m_Metadata:
      m_Items: []
  - m_Id: 994528833540
    m_Localized: "El diente humano m\xE1s largo registrado en el Libro Guinness med\xEDa
      m\xE1s de 4 cm."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833541
    m_Localized: "El canino humano m\xE1s largo registrado med\xEDa unos 3.67 cm."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833542
    m_Localized: Hay miles de millones de bacterias viviendo dentro de la boca.
    m_Metadata:
      m_Items: []
  - m_Id: 994528833543
    m_Localized: "Incluso despu\xE9s de cepillarse los dientes, muchas bacterias
      siguen dentro de la boca."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833544
    m_Localized: "Las personas producen mucha m\xE1s saliva mientras duermen."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833545
    m_Localized: "La producci\xF3n de saliva casi se detiene durante el sue\xF1o,
      lo que puede causar mal aliento por la ma\xF1ana."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833546
    m_Localized: La lengua puede cansarse.
    m_Metadata:
      m_Items: []
  - m_Id: 994528833547
    m_Localized: "La lengua est\xE1 hecha de m\xFAsculos, as\xED que se puede fatigar
      tras un uso intenso."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833548
    m_Localized: Los dientes tienen una estructura distinta a la de los huesos.
    m_Metadata:
      m_Items: []
  - m_Id: 994528833549
    m_Localized: A diferencia de los huesos, los dientes no pueden repararse por
      completo.
    m_Metadata:
      m_Items: []
  - m_Id: 994528833550
    m_Localized: Los labios humanos se ven rojos porque tienen mucho pigmento rojo.
    m_Metadata:
      m_Items: []
  - m_Id: 994528833551
    m_Localized: "Los labios son delgados, as\xED que se ve el color de los vasos
      sangu\xEDneos debajo de la piel."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833552
    m_Localized: "La lengua es una de las partes del cuerpo que sana m\xE1s r\xE1pido."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833553
    m_Localized: "La lengua sana r\xE1pido porque tiene un flujo sangu\xEDneo fuerte
      y una reparaci\xF3n celular veloz."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
