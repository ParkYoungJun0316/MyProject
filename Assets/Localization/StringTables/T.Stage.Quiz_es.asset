  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: T.Stage.Quiz_es
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: 96adcc13da5290147bc44fb643567e28, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 895241269248
    m_Localized: "La comida baja por el es\xF3fago por la gravedad."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240768
    m_Localized: "El es\xF3fago empuja la comida hacia abajo con movimientos musculares,
      por eso incluso se puede tragar boca abajo."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240769
    m_Localized: "La digesti\xF3n ocurre en el es\xF3fago."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240770
    m_Localized: "El es\xF3fago se encarga principalmente de llevar la comida al
      est\xF3mago."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240771
    m_Localized: "El es\xF3fago siempre est\xE1 abierto."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240772
    m_Localized: "Normalmente est\xE1 cerrado y solo se abre cuando pasa comida."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240773
    m_Localized: "El es\xF3fago solo mueve la comida hacia abajo."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240774
    m_Localized: "Durante los v\xF3mitos, la comida puede moverse hacia arriba."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240775
    m_Localized: "Entre el es\xF3fago y el est\xF3mago hay un m\xFAsculo que ayuda
      a evitar el reflujo \xE1cido."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240776
    m_Localized: "El esf\xEDnter esof\xE1gico inferior ayuda a evitar que el \xE1cido
      del est\xF3mago suba de nuevo."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240777
    m_Localized: "El c\xE1ncer de es\xF3fago es f\xE1cil de detectar en etapas tempranas."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240778
    m_Localized: "Al principio suele tener pocos s\xEDntomas, por lo que puede detectarse
      tarde."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240779
    m_Localized: "El hipo es causado por el es\xF3fago."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240780
    m_Localized: El hipo ocurre cuando el diafragma se contrae de repente.
    m_Metadata:
      m_Items: []
  - m_Id: 895262240781
    m_Localized: "El es\xF3fago puede moverse incluso cuando no hay comida dentro."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240782
    m_Localized: "En el es\xF3fago pueden seguir ocurriendo peque\xF1os movimientos
      musculares."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240783
    m_Localized: "El es\xF3fago tambi\xE9n puede mover aire."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240784
    m_Localized: "El aire pasa por el es\xF3fago cuando eructas."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240785
    m_Localized: "El agua puede quedarse un momento en el es\xF3fago."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240786
    m_Localized: "El agua tambi\xE9n baja gracias a los movimientos musculares."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240787
    m_Localized: "El es\xF3fago controla por s\xED mismo cu\xE1ndo abrirse y cerrarse."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240788
    m_Localized: "Sus movimientos son controlados autom\xE1ticamente por el sistema
      nervioso."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240789
    m_Localized: "El es\xF3fago se prepara para moverse solo con oler la comida."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240790
    m_Localized: El cerebro activa el sistema digestivo cuando espera que llegue
      comida.
    m_Metadata:
      m_Items: []
  - m_Id: 895262240791
    m_Localized: "Una pastilla puede sentirse atascada en la garganta incluso despu\xE9s
      de haberla tragado."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240792
    m_Localized: "La irritaci\xF3n en el es\xF3fago puede hacer que tu cerebro siga
      sintiendo algo ah\xED."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
