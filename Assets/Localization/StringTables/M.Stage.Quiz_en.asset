  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: M.Stage.Quiz_en
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 05362dd87941b804c948c6c4f45df573, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 994491084800
    m_Localized: Adults produce over 1 liter of saliva every day.
    m_Metadata:
      m_Items: []
  - m_Id: 994524639232
    m_Localized: Adults produce about 1 to 1.5 liters of saliva each day.
    m_Metadata:
      m_Items: []
  - m_Id: 994524639233
    m_Localized: Different parts of the tongue can only taste certain flavors.
    m_Metadata:
      m_Items: []
  - m_Id: 994524639234
    m_Localized: All parts of the tongue can detect all basic tastes.
    m_Metadata:
      m_Items: []
  - m_Id: 994524639235
    m_Localized: Tongue patterns are different for each person.
    m_Metadata:
      m_Items: []
  - m_Id: 994524639236
    m_Localized: The surface patterns of the tongue are unique enough to be studied
      for biometric technology.
    m_Metadata:
      m_Items: []
  - m_Id: 994528833536
    m_Localized: Lips do not have sweat glands like normal skin.
    m_Metadata:
      m_Items: []
  - m_Id: 994528833537
    m_Localized: Lips dry out easily because they do not have sweat or oil glands.
    m_Metadata:
      m_Items: []
  - m_Id: 994528833538
    m_Localized: People often become better at eating bitter foods as they get older.
    m_Metadata:
      m_Items: []
  - m_Id: 994528833539
    m_Localized: This happens because of changes in taste and repeated food experiences.
    m_Metadata:
      m_Items: []
  - m_Id: 994528833540
    m_Localized: The longest human tooth recorded in Guinness World Records was over
      4 cm long.
    m_Metadata:
      m_Items: []
  - m_Id: 994528833541
    m_Localized: The longest recorded human canine tooth was about 3.67 cm long.
    m_Metadata:
      m_Items: []
  - m_Id: 994528833542
    m_Localized: There are billions of bacteria living inside the mouth.
    m_Metadata:
      m_Items: []
  - m_Id: 994528833543
    m_Localized: Even after brushing, many bacteria still remain inside the mouth.
    m_Metadata:
      m_Items: []
  - m_Id: 994528833544
    m_Localized: People produce much more saliva while sleeping.
    m_Metadata:
      m_Items: []
  - m_Id: 994528833545
    m_Localized: Saliva production almost stops during sleep, which can cause bad
      breath in the morning.
    m_Metadata:
      m_Items: []
  - m_Id: 994528833546
    m_Localized: The tongue can get tired.
    m_Metadata:
      m_Items: []
  - m_Id: 994528833547
    m_Localized: The tongue is made of muscles, so it can become fatigued after heavy
      use.
    m_Metadata:
      m_Items: []
  - m_Id: 994528833548
    m_Localized: Teeth have a different structure from bones.
    m_Metadata:
      m_Items: []
  - m_Id: 994528833549
    m_Localized: Unlike bones, teeth cannot fully repair themselves.
    m_Metadata:
      m_Items: []
  - m_Id: 994528833550
    m_Localized: Human lips look red because they contain a lot of red pigment.
    m_Metadata:
      m_Items: []
  - m_Id: 994528833551
    m_Localized: Lips are thin, so the color of blood vessels underneath can be seen
      through the skin.
    m_Metadata:
      m_Items: []
  - m_Id: 994528833552
    m_Localized: The tongue is one of the fastest-healing parts of the body.
    m_Metadata:
      m_Items: []
  - m_Id: 994528833553
    m_Localized: The tongue heals quickly because it has strong blood flow and fast
      cell repair.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
