%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogue_fr
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: 043bf15b2a6a41c48971e11c678f419c, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 472199573504
    m_Localized: "Il y avait plein de bons fruits\u2026 pourquoi c'est moi que tu
      as mang\xE9 ?!"
    m_Metadata:
      m_Items: []
  - m_Id: 334352332992512
    m_Localized: "Des dalles color\xE9es vont appara\xEEtre au sol.\nReste 2 secondes
      dessus pour marquer un point."
    m_Metadata:
      m_Items: []
  - m_Id: 334425666203648
    m_Localized: "Les dalles blanches et noires, c'est pour tout le monde, mais une
      dalle color\xE9e ne compte que pour sa couleur.\nNe vous g\xEAnez pas et bougez
      vite !"
    m_Metadata:
      m_Items: []
  - m_Id: 335182629023744
    m_Localized: "Quelque chose bouge sous nos pieds\u2026 attention !\nVoil\xE0
      la langue !"
    m_Metadata:
      m_Items: []
  - m_Id: 335185439207424
    m_Localized: "La langue va briser la plateforme du milieu et bloquer le passage.\nCriez
      le cri d'\xE9quipe ensemble et elle redescendra \u2014 le chemin cass\xE9 reviendra
      aussi."
    m_Metadata:
      m_Items: []
  - m_Id: 335887280484352
    m_Localized: "Il fait du sport ou quoi ? Sa respiration s'est emball\xE9e d'un
      coup !"
    m_Metadata:
      m_Items: []
  - m_Id: 335890795311104
    m_Localized: "Hah\u2026 hah\u2026 encore un petit effort et on pourrait vraiment
      s'en sortir vivants\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 337052009345024
    m_Localized: "\u2026C'est devenu calme ici.\nOn va enfin pouvoir s'\xE9chapper\u2026
      ?"
    m_Metadata:
      m_Items: []
  - m_Id: 337056501444608
    m_Localized: "\u2026(CRAC !)"
    m_Metadata:
      m_Items: []
  - m_Id: 337060553142272
    m_Localized: "Oh non, on se fait avaler\u2026 !!"
    m_Metadata:
      m_Items: []
  - m_Id: 337070598500352
    m_Localized: "On s'est fait avaler\u2026 on est dans l'\u0153sophage, maintenant.\nPas
      le choix : il faut descendre et trouver une sortie."
    m_Metadata:
      m_Items: []
  - m_Id: 337897539088384
    m_Localized: "L'\u0153sophage va se resserrer sur nous.\nD\xE8s que l'alerte
      appara\xEEt, criez le cri d'\xE9quipe ensemble pour l'arr\xEAter !"
    m_Metadata:
      m_Items: []
  - m_Id: 337902496755712
    m_Localized: "Des murs color\xE9s vont se refermer des deux c\xF4t\xE9s.\nSi
      un mur affiche ma couleur, fonce dedans : \xE7a le fera reculer."
    m_Metadata:
      m_Items: []
  - m_Id: 337904153505792
    m_Localized: "On dirait que du gaz s'accumule dans l'\u0153sophage\u2026\nS'il
      devient trop \xE9pais pour voir, criez le cri d'\xE9quipe pour le dissiper
      !"
    m_Metadata:
      m_Items: []
  - m_Id: 337904874926080
    m_Localized: Retiens ma couleur et avance sur les cases qui correspondent !
    m_Metadata:
      m_Items: []
  - m_Id: 337906154188800
    m_Localized: "La couleur de la zone doit passer en premier, ensuite le chemin
      sera s\xFBr. On ne double pas !"
    m_Metadata:
      m_Items: []
  - m_Id: 337906812694528
    m_Localized: "L'\u0153sophage s'est contract\xE9 d'un coup et le passage est
      bloqu\xE9 !"
    m_Metadata:
      m_Items: []
  - m_Id: 337907517337600
    m_Localized: L'un de nous court en bas. Les autres, marchez sur les dalles de
      couleur pour ouvrir les portes !
    m_Metadata:
      m_Items: []
  - m_Id: 339357207212032
    m_Localized: "C'est la fin de l'\u0153sophage\u2026\nEn bas, \xE7a doit \xEAtre
      rempli d'acide gastrique. Descendre sans se pr\xE9parer, c'est dangereux."
    m_Metadata:
      m_Items: []
  - m_Id: 339360646541312
    m_Localized: "Le bonbon de tout \xE0 l'heure tombe du plafond.\nIl faut l'arr\xEAter
      avant qu'il touche le sol !"
    m_Metadata:
      m_Items: []
  - m_Id: 340094578438144
    m_Localized: "Ouf\u2026 on l'a arr\xEAt\xE9 de justesse\u2026\nMaintenant, r\xE9fl\xE9chissons
      \xE0 comment descendre sans risque."
    m_Metadata:
      m_Items: []
  - m_Id: 340096402960384
    m_Localized: "Glou\u2026 glou\u2026\nIl s'\xE9touffe et s'est mis \xE0 boire
      de l'eau ! Le bonbon descend !"
    m_Metadata:
      m_Items: []
  - m_Id: 335177390338048
    m_Localized: "Quand ta couleur appara\xEEt au sol, appuie sur <color=#FFD24D><b>Space</b></color>.\nLe
      blanc, tout le monde peut appuyer, mais surtout pas le noir !\nLe noir passe
      tout seul au tour suivant au bout d'1 seconde."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000001
    m_Localized: "\xC0 partir de maintenant, pensez juste \xE0 survivre."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000002
    m_Localized: "Retenez bien o\xF9 sont les bouches color\xE9es autour de vous.\nMarchez
      sur la dalle, et la bouche de cette couleur surgira pour briser les dents."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000003
    m_Localized: "Une seule couleur monte \xE0 la fois.\n\xC7a ne sert \xE0 rien
      de marcher dessus tous ensemble."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000004
    m_Localized: "Quand la bouche g\xE9ante commence \xE0 se fermer, criez tous le
      cri d'\xE9quipe !\nSinon, tout va devenir noir."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000005
    m_Localized: Autant de joueurs par zone que de KKUL-TTEOK ! Chacun ne voit que
      ceux de son panneau, alors annoncez-les !
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000006
    m_Localized: "Il a mang\xE9 un truc \xE9pic\xE9 avant de me manger\u2026 ?\nLa
      bave n'arr\xEAte pas de remonter du sol."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000007
    m_Localized: "Avec toute cette bave, le sol va glisser.\nCrions le cri d'\xE9quipe
      ensemble et on pourra la faire dispara\xEEtre !"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000008
    m_Localized: "Maintenant, \xE7a coule aussi d'en haut !\nIl a d\xFB manger un
      truc \xE9pic\xE9 et acide."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000009
    m_Localized: 'Certaines gouttes me visent !

      Accorde ma couleur au sol
      avec <color=#FFD24D><b>Ctrl</b></color> et elles me perdront de vue.'
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000010
    m_Localized: "\xC0 partir de maintenant, tu ne verras que la case suivante.\nRetiens-la
      bien !"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000011
    m_Localized: "Ici aussi, quelque chose me vise !\nAccorde ma couleur au sol avec
      <color=#FFD24D><b>Ctrl</b></color> et \xE7a me perdra de vue."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000012
    m_Localized: "Cette fois, la langue va d\xE9truire tout le c\xF4t\xE9 gauche
      ou droit du sol.\nCriez le cri d'\xE9quipe pour l'arr\xEAter \u2014 sinon,
      il va se briser."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000013
    m_Localized: "Le sol ne revient que si vous criez le cri d'\xE9quipe pendant
      l'alerte.\nUne fois cass\xE9, il faudra tenir jusqu'\xE0 la prochaine alerte."
    m_Metadata:
      m_Items: []
  - m_Id: 12337130970394624
    m_Localized: "C'est un bonbon qui roule derri\xE8re nous ?! Courez si vous ne
      voulez pas finir en cr\xEApe !"
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531969
    m_Localized: "On dirait du reflux\u2026 l'acide gastrique remonte !\nSi on ne
      passe pas chaque section avant la fin du chrono du panneau, on va finir par
      nager dedans !"
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531972
    m_Localized: "\xC7a doit \xEAtre une r\xE9action allergique\u2026 l'\u0153sophage
      est tout enfl\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531973
    m_Localized: "Une seule couleur de porte s'ouvre \xE0 la fois. Quelque chose
      nous poursuit, d\xE9p\xEAchez-vous !"
    m_Metadata:
      m_Items: []
  - m_Id: 13504475839442944
    m_Localized: "Des cases color\xE9es vont s'allumer au sol.\nSi ta couleur appara\xEEt,
      mets-toi uniquement sur cette case.\nSinon, tiens bon sur le noir ou le blanc
      \u2014 celui qui te correspond !"
    m_Metadata:
      m_Items: []
  - m_Id: 17908244660465664
    m_Localized: "Il est devenu si sensible qu'un seul d'entre nous peut tenir par
      case.\nCertaines cases se brisent facilement, alors r\xE9agissez vite !"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
