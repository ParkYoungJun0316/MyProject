%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogue_fr
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: 043bf15b2a6a41c48971e11c678f419c, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 472199573504
    m_Localized: "Pourquoi tu as mang\u00E9 un KKUL-TTEOK au lieu de tous ces bons fruits et bonbons !!!"
    m_Metadata:
      m_Items: []
  - m_Id: 334352332992512
    m_Localized: "Des dalles color\u00E9es vont appara\u00EEtre au sol.\nRestez dessus 2 secondes et le score augmente."
    m_Metadata:
      m_Items: []
  - m_Id: 334425666203648
    m_Localized: "Les dalles blanches ou noires, n'importe qui peut les prendre, mais les dalles de couleur unique ne comptent que pour cette couleur.\nNe bloquez pas le passage, bougez vite !"
    m_Metadata:
      m_Items: []
  - m_Id: 334428463804416
    m_Localized: ""
    m_Metadata:
      m_Items: []
  - m_Id: 335182629023744
    m_Localized: "Quelque chose bouge sous nos pieds... attention !\nUne attaque de langue arrive !"
    m_Metadata:
      m_Items: []
  - m_Id: 335185439207424
    m_Localized: "Une langue va surgir du centre, bloquant la vue de l'autre c\u00F4t\u00E9 et le passage.\nCriez tous le cri d'\u00E9quipe pour la faire redescendre et r\u00E9parer le chemin d\u00E9truit."
    m_Metadata:
      m_Items: []
  - m_Id: 335887280484352
    m_Localized: "On dirait qu'il fait de l'exercice !\nSa respiration est devenue soudainement plus forte.\nLe vent arrive !\nMontez sur la bonne dalle et tenez bon !"
    m_Metadata:
      m_Items: []
  - m_Id: 335890795311104
    m_Localized: "Hah... hah... encore un peu, et on devrait pouvoir sortir vivants..."
    m_Metadata:
      m_Items: []
  - m_Id: 335893903290368
    m_Localized: ""
    m_Metadata:
      m_Items: []
  - m_Id: 337052009345024
    m_Localized: "Ce silence... c'est devenu calme \u00E0 l'int\u00E9rieur.\nEst-ce qu'on va enfin pouvoir s'\u00E9chapper... ?"
    m_Metadata:
      m_Items: []
  - m_Id: 337056501444608
    m_Localized: ".....(CRAC !)"
    m_Metadata:
      m_Items: []
  - m_Id: 337060553142272
    m_Localized: "Non, on se fait avaler... !!"
    m_Metadata:
      m_Items: []
  - m_Id: 337068631371776
    m_Localized: ""
    m_Metadata:
      m_Items: []
  - m_Id: 337070598500352
    m_Localized: "On serait pass\xE9s dans l'\u0153sophage...?"
    m_Metadata:
      m_Items: []
  - m_Id: 337897539088384
    m_Localized: "On dirait que quelque chose roule derri\xE8re nous..."
    m_Metadata:
      m_Items: []
  - m_Id: 337902496755712
    m_Localized: Cours!!!
    m_Metadata:
      m_Items: []
  - m_Id: 337904153505792
    m_Localized: "Un faux pas et c'est la mort instantan\xE9e. Retiens juste les
      cases qui brillent."
    m_Metadata:
      m_Items: []
  - m_Id: 337904874926080
    m_Localized: "Cette fois, \xE7a s'affichera par couleur. Fais bien correspondre
      ta propre couleur!"
    m_Metadata:
      m_Items: []
  - m_Id: 337905520848896
    m_Localized: "M\xEAme si la couleur est bonne, le noir et blanc te tuera."
    m_Metadata:
      m_Items: []
  - m_Id: 337906154188800
    m_Localized: "Chaque zone a une couleur responsable. Le chemin ne devient s\xFBr
      que quand cette couleur passe en premier."
    m_Metadata:
      m_Items: []
  - m_Id: 337906812694528
    m_Localized: Attrape les globules rouges qui fuient!
    m_Metadata:
      m_Items: []
  - m_Id: 337907517337600
    m_Localized: Fuis les anticorps et survis!
    m_Metadata:
      m_Items: []
  - m_Id: 339357207212032
    m_Localized: "On est arriv\xE9s au bout de l'\u0153sophage."
    m_Metadata:
      m_Items: []
  - m_Id: 339360646541312
    m_Localized: "C'est peut-\xEAtre parce que c'est la derni\xE8re ligne droite...
      la pression est diff\xE9rente."
    m_Metadata:
      m_Items: []
  - m_Id: 339362018078720
    m_Localized: "Ne t'arr\xEAte pas, continue de bouger!"
    m_Metadata:
      m_Items: []
  - m_Id: 340094578438144
    m_Localized: "La compression s'est arr\xEAt\xE9e. Ouf... on a fini par survivre."
    m_Metadata:
      m_Items: []
  - m_Id: 340096402960384
    m_Localized: Mais le sol a l'air bizarre...
    m_Metadata:
      m_Items: []
  - m_Id: 340097782886400
    m_Localized: "Il commence \xE0 s'effondrer!"
    m_Metadata:
      m_Items: []
  - m_Id: 335177390338048
    m_Localized: "Quand ta couleur appara\u00EEt au sol, appuie sur <color=#FFD24D><b>Space</b></color>.\nN'importe qui peut appuyer pour le blanc, mais jamais pour le noir !\nApr\u00E8s 1 seconde, \u00E7a passe automatiquement au tour suivant."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000001
    m_Localized: "On dit qu'on peut survivre m\u00EAme dans la tani\u00E8re du tigre si on garde la t\u00EAte froide..!\n\u00C0 partir de maintenant, pensons juste \u00E0 survivre."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000002
    m_Localized: "Souvenez-vous bien de l'emplacement des bouches color\u00E9es autour de vous.\nMarchez sur la dalle, et la bouche de cette couleur se soul\u00E8vera pour briser les dents."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000003
    m_Localized: "Une seule couleur monte \u00E0 la fois.\n\u00C7a ne sert \u00E0 rien de marcher dessus tous ensemble."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000004
    m_Localized: "Si \u00E7a commence \u00E0 se refermer... criez tous le cri d'\u00E9quipe !\nSinon, vous ne verrez plus rien devant vous."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000005
    m_Localized: "Entrez dans la zone s\u00FBre indiqu\u00E9e \u00E0 l'\u00E9cran !"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000006
    m_Localized: "Il a mang\u00E9 \u00E9pic\u00E9 avant de m'avaler, ou quoi..?\nLa bave n'arr\u00EAte pas de monter du sol."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000007
    m_Localized: "Le sol est couvert de bave glissante.\nCriez tous le cri d'\u00E9quipe pour l'effacer."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000008
    m_Localized: "Maintenant \u00E7a d\u00E9gouline m\u00EAme d'en haut !\nIl a s\u00FBrement mang\u00E9 \u00E9pic\u00E9, et en plus quelque chose d'acide.\nIl essaie clairement de neutraliser \u00E7a avec un KKUL-TTEOK !"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000009
    m_Localized: "Certaines gouttes qui tombent me visent : appuyez sur <color=#FFD24D><b>Ctrl</b></color> pour assortir la couleur du sol \u00E0 la v\u00F4tre et d\u00E9bloquer le ciblage."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000010
    m_Localized: "\u00C0 partir de maintenant, une seule dalle en avance sera visible.\nM\u00E9morisez-la bien !"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000011
    m_Localized: "Ici aussi, quelque chose me vise.\nAppuyez sur <color=#FFD24D><b>Ctrl</b></color> pour assortir la couleur du sol \u00E0 la v\u00F4tre et d\u00E9bloquer le ciblage."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000012
    m_Localized: "Cette fois, la langue va d\u00E9truire tout le sol de gauche ou de droite.\nCriez le cri d'\u00E9quipe pour la bloquer ; sinon, \u00E7a se casse tout simplement."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000013
    m_Localized: "\u00C7a ne se r\u00E9pare que si vous criez le cri d'\u00E9quipe pendant que l'alerte est active.\nUne fois le sol d\u00E9truit, il faudra tenir jusqu'\u00E0 la prochaine alerte."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
