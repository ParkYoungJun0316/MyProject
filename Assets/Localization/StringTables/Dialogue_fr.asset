--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogue_fr
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: 043bf15b2a6a41c48971e11c678f419c, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 472199573504
    m_Localized: "On a \xE9t\xE9 mang\xE9s. \xC0 partir de maintenant, pense juste
      \xE0 survivre."
    m_Metadata:
      m_Items: []
  - m_Id: 334352332992512
    m_Localized: "\xC0 partir de maintenant, une tuile de ta couleur appara\xEEtra
      al\xE9atoirement sur le sol."
    m_Metadata:
      m_Items: []
  - m_Id: 334425666203648
    m_Localized: Tu dois monter sur elle avant la fin du temps limite.
    m_Metadata:
      m_Items: []
  - m_Id: 334428463804416
    m_Localized: "Si tu n'y arrives pas... les dents du plafond commenceront \xE0
      tomber."
    m_Metadata:
      m_Items: []
  - m_Id: 335182629023744
    m_Localized: N'importe qui peut appuyer pour le blanc, mais ne jamais appuyer
      pour le noir!
    m_Metadata:
      m_Items: []
  - m_Id: 335185439207424
    m_Localized: Une mauvaise pression te fait perdre du temps, alors fais attention!
    m_Metadata:
      m_Items: []
  - m_Id: 335887280484352
    m_Localized: Monte sur la tuile de ta couleur et tiens bon!
    m_Metadata:
      m_Items: []
  - m_Id: 335890795311104
    m_Localized: "C'est ici la derni\xE8re partie de la bouche."
    m_Metadata:
      m_Items: []
  - m_Id: 335893903290368
    m_Localized: Si on tient encore un peu, on devrait pouvoir sortir...
    m_Metadata:
      m_Items: []
  - m_Id: 337052009345024
    m_Localized: "Le silence est revenu dans la bouche... tout s'est arr\xEAt\xE9?"
    m_Metadata:
      m_Items: []
  - m_Id: 337056501444608
    m_Localized: "\xC7a veut dire qu'on peut s'\xE9chapper maintenant...?"
    m_Metadata:
      m_Items: []
  - m_Id: 337060553142272
    m_Localized: "\u2026\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 337068631371776
    m_Localized: "Non, on est encore aval\xE9s...!!"
    m_Metadata:
      m_Items: []
  - m_Id: 337070598500352
    m_Localized: "On serait pass\xE9s dans l'\u0153sophage...?"
    m_Metadata:
      m_Items: []
  - m_Id: 337897539088384
    m_Localized: "On dirait que quelque chose roule derri\xE8re nous..."
    m_Metadata:
      m_Items: []
  - m_Id: 337902496755712
    m_Localized: Cours!!!
    m_Metadata:
      m_Items: []
  - m_Id: 337904153505792
    m_Localized: "Un faux pas et c'est la mort instantan\xE9e. Retiens juste les
      cases qui brillent."
    m_Metadata:
      m_Items: []
  - m_Id: 337904874926080
    m_Localized: "Cette fois, \xE7a s'affichera par couleur. Fais bien correspondre
      ta propre couleur!"
    m_Metadata:
      m_Items: []
  - m_Id: 337905520848896
    m_Localized: "M\xEAme si la couleur est bonne, le noir et blanc te tuera."
    m_Metadata:
      m_Items: []
  - m_Id: 337906154188800
    m_Localized: "Chaque zone a une couleur responsable. Le chemin ne devient s\xFBr
      que quand cette couleur passe en premier."
    m_Metadata:
      m_Items: []
  - m_Id: 337906812694528
    m_Localized: Attrape les globules rouges qui fuient!
    m_Metadata:
      m_Items: []
  - m_Id: 337907517337600
    m_Localized: Fuis les anticorps et survis!
    m_Metadata:
      m_Items: []
  - m_Id: 339357207212032
    m_Localized: "On est arriv\xE9s au bout de l'\u0153sophage."
    m_Metadata:
      m_Items: []
  - m_Id: 339360646541312
    m_Localized: "C'est peut-\xEAtre parce que c'est la derni\xE8re ligne droite...
      la pression est diff\xE9rente."
    m_Metadata:
      m_Items: []
  - m_Id: 339362018078720
    m_Localized: "Ne t'arr\xEAte pas, continue de bouger!"
    m_Metadata:
      m_Items: []
  - m_Id: 340094578438144
    m_Localized: "La compression s'est arr\xEAt\xE9e. Ouf... on a fini par survivre."
    m_Metadata:
      m_Items: []
  - m_Id: 340096402960384
    m_Localized: Mais le sol a l'air bizarre...
    m_Metadata:
      m_Items: []
  - m_Id: 340097782886400
    m_Localized: "Il commence \xE0 s'effondrer!"
    m_Metadata:
      m_Items: []
  - m_Id: 335177390338048
    m_Localized: "Appuie sur <b><color=#FFC400>Espace</color></b> quand ta couleur
      appara\xEEt sur le sol."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
