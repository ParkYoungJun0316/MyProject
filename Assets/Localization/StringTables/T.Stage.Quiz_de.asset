  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: T.Stage.Quiz_de
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: de
  m_SharedData: {fileID: 11400000, guid: 96adcc13da5290147bc44fb643567e28, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 895241269248
    m_Localized: "Nahrung rutscht durch die Speiser\xF6hre wegen der Schwerkraft
      nach unten."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240768
    m_Localized: "Die Speiser\xF6hre schiebt Nahrung durch Muskelbewegungen nach
      unten, sodass man sogar kopf\xFCber schlucken kann."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240769
    m_Localized: "Die Verdauung findet in der Speiser\xF6hre statt."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240770
    m_Localized: "Die Speiser\xF6hre transportiert Nahrung haupts\xE4chlich zum Magen."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240771
    m_Localized: "Die Speiser\xF6hre ist immer ge\xF6ffnet."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240772
    m_Localized: "Normalerweise ist sie geschlossen und \xF6ffnet sich nur, wenn
      Nahrung durchgeht."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240773
    m_Localized: "Die Speiser\xF6hre bewegt Nahrung nur nach unten."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240774
    m_Localized: Beim Erbrechen kann sich Nahrung stattdessen nach oben bewegen.
    m_Metadata:
      m_Items: []
  - m_Id: 895262240775
    m_Localized: "Zwischen Speiser\xF6hre und Magen gibt es einen Muskel, der Reflux
      verhindert."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240776
    m_Localized: "Der untere \xD6sophagussphinkter verhindert, dass Magens\xE4ure
      wieder hochsteigt."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240777
    m_Localized: "Speiser\xF6hrenkrebs l\xE4sst sich fr\xFCh leicht erkennen."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240778
    m_Localized: "Anfangs gibt es oft nur wenige Symptome, weshalb er h\xE4ufig sp\xE4t
      erkannt wird."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240779
    m_Localized: "Schluckauf wird durch die Speiser\xF6hre verursacht."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240780
    m_Localized: "Schluckauf entsteht, wenn sich das Zwerchfell pl\xF6tzlich zusammenzieht."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240781
    m_Localized: "Die Speiser\xF6hre kann sich auch bewegen, wenn keine Nahrung drin
      ist."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240782
    m_Localized: "In der Speiser\xF6hre k\xF6nnen weiterhin kleine Muskelbewegungen
      stattfinden."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240783
    m_Localized: "Die Speiser\xF6hre kann auch Luft transportieren."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240784
    m_Localized: "Beim Aufsto\xDFen bewegt sich Luft durch die Speiser\xF6hre."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240785
    m_Localized: "Wasser kann kurz in der Speiser\xF6hre bleiben."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240786
    m_Localized: Auch Wasser bewegt sich durch Muskelbewegungen nach unten.
    m_Metadata:
      m_Items: []
  - m_Id: 895262240787
    m_Localized: "Die Speiser\xF6hre steuert selbst, wann sie sich \xF6ffnet und
      schlie\xDFt."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240788
    m_Localized: Ihre Bewegungen werden automatisch vom Nervensystem gesteuert.
    m_Metadata:
      m_Items: []
  - m_Id: 895262240789
    m_Localized: "Die Speiser\xF6hre bereitet sich schon vor, wenn sie nur den Geruch
      von Essen wahrnimmt."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240790
    m_Localized: Das Gehirn aktiviert das Verdauungssystem, wenn es Nahrung erwartet.
    m_Metadata:
      m_Items: []
  - m_Id: 895262240791
    m_Localized: "Eine Tablette kann sich noch im Hals festsitzend anf\xFChlen, obwohl
      sie schon runtergeschluckt wurde."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240792
    m_Localized: "Eine Reizung der Speiser\xF6hre kann dazu f\xFChren, dass dein
      Gehirn dort weiterhin etwas sp\xFCrt."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
