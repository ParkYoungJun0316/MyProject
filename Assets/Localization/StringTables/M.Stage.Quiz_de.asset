  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: M.Stage.Quiz_de
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: de
  m_SharedData: {fileID: 11400000, guid: 05362dd87941b804c948c6c4f45df573, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 994491084800
    m_Localized: "Erwachsene produzieren t\xE4glich \xFCber 1 Liter Speichel."
    m_Metadata:
      m_Items: []
  - m_Id: 994524639232
    m_Localized: "Erwachsene produzieren t\xE4glich etwa 1 bis 1,5 Liter Speichel."
    m_Metadata:
      m_Items: []
  - m_Id: 994524639233
    m_Localized: "Verschiedene Bereiche der Zunge k\xF6nnen nur bestimmte Geschm\xE4cker
      wahrnehmen."
    m_Metadata:
      m_Items: []
  - m_Id: 994524639234
    m_Localized: "Jeder Bereich der Zunge kann alle Grundgeschm\xE4cker erkennen."
    m_Metadata:
      m_Items: []
  - m_Id: 994524639235
    m_Localized: Die Zungenmuster sind bei jedem Menschen unterschiedlich.
    m_Metadata:
      m_Items: []
  - m_Id: 994524639236
    m_Localized: "Die Oberfl\xE4chenmuster der Zunge sind so einzigartig, dass sie
      f\xFCr Biometrie-Technologie erforscht werden."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833536
    m_Localized: "Lippen haben keine Schwei\xDFdr\xFCsen wie normale Haut."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833537
    m_Localized: "Lippen trocknen leicht aus, weil sie keine Schwei\xDF- oder Fettdr\xFCsen
      haben."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833538
    m_Localized: Mit dem Alter vertragen viele Menschen bittere Speisen besser.
    m_Metadata:
      m_Items: []
  - m_Id: 994528833539
    m_Localized: "Das liegt an Ver\xE4nderungen des Geschmacks und wiederholter Erfahrung
      mit Nahrung."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833540
    m_Localized: "Der l\xE4ngste im Guinness-Buch der Rekorde verzeichnete menschliche
      Zahn war \xFCber 4 cm lang."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833541
    m_Localized: "Der l\xE4ngste verzeichnete menschliche Eckzahn war etwa 3,67 cm
      lang."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833542
    m_Localized: Im Mund leben Milliarden von Bakterien.
    m_Metadata:
      m_Items: []
  - m_Id: 994528833543
    m_Localized: "Selbst nach dem Z\xE4hneputzen bleiben viele Bakterien im Mund
      zur\xFCck."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833544
    m_Localized: Menschen produzieren im Schlaf viel mehr Speichel.
    m_Metadata:
      m_Items: []
  - m_Id: 994528833545
    m_Localized: Die Speichelproduktion kommt im Schlaf fast zum Stillstand, was
      morgens Mundgeruch verursachen kann.
    m_Metadata:
      m_Items: []
  - m_Id: 994528833546
    m_Localized: "Auch die Zunge kann m\xFCde werden."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833547
    m_Localized: "Die Zunge besteht aus Muskeln und kann daher bei starker Belastung
      erm\xFCden."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833548
    m_Localized: "Z\xE4hne haben eine andere Struktur als Knochen."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833549
    m_Localized: "Anders als Knochen k\xF6nnen sich Z\xE4hne nicht vollst\xE4ndig
      selbst reparieren."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833550
    m_Localized: Menschliche Lippen wirken rot, weil sie viel rotes Pigment enthalten.
    m_Metadata:
      m_Items: []
  - m_Id: 994528833551
    m_Localized: "Lippen sind d\xFCnn, sodass die Farbe der darunterliegenden Blutgef\xE4\xDFe
      durchscheint."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833552
    m_Localized: "Die Zunge ist einer der am schnellsten heilenden Teile des K\xF6rpers."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833553
    m_Localized: Die Zunge heilt schnell, weil sie stark durchblutet ist und Zellen
      sich schnell erneuern.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
