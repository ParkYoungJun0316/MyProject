%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogue_es-419
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: es-419
  m_SharedData: {fileID: 11400000, guid: 043bf15b2a6a41c48971e11c678f419c, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 472199573504
    m_Localized: "\xA1\xBFCon toda la fruta rica que hab\xEDa, por qu\xE9 me comiste
      a m\xED?!"
    m_Metadata:
      m_Items: []
  - m_Id: 334352332992512
    m_Localized: "Van a aparecer baldosas de colores en el piso.\nQu\xE9date 2 segundos
      encima de una para sumar un punto."
    m_Metadata:
      m_Items: []
  - m_Id: 334425666203648
    m_Localized: "Las baldosas blancas y negras sirven para cualquiera, pero las
      de color solo cuentan para ese color.\n\xA1No se estorben y mu\xE9vanse r\xE1pido!"
    m_Metadata:
      m_Items: []
  - m_Id: 335182629023744
    m_Localized: "Algo se mueve bajo nuestros pies\u2026 \xA1cuidado!\n\xA1Ah\xED
      viene la lengua!"
    m_Metadata:
      m_Items: []
  - m_Id: 335185439207424
    m_Localized: 'La lengua va a romper la plataforma del centro y cortar el paso.

      Si
      gritamos juntos el grito de equipo, va a bajar y el camino roto va a volver
      a estar como antes.'
    m_Metadata:
      m_Items: []
  - m_Id: 335887280484352
    m_Localized: "\xBFEstar\xE1 haciendo ejercicio o qu\xE9? \xA1De repente est\xE1
      respirando fuerte!"
    m_Metadata:
      m_Items: []
  - m_Id: 335890795311104
    m_Localized: "Uf\u2026 uf\u2026 un poco m\xE1s y tal vez salgamos vivos de aqu\xED\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 337052009345024
    m_Localized: "\u2026Aqu\xED adentro se qued\xF3 todo en silencio.\n\xBFSer\xE1
      que por fin podemos escapar\u2026?"
    m_Metadata:
      m_Items: []
  - m_Id: 337056501444608
    m_Localized: "\u2026(\xA1CRAC!)"
    m_Metadata:
      m_Items: []
  - m_Id: 337060553142272
    m_Localized: "\xA1Oh, no, nos est\xE1 tragando\u2026!!"
    m_Metadata:
      m_Items: []
  - m_Id: 337070598500352
    m_Localized: "Nos trag\xF3\u2026 ahora estamos en el es\xF3fago.\nNo queda de
      otra: hay que bajar y buscar una salida."
    m_Metadata:
      m_Items: []
  - m_Id: 337897539088384
    m_Localized: "El es\xF3fago nos va a apretar.\nCuando aparezca la advertencia,
      \xA1griten juntos el grito de equipo para detenerlo!"
    m_Metadata:
      m_Items: []
  - m_Id: 337902496755712
    m_Localized: "Van a venir paredes de colores por los dos lados.\nSi una pared
      muestra mi color, emb\xEDstela de lleno: as\xED la vas a hacer retroceder."
    m_Metadata:
      m_Items: []
  - m_Id: 337904153505792
    m_Localized: "Creo que se est\xE1 juntando gas en el es\xF3fago\u2026\nSi se
      pone tan denso que no se ve nada, \xA1griten el grito de equipo para despejarlo!"
    m_Metadata:
      m_Items: []
  - m_Id: 337904874926080
    m_Localized: "\xA1Recuerda mi color y avanza por las baldosas que coincidan!"
    m_Metadata:
      m_Items: []
  - m_Id: 337906154188800
    m_Localized: "Primero tiene que pasar el color de la zona; despu\xE9s el camino
      va a ser seguro. \xA1Nada de saltarse la fila!"
    m_Metadata:
      m_Items: []
  - m_Id: 337906812694528
    m_Localized: "\xA1El es\xF3fago se sacudi\xF3 de golpe y bloque\xF3 el paso!"
    m_Metadata:
      m_Items: []
  - m_Id: 337907517337600
    m_Localized: "Uno corre abajo. \xA1Los dem\xE1s, pisen las placas de color para
      abrir las puertas!"
    m_Metadata:
      m_Items: []
  - m_Id: 339357207212032
    m_Localized: "Este es el final del es\xF3fago\u2026\nAh\xED abajo debe estar
      lleno de \xE1cido. Bajar sin prepararse es peligroso."
    m_Metadata:
      m_Items: []
  - m_Id: 339360646541312
    m_Localized: "El dulce de antes est\xE1 cayendo del techo.\n\xA1Hay que detenerlo
      antes de que toque el piso!"
    m_Metadata:
      m_Items: []
  - m_Id: 340094578438144
    m_Localized: "Uf\u2026 apenas lo logramos\u2026\nAhora pensemos c\xF3mo bajar
      sin peligro."
    m_Metadata:
      m_Items: []
  - m_Id: 340096402960384
    m_Localized: "Glup\u2026 glup\u2026\n\xA1Se atragant\xF3 y se puso a tomar agua!
      \xA1El dulce est\xE1 bajando!"
    m_Metadata:
      m_Items: []
  - m_Id: 335177390338048
    m_Localized: "Cuando salga tu color en el piso, presiona <color=#FFD24D><b>Space</b></color>.\nEl
      blanco lo puede presionar cualquiera, \xA1pero el negro ni lo toquen!\nEl negro
      pasa solo al siguiente turno despu\xE9s de 1 segundo."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000001
    m_Localized: De ahora en adelante, piensen solo en sobrevivir.
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000002
    m_Localized: "F\xEDjense bien d\xF3nde est\xE1n las bocas de colores.\nSi pisan
      la placa, la boca de ese color se va a levantar y har\xE1 pedazos los dientes."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000003
    m_Localized: 'Solo sube un color a la vez.

      No sirve de nada que pisen
      todos juntos.'
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000004
    m_Localized: "Cuando la boca gigante empiece a cerrarse, \xA1griten todos el
      grito de equipo!\nSi no, todo se va a quedar a oscuras."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000005
    m_Localized: "\xA1En cada zona tiene que haber tantos como KKUL-TTEOK! Cada uno
      solo ve los de su letrero, \xA1as\xED que av\xEDsense!"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000006
    m_Localized: "\xBFHabr\xE1 comido algo picante antes de comerme\u2026?\nNo para
      de salir baba del piso."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000007
    m_Localized: "Con tanta baba, el piso va a quedar resbaloso.\n\xA1Si gritamos
      juntos el grito de equipo, podemos quitarla!"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000008
    m_Localized: "\xA1Ahora tambi\xE9n gotea desde arriba!\nSeguro que comi\xF3 algo
      picante y \xE1cido."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000009
    m_Localized: "\xA1Algunas gotas me est\xE1n apuntando!\nIguala mi color con el
      del piso con <color=#FFD24D><b>Ctrl</b></color> y me van a perder de vista."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000010
    m_Localized: "De ahora en adelante solo vas a ver la siguiente baldosa.\n\xA1Memor\xEDzala
      bien!"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000011
    m_Localized: "\xA1Aqu\xED tambi\xE9n hay algo apunt\xE1ndome!\nIguala mi color
      con el del piso con <color=#FFD24D><b>Ctrl</b></color> y me va a perder de
      vista."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000012
    m_Localized: 'Esta vez la lengua va a destrozar todo el lado izquierdo o derecho
      del piso.

      Griten el grito de equipo para detenerla; si no, se va a romper.'
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000013
    m_Localized: "El piso solo vuelve si gritan el grito de equipo mientras est\xE1
      la advertencia.\nSi ya se rompi\xF3, les va a tocar aguantar hasta la siguiente
      advertencia."
    m_Metadata:
      m_Items: []
  - m_Id: 12337130970394624
    m_Localized: "\xA1\xBFEso que viene rodando atr\xE1s es un dulce?! \xA1Corran
      si no quieren quedar aplastados!"
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531969
    m_Localized: "Parece reflujo\u2026 \xA1est\xE1 subiendo \xE1cido del est\xF3mago!\nSi
      no pasamos cada tramo antes de que se acabe el tiempo del letrero, \xA1vamos
      a terminar nadando en \xE9l!"
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531972
    m_Localized: "Debe ser una reacci\xF3n al\xE9rgica\u2026 el es\xF3fago est\xE1
      todo hinchado."
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531973
    m_Localized: "Solo se abren las puertas de un color a la vez. \xA1Algo nos persigue,
      ap\xFArense!"
    m_Metadata:
      m_Items: []
  - m_Id: 13504475839442944
    m_Localized: "Se van a iluminar casillas de colores en el piso.\nSi sale tu color,
      ponte solo en esa casilla.\nSi no, aguanta en la negra o la blanca, \xA1la
      que coincida contigo!"
    m_Metadata:
      m_Items: []
  - m_Id: 17908244660465664
    m_Localized: "Est\xE1 tan sensible que solo cabe uno por casilla.\nAlgunas casillas
      se rompen f\xE1cil, \xA1reaccionen r\xE1pido!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
