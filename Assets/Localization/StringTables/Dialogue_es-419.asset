%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogue_es-419
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: es-419
  m_SharedData: {fileID: 11400000, guid: 043bf15b2a6a41c48971e11c678f419c, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 472199573504
    m_Localized: "\xA1\xBFPor qu\xE9 comiste un KKUL-TTEOK en lugar de toda la fruta
      y los dulces tan ricos que hab\xEDa?!"
    m_Metadata:
      m_Items: []
  - m_Id: 334352332992512
    m_Localized: "Van a aparecer baldosas de colores en el piso.\nQu\xE9dense 2 segundos
      encima de una y sube el puntaje."
    m_Metadata:
      m_Items: []
  - m_Id: 334425666203648
    m_Localized: "Las baldosas blancas o negras las puede pisar cualquiera, pero
      las de color \xFAnico solo suman puntos si las pisa ese color.\n\xA1No bloqueen
      el paso, mu\xE9vanse r\xE1pido!"
    m_Metadata:
      m_Items: []
  - m_Id: 334428463804416
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 335182629023744
    m_Localized: "Algo se mueve bajo nuestros pies... \xA1cuidado!\n\xA1Viene un
      ataque de lengua!"
    m_Metadata:
      m_Items: []
  - m_Id: 335185439207424
    m_Localized: 'La lengua va a destrozar la plataforma del centro y bloquear el
      camino.

      Griten todos el grito de equipo para que baje de nuevo y se
      repare el camino roto.'
    m_Metadata:
      m_Items: []
  - m_Id: 335887280484352
    m_Localized: "\xA1Parece que est\xE1 haciendo ejercicio! De repente empez\xF3
      a respirar m\xE1s fuerte.\n\xA1Viene viento! \xA1S\xFAbanse a la baldosa correcta
      y aguanten!"
    m_Metadata:
      m_Items: []
  - m_Id: 335890795311104
    m_Localized: "Fiu... fiu... con un poco m\xE1s de aguante, parece que vamos a
      poder salir con vida..."
    m_Metadata:
      m_Items: []
  - m_Id: 335893903290368
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 337052009345024
    m_Localized: "...La boca se qued\xF3 callada.\n\xBFSer\xE1 que por fin podemos
      escapar...?"
    m_Metadata:
      m_Items: []
  - m_Id: 337056501444608
    m_Localized: ".....(\xA1CRAC!)"
    m_Metadata:
      m_Items: []
  - m_Id: 337060553142272
    m_Localized: "No puede ser, \xA1nos est\xE1 tragando...!!"
    m_Metadata:
      m_Items: []
  - m_Id: 337068631371776
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 337070598500352
    m_Localized: "Nos trag\xF3 y terminamos en el es\xF3fago... As\xED las cosas,
      no queda de otra m\xE1s que bajar y escapar."
    m_Metadata:
      m_Items: []
  - m_Id: 337897539088384
    m_Localized: "El es\xF3fago se va a contraer a intervalos aleatorios. En cuanto
      aparezca la advertencia, \xA1griten todos el grito de equipo para detenerlo!"
    m_Metadata:
      m_Items: []
  - m_Id: 337902496755712
    m_Localized: "Van a avanzar paredes de colores desde los costados. Si una pared
      muestra tu color, ch\xF3cate contra ella sin miedo \u2014 va a retroceder."
    m_Metadata:
      m_Items: []
  - m_Id: 337904153505792
    m_Localized: "Memoricen solo las baldosas que brillan. Si pisan la equivocada,
      es muerte instant\xE1nea."
    m_Metadata:
      m_Items: []
  - m_Id: 337904874926080
    m_Localized: "Esta vez las va a mostrar por colores. \xA1Tienen que acertar con
      su propio color! Aunque el color sea el correcto, si est\xE1 en blanco y negro,
      mueren igual."
    m_Metadata:
      m_Items: []
  - m_Id: 337905520848896
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 337906154188800
    m_Localized: "Cada zona tiene un color asignado. \xA1El camino solo se vuelve
      seguro despu\xE9s de que pase primero ese color! \xA1Respeten el orden!"
    m_Metadata:
      m_Items: []
  - m_Id: 337906812694528
    m_Localized: "Vayan a atrapar a los gl\xF3bulos rojos que andan sueltos, a ver
      si le hacemos da\xF1o a este cuerpo. \xA1No podemos quedarnos solo aguantando
      golpes!"
    m_Metadata:
      m_Items: []
  - m_Id: 337907517337600
    m_Localized: "\xA1Al atrapar a los gl\xF3bulos rojos, los gl\xF3bulos blancos
      nos marcaron como enemigos! \xA1Corran y sobrevivan!"
    m_Metadata:
      m_Items: []
  - m_Id: 339357207212032
    m_Localized: "Este es el \xFAltimo tramo del es\xF3fago... ah\xED abajo debe
      estar lleno de \xE1cido del est\xF3mago. Bajar sin prepararnos es demasiado
      peligroso."
    m_Metadata:
      m_Items: []
  - m_Id: 339360646541312
    m_Localized: "El caramelo de antes est\xE1 bajando por el techo, y cada vez est\xE1
      m\xE1s grande. Tenemos que construir piso antes de que toque fondo \u2014 si
      no, nos va a arrastrar con \xE9l."
    m_Metadata:
      m_Items: []
  - m_Id: 339362018078720
    m_Localized: "Al superar cada tramo se genera parte del piso. \xA1R\xE1pido,
      constr\xFAyanlo para detener a eso!"
    m_Metadata:
      m_Items: []
  - m_Id: 340094578438144
    m_Localized: "Fiu... por poco lo detenemos... ahora pensemos. C\xF3mo bajar de
      forma segura desde aqu\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 340096402960384
    m_Localized: "Glup... glup... \xBFqu\xE9 es ese sonido...?"
    m_Metadata:
      m_Items: []
  - m_Id: 340097782886400
    m_Localized: "\xA1Se le ator\xF3 la garganta y empez\xF3 a beber agua! \xA1El
      caramelo est\xE1 rompiendo el piso!!"
    m_Metadata:
      m_Items: []
  - m_Id: 335177390338048
    m_Localized: "Cuando aparezca tu color en el piso, presiona <color=#FFD24D><b>Space</b></color>.\nAl
      blanco le puede dar cualquiera, \xA1pero al negro no le den!\nEl negro va a
      pasar autom\xE1ticamente al siguiente turno despu\xE9s de 1 segundo."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000001
    m_Localized: "Dicen que hasta en la cueva del tigre se puede sobrevivir si mantienes
      la cabeza fr\xEDa..!\nDe ahora en adelante, piensen solo en sobrevivir."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000002
    m_Localized: "Recuerden bien d\xF3nde est\xE1n las bocas de colores que hay alrededor.\nSi
      pisan la palanca, la boca de ese color se levanta y les rompe los dientes."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000003
    m_Localized: 'Solo se levanta un color a la vez.

      No sirve de nada pisarla
      todos juntos.'
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000004
    m_Localized: "Si esto empieza a cerrarse... \xA1griten todos el grito de equipo!\nSi
      no, se van a quedar sin ver nada."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000005
    m_Localized: "\xA1Entren a la zona segura que marca la pantalla!"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000006
    m_Localized: "\xBFHabr\xE1 comido algo picante antes de tragarme..?\nNo paran
      de salir babas del piso."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000007
    m_Localized: "El piso est\xE1 lleno de babas resbalosas.\nGriten todos el grito
      de equipo para quitarlas."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000008
    m_Localized: "\xA1Ahora tambi\xE9n caen babas desde arriba!\nSeguro que comi\xF3
      algo picante y encima algo \xE1cido.\n\xA1Est\xE1 clar\xEDsimo que quiere neutralizarlo
      con un KKUL-TTEOK!"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000009
    m_Localized: "Algunas de las babas que caen me apuntan a m\xED: presionen <color=#FFD24D><b>Ctrl</b></color>
      para igualar el color del piso con el suyo y desactivar el bloqueo."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000010
    m_Localized: "De ahora en adelante solo se va a ver una baldosa m\xE1s adelante.\n\xA1Memor\xEDcenla
      bien!"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000011
    m_Localized: "Aqu\xED tambi\xE9n hay algo que me apunta.\nPresionen <color=#FFD24D><b>Ctrl</b></color>
      para igualar el color del piso con el suyo y desactivar el bloqueo."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000012
    m_Localized: "Esta vez la lengua va a destrozar todo el piso de la izquierda
      o de la derecha.\nGriten el grito de equipo para bloquearla; si no lo hacen,
      se rompe nom\xE1s."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000013
    m_Localized: "Solo se repara si gritan el grito de equipo mientras est\xE9 activa
      la advertencia.\nUna vez que se rompe el piso, no queda otra que aguantar hasta
      la pr\xF3xima advertencia."
    m_Metadata:
      m_Items: []
  - m_Id: 12337130970394624
    m_Localized: "...\xBFese ruido de algo rodando? \xA1No me digan que es el caramelo
      de antes!? \xA1Corran si no quieren terminar aplastados!!"
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531968
    m_Localized: "Se le ator\xF3 un eructo en el es\xF3fago... est\xE1 empezando
      a acumularse el gas. Si se pone tan espeso que no se ve nada, griten el grito
      de equipo para despejarlo."
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531969
    m_Localized: "Cuidado con el piso. Debe tener reflujo \u2014 \xA1le est\xE1 subiendo
      \xE1cido del est\xF3mago!"
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531970
    m_Localized: "Van a venir ataques de p\xFAas desde donde no se ve. Est\xE9n siempre
      alerta."
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531971
    m_Localized: "Las paredes de los costados se van a poner en blanco y negro. \xA1Igualen
      el color y choquen contra la pared para hacer retroceder la presi\xF3n!"
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531972
    m_Localized: "Debe ser una reacci\xF3n al\xE9rgica \u2014 le salieron bultos
      por todo el es\xF3fago. Si chocan con uno, van a salir volando."
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531973
    m_Localized: "Si chocan contra una pared, van a salir despedidos. Podr\xEDamos
      usar eso para escapar, \xBFno?"
    m_Metadata:
      m_Items: []
  - m_Id: 12337131037503488
    m_Localized: "\xA1AAAAAAAAAH...!!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
