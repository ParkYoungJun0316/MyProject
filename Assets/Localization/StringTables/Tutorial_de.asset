  m_SharedData: {fileID: 11400000, guid: 240b9339ac6f60941bcab9ac03699409, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1040822272
    m_Localized: Bewegen
    m_Metadata:
      m_Items: []
  - m_Id: 1086959616
    m_Localized: "Sto\xDFen (0 Schaden)"
    m_Metadata:
      m_Items: []
  - m_Id: 1086959617
    m_Localized: "Schwarz-Wei\xDF"
    m_Metadata:
      m_Items: []
  - m_Id: 1086959618
    m_Localized: Deine Farbe
    m_Metadata:
      m_Items: []
  - m_Id: 1091153920
    m_Localized: Buff wechseln
    m_Metadata:
      m_Items: []
  - m_Id: 1091153921
    m_Localized: Solo-Anfeuerung
    m_Metadata:
      m_Items: []
  - m_Id: 1091153922
    m_Localized: "Rufe deinen eigenen Namen, um deinen Buff zu aktivieren.\nDr\xFCcke
      E, um deinen Spitznamen festzulegen.\nProbier's unbedingt einmal aus!"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153923
    m_Localized: Team-Anfeuerung
    m_Metadata:
      m_Items: []
  - m_Id: 1091153924
    m_Localized: "Wenn das Warnsymbol erscheint, ruft gemeinsam das Team-Wort.\nDadurch
      wird die Bedrohung durch Mund oder Speiser\xF6hre r\xFCckg\xE4ngig gemacht.\nNur
      der Host kann das Team-Wort festlegen \u2014 sprecht euch vorher im Team ab."
    m_Metadata:
      m_Items: []
  - m_Id: 1091153925
    m_Localized: Anfeuerungsname
    m_Metadata:
      m_Items: []
  - m_Id: 1091153926
    m_Localized: "Der Anfeuerungsname kann nur auf Englisch eingegeben werden.\nJe
      nat\xFCrlicher das Wort beim Aussprechen klingt, desto besser wird es erkannt!\nKein
      Mikro oder die Erkennung klappt nicht? Aktiviere die Zahlentasten-Anfeuerung
      im ESC-Men\xFC.\n(1 = Solo-Anfeuerung, 2 = Team-Anfeuerung \u2014 mit der Stimme
      macht es aber viel mehr Spa\xDF!)"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153927
    m_Localized: "Team-Anfeuerung \xFCben"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153928
    m_Localized: "Dr\xFCckst du [E], erscheint eine Warnung wie bei einer echten
      Bedrohung,\nund der Mund oben schlie\xDFt sich.\nRuft gemeinsam das Team-Wort,
      um ihn wieder zu \xF6ffnen.\n\xDCber dem Kopf der rufenden Person erscheint
      ein Herz."
    m_Metadata:
      m_Items: []
  - m_Id: 1091153929
    m_Localized: Auf geht's ins Spiel
    m_Metadata:
      m_Items: []
  - m_Id: 1091153930
    m_Localized: "Die Startzone liegt auf dem gelben Boden.\nSobald sich das ganze
      Team dort versammelt, l\xE4uft ein Countdown, und das Spiel beginnt.\nEuer
      Anfeuerungsname wird genau in dem Moment festgelegt, in dem der Countdown endet,\nalso
      stellt vorher sicher, dass alle fertig gew\xE4hlt haben."
    m_Metadata:
      m_Items: []
  - m_Id: 24992255946752
    m_Localized: Leg deinen Anfeuerungsnamen fest
    m_Metadata:
      m_Items: []
  - m_Id: 24992293695488
    m_Localized: "Das geht nicht\n\xB7 Beleidigungen/gesperrte W\xF6rter (z. B. fuck)\n\xB7
      Reservierte W\xF6rter (admin, host, cheer)\n\xB7 Zahlen, Unterstrich (_), Koreanisch,
      Emojis, ein einzelner Buchstabe\n\xB7 2\u201312 Zeichen, nur englische Kleinbuchstaben\n\nTeste
      nach dem Best\xE4tigen unbedingt, ob es wirklich erkannt wird!"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889792
    m_Localized: z. B. happy
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889793
    m_Localized: z. B. fighting
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889794
    m_Localized: "Best\xE4tigen"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889795
    m_Localized: "Schlie\xDFen"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889796
    m_Localized: 'Legt das Wort fest, das das ganze Team gemeinsam ruft (Standard:
      FIGHTING)'
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889797
    m_Localized: 'Team-Wort: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647744
    m_Localized: "Verwende nur 2\u201312 englische Kleinbuchstaben."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647745
    m_Localized: Das ist ein reserviertes Systemwort und kann nicht als Name verwendet
      werden.
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647746
    m_Localized: Das ist ein reserviertes Systemwort und kann nicht verwendet werden.
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647747
    m_Localized: "Das enth\xE4lt ein Wort, das nicht verwendet werden darf."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647748
    m_Localized: Dieser Name wird bereits von einem Teammitglied verwendet.
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647749
    m_Localized: Ein Teammitglied verwendet das bereits als Anfeuerungsname.
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647750
    m_Localized: "Der Name konnte nicht best\xE4tigt werden."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647751
    m_Localized: "Das Team-Wort konnte nicht best\xE4tigt werden."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647752
    m_Localized: Nur der Host kann das Team-Wort festlegen.
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647753
    m_Localized: "Wird gepr\xFCft \u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647754
    m_Localized: Keine Antwort erhalten. Bitte versuch's noch einmal.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
