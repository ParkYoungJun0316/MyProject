  m_TableData:
  - m_Id: 1040822272
    m_Localized: Bewegen
    m_Metadata:
      m_Items: []
  - m_Id: 1086959616
    m_Localized: "Sto\xDFen (kein Schaden)"
    m_Metadata:
      m_Items: []
  - m_Id: 1086959617
    m_Localized: Farbe S/W
    m_Metadata:
      m_Items: []
  - m_Id: 1086959618
    m_Localized: Farbe Eigenfarbe
    m_Metadata:
      m_Items: []
  - m_Id: 1091153920
    m_Localized: "Buff wechseln (Verteidigung \u2194 Tempo)"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153923
    m_Localized: Team-Anfeuerung
    m_Metadata:
      m_Items: []
  - m_Id: 1091153924
    m_Localized: "Wenn das Warnsymbol erscheint, ruft gemeinsam das Team-Wort, um
      die Bedrohung r\xFCckg\xE4ngig zu machen.\nDr\xFCcke hier [E], um sofort zu
      \xFCben."
    m_Metadata:
      m_Items: []
  - m_Id: 1091153925
    m_Localized: Team-Wort
    m_Metadata:
      m_Items: []
  - m_Id: 1091153926
    m_Localized: "Nur der Host kann das TeamCheerWord festlegen.\nJe nat\xFCrlicher
      das Wort beim Aussprechen klingt, desto besser wird es erkannt. (2\u201312
      Zeichen, nur englische Kleinbuchstaben)\nKein Mikro oder die Erkennung klappt
      nicht? Aktiviere die T-Taste-Anfeuerung unter Optionen \u2192 Allgemein und
      dr\xFCcke T, wenn die Warnung erscheint."
    m_Metadata:
      m_Items: []
  - m_Id: 24992255946752
    m_Localized: Leg das Team-Wort fest
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889793
    m_Localized: z. B. fighting
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889794
    m_Localized: "Best\xE4tigen"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889795
    m_Localized: "Schlie\xDFen"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889796
    m_Localized: 'Legt das Wort fest, das das ganze Team gemeinsam ruft (Standard:
      FIGHTING)'
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889797
    m_Localized: 'Team-Wort: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647744
    m_Localized: "Verwende nur 2\u201312 englische Kleinbuchstaben."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647746
    m_Localized: Das ist ein reserviertes Systemwort und kann nicht verwendet werden.
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647747
    m_Localized: "Das enth\xE4lt ein Wort, das nicht verwendet werden darf."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647751
    m_Localized: "Das Team-Wort konnte nicht best\xE4tigt werden."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647752
    m_Localized: Nur der Host kann das Team-Wort festlegen.
    m_Metadata:
      m_Items: []
  - m_Id: 53793039953920
    m_Localized: "Team-Wort \xE4ndern"
    m_Metadata:
      m_Items: []
  - m_Id: 53793073508352
    m_Localized: "Du kannst das Team-Wort ein letztes Mal \xE4ndern."
    m_Metadata:
      m_Items: []
  - m_Id: 56930631004160
    m_Localized: '[E] Team-Wort festlegen'
    m_Metadata:
      m_Items: []
  - m_Id: 56930635198464
    m_Localized: '[E] Team-Anfeuerung testen'
    m_Metadata:
      m_Items: []
  - m_Id: 1395064700000001
    m_Localized: Team wiederbeleben
    m_Metadata:
      m_Items: []
  - m_Id: 3228654335799296
    m_Localized: Buff nutzen
    m_Metadata:
      m_Items: []
  - m_Id: 3228654377742336
    m_Localized: Emote verwenden (1-8)
    m_Metadata:
      m_Items: []
  - m_Id: 3228654377742337
    m_Localized: Dies ist ein Spracherkennungsspiel. Bitte folge den Hinweisen auf
      dem Schild hinter dir.
    m_Metadata:
      m_Items: []
