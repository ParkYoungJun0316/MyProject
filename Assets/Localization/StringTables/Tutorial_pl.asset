  m_Name: Tutorial_pl
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: pl
  m_SharedData: {fileID: 11400000, guid: 240b9339ac6f60941bcab9ac03699409, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1040822272
    m_Localized: Ruch
    m_Metadata:
      m_Items: []
  - m_Id: 1086959616
    m_Localized: "Pchni\u0119cie (bez obra\u017Ce\u0144)"
    m_Metadata:
      m_Items: []
  - m_Id: 1086959617
    m_Localized: Zmiana koloru c/b
    m_Metadata:
      m_Items: []
  - m_Id: 1086959618
    m_Localized: "Zmiana koloru w\u0142asny"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153920
    m_Localized: "Zmiana buffa (obrona \u2194 pr\u0119dko\u015B\u0107)"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153921
    m_Localized: Doping solo
    m_Metadata:
      m_Items: []
  - m_Id: 1091153922
    m_Localized: "Krzyknij swoje imi\u0119, \u017Ceby aktywowa\u0107 swojego buffa.\nNaci\u015Bnij
      E, aby ustawi\u0107 sw\xF3j pseudonim.\nKoniecznie to przetestuj!"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153923
    m_Localized: "Doping dru\u017Cynowy"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153924
    m_Localized: "Gdy pojawi si\u0119 ikona ostrze\u017Cenia, krzyknijcie razem dru\u017Cynowe
      has\u0142o.\nTo cofa zagro\u017Cenie, kt\xF3re w\u0142a\u015Bnie stworzy\u0142y
      usta albo prze\u0142yk.\nHas\u0142o dru\u017Cynowe mo\u017Ce ustawi\u0107 tylko
      host \u2014 ustalcie je wcze\u015Bniej w dru\u017Cynie."
    m_Metadata:
      m_Items: []
  - m_Id: 1091153925
    m_Localized: "Imi\u0119 dopingowe"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153926
    m_Localized: "Imi\u0119 dopingowe mo\u017Cna wpisa\u0107 tylko po angielsku.\nIm
      bardziej naturalnie brzmi s\u0142owo, gdy je wypowiadasz, tym lepiej jest rozpoznawane!\nNie
      masz mikrofonu albo rozpoznawanie nie dzia\u0142a? W\u0142\u0105cz doping klawiszami
      numerycznymi w menu ESC.\n(1 to doping solo, 2 to doping dru\u017Cynowy \u2014
      ale dopingowanie g\u0142osem jest o wiele fajniejsze!)"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153927
    m_Localized: "Trening dopingu dru\u017Cynowego"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153928
    m_Localized: "Naci\u015Bni\u0119cie [E] wywo\u0142uje ostrze\u017Cenie takie
      jak przy prawdziwym zagro\u017Ceniu\ni usta na g\xF3rze si\u0119 zamykaj\u0105.\nKrzyknijcie
      razem dru\u017Cynowe has\u0142o, \u017Ceby je znowu otworzy\u0107.\nNad g\u0142ow\u0105
      osoby, kt\xF3ra krzykn\u0119\u0142a, pojawia si\u0119 serduszko."
    m_Metadata:
      m_Items: []
  - m_Id: 1091153929
    m_Localized: "Czas zacz\u0105\u0107 gr\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153930
    m_Localized: "Strefa startowa znajduje si\u0119 na \u017C\xF3\u0142tej pod\u0142odze.\nGdy
      zbierze si\u0119 tam ca\u0142a dru\u017Cyna, ruszy odliczanie, a potem zacznie
      si\u0119 gra.\nWasze imi\u0119 dopingowe zostaje ustalone dok\u0142adnie w
      momencie zako\u0144czenia odliczania,\nwi\u0119c upewnijcie si\u0119 wcze\u015Bniej,
      \u017Ce wszyscy ju\u017C wybrali."
    m_Metadata:
      m_Items: []
  - m_Id: 24992255946752
    m_Localized: "Wybierz swoje imi\u0119 dopingowe"
    m_Metadata:
      m_Items: []
  - m_Id: 24992293695488
    m_Localized: "Tak nie mo\u017Ce by\u0107\n\xB7 Wulgaryzmy/zakazane s\u0142owa
      (np. fuck)\n\xB7 Zastrze\u017Cone s\u0142owa (admin, host, cheer)\n\xB7 Cyfry,
      podkre\u015Blenie (_), korea\u0144ski, emotikony, jedna litera\n\xB7 2\u201312
      znak\xF3w, tylko ma\u0142e litery angielskiego alfabetu\n\nPo zatwierdzeniu
      koniecznie sprawd\u017A, czy naprawd\u0119 jest rozpoznawane!"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889792
    m_Localized: np. happy
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889793
    m_Localized: np. fighting
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889794
    m_Localized: "Potwierd\u017A"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889795
    m_Localized: Zamknij
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889796
    m_Localized: "Ustal s\u0142owo, kt\xF3re ca\u0142a dru\u017Cyna b\u0119dzie razem
      krzycze\u0107 (domy\u015Blnie: FIGHTING)"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889797
    m_Localized: "Has\u0142o dru\u017Cyny: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647744
    m_Localized: "U\u017Cyj od 2 do 12 ma\u0142ych liter angielskiego alfabetu."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647745
    m_Localized: "To zastrze\u017Cone s\u0142owo systemowe, nie mo\u017Cesz go u\u017Cy\u0107
      jako imienia."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647746
    m_Localized: "To zastrze\u017Cone s\u0142owo systemowe, nie mo\u017Cesz go u\u017Cy\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647747
    m_Localized: "Zawiera s\u0142owo, kt\xF3rego nie mo\u017Cna u\u017Cy\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647748
    m_Localized: "Ta nazwa jest ju\u017C u\u017Cywana przez innego cz\u0142onka dru\u017Cyny."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647749
    m_Localized: "Cz\u0142onek dru\u017Cyny u\u017Cywa ju\u017C tego jako imienia
      dopingowego."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647750
    m_Localized: "Nie uda\u0142o si\u0119 zatwierdzi\u0107 nazwy."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647751
    m_Localized: "Nie uda\u0142o si\u0119 zatwierdzi\u0107 has\u0142a dru\u017Cyny."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647752
    m_Localized: "Tylko host mo\u017Ce ustali\u0107 has\u0142o dru\u017Cyny."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647753
    m_Localized: "Sprawdzanie\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647754
    m_Localized: "Brak odpowiedzi. Spr\xF3buj ponownie."
    m_Metadata:
      m_Items: []
  - m_Id: 53793039953920
    m_Localized: Zmiana imienia
    m_Metadata:
      m_Items: []
  - m_Id: 53793073508352
    m_Localized: "Tutaj mo\u017Cesz ostatni raz zmieni\u0107 swoje imi\u0119 i has\u0142o
      dru\u017Cyny.\nJe\u015Bli to przegapisz, nie zmienisz ich ju\u017C do ko\u0144ca
      rozgrywki,\nwi\u0119c je\u015Bli chcesz co\u015B zmieni\u0107, zr\xF3b to teraz
      przy tablicy."
    m_Metadata:
      m_Items: []
  - m_Id: 56930631004160
    m_Localized: "[E] Ustaw imi\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 56930635198464
    m_Localized: "[E] Test dopingu dru\u017Cynowego"
    m_Metadata:
      m_Items: []
  - m_Id: 1395064601948160
    m_Localized: "Obrona blokuje te\u017C obra\u017Cenia rundy."
    m_Metadata:
      m_Items: []
  - m_Id: 1395064639696896
    m_Localized: "Powiedz swoje imi\u0119, \u017Ceby w\u0142\u0105czy\u0107 buffa."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
