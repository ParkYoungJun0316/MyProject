  m_TableData:
  - m_Id: 1040822272
    m_Localized: Ruch
    m_Metadata:
      m_Items: []
  - m_Id: 1086959616
    m_Localized: "Pchni\u0119cie (0 obra\u017Ce\u0144)"
    m_Metadata:
      m_Items: []
  - m_Id: 1086959617
    m_Localized: "Czer\u0144 i biel"
    m_Metadata:
      m_Items: []
  - m_Id: 1086959618
    m_Localized: "Tw\xF3j kolor"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153920
    m_Localized: Zmiana buffa
    m_Metadata:
      m_Items: []
  - m_Id: 1091153921
    m_Localized: Doping solo
    m_Metadata:
      m_Items: []
  - m_Id: 1091153922
    m_Localized: "Krzyknij swoje imi\u0119, \u017Ceby aktywowa\u0107 swojego buffa.\nNaci\u015Bnij
      E, aby ustawi\u0107 sw\xF3j pseudonim.\nKoniecznie to przetestuj!"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153923
    m_Localized: "Doping dru\u017Cynowy"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153924
    m_Localized: "Gdy pojawi si\u0119 ikona ostrze\u017Cenia, krzyknijcie razem dru\u017Cynowe
      has\u0142o.\nTo cofa zagro\u017Cenie, kt\xF3re w\u0142a\u015Bnie stworzy\u0142y
      usta albo prze\u0142yk.\nHas\u0142o dru\u017Cynowe mo\u017Ce ustawi\u0107 tylko
      host \u2014 ustalcie je wcze\u015Bniej w dru\u017Cynie."
    m_Metadata:
      m_Items: []
  - m_Id: 1091153925
    m_Localized: "Imi\u0119 dopingowe"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153926
    m_Localized: "Imi\u0119 dopingowe mo\u017Cna wpisa\u0107 tylko po angielsku.\nIm
      bardziej naturalnie brzmi s\u0142owo, gdy je wypowiadasz, tym lepiej jest rozpoznawane!\nNie
      masz mikrofonu albo rozpoznawanie nie dzia\u0142a? W\u0142\u0105cz doping klawiszami
      numerycznymi w menu ESC.\n(1 to doping solo, 2 to doping dru\u017Cynowy \u2014
      ale dopingowanie g\u0142osem jest o wiele fajniejsze!)"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153927
    m_Localized: "Trening dopingu dru\u017Cynowego"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153928
    m_Localized: "Naci\u015Bni\u0119cie [E] wywo\u0142uje ostrze\u017Cenie takie
      jak przy prawdziwym zagro\u017Ceniu\ni usta na g\xF3rze si\u0119 zamykaj\u0105.\nKrzyknijcie
      razem dru\u017Cynowe has\u0142o, \u017Ceby je znowu otworzy\u0107.\nNad g\u0142ow\u0105
      osoby, kt\xF3ra krzykn\u0119\u0142a, pojawia si\u0119 serduszko."
    m_Metadata:
      m_Items: []
  - m_Id: 1091153929
    m_Localized: "Czas zacz\u0105\u0107 gr\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153930
    m_Localized: "Strefa startowa znajduje si\u0119 na \u017C\xF3\u0142tej pod\u0142odze.\nGdy
      zbierze si\u0119 tam ca\u0142a dru\u017Cyna, ruszy odliczanie, a potem zacznie
      si\u0119 gra.\nWasze imi\u0119 dopingowe zostaje ustalone dok\u0142adnie w
      momencie zako\u0144czenia odliczania,\nwi\u0119c upewnijcie si\u0119 wcze\u015Bniej,
      \u017Ce wszyscy ju\u017C wybrali."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
