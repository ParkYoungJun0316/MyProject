  m_TableData:
  - m_Id: 1040822272
    m_Localized: Ruch
    m_Metadata:
      m_Items: []
  - m_Id: 1086959616
    m_Localized: "Pchni\u0119cie (bez obra\u017Ce\u0144)"
    m_Metadata:
      m_Items: []
  - m_Id: 1086959617
    m_Localized: Zmiana koloru c/b
    m_Metadata:
      m_Items: []
  - m_Id: 1086959618
    m_Localized: "Zmiana koloru w\u0142asny"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153920
    m_Localized: "Osobisty buff: Q \u2014 zmiana \xB7 Spacja \u2014 aktywacja (obrona
      \u2194 pr\u0119dko\u015B\u0107)"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153923
    m_Localized: "Doping dru\u017Cynowy"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153924
    m_Localized: "Gdy pojawi si\u0119 ikona ostrze\u017Cenia, krzyknijcie razem dru\u017Cynowe
      has\u0142o, \u017Ceby cofn\u0105\u0107 zagro\u017Cenie.\nNaci\u015Bnij tu [E],
      \u017Ceby od razu po\u0107wiczy\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 1091153925
    m_Localized: "Has\u0142o dru\u017Cyny"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153926
    m_Localized: "Tylko host mo\u017Ce ustawi\u0107 TeamCheerWord.\nIm bardziej naturalnie
      brzmi s\u0142owo, gdy je wypowiadasz, tym lepiej jest rozpoznawane. (2\u201312
      znak\xF3w, tylko ma\u0142e litery angielskiego alfabetu)\nNie masz mikrofonu
      albo rozpoznawanie nie dzia\u0142a? W\u0142\u0105cz doping klawiszem T w Opcje
      \u2192 Og\xF3lne i naciskaj T, gdy pojawi si\u0119 ostrze\u017Cenie."
    m_Metadata:
      m_Items: []
  - m_Id: 24992255946752
    m_Localized: "Wybierz has\u0142o dru\u017Cyny"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889793
    m_Localized: np. fighting
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889794
    m_Localized: "Potwierd\u017A"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889795
    m_Localized: Zamknij
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889796
    m_Localized: "Ustal s\u0142owo, kt\xF3re ca\u0142a dru\u017Cyna b\u0119dzie razem
      krzycze\u0107 (domy\u015Blnie: FIGHTING)"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889797
    m_Localized: "Has\u0142o dru\u017Cyny: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647744
    m_Localized: "U\u017Cyj od 2 do 12 ma\u0142ych liter angielskiego alfabetu."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647746
    m_Localized: "To zastrze\u017Cone s\u0142owo systemowe, nie mo\u017Cesz go u\u017Cy\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647747
    m_Localized: "Zawiera s\u0142owo, kt\xF3rego nie mo\u017Cna u\u017Cy\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647751
    m_Localized: "Nie uda\u0142o si\u0119 zatwierdzi\u0107 has\u0142a dru\u017Cyny."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647752
    m_Localized: "Tylko host mo\u017Ce ustali\u0107 has\u0142o dru\u017Cyny."
    m_Metadata:
      m_Items: []
  - m_Id: 53793039953920
    m_Localized: "Zmie\u0144 has\u0142o dru\u017Cyny"
    m_Metadata:
      m_Items: []
  - m_Id: 53793073508352
    m_Localized: "Tutaj mo\u017Cecie ostatni raz zmieni\u0107 has\u0142o dru\u017Cyny.\nJe\u015Bli
      przegapicie t\u0119 okazj\u0119, zostanie ono zablokowane do ko\u0144ca gry,\nwi\u0119c
      je\u015Bli kto\u015B chce je zmieni\u0107, niech zrobi to teraz na panelu."
    m_Metadata:
      m_Items: []
  - m_Id: 56930631004160
    m_Localized: "[E] Ustaw has\u0142o dru\u017Cyny"
    m_Metadata:
      m_Items: []
  - m_Id: 56930635198464
    m_Localized: "[E] Test dopingu dru\u017Cynowego"
    m_Metadata:
      m_Items: []
  - m_Id: 1395064601948160
    m_Localized: "Obrona blokuje te\u017C obra\u017Cenia rundy."
    m_Metadata:
      m_Items: []
  - m_Id: 1395064700000001
    m_Localized: "O\u017Cywianie (przytrzymaj [E] obok powalonego towarzysza)"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
