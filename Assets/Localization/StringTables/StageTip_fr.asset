--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: StageTip_fr
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: b434763c88cad514394ee69eedd290e7, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1141485568
    m_Localized: "\u2022 Une seule bouche de couleur se l\xE8ve \xE0 la fois.\n\u2022
      Tout le monde peut utiliser les dalles noires et blanches en accordant sa couleur.\n\u2022
      Quand \"TEAMCHEER\" s'affiche en haut, crie le mot d'\xE9quipe."
    m_Metadata:
      m_Items: []
  - m_Id: 1183428608
    m_Localized: "\u2022 Chaque zone doit avoir autant de joueurs que de KKUL-TTEOK
      sous son panneau \u2014 ni plus, ni moins.\n\u2022 Chacun voit quelque chose
      de diff\xE9rent. Partagez ce que vous voyez !\n\u2022 Quand \"TEAMCHEER\" s'affiche
      en haut, crie le mot d'\xE9quipe.\n\u2022 Le bonus de d\xE9fense bloque aussi
      les d\xE9g\xE2ts d'un round rat\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622912
    m_Localized: "\u2022 Appuie sur Ctrl pour accorder ta couleur au sol noir ou
      blanc et ne plus \xEAtre cibl\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622913
    m_Localized: "\u2022 Reste 2 secondes sur une dalle pour marquer.\n\u2022 Les
      dalles color\xE9es ne comptent que pour leur couleur ; les noires et blanches,
      pour tout le monde."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622914
    m_Localized: "\u2022 Appuie sur Space quand ta couleur s'allume.\n\u2022 Le blanc,
      n'importe qui peut appuyer. Le noir passe au tour suivant au bout d'1 seconde.\n\u2022
      Pendant le mini-jeu, tu ne peux pas utiliser le buff Space."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622915
    m_Localized: "\u2022 Tu ne vois que la case suivante.\n\u2022 Retiens sur laquelle
      appuyer."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622916
    m_Localized: "\u2022 Appuie sur Ctrl pour accorder ta couleur au sol et ne plus
      \xEAtre cibl\xE9.\n\u2022 Crie le mot d'\xE9quipe pendant que \"TEAMCHEER\"
      est affich\xE9 pour r\xE9parer le sol.\n\u2022 S'il est d\xE9j\xE0 cass\xE9,
      tiens jusqu'\xE0 la prochaine alerte."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622917
    m_Localized: "\u2022 Si une case de ta couleur appara\xEEt, mets-toi dessus.\n\u2022
      Sinon, tiens bon sur une case noire ou blanche.\n\u2022 Accorde aussi la couleur
      de ton perso au sol.\n\u2022 Le bonus de d\xE9fense bloque aussi les d\xE9g\xE2ts
      d'un round rat\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622918
    m_Localized: "\u2022 Fonce dans les murs de ta couleur."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622919
    m_Localized: "\u2022 Retiens le chemin."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622920
    m_Localized: "\u2022 Ne marche que sur les cases de ta couleur.\n\u2022 Accorde
      la couleur de ton perso \xE0 celle des cases."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622921
    m_Localized: "\u2022 La couleur de la zone passe en premier, puis les autres
      peuvent suivre."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622922
    m_Localized: "\u2022 Passe chaque section avant la fin du chrono du panneau,
      sinon l'acide l'inonde.\n\u2022 Accorde ta couleur aux murs lat\xE9raux et
      fonce dedans pour les repousser."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622923
    m_Localized: "\u2022 Un joueur par case : au-del\xE0, elle s'enfonce.\n\u2022
      Certaines cases peuvent se briser.\n\u2022 Toucher les murs avant et arri\xE8re
      ou les gonflements te repousse."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622924
    m_Localized: "\u2022 Un coureur traverse le labyrinthe pendant que les autres
      le guident depuis l'\xE9tage.\n\u2022 Marcher sur une dalle ouvre seulement
      les portes de cette couleur et ferme toutes les autres."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622926
    m_Localized: "\u2022 Atteins l'arriv\xE9e.\n\n\u2022 Termine cette section avant
      que le bonbon touche le sol."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622927
    m_Localized: "\u2022 Marche sur les dalles pour cr\xE9er un chemin, puis atteins
      l'arriv\xE9e.\n\n\u2022 Termine cette section avant que le bonbon touche le
      sol."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622928
    m_Localized: "\u2022 Un joueur par case s\xFBre. \xC0 plusieurs, on prend des
      d\xE9g\xE2ts.\n\n\u2022 Termine cette section avant que le bonbon touche le
      sol."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622929
    m_Localized: "\u2022 Accorde ta couleur au mur et fonce dedans."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891662639104
    m_Localized: "\u2022 Une seule bouche de couleur se l\xE8ve \xE0 la fois.\n\u2022
      Tout le monde peut utiliser les dalles noires et blanches en accordant sa couleur."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891696193536
    m_Localized: "\u2022 Chacun voit quelque chose de diff\xE9rent. Partagez ce que
      vous voyez !\n\u2022 Le bonus de d\xE9fense bloque aussi les d\xE9g\xE2ts d'un
      round rat\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891696193537
    m_Localized: "\u2022 Appuie sur Ctrl pour accorder ta couleur au sol et ne plus
      \xEAtre cibl\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891696193538
    m_Localized: "\u2022 Quand la bouche s'ouvre, crie le mot d'\xE9quipe pour r\xE9parer
      le sol cass\xE9."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
