  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: StageTip_fr
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: b434763c88cad514394ee69eedd290e7, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1141485568
    m_Localized: "Une seule couleur de bouche se l\xE8ve \xE0 la fois.\nTout le monde
      peut matcher sa couleur et marcher sur les dalles noir et blanc.\nQuand \"TEAMCHEER\"
      s'affiche en haut, crie le cri d'\xE9quipe."
    m_Metadata:
      m_Items: []
  - m_Id: 1183428608
    m_Localized: "La couleur d\xE9sign\xE9e doit forc\xE9ment \xEAtre dans cette
      zone.\nQuand \"TEAMCHEER\" s'affiche en haut, crie le cri d'\xE9quipe."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622912
    m_Localized: Appuie sur Ctrl pour caler la couleur de ton perso sur le sol noir
      ou blanc et casser le lock.
    m_Metadata:
      m_Items: []
  - m_Id: 1187622913
    m_Localized: 'Reste 2 secondes sur une tuile pour marquer.

      Les tuiles
      de couleur unique ne comptent que pour cette couleur. Noir et blanc, tout le
      monde peut marcher dessus.'
    m_Metadata:
      m_Items: []
  - m_Id: 1187622914
    m_Localized: 'Appuie sur Space quand ta couleur s''allume.

      Le blanc, n''importe
      qui peut appuyer. Le noir passe au tour suivant au bout d''1 seconde.

      Pendant
      le mini-jeu, tu ne peux pas utiliser le buff Space.'
    m_Metadata:
      m_Items: []
  - m_Id: 1187622915
    m_Localized: 'Tu ne vois qu''une case en avant.

      Retiens celles qu''il
      faut presser.'
    m_Metadata:
      m_Items: []
  - m_Id: 1187622916
    m_Localized: "Appuie sur Ctrl pour caler la couleur de ton perso sur le sol et
      casser le lock.\nCrie le cri d'\xE9quipe pendant \"TEAMCHEER\" pour r\xE9parer
      le sol.\nS'il est d\xE9j\xE0 cass\xE9, tiens jusqu'\xE0 la prochaine alerte."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622917
    m_Localized: "Si une case de couleur unique appara\xEEt, mets-toi dessus.\nSinon,
      tiens bon sur le noir ou le blanc.\nChange aussi la couleur de ton perso pour
      matcher le sol."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622918
    m_Localized: "Si tu percutes les murs lat\xE9raux quand ils affichent ta couleur,
      ils reculent."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622919
    m_Localized: Retiens le chemin.
    m_Metadata:
      m_Items: []
  - m_Id: 1187622920
    m_Localized: "Marche uniquement sur tes cases de couleur.\nM\xEAme si la case
      match, \xE7a ne marche pas si ton perso est en noir et blanc."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622921
    m_Localized: "La couleur assign\xE9e doit passer en premier, sinon les autres
      ne peuvent pas marcher sur ce sol."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622922
    m_Localized: "Aligne la couleur des murs lat\xE9raux et percute-les : ils reculent."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622923
    m_Localized: "Toucher les murs avant/arri\xE8re ou les gonflements te projette."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622924
    m_Localized: Utilise le buff pour attraper les globules rouges.
    m_Metadata:
      m_Items: []
  - m_Id: 1187622925
    m_Localized: Percute les gonflements verts et sers-toi du rebond pour fuir.
    m_Metadata:
      m_Items: []
  - m_Id: 1187622926
    m_Localized: "La couleur d\xE9sign\xE9e ouvre le chemin, puis atteins l'objectif.\n\nFinis
      ce passage avant que le bonbon touche le sol."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622927
    m_Localized: 'Marche sur les dalles pour faire un chemin, puis atteins l''objectif.


      Finis
      ce passage avant que le bonbon touche le sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 1187622928
    m_Localized: 'Marche sur la dalle du centre, rebondis, et percute le bonbon de
      la bonne couleur.


      Finis ce passage avant que le bonbon touche le sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 1187622929
    m_Localized: Aligne la couleur du mur et percute-le pour le repousser.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
