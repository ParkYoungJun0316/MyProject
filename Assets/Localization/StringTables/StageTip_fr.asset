%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: StageTip_fr
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: b434763c88cad514394ee69eedd290e7, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1141485568
    m_Localized: "\u2022 Une seule bouche d'une couleur se soul\xE8ve \xE0 la fois.\n\u2022
      N'importe qui peut utiliser les plateformes noires et blanches en faisant correspondre
      sa couleur.\n\u2022 Lorsque \xAB TEAMCHEER \xBB appara\xEEt en haut de l'\xE9cran,
      criez le cri d'\xE9quipe."
    m_Metadata:
      m_Items: []
  - m_Id: 1183428608
    m_Localized: "\u2022 Chaque zone doit contenir exactement autant de joueurs qu'il
      y a de KKUL-TTEOK sous son panneau. Ni plus ni moins.\n\u2022 Tout le monde
      voit quelque chose de diff\xE9rent. Partagez ce que vous voyez !\n\u2022 Lorsque
      \xAB TEAMCHEER \xBB appara\xEEt en haut de l'\xE9cran, criez le cri d'\xE9quipe.\n\u2022
      Le bonus de d\xE9fense bloque \xE9galement les d\xE9g\xE2ts caus\xE9s par l'\xE9chec
      de la manche."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622912
    m_Localized: "\u2022 Appuyez sur Ctrl pour faire correspondre votre couleur au
      sol noir ou blanc et \xE9viter d'\xEAtre pris pour cible."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622913
    m_Localized: "\u2022 Restez sur une dalle pendant 2 secondes pour marquer des
      points.\n\u2022 Les dalles color\xE9es ne comptent que pour les joueurs de
      cette couleur. Les dalles noires et blanches comptent pour tout le monde."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622914
    m_Localized: "\u2022 Appuyez sur Space lorsque votre couleur s'allume.\n\u2022
      Tout le monde peut frapper la case blanche. La noire passe au tour suivant
      apr\xE8s 1 seconde.\n\u2022 Vous ne pouvez pas utiliser votre bonus de Space
      pendant ce mini-jeu."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622915
    m_Localized: "\u2022 Vous ne voyez qu'une seule case devant vous.\n\u2022 M\xE9morisez
      la case sur laquelle appuyer."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622916
    m_Localized: "\u2022 Appuyez sur Ctrl pour faire correspondre votre couleur au
      sol et \xE9viter d'\xEAtre pris pour cible.\n\u2022 Lorsque \xAB TEAMCHEER
      \xBB est affich\xE9, criez le cri d'\xE9quipe pour r\xE9parer le sol.\n\u2022
      S'il est d\xE9j\xE0 cass\xE9, tenez bon jusqu'au prochain avertissement."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622917
    m_Localized: "\u2022 Si une dalle de votre couleur appara\xEEt, placez-vous dessus.\n\u2022
      Sinon, tenez bon sur une dalle noire ou blanche.\n\u2022 Faites \xE9galement
      correspondre la couleur de votre personnage \xE0 celle du sol.\n\u2022 Le bonus
      de d\xE9fense bloque \xE9galement les d\xE9g\xE2ts caus\xE9s par l'\xE9chec
      de la manche."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622918
    m_Localized: "\u2022 Foncez dans les murs correspondant \xE0 votre couleur."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622919
    m_Localized: "\u2022 M\xE9morisez le chemin."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622920
    m_Localized: "\u2022 Marchez uniquement sur les dalles de votre couleur.\n\u2022
      Faites correspondre la couleur de votre personnage \xE0 celle des dalles."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622921
    m_Localized: "\u2022 Le joueur de la couleur de la zone passe en premier, puis
      les autres peuvent suivre."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622922
    m_Localized: "\u2022 Terminez chaque section avant la fin du minuteur du panneau,
      sinon la zone sera inond\xE9e d'acide.\n\u2022 Faites correspondre la couleur
      des murs lat\xE9raux et foncez dedans pour les repousser."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622923
    m_Localized: "\u2022 Un seul joueur par dalle. S'il y en a plus, elle s'enfonce.\n\u2022
      Certaines dalles peuvent se casser.\n\u2022 Toucher les murs avant ou arri\xE8re
      ou les renflements vous fera reculer."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622924
    m_Localized: "\u2022 Un joueur traverse le labyrinthe pendant que les autres
      le guident depuis le deuxi\xE8me \xE9tage.\n\u2022 Marcher sur une plateforme
      n'ouvre que les portes de cette couleur et ferme toutes les autres."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622926
    m_Localized: "\u2022 Atteignez l'arriv\xE9e.\n\n\u2022 Terminez cette section
      avant que le bonbon ne touche le sol."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622927
    m_Localized: "\u2022 Marchez sur les plateformes pour cr\xE9er un chemin, puis
      atteignez l'arriv\xE9e.\n\n\u2022 Terminez cette section avant que le bonbon
      ne touche le sol."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622928
    m_Localized: "\u2022 Un seul joueur par dalle s\xFBre. Si deux joueurs se retrouvent
      dessus, ils subissent des d\xE9g\xE2ts.\n\n\u2022 Terminez cette section avant
      que le bonbon ne touche le sol."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622929
    m_Localized: "\u2022 Faites correspondre votre couleur \xE0 celle du mur et foncez
      dedans."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891662639104
    m_Localized: "\u2022 Une seule bouche d'une couleur se soul\xE8ve \xE0 la fois.\n\u2022
      N'importe qui peut utiliser les plateformes noires et blanches en faisant correspondre
      sa couleur."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891696193536
    m_Localized: "\u2022 Tout le monde voit quelque chose de diff\xE9rent. Partagez
      ce que vous voyez !\n\u2022 Le bonus de d\xE9fense bloque \xE9galement les
      d\xE9g\xE2ts caus\xE9s par l'\xE9chec de la manche."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891696193537
    m_Localized: "\u2022 Appuyez sur Ctrl pour faire correspondre votre couleur au
      sol et \xE9viter d'\xEAtre pris pour cible."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891696193538
    m_Localized: "\u2022 Lorsque la bouche s'ouvre, criez le cri d'\xE9quipe pour
      r\xE9parer le sol cass\xE9."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
