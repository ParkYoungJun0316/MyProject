%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: StageTip_de
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: de
  m_SharedData: {fileID: 11400000, guid: b434763c88cad514394ee69eedd290e7, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1141485568
    m_Localized: "\u2022 Es f\xE4hrt immer nur ein Mund einer Farbe hoch.\n\u2022
      Schwarze und wei\xDFe Platten kann jeder nutzen, der seine Farbe anpasst.\n\u2022
      Wenn oben \"TEAMCHEER\" erscheint, ruf das Team-Wort."
    m_Metadata:
      m_Items: []
  - m_Id: 1183428608
    m_Localized: "\u2022 Jede Zone braucht genau so viele Spieler, wie KKUL-TTEOK
      unter ihrem Schild sind \u2013 nicht mehr, nicht weniger.\n\u2022 Jeder sieht
      etwas anderes. Sagt an, was ihr seht!\n\u2022 Wenn oben \"TEAMCHEER\" erscheint,
      ruf das Team-Wort.\n\u2022 Der Verteidigungs-Buff blockt auch Schaden bei verlorener
      Runde."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622912
    m_Localized: "\u2022 Dr\xFCck Ctrl, um deine Farbe an den schwarzen oder wei\xDFen
      Boden anzupassen, damit du nicht anvisiert wirst."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622913
    m_Localized: "\u2022 Bleib 2 Sekunden auf einer Kachel, um zu punkten.\n\u2022
      Bunte Kacheln z\xE4hlen nur f\xFCr ihre Farbe, schwarze und wei\xDFe f\xFCr
      alle."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622914
    m_Localized: "\u2022 Dr\xFCck Space, wenn deine Farbe aufleuchtet.\n\u2022 Wei\xDF
      darf jeder dr\xFCcken. Schwarz geht nach 1 Sekunde automatisch weiter.\n\u2022
      W\xE4hrend des Minispiels geht der Space-Buff nicht."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622915
    m_Localized: "\u2022 Du siehst nur ein Feld voraus.\n\u2022 Merk dir, welches
      du dr\xFCcken musst."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622916
    m_Localized: "\u2022 Dr\xFCck Ctrl, um deine Farbe an den Boden anzupassen, damit
      du nicht anvisiert wirst.\n\u2022 Ruf das Team-Wort, solange \"TEAMCHEER\"
      angezeigt wird, um den Boden zu reparieren.\n\u2022 Ist er schon kaputt, halt
      bis zur n\xE4chsten Warnung durch."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622917
    m_Localized: "\u2022 Kommt ein Feld in deiner Farbe, stell dich drauf.\n\u2022
      Wenn nicht, halt dich auf einem schwarzen oder wei\xDFen Feld.\n\u2022 Pass
      auch die Farbe deines Charakters an den Boden an.\n\u2022 Der Verteidigungs-Buff
      blockt auch Schaden bei verlorener Runde."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622918
    m_Localized: "\u2022 Renn gegen die W\xE4nde in deiner Farbe."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622919
    m_Localized: "\u2022 Merk dir den Weg."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622920
    m_Localized: "\u2022 Tritt nur auf Felder in deiner Farbe.\n\u2022 Pass die Farbe
      deines Charakters an die Felder an."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622921
    m_Localized: "\u2022 Zuerst geht die Farbe der Zone, dann k\xF6nnen alle anderen
      folgen."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622922
    m_Localized: "\u2022 Schaff jeden Abschnitt, bevor der Timer am Schild abl\xE4uft,
      sonst flutet ihn die S\xE4ure.\n\u2022 Pass deine Farbe an die Seitenw\xE4nde
      an und ramm sie, um sie zur\xFCckzudr\xE4ngen."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622923
    m_Localized: "\u2022 Ein Spieler pro Feld \u2013 mehr, und es sinkt ab.\n\u2022
      Manche Felder k\xF6nnen brechen.\n\u2022 Wenn du die vordere und hintere Wand
      oder die Schwellungen ber\xFChrst, wirst du zur\xFCckgeschleudert."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622924
    m_Localized: "\u2022 Ein L\xE4ufer rennt durchs Labyrinth, die anderen lotsen
      ihn vom oberen Stock aus.\n\u2022 Wer auf eine Platte tritt, \xF6ffnet nur
      die T\xFCren dieser Farbe \u2013 alle anderen gehen zu."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622926
    m_Localized: "\u2022 Erreiche das Ziel.\n\n\u2022 Schaff diesen Abschnitt, bevor
      das Bonbon den Boden erreicht."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622927
    m_Localized: "\u2022 Tritt auf die Platten, um einen Weg zu bauen, und erreiche
      dann das Ziel.\n\n\u2022 Schaff diesen Abschnitt, bevor das Bonbon den Boden
      erreicht."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622928
    m_Localized: "\u2022 Ein Spieler pro sicherem Feld. Zu zweit gibt's Schaden.\n\n\u2022
      Schaff diesen Abschnitt, bevor das Bonbon den Boden erreicht."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622929
    m_Localized: "\u2022 Pass deine Farbe an die Wand an und ramm sie."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891662639104
    m_Localized: "\u2022 Es f\xE4hrt immer nur ein Mund einer Farbe hoch.\n\u2022
      Schwarze und wei\xDFe Platten kann jeder nutzen, der seine Farbe anpasst."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891696193536
    m_Localized: "\u2022 Jeder sieht etwas anderes. Sagt an, was ihr seht!\n\u2022
      Der Verteidigungs-Buff blockt auch Schaden bei verlorener Runde."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891696193537
    m_Localized: "\u2022 Dr\xFCck Ctrl, um deine Farbe an den Boden anzupassen, damit
      du nicht anvisiert wirst."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891696193538
    m_Localized: "\u2022 Wenn sich der Mund \xF6ffnet, ruf das Team-Wort, um den
      kaputten Boden zu reparieren."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
