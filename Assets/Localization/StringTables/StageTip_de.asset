  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: StageTip_de
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: de
  m_SharedData: {fileID: 11400000, guid: b434763c88cad514394ee69eedd290e7, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1141485568
    m_Localized: "Es kommt immer nur ein Mund in einer Farbe hoch.\nSchwarz-wei\xDFe
      Trittfl\xE4chen kann jeder betreten, wenn er die Farbe anpasst.\nWenn oben
      \"TEAMCHEER\" kommt, schrei den Teamruf."
    m_Metadata:
      m_Items: []
  - m_Id: 1183428608
    m_Localized: 'Die vorgesehene Farbe muss in diese Zone.

      Wenn oben "TEAMCHEER"
      kommt, schrei den Teamruf.'
    m_Metadata:
      m_Items: []
  - m_Id: 1187622912
    m_Localized: "Dr\xFCck Ctrl, pass die Farbe deines Charakters an den schwarz-wei\xDFen
      Boden an und l\xF6se das Lock-on."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622913
    m_Localized: "Zwei Sekunden auf einer Kachel stehen, dann gibt's Punkte.\nEinzigfarbige
      Kacheln z\xE4hlen nur f\xFCr diese Farbe. Schwarz und Wei\xDF kann jeder betreten."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622914
    m_Localized: "Dr\xFCck Space, wenn deine Farbe aufleuchtet.\nWei\xDF darf jeder
      dr\xFCcken. Schwarz geht nach 1 Sekunde automatisch weiter.\nW\xE4hrend des
      Minispiels geht der Space-Buff nicht."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622915
    m_Localized: "Du siehst nur eine Kachel voraus.\nMerk dir, welche du dr\xFCcken
      musst."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622916
    m_Localized: "Dr\xFCck Ctrl, pass die Farbe deines Charakters an den Boden an
      und l\xF6se das Lock-on.\nSchrei den Teamruf, solange \"TEAMCHEER\" da ist,
      dann repariert sich der Boden.\nIst er schon kaputt, halt durch bis zur n\xE4chsten
      Warnung."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622917
    m_Localized: "Wenn eine einzigfarbige Kachel kommt, stell dich drauf.\nWenn nicht,
      halt dich auf Schwarz oder Wei\xDF.\nPass auch die Farbe deines Charakters
      an den Boden an."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622918
    m_Localized: "Wenn du gegen die Seitenw\xE4nde knallst, die deine Farbe zeigen,
      weichen sie zur\xFCck."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622919
    m_Localized: Merk dir den Weg.
    m_Metadata:
      m_Items: []
  - m_Id: 1187622920
    m_Localized: "Tritt nur auf Kacheln deiner Farbe.\nAuch wenn die Kachel stimmt:
      Als Schwarz oder Wei\xDF geht das nicht."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622921
    m_Localized: "Die zust\xE4ndige Farbe muss zuerst r\xFCber, sonst d\xFCrfen die
      anderen den Boden nicht betreten."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622922
    m_Localized: "Pass die Farbe der Seitenw\xE4nde an und knall dagegen \u2014 sie
      weichen zur\xFCck."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622923
    m_Localized: "Vordere und hintere W\xE4nde und Schwellungen schleudern dich weg."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622924
    m_Localized: "Benutz den Buff, um die roten Blutk\xF6rperchen zu fangen."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622925
    m_Localized: "Knall gegen die gr\xFCnen Schwellungen und nutz den Bounce zum
      Abhauen."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622926
    m_Localized: "Die vorgesehene Farbe macht den Weg frei, dann erreicht das Ziel.\n\nBeendet
      diesen Abschnitt, bevor das Bonbon den Boden ber\xFChrt."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622927
    m_Localized: "Tretet auf die Platten, baut einen Weg, erreicht das Ziel.\n\nBeendet
      diesen Abschnitt, bevor das Bonbon den Boden ber\xFChrt."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622928
    m_Localized: "Tritt auf die mittlere Platte, spring hoch und knall farblich passend
      gegen das Bonbon.\n\nBeende diesen Abschnitt, bevor das Bonbon den Boden ber\xFChrt."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622929
    m_Localized: "Pass die Wandfarbe an und knall dagegen, um sie zur\xFCckzudr\xFCcken."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
