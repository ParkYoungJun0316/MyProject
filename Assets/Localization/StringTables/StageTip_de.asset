%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: StageTip_de
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: de
  m_SharedData: {fileID: 11400000, guid: b434763c88cad514394ee69eedd290e7, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1141485568
    m_Localized: "\u2022 Immer nur der Mund einer Farbe f\xE4hrt nach oben.\n\u2022
      Jeder kann die schwarzen und wei\xDFen Fl\xE4chen benutzen, indem er seine
      Farbe anpasst.\n\u2022 Wenn oben \u201ETEAMCHEER\u201C erscheint, ruft laut
      euren Teamruf."
    m_Metadata:
      m_Items: []
  - m_Id: 1183428608
    m_Localized: "\u2022 In jeder Zone m\xFCssen genau so viele Spieler stehen, wie
      KKUL-TTEOK unter dem Schild angezeigt werden. Nicht mehr und nicht weniger.\n\u2022
      Jeder sieht etwas anderes. Teilt, was ihr seht!\n\u2022 Wenn oben \u201ETEAMCHEER\u201C
      erscheint, ruft laut euren Teamruf.\n\u2022 Der Verteidigungs-Buff sch\xFCtzt
      auch vor Schaden beim Scheitern der Runde."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622912
    m_Localized: "\u2022 Dr\xFCcke Ctrl, um deine Farbe an den schwarzen oder wei\xDFen
      Boden anzupassen und nicht ins Visier genommen zu werden."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622913
    m_Localized: "\u2022 Bleibe 2 Sekunden auf einem Feld stehen, um Punkte zu erhalten.\n\u2022
      Farbige Felder z\xE4hlen nur f\xFCr Spieler dieser Farbe. Schwarze und wei\xDFe
      Felder z\xE4hlen f\xFCr alle."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622914
    m_Localized: "\u2022 Dr\xFCcke Space, wenn deine Farbe aufleuchtet.\n\u2022 Auf
      Wei\xDF kann jeder schlagen. Schwarz wechselt nach 1 Sekunde zum n\xE4chsten
      Zug.\n\u2022 W\xE4hrend dieses Minispiels kannst du deinen Space-Buff nicht
      benutzen."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622915
    m_Localized: "\u2022 Du siehst nur ein Feld vor dir.\n\u2022 Merke dir, auf welches
      Feld du dr\xFCcken musst."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622916
    m_Localized: "\u2022 Dr\xFCcke Ctrl, um deine Farbe an den Boden anzupassen und
      nicht ins Visier genommen zu werden.\n\u2022 Wenn \u201ETEAMCHEER\u201C erscheint,
      rufe deinen Teamruf, um den Boden zu reparieren.\n\u2022 Wenn er bereits kaputt
      ist, halte bis zur n\xE4chsten Warnung durch."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622917
    m_Localized: "\u2022 Wenn ein Feld in deiner Farbe erscheint, stelle dich darauf.\n\u2022
      Wenn nicht, halte dich auf einem schwarzen oder wei\xDFen Feld.\n\u2022 Passe
      auch die Farbe deiner Figur an die Farbe des Bodens an.\n\u2022 Der Verteidigungs-Buff
      sch\xFCtzt auch vor Schaden beim Scheitern der Runde."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622918
    m_Localized: "\u2022 Ramme die W\xE4nde, die zu deiner Farbe passen."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622919
    m_Localized: "\u2022 Merke dir den Weg."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622920
    m_Localized: "\u2022 Betritt nur Felder deiner Farbe.\n\u2022 Passe die Farbe
      deiner Figur an die Farbe der Felder an."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622921
    m_Localized: "\u2022 Der Spieler in der Farbe der Zone geht zuerst, danach k\xF6nnen
      alle anderen folgen."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622922
    m_Localized: "\u2022 Schlie\xDFe jeden Abschnitt ab, bevor der Timer des Schilds
      abl\xE4uft, sonst wird er mit S\xE4ure \xFCberflutet.\n\u2022 Passe die Farbe
      der Seitenw\xE4nde an und ramme sie, um sie zur\xFCckzudr\xFCcken."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622923
    m_Localized: "\u2022 Pro Feld darf nur ein Spieler stehen. Bei mehreren Spielern
      sinkt es ein.\n\u2022 Einige Felder k\xF6nnen zerbrechen.\n\u2022 Wenn du die
      vordere oder hintere Wand oder die W\xF6lbungen ber\xFChrst, wirst du zur\xFCckgesto\xDFen."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622924
    m_Localized: "\u2022 Ein Spieler l\xE4uft durch das Labyrinth, w\xE4hrend die
      anderen ihn vom zweiten Stock aus f\xFChren.\n\u2022 Wenn du auf eine Fl\xE4che
      trittst, \xF6ffnen sich nur die T\xFCren dieser Farbe und alle anderen schlie\xDFen
      sich."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622926
    m_Localized: "\u2022 Erreiche das Ziel.\n\n\u2022 Schlie\xDFe diesen Abschnitt
      ab, bevor die S\xFC\xDFigkeit den Boden ber\xFChrt."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622927
    m_Localized: "\u2022 Betritt die Fl\xE4chen, um einen Weg zu bilden, und erreiche
      dann das Ziel.\n\n\u2022 Schlie\xDFe diesen Abschnitt ab, bevor die S\xFC\xDFigkeit
      den Boden ber\xFChrt."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622928
    m_Localized: "\u2022 Pro sicherem Feld darf nur ein Spieler stehen. Wenn zwei
      darauf stehen, erleiden sie Schaden.\n\n\u2022 Schlie\xDFe diesen Abschnitt
      ab, bevor die S\xFC\xDFigkeit den Boden ber\xFChrt."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622929
    m_Localized: "\u2022 Passe deine Farbe an die Wandfarbe an und ramme sie."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891662639104
    m_Localized: "\u2022 Immer nur der Mund einer Farbe f\xE4hrt nach oben.\n\u2022
      Jeder kann die schwarzen und wei\xDFen Fl\xE4chen benutzen, indem er seine
      Farbe anpasst."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891696193536
    m_Localized: "\u2022 Jeder sieht etwas anderes. Teilt, was ihr seht!\n\u2022
      Der Verteidigungs-Buff sch\xFCtzt auch vor Schaden beim Scheitern der Runde."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891696193537
    m_Localized: "\u2022 Dr\xFCcke Ctrl, um deine Farbe an den Boden anzupassen und
      nicht ins Visier genommen zu werden."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891696193538
    m_Localized: "\u2022 Wenn sich der Mund \xF6ffnet, rufe deinen Teamruf, um den
      kaputten Boden zu reparieren."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
