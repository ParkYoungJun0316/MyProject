%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: StageTip_de
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: de
  m_SharedData: {fileID: 11400000, guid: b434763c88cad514394ee69eedd290e7, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1141485568
    m_Localized: "\u2022 Es kommt immer nur ein Mund in einer Farbe hoch.\n\u2022
      Schwarz-wei\xDFe Trittfl\xE4chen kann jeder betreten, wenn er die Farbe anpasst.\n\u2022
      Wenn oben \"TEAMCHEER\" kommt, ruf das Team-Wort."
    m_Metadata:
      m_Items: []
  - m_Id: 1183428608
    m_Localized: "\u2022 Die vorgesehene Farbe muss in diese Zone.\n\u2022 Wenn oben
      \"TEAMCHEER\" kommt, ruf das Team-Wort.\n\u2022 Der Verteidigungs-Buff blockt
      auch Schaden bei verlorener Runde."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622912
    m_Localized: "\u2022 Dr\xFCck Ctrl, pass die Farbe deines Charakters an den schwarz-wei\xDFen
      Boden an und l\xF6se das Lock-on."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622913
    m_Localized: "\u2022 Zwei Sekunden auf einer Kachel stehen, dann gibt's Punkte.\n\u2022
      Einzigfarbige Kacheln z\xE4hlen nur f\xFCr diese Farbe. Schwarz und Wei\xDF
      kann jeder betreten."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622914
    m_Localized: "\u2022 Dr\xFCck Space, wenn deine Farbe aufleuchtet.\n\u2022 Wei\xDF
      darf jeder dr\xFCcken. Schwarz geht nach 1 Sekunde automatisch weiter.\n\u2022
      W\xE4hrend des Minispiels geht der Space-Buff nicht."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622915
    m_Localized: "\u2022 Du siehst nur eine Kachel voraus.\n\u2022 Merk dir, welche
      du dr\xFCcken musst."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622916
    m_Localized: "\u2022 Dr\xFCck Ctrl, pass die Farbe deines Charakters an den Boden
      an und l\xF6se das Lock-on.\n\u2022 Ruf das Team-Wort, solange \"TEAMCHEER\"
      da ist, dann repariert sich der Boden.\n\u2022 Ist er schon kaputt, halt durch
      bis zur n\xE4chsten Warnung."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622917
    m_Localized: "\u2022 Wenn eine einzigfarbige Kachel kommt, stell dich drauf.\n\u2022
      Wenn nicht, halt dich auf Schwarz oder Wei\xDF.\n\u2022 Pass auch die Farbe
      deines Charakters an den Boden an.\n\u2022 Der Verteidigungs-Buff blockt auch
      Schaden bei verlorener Runde."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622918
    m_Localized: "\u2022 Wenn du gegen die Seitenw\xE4nde knallst, die deine Farbe
      zeigen, weichen sie zur\xFCck."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622919
    m_Localized: "\u2022 Merk dir den Weg."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622920
    m_Localized: "\u2022 Tritt nur auf Kacheln deiner Farbe.\n\u2022 Auch wenn die
      Kachel stimmt: Als Schwarz oder Wei\xDF geht das nicht."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622921
    m_Localized: "\u2022 Die zust\xE4ndige Farbe muss zuerst r\xFCber, sonst d\xFCrfen
      die anderen den Boden nicht betreten."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622922
    m_Localized: "\u2022 Pass die Farbe der Seitenw\xE4nde an und knall dagegen \u2014
      sie weichen zur\xFCck."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622923
    m_Localized: "\u2022 Vordere und hintere W\xE4nde und Schwellungen schleudern
      dich weg."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622924
    m_Localized: "\u2022 Ein L\xE4ufer rennt durch das Labyrinth, w\xE4hrend die
      anderen vom zweiten Stock aus lotsen.\n\u2022 Ein Pad zu betreten \xF6ffnet
      nur die T\xFCren dieser Farbe und schlie\xDFt alle anderen.\n\u2022 Farbige
      Pads gelten nur f\xFCr den Spieler dieser Farbe; schwarze und wei\xDFe Pads
      gelten f\xFCr alle."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622926
    m_Localized: "\u2022 Die vorgesehene Farbe macht den Weg frei, dann erreicht
      das Ziel.\n\n\u2022 Beendet diesen Abschnitt, bevor das Bonbon den Boden ber\xFChrt."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622927
    m_Localized: "\u2022 Tretet auf die Platten, baut einen Weg, erreicht das Ziel.\n\n\u2022
      Beendet diesen Abschnitt, bevor das Bonbon den Boden ber\xFChrt."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622928
    m_Localized: "\u2022 Tritt auf die mittlere Platte, spring hoch und knall farblich
      passend gegen das Bonbon.\n\n\u2022 Beende diesen Abschnitt, bevor das Bonbon
      den Boden ber\xFChrt."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622929
    m_Localized: "\u2022 Pass die Wandfarbe an und knall dagegen, um sie zur\xFCckzudr\xFCcken."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891662639104
    m_Localized: "\u2022 Es kommt immer nur ein Mund in einer Farbe hoch.\n\u2022
      Schwarz-wei\xDFe Trittfl\xE4chen kann jeder betreten, wenn er die Farbe anpasst."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891696193536
    m_Localized: "\u2022 Der Verteidigungs-Buff blockt auch Schaden bei verlorener
      Runde."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891696193537
    m_Localized: "\u2022 Dr\xFCck Ctrl, pass die Farbe deines Charakters an den Boden
      an und l\xF6se das Lock-on."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891696193538
    m_Localized: "\u2022 Wenn sich der Mund \xF6ffnet, ruf das Team-Wort, um den
      kaputten Boden zu reparieren."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
