  m_TableData:
  - m_Id: 1141485568
    m_Localized: "\u2022 \u4E00\u6B21\u53EA\u4F1A\u5347\u8D77\u4E00\u79CD\u989C\u8272\u7684\u5634\u3002\n\u2022
      \u9ED1\u767D\u8E0F\u677F\u8C01\u90FD\u53EF\u4EE5\u5BF9\u597D\u989C\u8272\u518D\u8E29\u3002\n\u2022
      \u9876\u90E8\u51FA\u73B0 \u201CTEAMCHEER\u201D \u65F6\uFF0C\u558A\u51FA\u56E2\u961F\u53E3\u53F7\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1183428608
    m_Localized: "\u2022 \u6307\u5B9A\u989C\u8272\u5FC5\u987B\u8FDB\u5165\u90A3\u4E2A\u533A\u57DF\u3002\n\u2022
      \u9876\u90E8\u51FA\u73B0 \u201CTEAMCHEER\u201D \u65F6\uFF0C\u558A\u51FA\u56E2\u961F\u53E3\u53F7\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622912
    m_Localized: "\u2022 \u6309 Ctrl\uFF0C\u628A\u89D2\u8272\u989C\u8272\u5BF9\u6210\u5730\u677F\u7684\u9ED1\u6216\u767D\uFF0C\u7529\u6389\u9501\u5B9A\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622913
    m_Localized: "\u2022 \u5728\u683C\u5B50\u4E0A\u7AD9\u6EE1 2 \u79D2\u624D\u52A0\u5206\u3002\n\u2022
      \u4E13\u5C5E\u8272\u683C\u5B50\u53EA\u6709\u8BE5\u989C\u8272\u80FD\u8E29\uFF0C\u9ED1\u767D\u8C01\u90FD\u53EF\u4EE5\u8E29\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622914
    m_Localized: "\u2022 \u4EAE\u8D77\u81EA\u5DF1\u7684\u989C\u8272\u65F6\u6309 Space\u3002\n\u2022
      \u767D\u8272\u8C01\u90FD\u53EF\u4EE5\u6309\u3002\u9ED1\u8272 1 \u79D2\u540E\u4F1A\u81EA\u52A8\u8FDB\u5165\u4E0B\u4E00\u8F6E\u3002\n\u2022
      \u5C0F\u6E38\u620F\u8FDB\u884C\u4E2D\u4E0D\u80FD\u7528 Space \u589E\u76CA\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622915
    m_Localized: "\u2022 \u53EA\u80FD\u770B\u5230\u524D\u9762\u4E00\u683C\u3002\n\u2022
      \u8981\u6309\u7684\u683C\u5B50\u8BF7\u5148\u8BB0\u4F4F\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622916
    m_Localized: "\u2022 \u6309 Ctrl\uFF0C\u628A\u89D2\u8272\u989C\u8272\u5BF9\u6210\u5730\u677F\u989C\u8272\uFF0C\u7529\u6389\u9501\u5B9A\u3002\n\u2022
      \u201CTEAMCHEER\u201D \u51FA\u73B0\u65F6\u558A\u51FA\u56E2\u961F\u53E3\u53F7\uFF0C\u5730\u677F\u5C31\u4F1A\u4FEE\u597D\u3002\n\u2022
      \u5DF2\u7ECF\u788E\u4E86\u7684\u8BDD\uFF0C\u6491\u5230\u4E0B\u4E00\u6B21\u8B66\u544A\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622917
    m_Localized: "\u2022 \u51FA\u73B0\u4E13\u5C5E\u8272\u683C\u5B50\u65F6\uFF0C\u5FC5\u987B\u7AD9\u4E0A\u53BB\u3002\n\u2022
      \u6CA1\u6709\u4E13\u5C5E\u8272\u5C31\u7AD9\u5728\u9ED1\u767D\u683C\u5B50\u4E0A\u6491\u4F4F\u3002\n\u2022
      \u89D2\u8272\u989C\u8272\u4E5F\u8981\u5BF9\u4E0A\u5730\u677F\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622918
    m_Localized: "\u2022 \u649E\u4E0A\u4EAE\u7740\u81EA\u5DF1\u989C\u8272\u7684\u4E24\u4FA7\u5899\u58C1\uFF0C\u5899\u5C31\u4F1A\u5F80\u540E\u9000\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622919
    m_Localized: "\u2022 \u628A\u8DEF\u8BB0\u4E0B\u6765\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622920
    m_Localized: "\u2022 \u53EA\u8E29\u81EA\u5DF1\u989C\u8272\u7684\u683C\u5B50\u3002\n\u2022
      \u683C\u5B50\u989C\u8272\u5BF9\u4E86\uFF0C\u89D2\u8272\u5374\u662F\u9ED1\u767D\u4E5F\u4E0D\u884C\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622921
    m_Localized: "\u2022 \u8D1F\u8D23\u7684\u989C\u8272\u5148\u8FC7\u53BB\uFF0C\u5176\u4ED6\u961F\u5458\u624D\u80FD\u8E29\u90A3\u5757\u5730\u677F\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622922
    m_Localized: "\u2022 \u5BF9\u597D\u4E24\u4FA7\u5899\u58C1\u7684\u989C\u8272\u518D\u649E\u4E0A\u53BB\uFF0C\u5899\u5C31\u4F1A\u5F80\u540E\u9000\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622923
    m_Localized: "\u2022 \u78B0\u5230\u524D\u540E\u7684\u5899\u6216\u80BF\u5757\u4F1A\u88AB\u5F39\u5F00\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622924
    m_Localized: "\u2022 \u7528\u589E\u76CA\u53BB\u6293\u7EA2\u7EC6\u80DE\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622925
    m_Localized: "\u2022 \u649E\u4E0A\u7EFF\u8272\u80BF\u5757\uFF0C\u501F\u5F39\u529B\u9003\u8DD1\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622926
    m_Localized: "\u2022 \u6307\u5B9A\u989C\u8272\u5F00\u8DEF\u540E\uFF0C\u5230\u8FBE\u7EC8\u70B9\u3002\n\n\u2022
