  m_TableData:
  - m_Id: 1141485568
    m_Localized: "\u2022 \u4E00\u6B21\u53EA\u4F1A\u5347\u8D77\u4E00\u79CD\u989C\u8272\u7684\u5634\u3002\n\u2022
      \u9ED1\u767D\u8E0F\u677F\u8C01\u90FD\u80FD\u7528\uFF0C\u5BF9\u597D\u989C\u8272\u5C31\u884C\u3002\n\u2022
      \u9876\u90E8\u51FA\u73B0\u201CTEAMCHEER\u201D\u65F6\uFF0C\u558A\u51FA\u56E2\u961F\u5173\u952E\u8BCD\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1183428608
    m_Localized: "\u2022 \u6BCF\u4E2A\u533A\u57DF\u7684\u4EBA\u6570\u8981\u548C\u724C\u5B50\u4E0B\u7684
      KKUL-TTEOK \u6570\u91CF\u4E00\u6837\uFF0C\u4E0D\u591A\u4E0D\u5C11\u3002\n\u2022
      \u6BCF\u4E2A\u4EBA\u770B\u5230\u7684\u90FD\u4E0D\u4E00\u6837\uFF0C\u628A\u4F60\u770B\u5230\u7684\u8BF4\u51FA\u6765\uFF01\n\u2022
      \u9876\u90E8\u51FA\u73B0\u201CTEAMCHEER\u201D\u65F6\uFF0C\u558A\u51FA\u56E2\u961F\u5173\u952E\u8BCD\u3002\n\u2022
      \u9632\u5FA1\u589E\u76CA\u4E5F\u80FD\u6321\u4F4F\u56DE\u5408\u5931\u8D25\u7684\u4F24\u5BB3\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622912
    m_Localized: "\u2022 \u6309 Ctrl \u628A\u4F60\u7684\u989C\u8272\u6362\u6210\u9ED1\u767D\u5730\u677F\u7684\u989C\u8272\uFF0C\u907F\u514D\u88AB\u7784\u51C6\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622913
    m_Localized: "\u2022 \u5728\u65B9\u5757\u4E0A\u7AD9 2 \u79D2\u5F97\u5206\u3002\n\u2022
      \u5F69\u8272\u65B9\u5757\u53EA\u7B97\u5BF9\u5E94\u989C\u8272\u7684\u4EBA\uFF0C\u9ED1\u767D\u65B9\u5757\u8C01\u90FD\u7B97\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622914
    m_Localized: "\u2022 \u4EAE\u8D77\u81EA\u5DF1\u7684\u989C\u8272\u65F6\u6309 Space\u3002\n\u2022
      \u767D\u8272\u8C01\u90FD\u53EF\u4EE5\u6309\u3002\u9ED1\u8272 1 \u79D2\u540E\u4F1A\u81EA\u52A8\u8FDB\u5165\u4E0B\u4E00\u8F6E\u3002\n\u2022
      \u5C0F\u6E38\u620F\u8FDB\u884C\u4E2D\u4E0D\u80FD\u7528 Space \u589E\u76CA\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622915
    m_Localized: "\u2022 \u53EA\u80FD\u770B\u5230\u524D\u9762\u4E00\u683C\u3002\n\u2022
      \u8BB0\u4F4F\u8981\u6309\u54EA\u4E00\u683C\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622916
    m_Localized: "\u2022 \u6309 Ctrl \u628A\u4F60\u7684\u989C\u8272\u6362\u6210\u5730\u677F\u7684\u989C\u8272\uFF0C\u907F\u514D\u88AB\u7784\u51C6\u3002\n\u2022
      \u201CTEAMCHEER\u201D\u51FA\u73B0\u65F6\u558A\u51FA\u56E2\u961F\u5173\u952E\u8BCD\uFF0C\u5C31\u80FD\u4FEE\u597D\u5730\u677F\u3002\n\u2022
      \u5982\u679C\u5DF2\u7ECF\u788E\u4E86\uFF0C\u5C31\u6491\u5230\u4E0B\u4E00\u6B21\u8B66\u544A\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622917
    m_Localized: "\u2022 \u51FA\u73B0\u4F60\u989C\u8272\u7684\u683C\u5B50\u5C31\u7AD9\u4E0A\u53BB\u3002\n\u2022
      \u6CA1\u6709\u7684\u8BDD\uFF0C\u5C31\u7AD9\u5728\u9ED1\u8272\u6216\u767D\u8272\u683C\u5B50\u4E0A\u6491\u4F4F\u3002\n\u2022
      \u89D2\u8272\u989C\u8272\u4E5F\u8981\u5BF9\u4E0A\u5730\u677F\u3002\n\u2022
      \u9632\u5FA1\u589E\u76CA\u4E5F\u80FD\u6321\u4F4F\u56DE\u5408\u5931\u8D25\u7684\u4F24\u5BB3\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622918
    m_Localized: "\u2022 \u649E\u5411\u548C\u4F60\u989C\u8272\u76F8\u540C\u7684\u5899\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622919
    m_Localized: "\u2022 \u628A\u8DEF\u8BB0\u4E0B\u6765\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622920
    m_Localized: "\u2022 \u53EA\u8E29\u4F60\u989C\u8272\u7684\u683C\u5B50\u3002\n\u2022
      \u89D2\u8272\u989C\u8272\u8981\u548C\u683C\u5B50\u5BF9\u4E0A\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622921
    m_Localized: "\u2022 \u8BE5\u533A\u57DF\u7684\u989C\u8272\u5148\u8D70\uFF0C\u5176\u4ED6\u4EBA\u518D\u8DDF\u4E0A\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622922
    m_Localized: "\u2022 \u5728\u724C\u5B50\u7684\u8BA1\u65F6\u7ED3\u675F\u524D\u901A\u8FC7\u8FD9\u4E00\u6BB5\uFF0C\u5426\u5219\u80C3\u6DB2\u4F1A\u6D8C\u4E0A\u6765\u3002\n\u2022
      \u5BF9\u4E0A\u4E24\u4FA7\u5899\u58C1\u7684\u989C\u8272\u649E\u8FC7\u53BB\uFF0C\u5C31\u80FD\u628A\u5899\u63A8\u56DE\u53BB\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622923
    m_Localized: "\u2022 \u4E00\u683C\u53EA\u80FD\u7AD9\u4E00\u4E2A\u4EBA\uFF0C\u591A\u4E86\u5C31\u4F1A\u4E0B\u6C89\u3002\n\u2022
      \u6709\u4E9B\u683C\u5B50\u4F1A\u788E\u3002\n\u2022 \u78B0\u5230\u524D\u540E\u7684\u5899\u6216\u80BF\u5757\u4F1A\u88AB\u5F39\u5F00\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622924
    m_Localized: "\u2022 \u4E00\u540D\u8DD1\u8005\u5728\u8FF7\u5BAB\u91CC\u8DD1\uFF0C\u5176\u4ED6\u4EBA\u5728\u4E8C\u697C\u6307\u8DEF\u3002\n\u2022
      \u8E29\u4E0B\u8E0F\u677F\u53EA\u4F1A\u6253\u5F00\u90A3\u4E2A\u989C\u8272\u7684\u95E8\uFF0C\u5176\u4ED6\u95E8\u5168\u90E8\u5173\u4E0A\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622926
    m_Localized: "\u2022 \u5230\u8FBE\u7EC8\u70B9\u3002\n\n\u2022 \u5728\u7CD6\u679C\u843D\u5730\u524D\u5B8C\u6210\u8FD9\u4E00\u6BB5\u3002"
