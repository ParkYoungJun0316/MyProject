  m_TableData:
  - m_Id: 1141485568
    m_Localized: "\u2022 \u6BCF\u6B21\u53EA\u4F1A\u5347\u8D77\u4E00\u79CD\u989C\u8272\u7684\u5634\u5DF4\u3002\n\u2022
      \u53EA\u8981\u5C06\u81EA\u5DF1\u7684\u989C\u8272\u4E0E\u9ED1\u8272\u6216\u767D\u8272\u7684\u8E0F\u677F\u5339\u914D\uFF0C\u4EFB\u4F55\u4EBA\u90FD\u53EF\u4EE5\u4F7F\u7528\u3002\n\u2022
      \u5F53\u9876\u90E8\u51FA\u73B0\u201CTEAMCHEER\u201D\u65F6\uFF0C\u5927\u58F0\u558A\u51FA\u4F60\u7684\u56E2\u961F\u53E3\u4EE4\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1183428608
    m_Localized: "\u2022 \u6BCF\u4E2A\u533A\u57DF\u7684\u4EBA\u6570\u5FC5\u987B\u4E0E\u6807\u5FD7\u4E0B\u65B9\u7684KKUL-TTEOK\u6570\u91CF\u5B8C\u5168\u4E00\u81F4\uFF0C\u4E0D\u80FD\u591A\uFF0C\u4E5F\u4E0D\u80FD\u5C11\u3002\n\u2022
      \u6BCF\u4E2A\u4EBA\u770B\u5230\u7684\u4E1C\u897F\u90FD\u4E0D\u4E00\u6837\u3002\u5206\u4EAB\u4F60\u770B\u5230\u7684\u5185\u5BB9\uFF01\n\u2022
      \u5F53\u9876\u90E8\u51FA\u73B0\u201CTEAMCHEER\u201D\u65F6\uFF0C\u5927\u58F0\u558A\u51FA\u4F60\u7684\u56E2\u961F\u53E3\u4EE4\u3002\n\u2022
      \u9632\u5FA1\u589E\u76CA\u8FD8\u53EF\u4EE5\u62B5\u6321\u672C\u56DE\u5408\u5931\u8D25\u65F6\u53D7\u5230\u7684\u4F24\u5BB3\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622912
    m_Localized: "\u2022 \u6309\u4E0BCtrl\uFF0C\u8BA9\u81EA\u5DF1\u7684\u989C\u8272\u4E0E\u9ED1\u8272\u6216\u767D\u8272\u5730\u677F\u5339\u914D\uFF0C\u907F\u514D\u6210\u4E3A\u653B\u51FB\u76EE\u6807\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622913
    m_Localized: "\u2022 \u5728\u4E00\u4E2A\u65B9\u5757\u4E0A\u7AD9\u6EE12\u79D2\u5373\u53EF\u5F97\u5206\u3002\n\u2022
      \u5F69\u8272\u65B9\u5757\u53EA\u6709\u5BF9\u5E94\u989C\u8272\u7684\u73A9\u5BB6\u53EF\u4EE5\u8BA1\u5206\u3002\u9ED1\u8272\u548C\u767D\u8272\u65B9\u5757\u4EFB\u4F55\u4EBA\u90FD\u53EF\u4EE5\u8BA1\u5206\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622914
    m_Localized: "\u2022 \u5F53\u4F60\u7684\u989C\u8272\u4EAE\u8D77\u65F6\u6309\u4E0BSpace\u3002\n\u2022
      \u767D\u8272\u4EFB\u4F55\u4EBA\u90FD\u53EF\u4EE5\u51FB\u6253\u3002\u9ED1\u8272\u57281\u79D2\u540E\u4F1A\u81EA\u52A8\u8FDB\u5165\u4E0B\u4E00\u56DE\u5408\u3002\n\u2022
      \u5728\u8FD9\u4E2A\u5C0F\u6E38\u620F\u4E2D\u65E0\u6CD5\u4F7F\u7528Space\u589E\u76CA\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622915
    m_Localized: "\u2022 \u4F60\u53EA\u80FD\u770B\u5230\u524D\u65B9\u4E00\u4E2A\u65B9\u5757\u3002\n\u2022
      \u8BB0\u4F4F\u8981\u6309\u4E0B\u54EA\u4E2A\u65B9\u5757\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622916
    m_Localized: "\u2022 \u6309\u4E0BCtrl\uFF0C\u8BA9\u81EA\u5DF1\u7684\u989C\u8272\u4E0E\u5730\u677F\u5339\u914D\uFF0C\u907F\u514D\u6210\u4E3A\u653B\u51FB\u76EE\u6807\u3002\n\u2022
      \u201CTEAMCHEER\u201D\u51FA\u73B0\u65F6\uFF0C\u558A\u51FA\u4F60\u7684\u56E2\u961F\u53E3\u4EE4\u6765\u4FEE\u590D\u5730\u677F\u3002\n\u2022
      \u5982\u679C\u5730\u677F\u5DF2\u7ECF\u635F\u574F\uFF0C\u5C31\u575A\u6301\u5230\u4E0B\u4E00\u6B21\u8B66\u544A\u51FA\u73B0\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622917
    m_Localized: "\u2022 \u5982\u679C\u51FA\u73B0\u4E0E\u4F60\u989C\u8272\u76F8\u540C\u7684\u65B9\u5757\uFF0C\u5C31\u7AD9\u4E0A\u53BB\u3002\n\u2022
      \u5982\u679C\u6CA1\u6709\uFF0C\u5C31\u7AD9\u5728\u9ED1\u8272\u6216\u767D\u8272\u65B9\u5757\u4E0A\u575A\u6301\u4E0B\u53BB\u3002\n\u2022
      \u89D2\u8272\u7684\u989C\u8272\u4E5F\u8981\u4E0E\u5730\u677F\u5339\u914D\u3002\n\u2022
      \u9632\u5FA1\u589E\u76CA\u8FD8\u53EF\u4EE5\u62B5\u6321\u672C\u56DE\u5408\u5931\u8D25\u65F6\u53D7\u5230\u7684\u4F24\u5BB3\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622918
    m_Localized: "\u2022 \u649E\u5411\u4E0E\u4F60\u989C\u8272\u76F8\u540C\u7684\u5899\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622919
    m_Localized: "\u2022 \u8BB0\u4F4F\u8DEF\u7EBF\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622920
    m_Localized: "\u2022 \u53EA\u80FD\u8E29\u4E0E\u4F60\u989C\u8272\u76F8\u540C\u7684\u65B9\u5757\u3002\n\u2022
      \u8BA9\u89D2\u8272\u7684\u989C\u8272\u4E0E\u65B9\u5757\u5339\u914D\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622921
    m_Localized: "\u2022 \u4E0E\u533A\u57DF\u989C\u8272\u76F8\u540C\u7684\u73A9\u5BB6\u5148\u901A\u8FC7\uFF0C\u7136\u540E\u5176\u4ED6\u4EBA\u8DDF\u4E0A\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622922
    m_Localized: "\u2022 \u5728\u6807\u5FD7\u4E0A\u7684\u8BA1\u65F6\u5668\u7ED3\u675F\u524D\u6E05\u9664\u6BCF\u4E2A\u533A\u57DF\uFF0C\u5426\u5219\u80C3\u9178\u4F1A\u704C\u6EE1\u8BE5\u533A\u57DF\u3002\n\u2022
      \u5339\u914D\u4E24\u4FA7\u5899\u58C1\u7684\u989C\u8272\u5E76\u649E\u51FB\u5B83\u4EEC\uFF0C\u628A\u5899\u63A8\u56DE\u53BB\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622923
    m_Localized: "\u2022 \u6BCF\u4E2A\u65B9\u5757\u53EA\u80FD\u7AD9\u4E00\u540D\u73A9\u5BB6\u3002\u4EBA\u6570\u8D85\u8FC7\u5C31\u4F1A\u4E0B\u6C89\u3002\n\u2022
      \u6709\u4E9B\u65B9\u5757\u53EF\u4EE5\u88AB\u7834\u574F\u3002\n\u2022 \u78B0\u5230\u524D\u540E\u5899\u6216\u80BF\u8D77\u7684\u90E8\u4F4D\u4F1A\u88AB\u5F39\u5F00\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622924
    m_Localized: "\u2022 \u4E00\u540D\u73A9\u5BB6\u7A7F\u8FC7\u8FF7\u5BAB\uFF0C\u5176\u4ED6\u73A9\u5BB6\u4ECE\u4E8C\u697C\u8D1F\u8D23\u6307\u5F15\u8DEF\u7EBF\u3002\n\u2022
      \u8E29\u4E0B\u8E0F\u677F\u540E\uFF0C\u53EA\u6709\u5BF9\u5E94\u989C\u8272\u7684\u95E8\u4F1A\u6253\u5F00\uFF0C\u5176\u4F59\u6240\u6709\u95E8\u90FD\u4F1A\u5173\u95ED\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622926
    m_Localized: "\u2022 \u5230\u8FBE\u7EC8\u70B9\u3002\n\n\u2022 \u5728\u7CD6\u679C\u843D\u5730\u524D\u5B8C\u6210\u8FD9\u4E00\u90E8\u5206\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622927
    m_Localized: "\u2022 \u8E29\u4E0B\u8E0F\u677F\u5236\u9020\u9053\u8DEF\uFF0C\u7136\u540E\u5230\u8FBE\u7EC8\u70B9\u3002\n\n\u2022
      \u5728\u7CD6\u679C\u843D\u5730\u524D\u5B8C\u6210\u8FD9\u4E00\u90E8\u5206\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622928
    m_Localized: "\u2022 \u6BCF\u4E2A\u5B89\u5168\u65B9\u5757\u53EA\u80FD\u7AD9\u4E00\u540D\u73A9\u5BB6\u3002\u4E24\u4EBA\u540C\u65F6\u7AD9\u4E0A\u53BB\u4F1A\u53D7\u5230\u4F24\u5BB3\u3002\n\n\u2022
