  m_SharedData: {fileID: 11400000, guid: b434763c88cad514394ee69eedd290e7, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1141485568
    m_Localized: "\u2022 \u0417\u0430 \u0440\u0430\u0437 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F
      \u0440\u043E\u0442 \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u0434\u043D\u043E\u0433\u043E
      \u0446\u0432\u0435\u0442\u0430.\n\u2022 \u041D\u0430 \u0447\u0451\u0440\u043D\u043E-\u0431\u0435\u043B\u044B\u0435
      \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u044B \u043C\u043E\u0436\u0435\u0442
      \u0432\u0441\u0442\u0430\u0442\u044C \u043B\u044E\u0431\u043E\u0439, \u043F\u043E\u0434\u0441\u0442\u0440\u043E\u0438\u0432
      \u0446\u0432\u0435\u0442.\n\u2022 \u041A\u043E\u0433\u0434\u0430 \u0441\u0432\u0435\u0440\u0445\u0443
      \u043F\u043E\u044F\u0432\u0438\u0442\u0441\u044F \xABTEAMCHEER\xBB, \u0432\u044B\u043A\u0440\u0438\u043A\u043D\u0438
      \u043A\u043E\u043C\u0430\u043D\u0434\u043D\u043E\u0435 \u0441\u043B\u043E\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1183428608
    m_Localized: "\u2022 \u041D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044B\u0439
      \u0446\u0432\u0435\u0442 \u043E\u0431\u044F\u0437\u0430\u043D \u0431\u044B\u0442\u044C
      \u0432 \u044D\u0442\u043E\u0439 \u0437\u043E\u043D\u0435.\n\u2022 \u041A\u043E\u0433\u0434\u0430
      \u0441\u0432\u0435\u0440\u0445\u0443 \u043F\u043E\u044F\u0432\u0438\u0442\u0441\u044F
      \xABTEAMCHEER\xBB, \u0432\u044B\u043A\u0440\u0438\u043A\u043D\u0438 \u043A\u043E\u043C\u0430\u043D\u0434\u043D\u043E\u0435
      \u0441\u043B\u043E\u0432\u043E.\n\u2022 \u0411\u0430\u0444\u0444 \u0437\u0430\u0449\u0438\u0442\u044B
      \u0442\u0430\u043A\u0436\u0435 \u0431\u043B\u043E\u043A\u0438\u0440\u0443\u0435\u0442
      \u0443\u0440\u043E\u043D \u0437\u0430 \u043F\u0440\u043E\u0432\u0430\u043B\u0435\u043D\u043D\u044B\u0439
      \u0440\u0430\u0443\u043D\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622912
    m_Localized: "\u2022 \u041D\u0430\u0436\u043C\u0438 Ctrl, \u043F\u043E\u0434\u0433\u043E\u043D\u0438
      \u0446\u0432\u0435\u0442 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430
      \u043F\u043E\u0434 \u0447\u0451\u0440\u043D\u044B\u0439 \u0438\u043B\u0438
      \u0431\u0435\u043B\u044B\u0439 \u043F\u043E\u043B \u2014 \u0438 \u0441\u0431\u0440\u043E\u0441\u044C
      \u0437\u0430\u0445\u0432\u0430\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622913
    m_Localized: "\u2022 \u0421\u0442\u043E\u0439 \u043D\u0430 \u043F\u043B\u0438\u0442\u043A\u0435
      2 \u0441\u0435\u043A\u0443\u043D\u0434\u044B \u2014 \u0442\u043E\u0433\u0434\u0430
      \u0438\u0434\u0443\u0442 \u043E\u0447\u043A\u0438.\n\u2022 \u0423\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u0435
      \u043F\u043B\u0438\u0442\u043A\u0438 \u0441\u0447\u0438\u0442\u0430\u0435\u0442
      \u0442\u043E\u043B\u044C\u043A\u043E \u044D\u0442\u043E\u0442 \u0446\u0432\u0435\u0442.
      \u0427\u0451\u0440\u043D\u044B\u0435 \u0438 \u0431\u0435\u043B\u044B\u0435
      \u043C\u043E\u0436\u0435\u0442 \u043D\u0430\u0441\u0442\u0443\u043F\u0430\u0442\u044C
      \u043A\u0442\u043E \u0443\u0433\u043E\u0434\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622914
    m_Localized: "\u2022 \u041D\u0430\u0436\u043C\u0438 Space, \u043A\u043E\u0433\u0434\u0430
      \u0437\u0430\u0433\u043E\u0440\u0438\u0442\u0441\u044F \u0442\u0432\u043E\u0439
      \u0446\u0432\u0435\u0442.\n\u2022 \u0411\u0435\u043B\u0443\u044E \u043C\u043E\u0436\u0435\u0442
      \u043D\u0430\u0436\u0430\u0442\u044C \u043A\u0442\u043E \u0443\u0433\u043E\u0434\u043D\u043E.
      \u0427\u0451\u0440\u043D\u0430\u044F \u0447\u0435\u0440\u0435\u0437 1 \u0441\u0435\u043A\u0443\u043D\u0434\u0443
      \u0441\u0430\u043C\u0430 \u043F\u0435\u0440\u0435\u0439\u0434\u0451\u0442 \u0434\u0430\u043B\u044C\u0448\u0435.\n\u2022
      \u0412\u043E \u0432\u0440\u0435\u043C\u044F \u043C\u0438\u043D\u0438-\u0438\u0433\u0440\u044B
      \u0431\u0430\u0444\u0444 \u043D\u0430 Space \u043D\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622915
    m_Localized: "\u2022 \u0412\u0438\u0434\u043D\u043E \u0442\u043E\u043B\u044C\u043A\u043E
      \u043E\u0434\u043D\u0443 \u043A\u043B\u0435\u0442\u043A\u0443 \u0432\u043F\u0435\u0440\u0451\u0434.\n\u2022
      \u0417\u0430\u043F\u043E\u043C\u043D\u0438, \u043A\u0430\u043A\u0438\u0435
      \u0436\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622916
    m_Localized: "\u2022 \u041D\u0430\u0436\u043C\u0438 Ctrl, \u043F\u043E\u0434\u0433\u043E\u043D\u0438
      \u0446\u0432\u0435\u0442 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430
      \u043F\u043E\u0434 \u043F\u043E\u043B \u2014 \u0438 \u0441\u0431\u0440\u043E\u0441\u044C
      \u0437\u0430\u0445\u0432\u0430\u0442.\n\u2022 \u0412\u044B\u043A\u0440\u0438\u043A\u043D\u0438
      \u043A\u043E\u043C\u0430\u043D\u0434\u043D\u043E\u0435 \u0441\u043B\u043E\u0432\u043E,
      \u043F\u043E\u043A\u0430 \u0432\u0438\u0441\u0438\u0442 \xABTEAMCHEER\xBB \u2014
      \u043F\u043E\u043B \u043F\u043E\u0447\u0438\u043D\u0438\u0442\u0441\u044F.\n\u2022
      \u0415\u0441\u043B\u0438 \u0443\u0436\u0435 \u0441\u043B\u043E\u043C\u0430\u043D\u043E,
      \u0442\u0435\u0440\u043F\u0438 \u0434\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
      \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622917
    m_Localized: "\u2022 \u0415\u0441\u043B\u0438 \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u0443\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u0430\u044F \u043A\u043B\u0435\u0442\u043A\u0430
      \u2014 \u0432\u0441\u0442\u0430\u043D\u044C \u043D\u0430 \u043D\u0435\u0451.\n\u2022
      \u0415\u0441\u043B\u0438 \u043D\u0435\u0442 \u2014 \u0434\u0435\u0440\u0436\u0438\u0441\u044C
      \u043D\u0430 \u0447\u0451\u0440\u043D\u043E\u0439 \u0438\u043B\u0438 \u0431\u0435\u043B\u043E\u0439.\n\u2022
      \u0426\u0432\u0435\u0442 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430
      \u0442\u043E\u0436\u0435 \u043F\u043E\u0434\u0433\u043E\u043D\u0438 \u043F\u043E\u0434
      \u043F\u043E\u043B.\n\u2022 \u0411\u0430\u0444\u0444 \u0437\u0430\u0449\u0438\u0442\u044B
      \u0442\u0430\u043A\u0436\u0435 \u0431\u043B\u043E\u043A\u0438\u0440\u0443\u0435\u0442
      \u0443\u0440\u043E\u043D \u0437\u0430 \u043F\u0440\u043E\u0432\u0430\u043B\u0435\u043D\u043D\u044B\u0439
      \u0440\u0430\u0443\u043D\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622918
    m_Localized: "\u2022 \u0415\u0441\u043B\u0438 \u0432\u0440\u0435\u0437\u0430\u0442\u044C\u0441\u044F
      \u0432 \u0431\u043E\u043A\u043E\u0432\u044B\u0435 \u0441\u0442\u0435\u043D\u044B
      \u0441\u0432\u043E\u0435\u0433\u043E \u0446\u0432\u0435\u0442\u0430, \u043E\u043D\u0438
      \u043E\u0442\u0441\u0442\u0443\u043F\u044F\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622919
    m_Localized: "\u2022 \u0417\u0430\u043F\u043E\u043C\u043D\u0438 \u0434\u043E\u0440\u043E\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622920
    m_Localized: "\u2022 \u0421\u0442\u0443\u043F\u0430\u0439 \u0442\u043E\u043B\u044C\u043A\u043E
      \u043D\u0430 \u043A\u043B\u0435\u0442\u043A\u0438 \u0441\u0432\u043E\u0435\u0433\u043E
      \u0446\u0432\u0435\u0442\u0430.\n\u2022 \u0414\u0430\u0436\u0435 \u0435\u0441\u043B\u0438
      \u0446\u0432\u0435\u0442 \u043A\u043B\u0435\u0442\u043A\u0438 \u0441\u043E\u0432\u043F\u0430\u043B
      \u2014 \u0432 \u0447\u0451\u0440\u043D\u043E-\u0431\u0435\u043B\u043E\u043C
      \u043D\u0435\u043B\u044C\u0437\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622921
    m_Localized: "\u2022 \u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0434\u043E\u043B\u0436\u0435\u043D
      \u043F\u0440\u043E\u0439\u0442\u0438 \u0441\u0432\u043E\u0439 \u0446\u0432\u0435\u0442,
      \u0438\u043D\u0430\u0447\u0435 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u043D\u0435 \u043C\u043E\u0433\u0443\u0442 \u043D\u0430\u0441\u0442\u0443\u043F\u0430\u0442\u044C
      \u043D\u0430 \u044D\u0442\u043E\u0442 \u043F\u043E\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622922
    m_Localized: "\u2022 \u041F\u043E\u0434\u0433\u043E\u043D\u0438 \u0446\u0432\u0435\u0442
      \u0431\u043E\u043A\u043E\u0432\u044B\u0445 \u0441\u0442\u0435\u043D \u0438
      \u0432\u0440\u0435\u0436\u044C\u0441\u044F \u2014 \u043E\u043D\u0438 \u043E\u0442\u0441\u0442\u0443\u043F\u044F\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622923
    m_Localized: "\u2022 \u041A\u0430\u0441\u0430\u043D\u0438\u0435 \u043F\u0435\u0440\u0435\u0434\u043D\u0438\u0445
      \u0438 \u0437\u0430\u0434\u043D\u0438\u0445 \u0441\u0442\u0435\u043D \u0438\u043B\u0438
      \u043E\u0442\u0451\u043A\u043E\u0432 \u043E\u0442\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622924
    m_Localized: "\u2022 \u041D\u0430\u0441\u0442\u0443\u043F\u0438\u0432 \u043D\u0430
      \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0443 \u0432 \u043B\u044E\u0431\u043E\u043C
      \u043C\u0435\u0441\u0442\u0435, \u0432\u044B \u043E\u0442\u043A\u0440\u043E\u0435\u0442\u0435
      \u0438 \u0437\u0430\u043A\u0440\u043E\u0435\u0442\u0435 \u0434\u0432\u0435\u0440\u0438.\n\u2022
      \u041A\u043E\u0433\u0434\u0430 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u044E\u0442\u0441\u044F
      \u0447\u0451\u0440\u043D\u044B\u0435 \u0434\u0432\u0435\u0440\u0438, \u0431\u0435\u043B\u044B\u0435
      \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u044E\u0442\u0441\u044F \u2014 \u0438
      \u043D\u0430\u043E\u0431\u043E\u0440\u043E\u0442.\n\u2022 \u0421\u043D\u0430\u0447\u0430\u043B\u0430
      \u043D\u0430\u0439\u0434\u0438\u0442\u0435 \u043F\u0443\u0442\u044C \u043D\u0430
      \u0432\u0442\u043E\u0440\u043E\u0439 \u044D\u0442\u0430\u0436."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622926
    m_Localized: "\u2022 \u041D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044B\u0439
      \u0446\u0432\u0435\u0442 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u043F\u0443\u0442\u044C \u2014 \u043F\u043E\u0442\u043E\u043C \u0434\u043E\u0431\u0435\u0440\u0438\u0441\u044C
      \u0434\u043E \u0446\u0435\u043B\u0438.\n\n\u2022 \u0417\u0430\u043A\u043E\u043D\u0447\u0438
      \u044D\u0442\u043E\u0442 \u043E\u0442\u0440\u0435\u0437\u043E\u043A, \u043F\u043E\u043A\u0430
      \u043A\u043E\u043D\u0444\u0435\u0442\u0430 \u043D\u0435 \u043A\u043E\u0441\u043D\u0451\u0442\u0441\u044F
      \u0437\u0435\u043C\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622927
    m_Localized: "\u2022 \u041D\u0430\u0441\u0442\u0443\u043F\u0430\u0439 \u043D\u0430
      \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u044B, \u043F\u0440\u043E\u043B\u043E\u0436\u0438
      \u043F\u0443\u0442\u044C \u0438 \u0434\u043E\u0431\u0435\u0440\u0438\u0441\u044C
      \u0434\u043E \u0446\u0435\u043B\u0438.\n\n\u2022 \u0417\u0430\u043A\u043E\u043D\u0447\u0438
      \u044D\u0442\u043E\u0442 \u043E\u0442\u0440\u0435\u0437\u043E\u043A, \u043F\u043E\u043A\u0430
      \u043A\u043E\u043D\u0444\u0435\u0442\u0430 \u043D\u0435 \u043A\u043E\u0441\u043D\u0451\u0442\u0441\u044F
      \u0437\u0435\u043C\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622928
    m_Localized: "\u2022 \u041D\u0430\u0441\u0442\u0443\u043F\u0438 \u043D\u0430
      \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u0443\u044E \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0443,
      \u043F\u043E\u0434\u043F\u0440\u044B\u0433\u043D\u0438 \u0438 \u0432\u0440\u0435\u0436\u044C\u0441\u044F
      \u0432 \u043A\u043E\u043D\u0444\u0435\u0442\u0443 \u043D\u0443\u0436\u043D\u044B\u043C
      \u0446\u0432\u0435\u0442\u043E\u043C.\n\n\u2022 \u0417\u0430\u043A\u043E\u043D\u0447\u0438
      \u044D\u0442\u043E\u0442 \u043E\u0442\u0440\u0435\u0437\u043E\u043A, \u043F\u043E\u043A\u0430
      \u043A\u043E\u043D\u0444\u0435\u0442\u0430 \u043D\u0435 \u043A\u043E\u0441\u043D\u0451\u0442\u0441\u044F
      \u0437\u0435\u043C\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622929
    m_Localized: "\u2022 \u041F\u043E\u0434\u0433\u043E\u043D\u0438 \u0446\u0432\u0435\u0442
      \u0441\u0442\u0435\u043D\u044B \u0438 \u0432\u0440\u0435\u0436\u044C\u0441\u044F,
      \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u0442\u043E\u043B\u043A\u043D\u0443\u0442\u044C
      \u0435\u0451."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891662639104
    m_Localized: "\u2022 \u0417\u0430 \u0440\u0430\u0437 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F
