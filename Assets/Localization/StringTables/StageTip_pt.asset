%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: StageTip_pt
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: pt
  m_SharedData: {fileID: 11400000, guid: b434763c88cad514394ee69eedd290e7, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1141485568
    m_Localized: "\u2022 S\xF3 sobe a boca de uma cor por vez.\n\u2022 Qualquer um
      pode usar as placas pretas e brancas ajustando a cor.\n\u2022 Quando \"TEAMCHEER\"
      aparecer no topo, grite a palavra da equipe."
    m_Metadata:
      m_Items: []
  - m_Id: 1183428608
    m_Localized: "\u2022 Cada \xE1rea precisa de tantos jogadores quanto os KKUL-TTEOK
      embaixo da placa \u2014 nem mais, nem menos.\n\u2022 Cada um v\xEA uma coisa
      diferente. Contem o que est\xE3o vendo!\n\u2022 Quando \"TEAMCHEER\" aparecer
      no topo, grite a palavra da equipe.\n\u2022 O buff de defesa tamb\xE9m bloqueia
      o dano de rodada perdida."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622912
    m_Localized: "\u2022 Aperte Ctrl pra igualar sua cor ao ch\xE3o preto ou branco
      e n\xE3o virar alvo."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622913
    m_Localized: "\u2022 Fique 2 segundos num bloco pra marcar ponto.\n\u2022 Blocos
      coloridos s\xF3 contam pra sua cor; pretos e brancos contam pra qualquer um."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622914
    m_Localized: "\u2022 Aperte Space quando a sua cor acender.\n\u2022 Branco qualquer
      um pode apertar. Preto passa pro pr\xF3ximo turno depois de 1 segundo.\n\u2022
      Durante o minigame voc\xEA n\xE3o pode usar o buff do Space."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622915
    m_Localized: "\u2022 Voc\xEA s\xF3 v\xEA um bloco \xE0 frente.\n\u2022 Grave
      qual bloco apertar."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622916
    m_Localized: "\u2022 Aperte Ctrl pra igualar sua cor \xE0 do ch\xE3o e n\xE3o
      virar alvo.\n\u2022 Grite a palavra da equipe enquanto \"TEAMCHEER\" estiver
      na tela pra consertar o ch\xE3o.\n\u2022 Se j\xE1 quebrou, aguente at\xE9 o
      pr\xF3ximo aviso."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622917
    m_Localized: "\u2022 Se aparecer um bloco da sua cor, fique em cima dele.\n\u2022
      Se n\xE3o, aguente num bloco preto ou branco.\n\u2022 Ajuste tamb\xE9m a cor
      do personagem \xE0 do ch\xE3o.\n\u2022 O buff de defesa tamb\xE9m bloqueia
      o dano de rodada perdida."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622918
    m_Localized: "\u2022 Trombe nas paredes da sua cor."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622919
    m_Localized: "\u2022 Decore o caminho."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622920
    m_Localized: "\u2022 Pise s\xF3 nos blocos da sua cor.\n\u2022 Ajuste a cor do
      personagem \xE0 dos blocos."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622921
    m_Localized: "\u2022 A cor da \xE1rea vai primeiro, depois os outros podem seguir."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622922
    m_Localized: "\u2022 Passe cada trecho antes do tempo da placa acabar, sen\xE3o
      o \xE1cido inunda tudo.\n\u2022 Iguale a cor das paredes laterais e trombe
      nelas pra empurr\xE1-las de volta."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622923
    m_Localized: "\u2022 Um jogador por bloco. Se tiver mais, ele afunda.\n\u2022
      Alguns blocos quebram.\n\u2022 Encostar nas paredes da frente e de tr\xE1s
      ou nos incha\xE7os te joga pra tr\xE1s."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622924
    m_Localized: "\u2022 Um corredor atravessa o labirinto enquanto os outros guiam
      do andar de cima.\n\u2022 Pisar numa placa abre s\xF3 as portas daquela cor
      e fecha todas as outras."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622926
    m_Localized: "\u2022 Alcance o objetivo.\n\n\u2022 Termine esta etapa antes que
      a bala chegue ao ch\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622927
    m_Localized: "\u2022 Pise nas placas pra formar um caminho e depois alcance o
      objetivo.\n\n\u2022 Termine esta etapa antes que a bala chegue ao ch\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622928
    m_Localized: "\u2022 Um jogador por bloco seguro. Dividir o bloco causa dano.\n\n\u2022
      Termine esta etapa antes que a bala chegue ao ch\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622929
    m_Localized: "\u2022 Iguale a cor da parede e trombe nela."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891662639104
    m_Localized: "\u2022 S\xF3 sobe a boca de uma cor por vez.\n\u2022 Qualquer um
      pode usar as placas pretas e brancas ajustando a cor."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891696193536
    m_Localized: "\u2022 Cada um v\xEA uma coisa diferente. Contem o que est\xE3o
      vendo!\n\u2022 O buff de defesa tamb\xE9m bloqueia o dano de rodada perdida."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891696193537
    m_Localized: "\u2022 Aperte Ctrl pra igualar sua cor \xE0 do ch\xE3o e n\xE3o
      virar alvo."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891696193538
    m_Localized: "\u2022 Quando a boca abrir, grite a palavra da equipe pra consertar
      o ch\xE3o quebrado."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
