%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: StageTip_pt
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: pt
  m_SharedData: {fileID: 11400000, guid: b434763c88cad514394ee69eedd290e7, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1141485568
    m_Localized: "\u2022 Apenas a boca de uma cor sobe por vez.\n\u2022 Qualquer
      jogador pode usar as placas pretas e brancas ao combinar sua cor.\n\u2022 Quando
      \u201CTEAMCHEER\u201D aparecer no topo, grite o grito da equipe."
    m_Metadata:
      m_Items: []
  - m_Id: 1183428608
    m_Localized: "\u2022 Cada zona precisa de exatamente a mesma quantidade de jogadores
      que houver de KKUL-TTEOK abaixo da placa. Nem mais, nem menos.\n\u2022 Cada
      jogador v\xEA algo diferente. Compartilhe o que voc\xEA v\xEA!\n\u2022 Quando
      \u201CTEAMCHEER\u201D aparecer no topo, grite o grito da equipe.\n\u2022 O
      b\xF4nus de defesa tamb\xE9m bloqueia o dano causado por falhar na rodada."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622912
    m_Localized: "\u2022 Pressione Ctrl para combinar sua cor com o piso preto ou
      branco e evitar ser o alvo."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622913
    m_Localized: "\u2022 Fique em uma plataforma por 2 segundos para marcar pontos.\n\u2022
      As plataformas coloridas s\xF3 contam para jogadores daquela cor. As plataformas
      pretas e brancas contam para qualquer jogador."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622914
    m_Localized: "\u2022 Pressione Space quando a sua cor acender.\n\u2022 Qualquer
      jogador pode bater na branca. A preta passa para o pr\xF3ximo turno ap\xF3s
      1 segundo.\n\u2022 Voc\xEA n\xE3o pode usar seu b\xF4nus de Space durante este
      minijogo."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622915
    m_Localized: "\u2022 Voc\xEA s\xF3 consegue ver a plataforma logo \xE0 frente.\n\u2022
      Memorize qual plataforma deve pressionar."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622916
    m_Localized: "\u2022 Pressione Ctrl para combinar sua cor com o piso e evitar
      ser o alvo.\n\u2022 Quando \u201CTEAMCHEER\u201D aparecer, grite o grito da
      equipe para reparar o piso.\n\u2022 Se ele j\xE1 estiver quebrado, aguente
      at\xE9 o pr\xF3ximo aviso."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622917
    m_Localized: "\u2022 Se aparecer uma plataforma da sua cor, fique sobre ela.\n\u2022
      Caso contr\xE1rio, aguente em uma plataforma preta ou branca.\n\u2022 Combine
      tamb\xE9m a cor do seu personagem com a cor do piso.\n\u2022 O b\xF4nus de
      defesa tamb\xE9m bloqueia o dano causado por falhar na rodada."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622918
    m_Localized: "\u2022 Invista contra as paredes que combinarem com a sua cor."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622919
    m_Localized: "\u2022 Memorize o caminho."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622920
    m_Localized: "\u2022 Pise apenas nas plataformas da sua cor.\n\u2022 Combine
      a cor do seu personagem com a cor das plataformas."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622921
    m_Localized: "\u2022 O jogador da cor da zona passa primeiro, e os demais podem
      seguir."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622922
    m_Localized: "\u2022 Conclua cada se\xE7\xE3o antes que o cron\xF4metro da placa
      termine, ou ela ser\xE1 inundada por \xE1cido.\n\u2022 Combine a cor das paredes
      laterais e invista contra elas para empurr\xE1-las de volta."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622923
    m_Localized: "\u2022 Apenas um jogador por plataforma. Se houver mais, ela afundar\xE1.\n\u2022
      Algumas plataformas podem quebrar.\n\u2022 Tocar nas paredes da frente, de
      tr\xE1s ou nas sali\xEAncias far\xE1 voc\xEA recuar."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622924
    m_Localized: "\u2022 Um jogador atravessa o labirinto enquanto os outros o guiam
      do segundo andar.\n\u2022 Ao pisar em uma placa, apenas as portas daquela cor
      se abrem e todas as outras se fecham."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622926
    m_Localized: "\u2022 Chegue ao objetivo.\n\n\u2022 Conclua esta se\xE7\xE3o antes
      que o doce toque o ch\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622927
    m_Localized: "\u2022 Pise nas placas para criar um caminho e depois chegue ao
      objetivo.\n\n\u2022 Conclua esta se\xE7\xE3o antes que o doce toque o ch\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622928
    m_Localized: "\u2022 Apenas um jogador por plataforma segura. Se dois ficarem
      juntos, eles sofrer\xE3o dano.\n\n\u2022 Conclua esta se\xE7\xE3o antes que
      o doce toque o ch\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622929
    m_Localized: "\u2022 Combine sua cor com a da parede e invista contra ela."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891662639104
    m_Localized: "\u2022 Apenas a boca de uma cor sobe por vez.\n\u2022 Qualquer
      jogador pode usar as placas pretas e brancas ao combinar sua cor."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891696193536
    m_Localized: "\u2022 Cada jogador v\xEA algo diferente. Compartilhe o que voc\xEA
      v\xEA!\n\u2022 O b\xF4nus de defesa tamb\xE9m bloqueia o dano causado por falhar
      na rodada."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891696193537
    m_Localized: "\u2022 Pressione Ctrl para combinar sua cor com o piso e evitar
      ser o alvo."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891696193538
    m_Localized: "\u2022 Quando a boca abrir, grite o grito da equipe para reparar
      o piso quebrado."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
