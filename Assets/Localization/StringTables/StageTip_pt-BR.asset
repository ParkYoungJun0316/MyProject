%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: StageTip_pt-BR
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: pt-BR
  m_SharedData: {fileID: 11400000, guid: b434763c88cad514394ee69eedd290e7, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1141485568
    m_Localized: "\u2022 S\xF3 sobe uma boca de cada cor por vez.\n\u2022 Qualquer
      um pode acertar a cor e pisar nas plataformas preto e branco.\n\u2022 Quando
      o \"TEAMCHEER\" aparecer em cima, grite a palavra da equipe."
    m_Metadata:
      m_Items: []
  - m_Id: 1183428608
    m_Localized: "\u2022 A cor designada tem que estar naquela zona.\n\u2022 Quando
      o \"TEAMCHEER\" aparecer em cima, grite a palavra da equipe.\n\u2022 O buff
      de defesa tamb\xE9m bloqueia o dano de rodada perdida."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622912
    m_Localized: "\u2022 Aperte Ctrl para igualar a cor do personagem ao ch\xE3o
      preto ou branco e sair da mira."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622913
    m_Localized: "\u2022 Fique 2 segundos no bloco para pontuar.\n\u2022 Bloco de
      cor \xFAnica s\xF3 vale pra essa cor. Preto e branco qualquer um pode pisar."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622914
    m_Localized: "\u2022 Aperte Space quando a sua cor acender.\n\u2022 Branco qualquer
      um pode apertar. Preto passa pro pr\xF3ximo turno depois de 1 segundo.\n\u2022
      Durante o minigame voc\xEA n\xE3o pode usar o buff do Space."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622915
    m_Localized: "\u2022 S\xF3 aparece um bloco \xE0 frente.\n\u2022 Decore quais
      voc\xEA tem que apertar."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622916
    m_Localized: "\u2022 Aperte Ctrl para igualar a cor do personagem \xE0 do ch\xE3o
      e sair da mira.\n\u2022 Grite a palavra da equipe enquanto o \"TEAMCHEER\"
      estiver na tela pra consertar o ch\xE3o.\n\u2022 Se j\xE1 quebrou, aguente
      at\xE9 o pr\xF3ximo aviso."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622917
    m_Localized: "\u2022 Se aparecer um bloco de cor \xFAnica, fique em cima.\n\u2022
      Se n\xE3o aparecer, aguente no preto ou branco.\n\u2022 Troque a cor do personagem
      pra combinar com o ch\xE3o tamb\xE9m.\n\u2022 O buff de defesa tamb\xE9m bloqueia
      o dano de rodada perdida."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622918
    m_Localized: "\u2022 Se bater nas paredes laterais quando elas mostrarem a sua
      cor, elas recuam."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622919
    m_Localized: "\u2022 Decore o caminho."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622920
    m_Localized: "\u2022 Pise s\xF3 nos blocos da sua cor.\n\u2022 Mesmo se a cor
      do bloco bater, n\xE3o vale se o personagem estiver preto ou branco."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622921
    m_Localized: "\u2022 A cor respons\xE1vel tem que passar primeiro pra o resto
      do time poder pisar nesse ch\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622922
    m_Localized: "\u2022 Acerte a cor das paredes laterais e bata nelas \u2014 elas
      recuam."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622923
    m_Localized: "\u2022 Encostar nas paredes da frente e de tr\xE1s ou nos incha\xE7os
      te arremessa."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622924
    m_Localized: "\u2022 Pisar em um pad em qualquer lugar abre e fecha as portas.\n\u2022
      Quando as portas pretas abrem, as brancas fecham, e vice-versa.\n\u2022 Procurem
      primeiro o caminho para o segundo andar."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622926
    m_Localized: "\u2022 A cor designada abre o caminho, depois chegue no objetivo.\n\n\u2022
      Termine esse trecho antes do doce encostar no ch\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622927
    m_Localized: "\u2022 Pise nas plataformas pra fazer um caminho e chegue no objetivo.\n\n\u2022
      Termine esse trecho antes do doce encostar no ch\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622928
    m_Localized: "\u2022 Pise na plataforma do meio, pule e bata no doce na cor certa.\n\n\u2022
      Termine esse trecho antes do doce encostar no ch\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622929
    m_Localized: "\u2022 Acerte a cor da parede e bata nela pra empurrar."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891662639104
    m_Localized: "\u2022 S\xF3 sobe uma boca de cada cor por vez.\n\u2022 Qualquer
      um pode acertar a cor e pisar nas plataformas preto e branco."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891696193536
    m_Localized: "\u2022 O buff de defesa tamb\xE9m bloqueia o dano de rodada perdida."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891696193537
    m_Localized: "\u2022 Aperte Ctrl para igualar a cor do personagem \xE0 do ch\xE3o
      e sair da mira."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891696193538
    m_Localized: "\u2022 Quando a boca abrir, grite a palavra da equipe pra consertar
      o ch\xE3o quebrado."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
