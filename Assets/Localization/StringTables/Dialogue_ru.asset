  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogue_ru
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ru
  m_SharedData: {fileID: 11400000, guid: 043bf15b2a6a41c48971e11c678f419c, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 472199573504
    m_Localized: "\u041D\u0430\u0441 \u0441\u044A\u0435\u043B\u0438. \u0422\u0435\u043F\u0435\u0440\u044C
      \u0434\u0443\u043C\u0430\u0439 \u0442\u043E\u043B\u044C\u043A\u043E \u043E
      \u0442\u043E\u043C, \u043A\u0430\u043A \u0432\u044B\u0436\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 334352332992512
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u043D\u0430 \u043F\u043E\u043B\u0443
      \u0431\u0443\u0434\u0435\u0442 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E
      \u043F\u043E\u044F\u0432\u043B\u044F\u0442\u044C\u0441\u044F \u043F\u043B\u0438\u0442\u043A\u0430
      \u0442\u0432\u043E\u0435\u0433\u043E \u0446\u0432\u0435\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 334425666203648
    m_Localized: "\u0422\u0435\u0431\u0435 \u043D\u0443\u0436\u043D\u043E \u0443\u0441\u043F\u0435\u0442\u044C
      \u0432\u0441\u0442\u0430\u0442\u044C \u043D\u0430 \u043D\u0435\u0451 \u0434\u043E
      \u043A\u043E\u043D\u0446\u0430 \u043E\u0442\u0432\u0435\u0434\u0451\u043D\u043D\u043E\u0433\u043E
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 334428463804416
    m_Localized: "\u0415\u0441\u043B\u0438 \u043D\u0435 \u0443\u0441\u043F\u0435\u0435\u0448\u044C...
      \u0437\u0443\u0431\u044B \u0441 \u043F\u043E\u0442\u043E\u043B\u043A\u0430
      \u043D\u0430\u0447\u043D\u0443\u0442 \u043F\u0430\u0434\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 335182629023744
    m_Localized: "\u041D\u0430 \u0431\u0435\u043B\u044B\u0439 \u043C\u043E\u0436\u0435\u0442
      \u043D\u0430\u0436\u0430\u0442\u044C \u043A\u0442\u043E \u0443\u0433\u043E\u0434\u043D\u043E,
      \u0430 \u043D\u0430 \u0447\u0451\u0440\u043D\u044B\u0439 \u2014 \u043D\u0438\u043A\u043E\u0433\u0434\u0430
      \u043D\u0435 \u043D\u0430\u0436\u0438\u043C\u0430\u0439!"
    m_Metadata:
      m_Items: []
  - m_Id: 335185439207424
    m_Localized: "\u041E\u0448\u0438\u0431\u0451\u0448\u044C\u0441\u044F \u2014 \u043F\u043E\u0442\u0435\u0440\u044F\u0435\u0448\u044C
      \u0432\u0440\u0435\u043C\u044F, \u0442\u0430\u043A \u0447\u0442\u043E \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 335887280484352
    m_Localized: "\u0412\u0441\u0442\u0430\u043D\u044C \u043D\u0430 \u043F\u043B\u0438\u0442\u043A\u0443
      \u0441\u0432\u043E\u0435\u0433\u043E \u0446\u0432\u0435\u0442\u0430 \u0438
      \u0434\u0435\u0440\u0436\u0438\u0441\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 335890795311104
    m_Localized: "\u042D\u0442\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
      \u0443\u0447\u0430\u0441\u0442\u043E\u043A \u0432\u043E \u0440\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 335893903290368
    m_Localized: "\u0415\u0441\u043B\u0438 \u0435\u0449\u0451 \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u043F\u0440\u043E\u0434\u0435\u0440\u0436\u0430\u0442\u044C\u0441\u044F, \u043A\u0430\u0436\u0435\u0442\u0441\u044F,
      \u043C\u043E\u0436\u043D\u043E \u0431\u0443\u0434\u0435\u0442 \u0432\u044B\u0431\u0440\u0430\u0442\u044C\u0441\u044F..."
    m_Metadata:
      m_Items: []
  - m_Id: 337052009345024
    m_Localized: "\u0412\u043E \u0440\u0442\u0443 \u0441\u0442\u0430\u043B\u043E
      \u0442\u0438\u0445\u043E... \u043D\u0435\u0443\u0436\u0435\u043B\u0438 \u0432\u0441\u0451
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u043E\u0441\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 337056501444608
    m_Localized: "\u0417\u043D\u0430\u0447\u0438\u0442, \u0442\u0435\u043F\u0435\u0440\u044C
      \u043C\u044B \u043C\u043E\u0436\u0435\u043C \u0441\u0431\u0435\u0436\u0430\u0442\u044C...?"
    m_Metadata:
      m_Items: []
  - m_Id: 337060553142272
    m_Localized: "\u2026\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 337068631371776
    m_Localized: "\u041E \u043D\u0435\u0442, \u043D\u0430\u0441 \u0441\u043D\u043E\u0432\u0430
      \u0433\u043B\u043E\u0442\u0430\u044E\u0442...!!"
    m_Metadata:
      m_Items: []
  - m_Id: 337070598500352
    m_Localized: "\u041C\u044B \u043F\u043E\u043F\u0430\u043B\u0438 \u0432 \u043F\u0438\u0449\u0435\u0432\u043E\u0434...?"
    m_Metadata:
      m_Items: []
  - m_Id: 337897539088384
    m_Localized: "\u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u0447\u0442\u043E-\u0442\u043E
      \u043A\u0430\u0442\u0438\u0442\u0441\u044F \u0441\u0437\u0430\u0434\u0438..."
    m_Metadata:
      m_Items: []
  - m_Id: 337902496755712
    m_Localized: "\u0411\u0435\u0433\u043E\u043C!!!"
    m_Metadata:
      m_Items: []
  - m_Id: 337904153505792
    m_Localized: "\u041E\u0434\u0438\u043D \u043D\u0435\u0432\u0435\u0440\u043D\u044B\u0439
      \u0448\u0430\u0433 \u2014 \u0438 \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u0430\u044F
      \u0441\u043C\u0435\u0440\u0442\u044C. \u0417\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0439
      \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u0432\u0435\u0442\u044F\u0449\u0438\u0435\u0441\u044F
      \u043A\u043B\u0435\u0442\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 337904874926080
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u0431\u0443\u0434\u0435\u0442
      \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u043E \u043F\u043E \u0446\u0432\u0435\u0442\u0430\u043C.
      \u041E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0439
      \u0441\u0432\u043E\u0435\u043C\u0443 \u0446\u0432\u0435\u0442\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 337905520848896
    m_Localized: "\u0414\u0430\u0436\u0435 \u0435\u0441\u043B\u0438 \u0446\u0432\u0435\u0442
      \u0432\u0435\u0440\u043D\u044B\u0439, \u0447\u0451\u0440\u043D\u043E-\u0431\u0435\u043B\u043E\u0435
      \u0443\u0431\u044C\u0451\u0442 \u0442\u0435\u0431\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 337906154188800
    m_Localized: "\u0423 \u043A\u0430\u0436\u0434\u043E\u0439 \u0437\u043E\u043D\u044B
      \u0441\u0432\u043E\u0439 \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
      \u0446\u0432\u0435\u0442. \u041F\u0443\u0442\u044C \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u044B\u043C \u0442\u043E\u043B\u044C\u043A\u043E
      \u043F\u043E\u0441\u043B\u0435 \u0442\u043E\u0433\u043E, \u043A\u0430\u043A
      \u044D\u0442\u043E\u0442 \u0446\u0432\u0435\u0442 \u043F\u0440\u043E\u0439\u0434\u0451\u0442
      \u043F\u0435\u0440\u0432\u044B\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 337906812694528
    m_Localized: "\u041B\u043E\u0432\u0438 \u0443\u0431\u0435\u0433\u0430\u044E\u0449\u0438\u0435
      \u044D\u0440\u0438\u0442\u0440\u043E\u0446\u0438\u0442\u044B!"
    m_Metadata:
      m_Items: []
  - m_Id: 337907517337600
    m_Localized: "\u0411\u0435\u0433\u0438 \u043E\u0442 \u0430\u043D\u0442\u0438\u0442\u0435\u043B
      \u0438 \u0432\u044B\u0436\u0438\u0432\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 339357207212032
    m_Localized: "\u041C\u044B \u0434\u043E\u0448\u043B\u0438 \u0434\u043E \u043A\u043E\u043D\u0446\u0430
      \u043F\u0438\u0449\u0435\u0432\u043E\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 339360646541312
    m_Localized: "\u041C\u043E\u0436\u0435\u0442, \u043F\u043E\u0442\u043E\u043C\u0443
      \u0447\u0442\u043E \u044D\u0442\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
      \u0443\u0447\u0430\u0441\u0442\u043E\u043A... \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435
      \u043E\u0449\u0443\u0449\u0430\u0435\u0442\u0441\u044F \u0438\u043D\u0430\u0447\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 339362018078720
    m_Localized: "\u041D\u0435 \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0439\u0441\u044F,
      \u0434\u0432\u0438\u0433\u0430\u0439\u0441\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 340094578438144
    m_Localized: "\u0421\u0436\u0430\u0442\u0438\u0435 \u043F\u0440\u0435\u043A\u0440\u0430\u0442\u0438\u043B\u043E\u0441\u044C.
      \u0423\u0444... \u0432 \u0438\u0442\u043E\u0433\u0435 \u043C\u044B \u0432\u044B\u0436\u0438\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 340096402960384
    m_Localized: "\u041D\u043E \u0441 \u043F\u043E\u043B\u043E\u043C \u0447\u0442\u043E-\u0442\u043E
      \u043D\u0435 \u0442\u0430\u043A..."
    m_Metadata:
      m_Items: []
  - m_Id: 340097782886400
    m_Localized: "\u041E\u043D \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442 \u0440\u0443\u0448\u0438\u0442\u044C\u0441\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 335177390338048
    m_Localized: "\u041D\u0430\u0436\u0438\u043C\u0430\u0439 <b><color=#FFC400>\u043F\u0440\u043E\u0431\u0435\u043B</color></b>,
      \u043A\u043E\u0433\u0434\u0430 \u043D\u0430 \u043F\u043E\u043B\u0443 \u043F\u043E\u044F\u0432\u0438\u0442\u0441\u044F
      \u0442\u0432\u043E\u0439 \u0446\u0432\u0435\u0442."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
