  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: T.Stage.Quiz_en
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 96adcc13da5290147bc44fb643567e28, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 895241269248
    m_Localized: Food goes down the esophagus because of gravity.
    m_Metadata:
      m_Items: []
  - m_Id: 895262240768
    m_Localized: The esophagus pushes food down with muscle movements, so you can
      even swallow upside down.
    m_Metadata:
      m_Items: []
  - m_Id: 895262240769
    m_Localized: Digestion happens in the esophagus.
    m_Metadata:
      m_Items: []
  - m_Id: 895262240770
    m_Localized: The esophagus mainly moves food to the stomach.
    m_Metadata:
      m_Items: []
  - m_Id: 895262240771
    m_Localized: The esophagus is always open.
    m_Metadata:
      m_Items: []
  - m_Id: 895262240772
    m_Localized: It normally stays closed and only opens when food passes through.
    m_Metadata:
      m_Items: []
  - m_Id: 895262240773
    m_Localized: The esophagus only moves food downward.
    m_Metadata:
      m_Items: []
  - m_Id: 895262240774
    m_Localized: During vomiting, food can move upward instead.
    m_Metadata:
      m_Items: []
  - m_Id: 895262240775
    m_Localized: There is a muscle between the esophagus and stomach that helps stop
      acid reflux.
    m_Metadata:
      m_Items: []
  - m_Id: 895262240776
    m_Localized: The lower esophageal sphincter helps keep stomach acid from coming
      back up.
    m_Metadata:
      m_Items: []
  - m_Id: 895262240777
    m_Localized: Esophageal cancer is easy to detect early.
    m_Metadata:
      m_Items: []
  - m_Id: 895262240778
    m_Localized: It often has few symptoms at first, so it may be found late.
    m_Metadata:
      m_Items: []
  - m_Id: 895262240779
    m_Localized: Hiccups are caused by the esophagus.
    m_Metadata:
      m_Items: []
  - m_Id: 895262240780
    m_Localized: Hiccups happen when the diaphragm suddenly contracts.
    m_Metadata:
      m_Items: []
  - m_Id: 895262240781
    m_Localized: The esophagus can move even when there is no food inside.
    m_Metadata:
      m_Items: []
  - m_Id: 895262240782
    m_Localized: Small muscle movements can still happen in the esophagus.
    m_Metadata:
      m_Items: []
  - m_Id: 895262240783
    m_Localized: The esophagus can also move air.
    m_Metadata:
      m_Items: []
  - m_Id: 895262240784
    m_Localized: Air moves through the esophagus when you burp.
    m_Metadata:
      m_Items: []
  - m_Id: 895262240785
    m_Localized: Water can stay in the esophagus for a short time.
    m_Metadata:
      m_Items: []
  - m_Id: 895262240786
    m_Localized: Water also moves down through muscle movements.
    m_Metadata:
      m_Items: []
  - m_Id: 895262240787
    m_Localized: The esophagus controls when to open and close by itself.
    m_Metadata:
      m_Items: []
  - m_Id: 895262240788
    m_Localized: Its movements are automatically controlled by the nervous system.
    m_Metadata:
      m_Items: []
  - m_Id: 895262240789
    m_Localized: The esophagus gets ready to move just by smelling food.
    m_Metadata:
      m_Items: []
  - m_Id: 895262240790
    m_Localized: The brain activates the digestive system when it expects food.
    m_Metadata:
      m_Items: []
  - m_Id: 895262240791
    m_Localized: A pill can feel stuck in your throat even after it has gone down.
    m_Metadata:
      m_Items: []
  - m_Id: 895262240792
    m_Localized: Irritation in the esophagus can make your brain still feel something
      there.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
