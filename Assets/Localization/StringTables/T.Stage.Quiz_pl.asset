  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: T.Stage.Quiz_pl
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: pl
  m_SharedData: {fileID: 11400000, guid: 96adcc13da5290147bc44fb643567e28, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 895241269248
    m_Localized: "Jedzenie przechodzi przez prze\u0142yk dzi\u0119ki grawitacji."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240768
    m_Localized: "Prze\u0142yk przesuwa jedzenie ruchami mi\u0119\u015Bni, wi\u0119c
      mo\u017Cna prze\u0142yka\u0107 nawet do g\xF3ry nogami."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240769
    m_Localized: "Trawienie zachodzi w prze\u0142yku."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240770
    m_Localized: "Prze\u0142yk g\u0142\xF3wnie przenosi jedzenie do \u017Co\u0142\u0105dka."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240771
    m_Localized: "Prze\u0142yk jest zawsze otwarty."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240772
    m_Localized: "Zwykle jest zamkni\u0119ty i otwiera si\u0119 tylko, gdy przechodzi
      przez niego jedzenie."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240773
    m_Localized: "Prze\u0142yk przesuwa jedzenie tylko w d\xF3\u0142."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240774
    m_Localized: "Podczas wymiot\xF3w jedzenie mo\u017Ce przemieszcza\u0107 si\u0119
      do g\xF3ry."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240775
    m_Localized: "Mi\u0119dzy prze\u0142ykiem a \u017Co\u0142\u0105dkiem jest mi\u0119sie\u0144,
      kt\xF3ry pomaga zapobiega\u0107 refluksowi."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240776
    m_Localized: "Dolny zwieracz prze\u0142yku pomaga powstrzyma\u0107 kwas \u017Co\u0142\u0105dkowy
      przed powrotem do g\xF3ry."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240777
    m_Localized: "Rak prze\u0142yku \u0142atwo wykry\u0107 na wczesnym etapie."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240778
    m_Localized: "Na pocz\u0105tku ma zwykle niewiele objaw\xF3w, wi\u0119c bywa
      wykrywany p\xF3\u017Ano."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240779
    m_Localized: "Czkawka jest spowodowana przez prze\u0142yk."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240780
    m_Localized: "Czkawka pojawia si\u0119, gdy przepona nagle si\u0119 skurczy."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240781
    m_Localized: "Prze\u0142yk mo\u017Ce si\u0119 porusza\u0107, nawet gdy nie ma
      w nim jedzenia."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240782
    m_Localized: "W prze\u0142yku wci\u0105\u017C mog\u0105 zachodzi\u0107 niewielkie
      ruchy mi\u0119\u015Bni."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240783
    m_Localized: "Prze\u0142yk mo\u017Ce r\xF3wnie\u017C przenosi\u0107 powietrze."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240784
    m_Localized: "Podczas odbijania powietrze przechodzi przez prze\u0142yk."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240785
    m_Localized: "Woda mo\u017Ce na chwil\u0119 zatrzyma\u0107 si\u0119 w prze\u0142yku."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240786
    m_Localized: "Woda r\xF3wnie\u017C przesuwa si\u0119 w d\xF3\u0142 dzi\u0119ki
      ruchom mi\u0119\u015Bni."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240787
    m_Localized: "Prze\u0142yk sam kontroluje, kiedy si\u0119 otwiera\u0107 i zamyka\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240788
    m_Localized: "Jego ruchy s\u0105 automatycznie kontrolowane przez uk\u0142ad
      nerwowy."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240789
    m_Localized: "Prze\u0142yk zaczyna si\u0119 przygotowywa\u0107 do ruchu ju\u017C
      na sam zapach jedzenia."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240790
    m_Localized: "M\xF3zg aktywuje uk\u0142ad pokarmowy, gdy oczekuje jedzenia."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240791
    m_Localized: "Tabletka mo\u017Ce wydawa\u0107 si\u0119 utkwiona w gardle, nawet
      gdy ju\u017C zesz\u0142a ni\u017Cej."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240792
    m_Localized: "Podra\u017Cnienie prze\u0142yku mo\u017Ce sprawi\u0107, \u017Ce
      m\xF3zg wci\u0105\u017C czuje, \u017Ce co\u015B tam zosta\u0142o."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
