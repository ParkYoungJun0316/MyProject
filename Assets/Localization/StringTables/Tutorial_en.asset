  - m_Id: 10576884501426176
    m_Localized: Stop ({0:0.0}s)
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426177
    m_Localized: Record #1
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426178
    m_Localized: Record #2
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426179
    m_Localized: Play back
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426180
    m_Localized: Hear host
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426181
    m_Localized: The host hasn't recorded the team cheer yet
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426182
    m_Localized: Team cheer ready ({1:0.0}s)
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426183
    m_Localized: 'Recorded. Listen, then press [Confirm]'
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426184
    m_Localized: Listen to the host, then do [Record #1] the same way (0.5 s+ of
      sound)
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426185
    m_Localized: 'Once more, the same way: [Record #2]'
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426186
    m_Localized: Registered! Now try it at the practice sign
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426187
    m_Localized: The host re-recorded. Please register again
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426188
    m_Localized: No microphone input
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426189
    m_Localized: Too quiet. Shout louder
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426190
    m_Localized: Too loud. The sound is distorted
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426191
    m_Localized: Too short. Make a sound for at least 0.5 s
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426192
    m_Localized: Too long (max 3 s)
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426193
    m_Localized: Different number of breaks (host {0}, you {1})
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426194
    m_Localized: The pitch goes up and down differently
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426195
    m_Localized: Sounds different. Listen to the host again and copy it
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426196
    m_Localized: Doesn't match #1. Shout it the way you did for #1
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426197
    m_Localized: Nice!
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426198
    m_Localized: Team cheer set! Sent to your team
    m_Metadata:
      m_Items: []
