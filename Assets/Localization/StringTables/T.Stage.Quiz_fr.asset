  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: T.Stage.Quiz_fr
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: 96adcc13da5290147bc44fb643567e28, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 895241269248
    m_Localized: "La nourriture descend dans l'\u0153sophage gr\xE2ce \xE0 la gravit\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240768
    m_Localized: "L'\u0153sophage pousse la nourriture vers le bas gr\xE2ce \xE0
      des mouvements musculaires, donc on peut m\xEAme avaler la t\xEAte en bas."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240769
    m_Localized: "La digestion se produit dans l'\u0153sophage."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240770
    m_Localized: "L'\u0153sophage se contente surtout de transporter la nourriture
      vers l'estomac."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240771
    m_Localized: "L'\u0153sophage est toujours ouvert."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240772
    m_Localized: "Il reste normalement ferm\xE9 et ne s'ouvre que quand la nourriture
      y passe."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240773
    m_Localized: "L'\u0153sophage ne d\xE9place la nourriture que vers le bas."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240774
    m_Localized: Pendant les vomissements, la nourriture peut au contraire remonter.
    m_Metadata:
      m_Items: []
  - m_Id: 895262240775
    m_Localized: "Il y a un muscle entre l'\u0153sophage et l'estomac qui aide \xE0
      emp\xEAcher les reflux acides."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240776
    m_Localized: "Le sphincter \u0153sophagien inf\xE9rieur emp\xEAche l'acide gastrique
      de remonter."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240777
    m_Localized: "Le cancer de l'\u0153sophage est facile \xE0 d\xE9tecter t\xF4t."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240778
    m_Localized: "Il pr\xE9sente souvent peu de sympt\xF4mes au d\xE9but, donc il
      peut \xEAtre d\xE9couvert tard."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240779
    m_Localized: "Le hoquet est caus\xE9 par l'\u0153sophage."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240780
    m_Localized: Le hoquet survient quand le diaphragme se contracte soudainement.
    m_Metadata:
      m_Items: []
  - m_Id: 895262240781
    m_Localized: "L'\u0153sophage peut bouger m\xEAme quand il n'y a pas de nourriture
      \xE0 l'int\xE9rieur."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240782
    m_Localized: "De petits mouvements musculaires peuvent tout de m\xEAme se produire
      dans l'\u0153sophage."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240783
    m_Localized: "L'\u0153sophage peut aussi d\xE9placer de l'air."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240784
    m_Localized: "L'air passe par l'\u0153sophage quand on rote."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240785
    m_Localized: "L'eau peut rester un court instant dans l'\u0153sophage."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240786
    m_Localized: "L'eau descend aussi gr\xE2ce aux mouvements musculaires."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240787
    m_Localized: "L'\u0153sophage contr\xF4le lui-m\xEAme le moment o\xF9 il s'ouvre
      et se ferme."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240788
    m_Localized: "Ses mouvements sont contr\xF4l\xE9s automatiquement par le syst\xE8me
      nerveux."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240789
    m_Localized: "L'\u0153sophage se pr\xE9pare \xE0 bouger juste en sentant l'odeur
      de la nourriture."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240790
    m_Localized: "Le cerveau active le syst\xE8me digestif quand il anticipe l'arriv\xE9e
      de nourriture."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240791
    m_Localized: "Un comprim\xE9 peut sembler coinc\xE9 dans la gorge m\xEAme apr\xE8s
      avoir \xE9t\xE9 aval\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240792
    m_Localized: "Une irritation de l'\u0153sophage peut faire croire au cerveau
      qu'il reste quelque chose l\xE0."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
