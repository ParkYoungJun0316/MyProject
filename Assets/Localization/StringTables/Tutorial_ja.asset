    m_Localized: "\u30DB\u30B9\u30C8\u304C\u9332\u97F3\u3057\u76F4\u3057\u307E\u3057\u305F\u3002\u3082\u3046\u4E00\u5EA6\u767B\u9332\u3057\u3066\u304F\u3060\u3055\u3044"
