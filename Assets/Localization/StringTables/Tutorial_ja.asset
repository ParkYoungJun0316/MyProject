    m_Localized: "\u81EA\u5206\u306E\u540D\u524D\u3092\u53EB\u3076\u3068\u30D0\u30D5\u304C\u767A\u52D5\u3057\u307E\u3059\u3002\nE\u30AD\u30FC\u3067\u30CB\u30C3\u30AF\u30CD\u30FC\u30E0\u3092\u8A2D\u5B9A\u3057\u307E\u3057\u3087\u3046\u3002\n\u5FD8\u308C\u305A\u306B\u30C6\u30B9\u30C8\u3057\u3066\u307F\u3066\u304F\u3060\u3055\u3044\uFF01"
