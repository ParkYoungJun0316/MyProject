  - m_Id: 1091153926
    m_Localized: "\u5FDC\u63F4\u30CD\u30FC\u30E0\u306F\u82F1\u8A9E\u3067\u3057\u304B\u5165\u529B\u3067\u304D\u307E\u305B\u3093\u3002\n\u5B9F\u969B\u306B\u3088\u304F\u4F7F\u3046\u5358\u8A9E\u307B\u3069\u8A8D\u8B58\u3055\u308C\u3084\u3059\u3044\u3067\u3059\u3088\uFF01\n\u30DE\u30A4\u30AF\u304C\u306A\u3044\u3001\u307E\u305F\u306F\u8A8D\u8B58\u3055\u308C\u306A\u3044\u5834\u5408\u306FESC\u30E1\u30CB\u30E5\u30FC\u304B\u3089\u6570\u5B57\u30AD\u30FC\u5FDC\u63F4\u3092\u30AA\u30F3\u306B\u3057\u307E\u3057\u3087\u3046\u3002\n\uFF081\u304C\u500B\u4EBA\u5FDC\u63F4\u30012\u304C\u30C1\u30FC\u30E0\u5FDC\u63F4\u3067\u3059\u3002\u3067\u3082\u58F0\u3067\u5FDC\u63F4\u3059\u308B\u65B9\u304C\u65AD\u7136\u697D\u3057\u3044\u3067\u3059\u3088\uFF01\uFF09"
