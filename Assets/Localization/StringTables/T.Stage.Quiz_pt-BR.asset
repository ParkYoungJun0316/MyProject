  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: T.Stage.Quiz_pt-BR
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: pt-BR
  m_SharedData: {fileID: 11400000, guid: 96adcc13da5290147bc44fb643567e28, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 895241269248
    m_Localized: "A comida desce pelo es\xF4fago por causa da gravidade."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240768
    m_Localized: "O es\xF4fago empurra a comida para baixo com movimentos musculares,
      ent\xE3o \xE9 poss\xEDvel engolir at\xE9 de cabe\xE7a para baixo."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240769
    m_Localized: "A digest\xE3o acontece no es\xF4fago."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240770
    m_Localized: "O es\xF4fago serve principalmente para levar a comida at\xE9 o
      est\xF4mago."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240771
    m_Localized: "O es\xF4fago est\xE1 sempre aberto."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240772
    m_Localized: "Normalmente ele fica fechado e s\xF3 abre quando a comida passa."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240773
    m_Localized: "O es\xF4fago s\xF3 move a comida para baixo."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240774
    m_Localized: "Durante o v\xF4mito, a comida pode se mover para cima."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240775
    m_Localized: "Entre o es\xF4fago e o est\xF4mago existe um m\xFAsculo que ajuda
      a evitar o refluxo \xE1cido."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240776
    m_Localized: "O esf\xEDncter esof\xE1gico inferior ajuda a impedir que o \xE1cido
      do est\xF4mago volte a subir."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240777
    m_Localized: "O c\xE2ncer de es\xF4fago \xE9 f\xE1cil de detectar no in\xEDcio."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240778
    m_Localized: "No in\xEDcio costuma ter poucos sintomas, ent\xE3o pode ser descoberto
      tarde."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240779
    m_Localized: "O solu\xE7o \xE9 causado pelo es\xF4fago."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240780
    m_Localized: "O solu\xE7o acontece quando o diafragma se contrai de repente."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240781
    m_Localized: "O es\xF4fago pode se movimentar mesmo sem comida dentro dele."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240782
    m_Localized: "Pequenos movimentos musculares ainda podem ocorrer no es\xF4fago."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240783
    m_Localized: "O es\xF4fago tamb\xE9m consegue mover ar."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240784
    m_Localized: "O ar passa pelo es\xF4fago quando voc\xEA arrota."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240785
    m_Localized: "A \xE1gua pode ficar um pouco no es\xF4fago."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240786
    m_Localized: "A \xE1gua tamb\xE9m desce por meio de movimentos musculares."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240787
    m_Localized: "O es\xF4fago controla por conta pr\xF3pria quando abrir e fechar."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240788
    m_Localized: "Os movimentos dele s\xE3o controlados automaticamente pelo sistema
      nervoso."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240789
    m_Localized: "O es\xF4fago j\xE1 se prepara para se movimentar s\xF3 com o cheiro
      da comida."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240790
    m_Localized: "O c\xE9rebro ativa o sistema digestivo quando espera que a comida
      chegue."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240791
    m_Localized: "Um comprimido pode parecer que ficou preso na garganta mesmo depois
      de j\xE1 ter descido."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240792
    m_Localized: "A irrita\xE7\xE3o no es\xF4fago pode fazer seu c\xE9rebro continuar
      sentindo que h\xE1 algo ali."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
