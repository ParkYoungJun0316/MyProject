  m_TableData:
  - m_Id: 1141485568
    m_Localized: "\u2022 \u4E00\u6B21\u53EA\u6703\u5347\u8D77\u4E00\u7A2E\u984F\u8272\u7684\u5634\u3002\n\u2022
      \u9ED1\u767D\u8E0F\u677F\u8AB0\u90FD\u80FD\u7528\uFF0C\u5C0D\u597D\u984F\u8272\u5C31\u884C\u3002\n\u2022
      \u9802\u90E8\u51FA\u73FE\u300CTEAMCHEER\u300D\u6642\uFF0C\u558A\u51FA\u5718\u968A\u95DC\u9375\u8A5E\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1183428608
    m_Localized: "\u2022 \u6BCF\u500B\u5340\u57DF\u7684\u4EBA\u6578\u8981\u548C\u724C\u5B50\u4E0B\u7684
      KKUL-TTEOK \u6578\u91CF\u4E00\u6A23\uFF0C\u4E0D\u591A\u4E0D\u5C11\u3002\n\u2022
      \u6BCF\u500B\u4EBA\u770B\u5230\u7684\u90FD\u4E0D\u4E00\u6A23\uFF0C\u628A\u4F60\u770B\u5230\u7684\u8AAA\u51FA\u4F86\uFF01\n\u2022
      \u9802\u90E8\u51FA\u73FE\u300CTEAMCHEER\u300D\u6642\uFF0C\u558A\u51FA\u5718\u968A\u95DC\u9375\u8A5E\u3002\n\u2022
      \u9632\u79A6\u589E\u76CA\u4E5F\u80FD\u64CB\u4E0B\u56DE\u5408\u5931\u6557\u7684\u50B7\u5BB3\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622912
    m_Localized: "\u2022 \u6309 Ctrl \u628A\u4F60\u7684\u984F\u8272\u63DB\u6210\u9ED1\u767D\u5730\u677F\u7684\u984F\u8272\uFF0C\u907F\u514D\u88AB\u7784\u6E96\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622913
    m_Localized: "\u2022 \u5728\u65B9\u584A\u4E0A\u7AD9 2 \u79D2\u5F97\u5206\u3002\n\u2022
      \u5F69\u8272\u65B9\u584A\u53EA\u7B97\u5C0D\u61C9\u984F\u8272\u7684\u4EBA\uFF0C\u9ED1\u767D\u65B9\u584A\u8AB0\u90FD\u7B97\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622914
    m_Localized: "\u2022 \u4EAE\u8D77\u81EA\u5DF1\u7684\u984F\u8272\u6642\u6309 Space\u3002\n\u2022
      \u767D\u8272\u8AB0\u90FD\u53EF\u4EE5\u6309\u3002\u9ED1\u8272 1 \u79D2\u5F8C\u6703\u81EA\u52D5\u9032\u5165\u4E0B\u4E00\u8F2A\u3002\n\u2022
      \u5C0F\u904A\u6232\u9032\u884C\u4E2D\u4E0D\u80FD\u7528 Space \u589E\u76CA\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622915
    m_Localized: "\u2022 \u53EA\u80FD\u770B\u5230\u524D\u9762\u4E00\u683C\u3002\n\u2022
      \u8A18\u4F4F\u8981\u6309\u54EA\u4E00\u683C\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622916
    m_Localized: "\u2022 \u6309 Ctrl \u628A\u4F60\u7684\u984F\u8272\u63DB\u6210\u5730\u677F\u7684\u984F\u8272\uFF0C\u907F\u514D\u88AB\u7784\u6E96\u3002\n\u2022
      \u300CTEAMCHEER\u300D\u51FA\u73FE\u6642\u558A\u51FA\u5718\u968A\u95DC\u9375\u8A5E\uFF0C\u5C31\u80FD\u4FEE\u597D\u5730\u677F\u3002\n\u2022
      \u5982\u679C\u5DF2\u7D93\u788E\u4E86\uFF0C\u5C31\u6490\u5230\u4E0B\u4E00\u6B21\u8B66\u544A\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622917
    m_Localized: "\u2022 \u51FA\u73FE\u4F60\u984F\u8272\u7684\u683C\u5B50\u5C31\u7AD9\u4E0A\u53BB\u3002\n\u2022
      \u6C92\u6709\u7684\u8A71\uFF0C\u5C31\u7AD9\u5728\u9ED1\u8272\u6216\u767D\u8272\u683C\u5B50\u4E0A\u6490\u4F4F\u3002\n\u2022
      \u89D2\u8272\u984F\u8272\u4E5F\u8981\u5C0D\u4E0A\u5730\u677F\u3002\n\u2022
      \u9632\u79A6\u589E\u76CA\u4E5F\u80FD\u64CB\u4E0B\u56DE\u5408\u5931\u6557\u7684\u50B7\u5BB3\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622918
    m_Localized: "\u2022 \u649E\u5411\u548C\u4F60\u984F\u8272\u76F8\u540C\u7684\u7246\u3002"
