  m_TableData:
  - m_Id: 1141485568
    m_Localized: "\u2022 \u6BCF\u6B21\u53EA\u6703\u5347\u8D77\u4E00\u7A2E\u984F\u8272\u7684\u5634\u5DF4\u3002\n\u2022
      \u53EA\u8981\u5C07\u81EA\u5DF1\u7684\u984F\u8272\u8207\u9ED1\u8272\u6216\u767D\u8272\u7684\u8E0F\u677F\u5339\u914D\uFF0C\u4EFB\u4F55\u4EBA\u90FD\u53EF\u4EE5\u4F7F\u7528\u3002\n\u2022
      \u7576\u9802\u90E8\u51FA\u73FE\u300CTEAMCHEER\u300D\u6642\uFF0C\u5927\u8072\u558A\u51FA\u4F60\u7684\u5718\u968A\u53E3\u4EE4\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1183428608
    m_Localized: "\u2022 \u6BCF\u500B\u5340\u57DF\u7684\u4EBA\u6578\u5FC5\u9808\u8207\u6A19\u8A8C\u4E0B\u65B9\u7684KKUL-TTEOK\u6578\u91CF\u5B8C\u5168\u4E00\u81F4\uFF0C\u4E0D\u80FD\u591A\uFF0C\u4E5F\u4E0D\u80FD\u5C11\u3002\n\u2022
      \u6BCF\u500B\u4EBA\u770B\u5230\u7684\u6771\u897F\u90FD\u4E0D\u4E00\u6A23\u3002\u5206\u4EAB\u4F60\u770B\u5230\u7684\u5167\u5BB9\uFF01\n\u2022
      \u7576\u9802\u90E8\u51FA\u73FE\u300CTEAMCHEER\u300D\u6642\uFF0C\u5927\u8072\u558A\u51FA\u4F60\u7684\u5718\u968A\u53E3\u4EE4\u3002\n\u2022
      \u9632\u79A6\u589E\u76CA\u4E5F\u53EF\u4EE5\u62B5\u64CB\u672C\u56DE\u5408\u5931\u6557\u6642\u53D7\u5230\u7684\u50B7\u5BB3\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622912
    m_Localized: "\u2022 \u6309\u4E0BCtrl\uFF0C\u8B93\u81EA\u5DF1\u7684\u984F\u8272\u8207\u9ED1\u8272\u6216\u767D\u8272\u5730\u677F\u5339\u914D\uFF0C\u907F\u514D\u6210\u70BA\u653B\u64CA\u76EE\u6A19\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622913
    m_Localized: "\u2022 \u5728\u4E00\u500B\u65B9\u584A\u4E0A\u7AD9\u6EFF2\u79D2\u5373\u53EF\u5F97\u5206\u3002\n\u2022
      \u5F69\u8272\u65B9\u584A\u53EA\u6709\u5C0D\u61C9\u984F\u8272\u7684\u73A9\u5BB6\u53EF\u4EE5\u8A08\u5206\u3002\u9ED1\u8272\u548C\u767D\u8272\u65B9\u584A\u4EFB\u4F55\u4EBA\u90FD\u53EF\u4EE5\u8A08\u5206\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622914
    m_Localized: "\u2022 \u7576\u4F60\u7684\u984F\u8272\u4EAE\u8D77\u6642\u6309\u4E0BSpace\u3002\n\u2022
      \u767D\u8272\u4EFB\u4F55\u4EBA\u90FD\u53EF\u4EE5\u64CA\u6253\u3002\u9ED1\u8272\u57281\u79D2\u5F8C\u6703\u81EA\u52D5\u9032\u5165\u4E0B\u4E00\u56DE\u5408\u3002\n\u2022
      \u5728\u9019\u500B\u5C0F\u904A\u6232\u4E2D\u7121\u6CD5\u4F7F\u7528Space\u589E\u76CA\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622915
    m_Localized: "\u2022 \u4F60\u53EA\u80FD\u770B\u5230\u524D\u65B9\u4E00\u500B\u65B9\u584A\u3002\n\u2022
      \u8A18\u4F4F\u8981\u6309\u4E0B\u54EA\u500B\u65B9\u584A\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622916
    m_Localized: "\u2022 \u6309\u4E0BCtrl\uFF0C\u8B93\u81EA\u5DF1\u7684\u984F\u8272\u8207\u5730\u677F\u5339\u914D\uFF0C\u907F\u514D\u6210\u70BA\u653B\u64CA\u76EE\u6A19\u3002\n\u2022
      \u300CTEAMCHEER\u300D\u51FA\u73FE\u6642\uFF0C\u558A\u51FA\u4F60\u7684\u5718\u968A\u53E3\u4EE4\u4F86\u4FEE\u5FA9\u5730\u677F\u3002\n\u2022
      \u5982\u679C\u5730\u677F\u5DF2\u7D93\u640D\u58DE\uFF0C\u5C31\u6490\u5230\u4E0B\u4E00\u6B21\u8B66\u544A\u51FA\u73FE\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622917
    m_Localized: "\u2022 \u5982\u679C\u51FA\u73FE\u8207\u4F60\u984F\u8272\u76F8\u540C\u7684\u65B9\u584A\uFF0C\u5C31\u7AD9\u4E0A\u53BB\u3002\n\u2022
      \u5982\u679C\u6C92\u6709\uFF0C\u5C31\u7AD9\u5728\u9ED1\u8272\u6216\u767D\u8272\u65B9\u584A\u4E0A\u6490\u4E0B\u53BB\u3002\n\u2022
      \u89D2\u8272\u7684\u984F\u8272\u4E5F\u8981\u8207\u5730\u677F\u5339\u914D\u3002\n\u2022
      \u9632\u79A6\u589E\u76CA\u4E5F\u53EF\u4EE5\u62B5\u64CB\u672C\u56DE\u5408\u5931\u6557\u6642\u53D7\u5230\u7684\u50B7\u5BB3\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622918
    m_Localized: "\u2022 \u649E\u5411\u8207\u4F60\u984F\u8272\u76F8\u540C\u7684\u7246\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622919
    m_Localized: "\u2022 \u8A18\u4F4F\u8DEF\u7DDA\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622920
    m_Localized: "\u2022 \u53EA\u80FD\u8E29\u8207\u4F60\u984F\u8272\u76F8\u540C\u7684\u65B9\u584A\u3002\n\u2022
      \u8B93\u89D2\u8272\u7684\u984F\u8272\u8207\u65B9\u584A\u5339\u914D\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622921
    m_Localized: "\u2022 \u8207\u5340\u57DF\u984F\u8272\u76F8\u540C\u7684\u73A9\u5BB6\u5148\u901A\u904E\uFF0C\u7136\u5F8C\u5176\u4ED6\u4EBA\u8DDF\u4E0A\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622922
    m_Localized: "\u2022 \u5728\u6A19\u8A8C\u4E0A\u7684\u8A08\u6642\u5668\u7D50\u675F\u524D\u6E05\u9664\u6BCF\u500B\u5340\u57DF\uFF0C\u5426\u5247\u80C3\u9178\u6703\u704C\u6EFF\u8A72\u5340\u57DF\u3002\n\u2022
      \u5339\u914D\u5169\u5074\u7246\u58C1\u7684\u984F\u8272\u4E26\u649E\u64CA\u5B83\u5011\uFF0C\u628A\u7246\u63A8\u56DE\u53BB\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622923
    m_Localized: "\u2022 \u6BCF\u500B\u65B9\u584A\u53EA\u80FD\u7AD9\u4E00\u540D\u73A9\u5BB6\u3002\u4EBA\u6578\u8D85\u904E\u5C31\u6703\u4E0B\u6C89\u3002\n\u2022
      \u6709\u4E9B\u65B9\u584A\u53EF\u4EE5\u88AB\u7834\u58DE\u3002\n\u2022 \u78B0\u5230\u524D\u5F8C\u7246\u6216\u816B\u8D77\u7684\u90E8\u4F4D\u6703\u88AB\u5F48\u958B\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622924
    m_Localized: "\u2022 \u4E00\u540D\u73A9\u5BB6\u7A7F\u904E\u8FF7\u5BAE\uFF0C\u5176\u4ED6\u73A9\u5BB6\u5F9E\u4E8C\u6A13\u8CA0\u8CAC\u6307\u5F15\u8DEF\u7DDA\u3002\n\u2022
      \u8E29\u4E0B\u8E0F\u677F\u5F8C\uFF0C\u53EA\u6709\u5C0D\u61C9\u984F\u8272\u7684\u9580\u6703\u6253\u958B\uFF0C\u5176\u9918\u6240\u6709\u9580\u90FD\u6703\u95DC\u9589\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622926
    m_Localized: "\u2022 \u5230\u9054\u7D42\u9EDE\u3002\n\n\u2022 \u5728\u7CD6\u679C\u843D\u5730\u524D\u5B8C\u6210\u9019\u4E00\u90E8\u5206\u3002"
