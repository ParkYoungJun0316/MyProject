  m_TableData:
  - m_Id: 1141485568
    m_Localized: "\u2022 \u4E00\u6B21\u53EA\u6703\u5347\u8D77\u4E00\u7A2E\u984F\u8272\u7684\u5634\u3002\n\u2022
      \u9ED1\u767D\u8E0F\u677F\u8AB0\u90FD\u53EF\u4EE5\u5C0D\u597D\u984F\u8272\u518D\u8E29\u3002\n\u2022
      \u9802\u90E8\u51FA\u73FE\u300CTEAMCHEER\u300D\u6642\uFF0C\u558A\u51FA\u5718\u968A\u95DC\u9375\u8A5E\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1183428608
    m_Localized: "\u2022 \u6307\u5B9A\u984F\u8272\u5FC5\u9808\u9032\u5165\u90A3\u500B\u5340\u57DF\u3002\n\u2022
      \u9802\u90E8\u51FA\u73FE\u300CTEAMCHEER\u300D\u6642\uFF0C\u558A\u51FA\u5718\u968A\u95DC\u9375\u8A5E\u3002\n\u2022
      \u9632\u79A6\u589E\u76CA\u4E5F\u80FD\u64CB\u4E0B\u56DE\u5408\u5931\u6557\u7684\u50B7\u5BB3\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622912
    m_Localized: "\u2022 \u6309 Ctrl\uFF0C\u628A\u89D2\u8272\u984F\u8272\u5C0D\u6210\u5730\u677F\u7684\u9ED1\u6216\u767D\uFF0C\u7529\u6389\u9396\u5B9A\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622913
    m_Localized: "\u2022 \u5728\u683C\u5B50\u4E0A\u7AD9\u6EFF 2 \u79D2\u624D\u52A0\u5206\u3002\n\u2022
      \u5C08\u5C6C\u8272\u683C\u5B50\u53EA\u6709\u8A72\u984F\u8272\u80FD\u8E29\uFF0C\u9ED1\u767D\u8AB0\u90FD\u53EF\u4EE5\u8E29\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622914
    m_Localized: "\u2022 \u4EAE\u8D77\u81EA\u5DF1\u7684\u984F\u8272\u6642\u6309 Space\u3002\n\u2022
      \u767D\u8272\u8AB0\u90FD\u53EF\u4EE5\u6309\u3002\u9ED1\u8272 1 \u79D2\u5F8C\u6703\u81EA\u52D5\u9032\u5165\u4E0B\u4E00\u8F2A\u3002\n\u2022
      \u5C0F\u904A\u6232\u9032\u884C\u4E2D\u4E0D\u80FD\u7528 Space \u589E\u76CA\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622915
    m_Localized: "\u2022 \u53EA\u80FD\u770B\u5230\u524D\u9762\u4E00\u683C\u3002\n\u2022
      \u8981\u6309\u7684\u683C\u5B50\u8ACB\u5148\u8A18\u4F4F\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622916
    m_Localized: "\u2022 \u6309 Ctrl\uFF0C\u628A\u89D2\u8272\u984F\u8272\u5C0D\u6210\u5730\u677F\u984F\u8272\uFF0C\u7529\u6389\u9396\u5B9A\u3002\n\u2022
      \u300CTEAMCHEER\u300D\u51FA\u73FE\u6642\u558A\u51FA\u5718\u968A\u95DC\u9375\u8A5E\uFF0C\u5730\u677F\u5C31\u6703\u4FEE\u597D\u3002\n\u2022
      \u5DF2\u7D93\u788E\u4E86\u7684\u8A71\uFF0C\u6490\u5230\u4E0B\u4E00\u6B21\u8B66\u544A\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622917
    m_Localized: "\u2022 \u51FA\u73FE\u5C08\u5C6C\u8272\u683C\u5B50\u6642\uFF0C\u5FC5\u9808\u7AD9\u4E0A\u53BB\u3002\n\u2022
      \u6C92\u6709\u5C08\u5C6C\u8272\u5C31\u7AD9\u5728\u9ED1\u767D\u683C\u5B50\u4E0A\u6490\u4F4F\u3002\n\u2022
      \u89D2\u8272\u984F\u8272\u4E5F\u8981\u5C0D\u4E0A\u5730\u677F\u3002\n\u2022
      \u9632\u79A6\u589E\u76CA\u4E5F\u80FD\u64CB\u4E0B\u56DE\u5408\u5931\u6557\u7684\u50B7\u5BB3\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622918
    m_Localized: "\u2022 \u649E\u4E0A\u4EAE\u8457\u81EA\u5DF1\u984F\u8272\u7684\u5169\u5074\u7246\u58C1\uFF0C\u7246\u5C31\u6703\u5F80\u5F8C\u9000\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622919
    m_Localized: "\u2022 \u628A\u8DEF\u8A18\u4E0B\u4F86\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622920
    m_Localized: "\u2022 \u53EA\u8E29\u81EA\u5DF1\u984F\u8272\u7684\u683C\u5B50\u3002\n\u2022
      \u683C\u5B50\u984F\u8272\u5C0D\u4E86\uFF0C\u89D2\u8272\u537B\u662F\u9ED1\u767D\u4E5F\u4E0D\u884C\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622921
    m_Localized: "\u2022 \u8CA0\u8CAC\u7684\u984F\u8272\u5148\u904E\u53BB\uFF0C\u5176\u4ED6\u968A\u54E1\u624D\u80FD\u8E29\u90A3\u584A\u5730\u677F\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622922
    m_Localized: "\u2022 \u5C0D\u597D\u5169\u5074\u7246\u58C1\u7684\u984F\u8272\u518D\u649E\u4E0A\u53BB\uFF0C\u7246\u5C31\u6703\u5F80\u5F8C\u9000\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622923
    m_Localized: "\u2022 \u78B0\u5230\u524D\u5F8C\u7684\u7246\u6216\u816B\u584A\u6703\u88AB\u5F48\u958B\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622924
    m_Localized: "\u2022 \u4E00\u540D\u5954\u8DD1\u8005\u5728\u8FF7\u5BAE\u4E2D\u5954\u8DD1\uFF0C\u5176\u4ED6\u4EBA\u5728\u4E8C\u6A13\u6307\u8DEF\u3002\n\u2022
      \u8E29\u4E0B\u8E0F\u677F\u5F8C\uFF0C\u53EA\u6709\u8A72\u984F\u8272\u7684\u9580\u6703\u6253\u958B\uFF0C\u5176\u9918\u5168\u90E8\u95DC\u9589\u3002\n\u2022
      \u5C08\u5C6C\u984F\u8272\u7684\u8E0F\u677F\u53EA\u6709\u8A72\u984F\u8272\u7684\u73A9\u5BB6\u80FD\u8E29\uFF0C\u9ED1\u767D\u8E0F\u677F\u4EFB\u4F55\u4EBA\u90FD\u80FD\u8E29\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622926
    m_Localized: "\u2022 \u6307\u5B9A\u984F\u8272\u958B\u8DEF\u5F8C\uFF0C\u5230\u9054\u7D42\u9EDE\u3002\n\n\u2022
      \u5728\u7CD6\u679C\u843D\u5230\u5730\u4E0A\u4E4B\u524D\uFF0C\u6E05\u6389\u9019\u4E00\u6BB5\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622927
    m_Localized: "\u2022 \u8E29\u8E0F\u677F\u958B\u8DEF\uFF0C\u5230\u9054\u7D42\u9EDE\u3002\n\n\u2022
