%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogue_pt-BR
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: pt-BR
  m_SharedData: {fileID: 11400000, guid: 043bf15b2a6a41c48971e11c678f419c, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 472199573504
    m_Localized: "Com tanta fruta gostosa, por que voc\xEA foi me comer?!"
    m_Metadata:
      m_Items: []
  - m_Id: 334352332992512
    m_Localized: "V\xE3o aparecer blocos coloridos no ch\xE3o.\nFique 2 segundos
      em cima de um pra marcar ponto."
    m_Metadata:
      m_Items: []
  - m_Id: 334425666203648
    m_Localized: "Os blocos brancos e pretos valem pra qualquer um, mas os coloridos
      s\xF3 contam pra aquela cor.\nN\xE3o atrapalhem uns aos outros e sejam r\xE1pidos!"
    m_Metadata:
      m_Items: []
  - m_Id: 335182629023744
    m_Localized: "Tem alguma coisa se mexendo debaixo da gente\u2026 cuidado!\nL\xE1
      vem a l\xEDngua!"
    m_Metadata:
      m_Items: []
  - m_Id: 335185439207424
    m_Localized: "A l\xEDngua vai quebrar a plataforma do meio e bloquear o caminho.\nGritem
      o grito da equipe juntos que ela desce de novo \u2014 e o caminho quebrado
      volta tamb\xE9m."
    m_Metadata:
      m_Items: []
  - m_Id: 335887280484352
    m_Localized: "Ele t\xE1 malhando ou o qu\xEA? A respira\xE7\xE3o dele ficou pesada
      do nada!"
    m_Metadata:
      m_Items: []
  - m_Id: 335890795311104
    m_Localized: "Ufa\u2026 ufa\u2026 s\xF3 mais um pouco e talvez a gente saia vivo
      daqui\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 337052009345024
    m_Localized: "\u2026Ficou tudo quieto aqui dentro.\nSer\xE1 que finalmente d\xE1
      pra escapar\u2026?"
    m_Metadata:
      m_Items: []
  - m_Id: 337056501444608
    m_Localized: "\u2026(CRAC!)"
    m_Metadata:
      m_Items: []
  - m_Id: 337060553142272
    m_Localized: "Ah, n\xE3o, a gente t\xE1 sendo engolido\u2026!!"
    m_Metadata:
      m_Items: []
  - m_Id: 337070598500352
    m_Localized: "A gente foi engolido\u2026 agora estamos no es\xF4fago.\nN\xE3o
      tem jeito \u2014 temos que descer e achar uma sa\xEDda."
    m_Metadata:
      m_Items: []
  - m_Id: 337897539088384
    m_Localized: "O es\xF4fago vai apertar a gente.\nQuando o aviso aparecer, gritem
      juntos o grito da equipe pra impedir!"
    m_Metadata:
      m_Items: []
  - m_Id: 337902496755712
    m_Localized: "Paredes coloridas v\xE3o vir dos dois lados.\nSe uma parede mostrar
      a minha cor, pode trombar com tudo \u2014 isso empurra ela pra tr\xE1s."
    m_Metadata:
      m_Items: []
  - m_Id: 337904153505792
    m_Localized: "Acho que t\xE1 acumulando g\xE1s no es\xF4fago\u2026\nSe ficar
      t\xE3o denso que n\xE3o d\xE1 pra ver, gritem o grito da equipe pra dissipar!"
    m_Metadata:
      m_Items: []
  - m_Id: 337904874926080
    m_Localized: "Lembre a minha cor e v\xE1 pelos blocos que combinam com ela!"
    m_Metadata:
      m_Items: []
  - m_Id: 337906154188800
    m_Localized: "A cor da \xE1rea tem que ir primeiro, a\xED o caminho fica seguro.
      Nada de furar fila!"
    m_Metadata:
      m_Items: []
  - m_Id: 337906812694528
    m_Localized: "O es\xF4fago se contorceu do nada e bloqueou a passagem!"
    m_Metadata:
      m_Items: []
  - m_Id: 337907517337600
    m_Localized: "Um de n\xF3s corre l\xE1 embaixo. O resto, pise nas placas coloridas
      pra abrir as portas!"
    m_Metadata:
      m_Items: []
  - m_Id: 339357207212032
    m_Localized: "Aqui \xE9 o fim do es\xF4fago\u2026\nL\xE1 embaixo deve estar cheio
      de suco g\xE1strico. Descer sem se preparar \xE9 perigoso."
    m_Metadata:
      m_Items: []
  - m_Id: 339360646541312
    m_Localized: "Aquele doce de antes t\xE1 caindo do teto.\nA gente tem que parar
      ele antes de chegar no ch\xE3o!"
    m_Metadata:
      m_Items: []
  - m_Id: 340094578438144
    m_Localized: "Ufa\u2026 foi por pouco\u2026\nAgora vamos pensar em como descer
      com seguran\xE7a."
    m_Metadata:
      m_Items: []
  - m_Id: 340096402960384
    m_Localized: "Glup\u2026 glup\u2026\nEle engasgou e come\xE7ou a beber \xE1gua!
      O doce t\xE1 descendo!"
    m_Metadata:
      m_Items: []
  - m_Id: 335177390338048
    m_Localized: "Quando a sua cor aparecer no ch\xE3o, aperte <color=#FFD24D><b>Space</b></color>.\nBranco
      qualquer um pode apertar, mas preto nem pensar!\nO preto passa sozinho pro
      pr\xF3ximo turno depois de 1 segundo."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000001
    m_Localized: "De agora em diante, s\xF3 pensem em sobreviver."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000002
    m_Localized: 'Guardem bem onde ficam as bocas coloridas em volta.

      Pisou
      na placa, a boca daquela cor sobe e quebra os dentes.'
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000003
    m_Localized: "S\xF3 sobe uma cor por vez.\nN\xE3o adianta todo mundo pisar junto."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000004
    m_Localized: "Quando a boca gigante come\xE7ar a fechar, todo mundo grita o grito
      da equipe!\nSen\xE3o, vai ficar tudo escuro."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000005
    m_Localized: "Cada \xE1rea precisa ter a mesma quantidade de gente que de KKUL-TTEOK!
      Cada um s\xF3 v\xEA os da pr\xF3pria placa, ent\xE3o avisem!"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000006
    m_Localized: "Ser\xE1 que ele comeu algo apimentado antes de me comer\u2026?\nN\xE3o
      para de brotar baba do ch\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000007
    m_Localized: "Com tanta baba, o ch\xE3o vai ficar escorregadio.\nSe a gente gritar
      o grito da equipe junto, d\xE1 pra limpar!"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000008
    m_Localized: "Agora t\xE1 pingando de cima tamb\xE9m!\nEle deve ter comido algo
      apimentado e azedo."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000009
    m_Localized: "Algumas gotas est\xE3o mirando em mim!\nIguale minha cor \xE0 do
      ch\xE3o com <color=#FFD24D><b>Ctrl</b></color> e elas me perdem de vista."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000010
    m_Localized: "De agora em diante, voc\xEA s\xF3 vai ver um bloco \xE0 frente.\nGrave
      bem!"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000011
    m_Localized: "Aqui tamb\xE9m tem algo mirando em mim!\nIguale minha cor \xE0
      do ch\xE3o com <color=#FFD24D><b>Ctrl</b></color> e ele me perde de vista."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000012
    m_Localized: "Dessa vez a l\xEDngua vai destruir o lado esquerdo ou direito inteiro
      do ch\xE3o.\nGritem o grito da equipe pra impedir \u2014 sen\xE3o, vai quebrar."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000013
    m_Localized: "O ch\xE3o s\xF3 volta se voc\xEAs gritarem o grito da equipe enquanto
      o aviso estiver na tela.\nSe j\xE1 quebrou, vai ter que aguentar at\xE9 o pr\xF3ximo
      aviso."
    m_Metadata:
      m_Items: []
  - m_Id: 12337130970394624
    m_Localized: "Isso rolando atr\xE1s da gente \xE9 um doce?! Corram se n\xE3o
      quiserem virar panqueca!"
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531969
    m_Localized: "Parece refluxo\u2026 o suco g\xE1strico t\xE1 subindo!\nSe a gente
      n\xE3o passar cada trecho antes do tempo da placa acabar, vamos acabar nadando
      nele!"
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531972
    m_Localized: "Deve ser uma rea\xE7\xE3o al\xE9rgica\u2026 o es\xF4fago t\xE1
      todo inchado."
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531973
    m_Localized: "S\xF3 abrem as portas de uma cor por vez. Tem alguma coisa atr\xE1s
      da gente, corram!"
    m_Metadata:
      m_Items: []
  - m_Id: 13504475839442944
    m_Localized: "V\xE3o acender blocos coloridos no ch\xE3o.\nSe a sua cor aparecer,
      fique s\xF3 naquele bloco.\nSe n\xE3o aparecer, aguente no preto ou no branco
      \u2014 o que combinar com voc\xEA!"
    m_Metadata:
      m_Items: []
  - m_Id: 17908244660465664
    m_Localized: "Ficou t\xE3o sens\xEDvel que s\xF3 cabe um de n\xF3s por bloco.\nAlguns
      blocos quebram f\xE1cil, ent\xE3o reajam r\xE1pido!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
