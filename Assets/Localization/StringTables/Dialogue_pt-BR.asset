%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogue_pt-BR
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: pt-BR
  m_SharedData: {fileID: 11400000, guid: 043bf15b2a6a41c48971e11c678f419c, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 472199573504
    m_Localized: "Por que voc\xEA comeu um KKUL-TTEOK e deixou passar todas aquelas
      frutas e guloseimas gostosas?!"
    m_Metadata:
      m_Items: []
  - m_Id: 334352332992512
    m_Localized: "V\xE3o aparecer blocos coloridos no ch\xE3o.\nFique 2 segundos
      em cima e a pontua\xE7\xE3o sobe."
    m_Metadata:
      m_Items: []
  - m_Id: 334425666203648
    m_Localized: "Blocos brancos ou pretos qualquer um pode pisar, mas os de cor
      \xFAnica s\xF3 somam ponto se for daquela cor.\nN\xE3o bloqueia o caminho,
      se mexe r\xE1pido!"
    m_Metadata:
      m_Items: []
  - m_Id: 335182629023744
    m_Localized: "Tem algo se mexendo debaixo dos nossos p\xE9s... cuidado!\nVem
      um ataque de l\xEDngua!"
    m_Metadata:
      m_Items: []
  - m_Id: 335185439207424
    m_Localized: "A l\xEDngua vai destruir a plataforma do centro e bloquear o caminho.\nGritem
      todos juntos o grito do time pra ela descer de novo e o caminho quebrado se
      consertar."
    m_Metadata:
      m_Items: []
  - m_Id: 335887280484352
    m_Localized: "Parece que t\xE1 se exercitando! A respira\xE7\xE3o ficou pesada
      do nada."
    m_Metadata:
      m_Items: []
  - m_Id: 335890795311104
    m_Localized: "Haah... haah... com mais um pouco de esfor\xE7o, parece que a gente
      sai vivo daqui..."
    m_Metadata:
      m_Items: []
  - m_Id: 337052009345024
    m_Localized: "...Ficou tudo quieto aqui dentro.\nSer\xE1 que finalmente d\xE1
      pra escapar...?"
    m_Metadata:
      m_Items: []
  - m_Id: 337056501444608
    m_Localized: .....(CRAC!)
    m_Metadata:
      m_Items: []
  - m_Id: 337060553142272
    m_Localized: "N\xE3o, estamos sendo engolidos...!!"
    m_Metadata:
      m_Items: []
  - m_Id: 337070598500352
    m_Localized: "A gente foi engolido e acabou no es\xF4fago...\nJ\xE1 que \xE9
      assim, s\xF3 resta descer e escapar."
    m_Metadata:
      m_Items: []
  - m_Id: 337897539088384
    m_Localized: "O es\xF4fago vai se contrair em intervalos aleat\xF3rios.\nQuando
      aparecer o aviso, gritem todos juntos o grito do time pra parar isso!"
    m_Metadata:
      m_Items: []
  - m_Id: 337902496755712
    m_Localized: "Paredes coloridas v\xE3o avan\xE7ar dos dois lados.\nSe uma parede
      mostrar sua cor, bate direto nela \u2014 ela vai recuar."
    m_Metadata:
      m_Items: []
  - m_Id: 337904153505792
    m_Localized: "Decorem s\xF3 os blocos que brilham. Se pisarem no errado, \xE9
      morte instant\xE2nea."
    m_Metadata:
      m_Items: []
  - m_Id: 337904874926080
    m_Localized: "Agora vai mostrar por cor. Voc\xEA tem que acertar a sua pr\xF3pria
      cor!\nMesmo se a cor bater, se estiver em preto e branco, voc\xEA morre do
      mesmo jeito."
    m_Metadata:
      m_Items: []
  - m_Id: 337906154188800
    m_Localized: "Cada \xE1rea tem uma cor respons\xE1vel. O caminho s\xF3 fica seguro
      depois que essa cor passar primeiro!\nRespeitem bem a ordem!"
    m_Metadata:
      m_Items: []
  - m_Id: 337906812694528
    m_Localized: "V\xE3o atr\xE1s dos gl\xF3bulos vermelhos que est\xE3o correndo
      por a\xED, vamos dar um dano nesse corpo.\nA gente n\xE3o pode s\xF3 ficar
      levando pancada!"
    m_Metadata:
      m_Items: []
  - m_Id: 337907517337600
    m_Localized: "Depois que capturamos os gl\xF3bulos vermelhos, os gl\xF3bulos
      brancos passaram a nos marcar como inimigos!\nCorram e sobrevivam!"
    m_Metadata:
      m_Items: []
  - m_Id: 339357207212032
    m_Localized: "Esse \xE9 o \xFAltimo trecho do es\xF4fago...\nA\xED embaixo deve
      estar cheio de \xE1cido do est\xF4mago. Descer sem se preparar \xE9 arriscado
      demais."
    m_Metadata:
      m_Items: []
  - m_Id: 339360646541312
    m_Localized: "Aquela bala de antes t\xE1 descendo do teto, e cada vez maior.\nA
      gente precisa construir um ch\xE3o antes que ela toque o fundo.\nSen\xE3o vamos
      ser arrastados junto."
    m_Metadata:
      m_Items: []
  - m_Id: 339362018078720
    m_Localized: "Cada trecho que a gente vence gera uma parte do ch\xE3o. R\xE1pido,
      construam isso pra bloquear aquilo!"
    m_Metadata:
      m_Items: []
  - m_Id: 340094578438144
    m_Localized: "Ufa... quase n\xE3o deu, mas paramos... agora vamos pensar. Como
      descer daqui em seguran\xE7a."
    m_Metadata:
      m_Items: []
  - m_Id: 340096402960384
    m_Localized: "Glup... glup... que som \xE9 esse...?"
    m_Metadata:
      m_Items: []
  - m_Id: 340097782886400
    m_Localized: "A garganta dele entupiu e ele come\xE7ou a beber \xE1gua! A bala
      t\xE1 quebrando o ch\xE3o!!"
    m_Metadata:
      m_Items: []
  - m_Id: 335177390338048
    m_Localized: "Quando sua cor aparecer no ch\xE3o, aperta <color=#FFD24D><b>Space</b></color>.\nNo
      branco qualquer um pode apertar, mas no preto n\xE3o aperte!\nNo preto, passa
      autom\xE1tico pro pr\xF3ximo turno depois de 1 segundo."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000001
    m_Localized: "Dizem que at\xE9 no covil do tigre d\xE1 pra sobreviver se voc\xEA
      mantiver a cabe\xE7a fria..!\nA partir de agora, s\xF3 pense em sobreviver."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000002
    m_Localized: "Decore bem onde est\xE3o as bocas coloridas ao redor.\nSe pisar
      no pedal, a boca daquela cor sobe e quebra os dentes."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000003
    m_Localized: "S\xF3 sobe uma cor por vez.\nN\xE3o adianta todo mundo pisar junto."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000004
    m_Localized: "Se isso aqui come\xE7ar a fechar... gritem todos juntos o grito
      do time!\nSen\xE3o, voc\xEAs v\xE3o ficar sem enxergar nada."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000005
    m_Localized: Entrem na zona segura marcada na tela!
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000006
    m_Localized: "Ser\xE1 que comeu algo apimentado antes de me engolir..?\nN\xE3o
      para de sair baba do ch\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000007
    m_Localized: "O ch\xE3o est\xE1 cheio de baba escorregadia.\nGritem todos juntos
      o grito do time pra sumir com ela."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000008
    m_Localized: "Agora t\xE1 pingando baba de cima tamb\xE9m!\nCom certeza comeu
      algo apimentado e ainda por cima algo \xE1cido.\nS\xF3 pode estar tentando
      neutralizar com um KKUL-TTEOK!"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000009
    m_Localized: "Algumas das gotas que caem est\xE3o mirando em mim: aperta <color=#FFD24D><b>Ctrl</b></color>
      pra combinar a cor do ch\xE3o com a sua e travar a mira."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000010
    m_Localized: "A partir de agora s\xF3 vai mostrar um bloco \xE0 frente.\nDecorem
      bem!"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000011
    m_Localized: "Aqui tamb\xE9m tem algo mirando em mim.\nAperta <color=#FFD24D><b>Ctrl</b></color>
      pra combinar a cor do ch\xE3o com a sua e travar a mira."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000012
    m_Localized: "Dessa vez a l\xEDngua vai destruir o ch\xE3o inteiro da esquerda
      ou da direita.\nGritem o grito do time pra bloquear; se n\xE3o conseguirem,
      ela quebra do mesmo jeito."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000013
    m_Localized: "S\xF3 conserta se voc\xEAs gritarem o grito do time enquanto o
      aviso estiver ativo.\nDepois que o ch\xE3o quebra, s\xF3 resta aguentar at\xE9
      o pr\xF3ximo aviso."
    m_Metadata:
      m_Items: []
  - m_Id: 12337130970394624
    m_Localized: "...esse barulho de coisa rolando?\nN\xE3o me diga que \xE9 aquela
      bala rolando de novo?! Corram se n\xE3o quiserem ser esmagados!!"
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531968
    m_Localized: "Um arroto ficou entalado no es\xF4fago... o g\xE1s est\xE1 come\xE7ando
      a se acumular.\nSe ficar t\xE3o denso que n\xE3o d\xE1 pra ver nada, gritem
      o grito do time pra limpar isso."
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531969
    m_Localized: "Cuidado com o ch\xE3o. Deve ser refluxo \u2014 t\xE1 subindo \xE1cido
      do est\xF4mago!"
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531970
    m_Localized: "V\xE3o vir ataques de espinho de lugares que a gente n\xE3o v\xEA.
      Fiquem sempre atentos."
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531971
    m_Localized: "As paredes dos dois lados v\xE3o virar preto e branco.\nAcerte
      a cor e bata na parede pra empurrar a press\xE3o de volta!"
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531972
    m_Localized: "Deve ser uma rea\xE7\xE3o al\xE9rgica \u2014 surgiram incha\xE7os
      por todo o es\xF4fago.\nSe baterem em um desses, v\xE3o ser lan\xE7ados pra
      tr\xE1s."
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531973
    m_Localized: "Se baterem numa parede, v\xE3o ser lan\xE7ados pra tr\xE1s.\nD\xE1
      pra usar isso pra fugir, n\xE9?"
    m_Metadata:
      m_Items: []
  - m_Id: 12337131037503488
    m_Localized: AAAAAAAAAH...!!
    m_Metadata:
      m_Items: []
  - m_Id: 13504475839442944
    m_Localized: "Casas coloridas v\xE3o acender no ch\xE3o.\nSe a sua cor aparecer,
      fique s\xF3 naquela casa.\nSe n\xE3o aparecer, aguente no preto ou branco,
      do seu."
    m_Metadata:
      m_Items: []
  - m_Id: 13504475885580288
    m_Localized: "Tem que acertar a cor do personagem tamb\xE9m!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
