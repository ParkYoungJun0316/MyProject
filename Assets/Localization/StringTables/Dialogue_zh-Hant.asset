  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogue_zh-Hant
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: zh-Hant
  m_SharedData: {fileID: 11400000, guid: 043bf15b2a6a41c48971e11c678f419c, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 472199573504
    m_Localized: "\u4F60\u600E\u9EBC\u653E\u7740\u597D\u5403\u7684\u6C34\u679C\u548C\u96F6\u98DF\u4E0D\u5403,\u504F\u504F\u5403\u4E86\u500BKKUL-TTEOK\u554A!!!"
    m_Metadata:
      m_Items: []
  - m_Id: 334352332992512
    m_Localized: "\u5730\u4E0A\u6703\u51FA\u73FE\u5F69\u8272\u78C1\u78DA\u3002\n\u7AD9\u5728\u4E0A\u97622\u79D2\u5206\u6578\u5C31\u6703\u589E\u52A0\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 334425666203648
    m_Localized: "\u767D\u8272\u548C\u9ED1\u8272\u78C1\u78DA\u8AB0\u8E29\u90FD\u884C,\u4F46\u5C08\u5C6C\u984F\u8272\u78C1\u78DA\u53EA\u6709\u5C0D\u61C9\u984F\u8272\u624D\u80FD\u52A0\u5206\u3002\n\u5225\u64CB\u8DEF,\u52D5\u4F5C\u5FEB\u9EDE!"
    m_Metadata:
      m_Items: []
  - m_Id: 335182629023744
    m_Localized: "\u8173\u4E0B\u597D\u50CF\u6709\u4EC0\u9EBC\u5728\u52D5\u2026\u2026\u5C0F\u5FC3!\n\u820C\u982D\u653B\u64CA\u4F86\u4E86!"
    m_Metadata:
      m_Items: []
  - m_Id: 335185439207424
    m_Localized: "\u820C\u982D\u6703\u7838\u788E\u4E2D\u9593\u7684\u8E0F\u677F,\u64CB\u4F4F\u53BB\u8DEF\u3002\n\u5927\u5BB6\u4E00\u8D77\u558A\u5718\u968A\u53E3\u865F\u5C31\u80FD\u8B93\u5B83\u964D\u4E0B\u53BB,\u58DE\u6389\u7684\u8DEF\u4E5F\u6703\u6062\u5FA9\u539F\u72C0\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 335887280484352
    m_Localized: "\u597D\u50CF\u5728\u904B\u52D5!\u547C\u5438\u7A81\u7136\u8B8A\u7C97\u91CD\u4E86\u3002\n\u98A8\u5439\u904E\u4F86\u4E86!\u7AD9\u5230\u5C0D\u61C9\u7684\u5730\u677F\u4E0A\u6490\u4F4F!"
    m_Metadata:
      m_Items: []
  - m_Id: 335890795311104
    m_Localized: "\u547C\u2026\u2026\u547C\u2026\u2026\u518D\u6490\u4E00\u4E0B,\u597D\u50CF\u5C31\u80FD\u6D3B\u8457\u51FA\u53BB\u4E86\u2026\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 337052009345024
    m_Localized: "\u2026\u2026\u5634\u88E1\u5B89\u975C\u4E0B\u4F86\u4E86\u3002\n\u96E3\u9053\u7D42\u65BC\u80FD\u9003\u51FA\u53BB\u4E86\u2026\u2026?"
    m_Metadata:
      m_Items: []
  - m_Id: 337056501444608
    m_Localized: ".....(\u5580\u5693!)"
    m_Metadata:
      m_Items: []
  - m_Id: 337060553142272
    m_Localized: "\u7CDF\u4E86,\u8981\u88AB\u541E\u4E0B\u53BB\u4E86\u2026\u2026!!"
    m_Metadata:
      m_Items: []
  - m_Id: 337070598500352
    m_Localized: "\u88AB\u541E\u4E0B\u53BB\u6389\u9032\u98DF\u9053\u88E1\u4E86\u2026\u2026\n\u5230\u9019\u4E00\u6B65,\u53EA\u80FD\u5F80\u4E0B\u8D70\u60F3\u8FA6\u6CD5\u9003\u51FA\u53BB\u4E86\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 337897539088384
    m_Localized: "\u98DF\u9053\u6703\u9031\u671F\u6027\u5730\u6536\u7E2E\u3002\n\u8B66\u544A\u4E00\u51FA\u73FE,\u5927\u5BB6\u4E00\u8D77\u558A\u5718\u968A\u53E3\u865F\u628A\u5B83\u9802\u56DE\u53BB!"
    m_Metadata:
      m_Items: []
  - m_Id: 337902496755712
    m_Localized: "\u5169\u5074\u7684\u5F69\u8272\u7246\u6703\u64E0\u904E\u4F86\u3002\n\u54EA\u9762\u7246\u662F\u4F60\u7684\u984F\u8272,\u5C31\u76F4\u63A5\u649E\u4E0A\u53BB\u2014\u2014\u7246\u6703\u88AB\u649E\u9000\u56DE\u53BB\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 337904153505792
    m_Localized: "\u53EA\u8981\u8A18\u4F4F\u767C\u5149\u7684\u683C\u5B50\u5C31\u597D\u3002\u8E29\u932F\u683C\u5B50\u6703\u7ACB\u523B\u6B7B\u6389\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 337904874926080
    m_Localized: "\u9019\u6B21\u6703\u6309\u984F\u8272\u5206\u5225\u986F\u793A\u3002\u4E00\u5B9A\u8981\u5C0D\u4E0A\u4F60\u81EA\u5DF1\u7684\u984F\u8272!\n\u984F\u8272\u5C0D\u4E86\u4E5F\u6C92\u7528,\u9ED1\u767D\u72C0\u614B\u7167\u6A23\u6703\u6B7B\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 337906154188800
    m_Localized: "\u6BCF\u500B\u5340\u57DF\u90FD\u6709\u5C0D\u61C9\u7684\u8CA0\u8CAC\u984F\u8272\u3002\u8CA0\u8CAC\u7684\u984F\u8272\u8981\u5148\u8D70\u4E00\u904D,\u8DEF\u624D\u6703\u8B8A\u5B89\u5168!\n\u4E00\u5B9A\u8981\u6309\u9806\u5E8F\u4F86!"
    m_Metadata:
      m_Items: []
  - m_Id: 337906812694528
    m_Localized: "\u53BB\u6293\u4F4F\u5230\u8655\u4E82\u8DD1\u7684\u7D05\u8840\u7403,\u5927\u5BB6\u4E00\u8D77\u7D66\u9019\u8EAB\u9AD4\u4F86\u9EDE\u50B7\u5BB3\u3002\n\u4E0D\u80FD\u4E00\u76F4\u53EA\u6328\u6253!"
    m_Metadata:
      m_Items: []
  - m_Id: 337907517337600
    m_Localized: "\u6293\u4E86\u7D05\u8840\u7403\u4E4B\u5F8C,\u767D\u8840\u7403\u628A\u6211\u5011\u7576\u6210\u6575\u4EBA\u4E86!\n\u5FEB\u9003,\u6D3B\u4E0B\u4F86!"
    m_Metadata:
      m_Items: []
  - m_Id: 339357207212032
    m_Localized: "\u9019\u662F\u98DF\u9053\u7684\u6700\u5F8C\u4E00\u6BB5\u4E86\u2026\u2026\n\u4E0B\u9762\u80AF\u5B9A\u5168\u662F\u80C3\u6DB2\u3002\u6BEB\u7121\u6E96\u5099\u5C31\u4E0B\u53BB\u592A\u5371\u96AA\u4E86\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 339360646541312
    m_Localized: "\u5929\u82B1\u677F\u4E0A\u90A3\u9846\u7CD6\u679C\u6B63\u5728\u6162\u6162\u964D\u4E0B\u4F86,\u800C\u4E14\u8D8A\u8B8A\u8D8A\u5927\u3002\n\u5F97\u8D95\u7DCA\u642D\u51FA\u5730\u677F\u64CB\u4F4F\u5B83\u3002\n\u4E0D\u7136\u6211\u5011\u4E5F\u6703\u4E00\u8D77\u88AB\u6C96\u4E0B\u53BB\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 339362018078720
    m_Localized: "\u6BCF\u89E3\u6C7A\u4E00\u500B\u5340\u6BB5\u5C31\u6703\u751F\u6210\u4E00\u584A\u5730\u677F\u3002\u8D95\u7DCA\u642D\u597D\u64CB\u4F4F\u90A3\u6771\u897F!"
    m_Metadata:
      m_Items: []
  - m_Id: 340094578438144
    m_Localized: "\u547C\u2026\u2026\u7E3D\u7B97\u662F\u64CB\u4F4F\u4E86\u2026\u2026\u597D,\u60F3\u60F3\u63A5\u4E0B\u4F86\u8981\u600E\u9EBC\u5B89\u5168\u4E0B\u53BB\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 340096402960384
    m_Localized: "\u5495\u561F\u2026\u2026\u5495\u561F\u2026\u2026\u9019\u662F\u4EC0\u9EBC\u8072\u97F3\u2026\u2026?"
    m_Metadata:
      m_Items: []
  - m_Id: 340097782886400
    m_Localized: "\u7260\u5589\u982D\u5361\u4F4F\u4E86,\u958B\u59CB\u5495\u561F\u5495\u561F\u704C\u6C34!\u7CD6\u679C\u6B63\u5728\u628A\u5730\u677F\u7838\u7834!!"
    m_Metadata:
      m_Items: []
  - m_Id: 335177390338048
    m_Localized: "\u4F60\u7684\u984F\u8272\u51FA\u73FE\u5728\u5730\u4E0A\u6642\u6309<color=#FFD24D><b>Space</b></color>\u3002\n\u767D\u8272\u8AB0\u6309\u90FD\u884C,\u9ED1\u8272\u4E0D\u80FD\u6309!\n\u9ED1\u8272\u6703\u57281\u79D2\u5F8C\u81EA\u52D5\u8F2A\u5230\u4E0B\u4E00\u500B\u4EBA\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000001
    m_Localized: "\u5E38\u8A00\u9053,\u5C31\u7B97\u8AA4\u5165\u864E\u7A74,\u53EA\u8981\u4FDD\u6301\u93AE\u5B9A\u5C31\u80FD\u6D3B\u4E0B\u4F86..!\n\u5F9E\u73FE\u5728\u8D77,\u53EA\u60F3\u8457\u600E\u9EBC\u6D3B\u4E0B\u53BB\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000002
    m_Localized: "\u8A18\u597D\u5468\u570D\u90A3\u4E9B\u5F69\u8272\u5634\u5DF4\u7684\u4F4D\u7F6E\u3002\n\u8E29\u4E0A\u8E0F\u677F,\u90A3\u500B\u984F\u8272\u7684\u5634\u5DF4\u5C31\u6703\u5347\u8D77\u4F86,\u628A\u7259\u9F52\u7838\u788E\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000003
    m_Localized: "\u4E00\u6B21\u53EA\u6703\u5347\u8D77\u4E00\u7A2E\u984F\u8272\u3002\n\u5927\u5BB6\u4E00\u8D77\u8E29\u4E5F\u6C92\u7528\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000004
    m_Localized: "\u9019\u88E1\u8981\u662F\u5FEB\u95DC\u4E0A\u4E86\u2026\u2026\u5927\u5BB6\u4E00\u8D77\u558A\u5718\u968A\u53E3\u865F!\n\u4E0D\u7136\u773C\u524D\u5C31\u6703\u8B8A\u5F97\u4E00\u7247\u6F06\u9ED1\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000005
    m_Localized: "\u7167\u756B\u9762\u63D0\u793A\u9032\u5165\u5B89\u5168\u5340!"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000006
    m_Localized: "\u5403\u6211\u4E4B\u524D\u662F\u4E0D\u662F\u5403\u4E86\u8FA3\u7684..?\n\u5730\u4E0A\u7684\u53E3\u6C34\u4E00\u76F4\u5192\u51FA\u4F86\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000007
    m_Localized: "\u5730\u4E0A\u90FD\u662F\u53E3\u6C34,\u5F88\u6ED1\u3002\n\u5927\u5BB6\u4E00\u8D77\u558A\u5718\u968A\u53E3\u865F\u5C31\u80FD\u6E05\u6389\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000008
    m_Localized: "\u73FE\u5728\u4E0A\u9762\u4E5F\u958B\u59CB\u6EF4\u53E3\u6C34\u4E86!\n\u80AF\u5B9A\u662F\u5403\u4E86\u8FA3\u7684\u53C8\u5403\u4E86\u9178\u7684\u3002\n\u4E00\u5B9A\u662F\u60F3\u7528KKUL-TTEOK\u4F86\u4E2D\u548C!"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000009
    m_Localized: "\u6389\u4E0B\u4F86\u7684\u53E3\u6C34\u88E1\u6709\u7684\u6703\u7784\u6E96\u6211,\u7528<color=#FFD24D><b>Ctrl</b></color>\u628A\u5730\u677F\u984F\u8272\u548C\u81EA\u5DF1\u7684\u984F\u8272\u5C0D\u4E0A\u5C31\u80FD\u89E3\u9664\u9396\u5B9A\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000010
    m_Localized: "\u5F9E\u73FE\u5728\u8D77\u53EA\u6703\u986F\u793A\u524D\u9762\u4E00\u683C\u3002\n\u8981\u597D\u597D\u8A18\u4F4F!"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000011
    m_Localized: "\u9019\u88E1\u4E5F\u6709\u7784\u6E96\u6211\u7684\u6771\u897F\u3002\n\u7528<color=#FFD24D><b>Ctrl</b></color>\u628A\u5730\u677F\u984F\u8272\u548C\u81EA\u5DF1\u7684\u984F\u8272\u5C0D\u4E0A\u5C31\u80FD\u89E3\u9664\u9396\u5B9A\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000012
    m_Localized: "\u9019\u6B21\u820C\u982D\u6703\u628A\u5DE6\u908A\u6216\u53F3\u908A\u7684\u5730\u677F\u6574\u7247\u7838\u788E\u3002\n\u558A\u5718\u968A\u53E3\u865F\u5C31\u80FD\u64CB\u4F4F,\u558A\u4E0D\u51FA\u4F86\u5C31\u6703\u76F4\u63A5\u788E\u6389\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000013
    m_Localized: "\u53EA\u6709\u5728\u8B66\u544A\u51FA\u73FE\u7684\u6642\u5019\u558A\u5718\u968A\u53E3\u865F\u624D\u80FD\u6062\u5FA9\u539F\u72C0\u3002\n\u5730\u677F\u788E\u4E86\u4E4B\u5F8C,\u53EA\u80FD\u6490\u5230\u4E0B\u4E00\u6B21\u8B66\u544A\u51FA\u73FE\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 12337130970394624
    m_Localized: "\u2026\u2026\u5495\u5695\u5495\u5695\u5495\u5695?\n\u73FE\u5728\u6EFE\u904E\u4F86\u7684\u9019\u500B,\u96E3\u9053\u662F\u7CD6\u679C\u55CE?!\u4E0D\u60F3\u88AB\u58D3\u6241\u5C31\u5FEB\u8DD1!!"
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531968
    m_Localized: "\u6253\u55DD\u6253\u5230\u4E00\u534A\u88AB\u98DF\u9053\u5361\u4F4F\u4E86\u2026\u2026\u6C23\u9AD4\u958B\u59CB\u7A4D\u8D77\u4F86\u4E86\u3002\n\u8B8A\u6FC3\u770B\u4E0D\u6E05\u8DEF\u7684\u6642\u5019,\u5927\u5BB6\u4E00\u8D77\u558A\u5718\u968A\u53E3\u865F\u628A\u5B83\u6E05\u6389\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531969
    m_Localized: "\u5C0F\u5FC3\u8173\u4E0B\u3002\u662F\u4E0D\u662F\u6709\u80C3\u98DF\u9053\u9006\u6D41\u554A,\u80C3\u9178\u90FD\u6E67\u4E0A\u4F86\u4E86!"
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531970
    m_Localized: "\u770B\u4E0D\u898B\u7684\u5730\u65B9\u6703\u6709\u5C16\u523A\u653B\u64CA\u904E\u4F86\u3002\u8981\u96A8\u6642\u4FDD\u6301\u8B66\u89BA\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531971
    m_Localized: "\u5169\u5074\u7684\u7246\u6703\u8B8A\u6210\u9ED1\u767D\u8272\u3002\n\u5C0D\u4E0A\u984F\u8272\u649E\u4E0A\u53BB,\u628A\u58D3\u904E\u4F86\u7684\u7246\u63A8\u56DE\u53BB!"
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531972
    m_Localized: "\u597D\u50CF\u662F\u904E\u654F\u53CD\u61C9,\u98DF\u9053\u88E1\u9577\u51FA\u4E86\u4E00\u5806\u6D6E\u816B\u3002\n\u649E\u5230\u9019\u4E9B\u6771\u897F\u6703\u88AB\u5F48\u98DB\u51FA\u53BB\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531973
    m_Localized: "\u649E\u5230\u7246\u6703\u88AB\u5F48\u958B\u3002\n\u597D\u597D\u5229\u7528\u9019\u500B,\u8AAA\u4E0D\u5B9A\u80FD\u9003\u6389?"
    m_Metadata:
      m_Items: []
  - m_Id: 12337131037503488
    m_Localized: "\u554A\u554A\u554A\u554A\u554A\u554A\u554A\u554A\u554A\u2026\u2026!!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
