  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogue_zh-Hans
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: zh-Hans
  m_SharedData: {fileID: 11400000, guid: 043bf15b2a6a41c48971e11c678f419c, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 472199573504
    m_Localized: "\u4F60\u600E\u4E48\u653E\u7740\u597D\u5403\u7684\u6C34\u679C\u548C\u96F6\u98DF\u4E0D\u5403,\u504F\u504F\u5403\u4E86\u4E2AKKUL-TTEOK!!!"
    m_Metadata:
      m_Items: []
  - m_Id: 334352332992512
    m_Localized: "\u5730\u4E0A\u4F1A\u51FA\u73B0\u5F69\u8272\u74F7\u7816\u3002\n\u5728\u4E0A\u9762\u7AD92\u79D2\u5206\u6570\u5C31\u4F1A\u589E\u52A0\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 334425666203648
    m_Localized: "\u767D\u8272\u548C\u9ED1\u8272\u74F7\u7816\u8C01\u8E29\u90FD\u884C,\u4F46\u4E13\u5C5E\u989C\u8272\u74F7\u7816\u53EA\u6709\u5BF9\u5E94\u989C\u8272\u624D\u80FD\u52A0\u5206\u3002\n\u522B\u6321\u8DEF,\u52A8\u4F5C\u5FEB\u70B9!"
    m_Metadata:
      m_Items: []
  - m_Id: 335182629023744
    m_Localized: "\u811A\u4E0B\u597D\u50CF\u6709\u4EC0\u4E48\u5728\u52A8\u2026\u2026\u5C0F\u5FC3!\n\u820C\u5934\u653B\u51FB\u6765\u4E86!"
    m_Metadata:
      m_Items: []
  - m_Id: 335185439207424
    m_Localized: "\u820C\u5934\u4F1A\u7838\u788E\u4E2D\u95F4\u7684\u8E0F\u677F,\u6321\u4F4F\u53BB\u8DEF\u3002\n\u5927\u5BB6\u4E00\u8D77\u558A\u56E2\u961F\u53E3\u53F7\u5C31\u80FD\u8BA9\u5B83\u964D\u4E0B\u53BB,\u635F\u574F\u7684\u8DEF\u4E5F\u4F1A\u6062\u590D\u539F\u72B6\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 335887280484352
    m_Localized: "\u597D\u50CF\u5728\u8FD0\u52A8!\u547C\u5438\u7A81\u7136\u53D8\u7C97\u91CD\u4E86\u3002\n\u98CE\u5439\u8FC7\u6765\u4E86!\u7AD9\u5230\u5BF9\u5E94\u7684\u5730\u677F\u4E0A\u6491\u4F4F!"
    m_Metadata:
      m_Items: []
  - m_Id: 335890795311104
    m_Localized: "\u547C\u2026\u2026\u547C\u2026\u2026\u518D\u6491\u4E00\u4E0B,\u597D\u50CF\u5C31\u80FD\u6D3B\u7740\u51FA\u53BB\u4E86\u2026\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 337052009345024
    m_Localized: "\u2026\u2026\u5634\u91CC\u5B89\u9759\u4E0B\u6765\u4E86\u3002\n\u96BE\u9053\u7EC8\u4E8E\u80FD\u9003\u51FA\u53BB\u4E86\u2026\u2026?"
    m_Metadata:
      m_Items: []
  - m_Id: 337056501444608
    m_Localized: ".....(\u5494\u5693!)"
    m_Metadata:
      m_Items: []
  - m_Id: 337060553142272
    m_Localized: "\u7CDF\u4E86,\u8981\u88AB\u541E\u4E0B\u53BB\u4E86\u2026\u2026!!"
    m_Metadata:
      m_Items: []
  - m_Id: 337070598500352
    m_Localized: "\u88AB\u541E\u4E0B\u53BB\u6389\u8FDB\u98DF\u9053\u91CC\u4E86\u2026\u2026\n\u5230\u8FD9\u4E00\u6B65,\u53EA\u80FD\u5F80\u4E0B\u8D70\u60F3\u529E\u6CD5\u9003\u51FA\u53BB\u4E86\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 337897539088384
    m_Localized: "\u98DF\u9053\u4F1A\u5468\u671F\u6027\u5730\u6536\u7F29\u3002\n\u8B66\u544A\u4E00\u51FA\u73B0,\u5927\u5BB6\u4E00\u8D77\u558A\u56E2\u961F\u53E3\u53F7\u628A\u5B83\u9876\u56DE\u53BB!"
    m_Metadata:
      m_Items: []
  - m_Id: 337902496755712
    m_Localized: "\u4E24\u4FA7\u7684\u5F69\u8272\u5899\u4F1A\u6324\u8FC7\u6765\u3002\n\u54EA\u9762\u5899\u662F\u4F60\u7684\u989C\u8272,\u5C31\u76F4\u63A5\u649E\u4E0A\u53BB\u2014\u2014\u5899\u4F1A\u88AB\u649E\u9000\u56DE\u53BB\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 337904153505792
    m_Localized: "\u53EA\u8BB0\u4F4F\u53D1\u5149\u7684\u683C\u5B50\u5C31\u884C\u3002\u8E29\u9519\u683C\u5B50\u4F1A\u7ACB\u523B\u6B7B\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 337904874926080
    m_Localized: "\u8FD9\u6B21\u4F1A\u6309\u989C\u8272\u5206\u522B\u663E\u793A\u3002\u4E00\u5B9A\u8981\u5BF9\u4E0A\u4F60\u81EA\u5DF1\u7684\u989C\u8272!\n\u989C\u8272\u5BF9\u4E86\u4E5F\u6CA1\u7528,\u9ED1\u767D\u72B6\u6001\u7167\u6837\u4F1A\u6B7B\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 337906154188800
    m_Localized: "\u6BCF\u4E2A\u533A\u57DF\u90FD\u6709\u5BF9\u5E94\u7684\u8D1F\u8D23\u989C\u8272\u3002\u8D1F\u8D23\u7684\u989C\u8272\u5148\u8D70\u4E00\u904D,\u8DEF\u624D\u4F1A\u53D8\u5B89\u5168!\n\u4E00\u5B9A\u8981\u6309\u987A\u5E8F\u6765!"
    m_Metadata:
      m_Items: []
  - m_Id: 337906812694528
    m_Localized: "\u53BB\u6293\u4F4F\u5230\u5904\u8DD1\u7684\u7EA2\u7EC6\u80DE,\u54B1\u4EEC\u4E5F\u7ED9\u8FD9\u8EAB\u4F53\u6765\u70B9\u4F24\u5BB3\u3002\n\u4E0D\u80FD\u4E00\u76F4\u53EA\u6328\u6253!"
    m_Metadata:
      m_Items: []
  - m_Id: 337907517337600
    m_Localized: "\u6293\u4E86\u7EA2\u7EC6\u80DE\u4E4B\u540E,\u767D\u7EC6\u80DE\u628A\u6211\u4EEC\u5F53\u6210\u654C\u4EBA\u4E86!\n\u5FEB\u8DD1,\u6D3B\u4E0B\u6765!"
    m_Metadata:
      m_Items: []
  - m_Id: 339357207212032
    m_Localized: "\u8FD9\u662F\u98DF\u9053\u7684\u6700\u540E\u4E00\u6BB5\u4E86\u2026\u2026\n\u4E0B\u9762\u80AF\u5B9A\u5168\u662F\u80C3\u6DB2\u3002\u6BEB\u65E0\u51C6\u5907\u5C31\u4E0B\u53BB\u592A\u5371\u9669\u4E86\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 339360646541312
    m_Localized: "\u5929\u82B1\u677F\u4E0A\u90A3\u5757\u7CD6\u679C\u6B63\u5728\u6162\u6162\u964D\u4E0B\u6765,\u800C\u4E14\u8D8A\u6765\u8D8A\u5927\u3002\n\u5F97\u8D76\u7D27\u642D\u51FA\u5730\u9762\u6321\u4F4F\u5B83\u3002\n\u4E0D\u7136\u6211\u4EEC\u4E5F\u4F1A\u4E00\u8D77\u88AB\u51B2\u4E0B\u53BB\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 339362018078720
    m_Localized: "\u6BCF\u89E3\u51B3\u4E00\u4E2A\u533A\u95F4\u5C31\u4F1A\u751F\u6210\u4E00\u5757\u5730\u9762\u3002\u8D76\u7D27\u642D\u597D\u6321\u4F4F\u90A3\u4E1C\u897F!"
    m_Metadata:
      m_Items: []
  - m_Id: 340094578438144
    m_Localized: "\u547C\u2026\u2026\u603B\u7B97\u662F\u6321\u4F4F\u4E86\u2026\u2026\u597D,\u60F3\u60F3\u63A5\u4E0B\u6765\u8981\u600E\u4E48\u5B89\u5168\u5730\u4E0B\u53BB\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 340096402960384
    m_Localized: "\u5495\u549A\u2026\u2026\u5495\u549A\u2026\u2026\u8FD9\u662F\u4EC0\u4E48\u58F0\u97F3\u2026\u2026?"
    m_Metadata:
      m_Items: []
  - m_Id: 340097782886400
    m_Localized: "\u5B83\u55D3\u5B50\u5835\u4F4F\u4E86,\u5F00\u59CB\u5495\u561F\u5495\u561F\u704C\u6C34!\u7CD6\u679C\u628A\u5730\u9762\u7838\u7834\u4E86!!"
    m_Metadata:
      m_Items: []
  - m_Id: 335177390338048
    m_Localized: "\u4F60\u7684\u989C\u8272\u51FA\u73B0\u5728\u5730\u4E0A\u65F6\u6309<color=#FFD24D><b>Space</b></color>\u3002\n\u767D\u8272\u8C01\u6309\u90FD\u884C,\u9ED1\u8272\u4E0D\u80FD\u6309!\n\u9ED1\u8272\u4F1A\u57281\u79D2\u540E\u81EA\u52A8\u8F6E\u5230\u4E0B\u4E00\u4E2A\u4EBA\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000001
    m_Localized: "\u5E38\u8A00\u9053,\u5C31\u7B97\u8BEF\u5165\u864E\u7A74,\u53EA\u8981\u4FDD\u6301\u9547\u5B9A\u5C31\u80FD\u6D3B\u4E0B\u6765..!\n\u4ECE\u73B0\u5728\u8D77,\u53EA\u60F3\u7740\u600E\u4E48\u6D3B\u4E0B\u53BB\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000002
    m_Localized: "\u8BB0\u597D\u5468\u56F4\u90A3\u4E9B\u5F69\u8272\u5634\u5DF4\u7684\u4F4D\u7F6E\u3002\n\u8E29\u4E0A\u8E0F\u677F,\u90A3\u4E2A\u989C\u8272\u7684\u5634\u5DF4\u5C31\u4F1A\u5347\u8D77\u6765,\u628A\u7259\u9F7F\u7838\u788E\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000003
    m_Localized: "\u4E00\u6B21\u53EA\u4F1A\u5347\u8D77\u4E00\u79CD\u989C\u8272\u3002\n\u5927\u5BB6\u4E00\u8D77\u8E29\u4E5F\u6CA1\u7528\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000004
    m_Localized: "\u8FD9\u91CC\u8981\u662F\u5FEB\u5173\u4E0A\u4E86\u2026\u2026\u5927\u5BB6\u4E00\u8D77\u558A\u56E2\u961F\u53E3\u53F7!\n\u4E0D\u7136\u773C\u524D\u5C31\u4F1A\u53D8\u5F97\u4E00\u7247\u6F06\u9ED1\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000005
    m_Localized: "\u6309\u7167\u753B\u9762\u63D0\u793A\u8FDB\u5165\u5B89\u5168\u533A!"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000006
    m_Localized: "\u5403\u6211\u4E4B\u524D\u662F\u4E0D\u662F\u5403\u4E86\u8FA3\u7684..?\n\u5730\u4E0A\u7684\u53E3\u6C34\u4E0D\u505C\u5730\u5F80\u4E0A\u5192\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000007
    m_Localized: "\u5730\u4E0A\u5168\u662F\u53E3\u6C34,\u5F88\u6ED1\u3002\n\u5927\u5BB6\u4E00\u8D77\u558A\u56E2\u961F\u53E3\u53F7\u5C31\u80FD\u6E05\u6389\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000008
    m_Localized: "\u73B0\u5728\u4E0A\u9762\u4E5F\u5F00\u59CB\u6EF4\u53E3\u6C34\u4E86!\n\u80AF\u5B9A\u662F\u5403\u4E86\u8FA3\u7684\u53C8\u5403\u4E86\u9178\u7684\u3002\n\u4E00\u5B9A\u662F\u60F3\u7528KKUL-TTEOK\u6765\u4E2D\u548C!"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000009
    m_Localized: "\u6389\u4E0B\u6765\u7684\u53E3\u6C34\u91CC\u6709\u7684\u4F1A\u7784\u51C6\u6211,\u7528<color=#FFD24D><b>Ctrl</b></color>\u628A\u5730\u677F\u989C\u8272\u548C\u81EA\u5DF1\u7684\u989C\u8272\u5BF9\u4E0A\u5C31\u80FD\u89E3\u9664\u9501\u5B9A\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000010
    m_Localized: "\u4ECE\u73B0\u5728\u8D77\u53EA\u4F1A\u663E\u793A\u524D\u9762\u4E00\u683C\u3002\n\u8981\u597D\u597D\u8BB0\u4F4F!"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000011
    m_Localized: "\u8FD9\u91CC\u4E5F\u6709\u7784\u51C6\u6211\u7684\u4E1C\u897F\u3002\n\u7528<color=#FFD24D><b>Ctrl</b></color>\u628A\u5730\u677F\u989C\u8272\u548C\u81EA\u5DF1\u7684\u989C\u8272\u5BF9\u4E0A\u5C31\u80FD\u89E3\u9664\u9501\u5B9A\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000012
    m_Localized: "\u8FD9\u6B21\u820C\u5934\u4F1A\u628A\u5DE6\u8FB9\u6216\u53F3\u8FB9\u7684\u5730\u677F\u6574\u7247\u7838\u788E\u3002\n\u558A\u56E2\u961F\u53E3\u53F7\u5C31\u80FD\u6321\u4F4F,\u558A\u4E0D\u51FA\u6765\u5C31\u4F1A\u76F4\u63A5\u788E\u6389\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000013
    m_Localized: "\u53EA\u6709\u5728\u8B66\u544A\u51FA\u73B0\u7684\u65F6\u5019\u558A\u56E2\u961F\u53E3\u53F7\u624D\u80FD\u6062\u590D\u539F\u72B6\u3002\n\u5730\u677F\u788E\u4E86\u4E4B\u540E,\u53EA\u80FD\u6491\u5230\u4E0B\u4E00\u6B21\u8B66\u544A\u51FA\u73B0\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 12337130970394624
    m_Localized: "\u2026\u2026\u5495\u565C\u5495\u565C\u5495\u565C?\n\u73B0\u5728\u6EDA\u8FC7\u6765\u7684\u8FD9\u4E2A,\u96BE\u9053\u662F\u7CD6\u679C\u5417?!\u4E0D\u60F3\u88AB\u538B\u6241\u5C31\u5FEB\u8DD1!!"
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531968
    m_Localized: "\u6253\u55DD\u6253\u5230\u4E00\u534A\u88AB\u98DF\u9053\u5835\u4F4F\u4E86\u2026\u2026\u6C14\u4F53\u5F00\u59CB\u79EF\u8D77\u6765\u4E86\u3002\n\u53D8\u6D53\u770B\u4E0D\u6E05\u8DEF\u7684\u65F6\u5019,\u5927\u5BB6\u4E00\u8D77\u558A\u56E2\u961F\u53E3\u53F7\u628A\u5B83\u6E05\u6389\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531969
    m_Localized: "\u5C0F\u5FC3\u811A\u4E0B\u3002\u662F\u4E0D\u662F\u6709\u53CD\u6D41\u6027\u98DF\u9053\u708E\u554A,\u80C3\u9178\u90FD\u6D8C\u4E0A\u6765\u4E86!"
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531970
    m_Localized: "\u770B\u4E0D\u89C1\u7684\u5730\u65B9\u4F1A\u6709\u5C16\u523A\u653B\u51FB\u8FC7\u6765\u3002\u65F6\u523B\u4FDD\u6301\u8B66\u60D5\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531971
    m_Localized: "\u4E24\u4FA7\u7684\u5899\u4F1A\u53D8\u6210\u9ED1\u767D\u8272\u3002\n\u5BF9\u4E0A\u989C\u8272\u649E\u4E0A\u53BB,\u628A\u538B\u8FC7\u6765\u7684\u5899\u63A8\u56DE\u53BB!"
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531972
    m_Localized: "\u597D\u50CF\u662F\u8FC7\u654F\u53CD\u5E94,\u98DF\u9053\u91CC\u957F\u51FA\u4E86\u4E00\u5806\u6D6E\u80BF\u3002\n\u649E\u5230\u8FD9\u4E9B\u4E1C\u897F\u4F1A\u88AB\u5F39\u98DE\u51FA\u53BB\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531973
    m_Localized: "\u649E\u5230\u5899\u4F1A\u88AB\u5F39\u5F00\u3002\n\u597D\u597D\u5229\u7528\u8FD9\u4E2A\u8BF4\u4E0D\u5B9A\u80FD\u9003\u6389?"
    m_Metadata:
      m_Items: []
  - m_Id: 12337131037503488
    m_Localized: "\u554A\u554A\u554A\u554A\u554A\u554A\u554A\u554A\u554A\u2026\u2026!!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
