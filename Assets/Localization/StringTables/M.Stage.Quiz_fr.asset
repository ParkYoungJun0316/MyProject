  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: M.Stage.Quiz_fr
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: 05362dd87941b804c948c6c4f45df573, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 994491084800
    m_Localized: Les adultes produisent plus d'un litre de salive par jour.
    m_Metadata:
      m_Items: []
  - m_Id: 994524639232
    m_Localized: "Les adultes produisent environ 1 \xE0 1,5 litre de salive par jour."
    m_Metadata:
      m_Items: []
  - m_Id: 994524639233
    m_Localized: "Diff\xE9rentes parties de la langue ne peuvent percevoir que certaines
      saveurs."
    m_Metadata:
      m_Items: []
  - m_Id: 994524639234
    m_Localized: "Toutes les parties de la langue peuvent d\xE9tecter toutes les
      saveurs de base."
    m_Metadata:
      m_Items: []
  - m_Id: 994524639235
    m_Localized: "Les motifs de la langue sont diff\xE9rents pour chaque personne."
    m_Metadata:
      m_Items: []
  - m_Id: 994524639236
    m_Localized: "Les motifs \xE0 la surface de la langue sont suffisamment uniques
      pour \xEAtre \xE9tudi\xE9s en biom\xE9trie."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833536
    m_Localized: "Les l\xE8vres n'ont pas de glandes sudoripares comme la peau normale."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833537
    m_Localized: "Les l\xE8vres s\xE8chent facilement car elles n'ont ni glandes
      sudoripares ni glandes s\xE9bac\xE9es."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833538
    m_Localized: "Avec l'\xE2ge, on tol\xE8re souvent mieux les aliments amers."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833539
    m_Localized: "Cela s'explique par des changements du go\xFBt et l'exp\xE9rience
      r\xE9p\xE9t\xE9e des aliments."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833540
    m_Localized: "La dent humaine la plus longue enregistr\xE9e dans le Livre Guinness
      mesurait plus de 4 cm."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833541
    m_Localized: "La plus longue canine humaine enregistr\xE9e mesurait environ 3,67
      cm."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833542
    m_Localized: "Des milliards de bact\xE9ries vivent dans la bouche."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833543
    m_Localized: "M\xEAme apr\xE8s le brossage, de nombreuses bact\xE9ries restent
      dans la bouche."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833544
    m_Localized: On produit beaucoup plus de salive pendant le sommeil.
    m_Metadata:
      m_Items: []
  - m_Id: 994528833545
    m_Localized: "La production de salive s'arr\xEAte presque pendant le sommeil,
      ce qui peut causer une mauvaise haleine au r\xE9veil."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833546
    m_Localized: La langue peut se fatiguer.
    m_Metadata:
      m_Items: []
  - m_Id: 994528833547
    m_Localized: "La langue est faite de muscles, elle peut donc se fatiguer apr\xE8s
      un usage intense."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833548
    m_Localized: "Les dents ont une structure diff\xE9rente de celle des os."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833549
    m_Localized: "Contrairement aux os, les dents ne peuvent pas se r\xE9parer compl\xE8tement."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833550
    m_Localized: "Les l\xE8vres humaines paraissent rouges parce qu'elles contiennent
      beaucoup de pigment rouge."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833551
    m_Localized: "Les l\xE8vres sont fines, ce qui laisse voir la couleur des vaisseaux
      sanguins en dessous."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833552
    m_Localized: "La langue est l'une des parties du corps qui gu\xE9rit le plus
      vite."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833553
    m_Localized: "La langue gu\xE9rit vite gr\xE2ce \xE0 une forte circulation sanguine
      et une r\xE9paration cellulaire rapide."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
