%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogue_es
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: 043bf15b2a6a41c48971e11c678f419c, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 472199573504
    m_Localized: "\xA1\xBFPor qu\xE9 comiste un KKUL-TTEOK en vez de toda la fruta
      y las chuches tan ricas que hab\xEDa?!"
    m_Metadata:
      m_Items: []
  - m_Id: 334352332992512
    m_Localized: "Aparecer\xE1n baldosas de colores en el suelo.\nQuedaos 2 segundos
      encima de una y subir\xE1 la puntuaci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 334425666203648
    m_Localized: "Las baldosas blancas o negras las puede pisar cualquiera, pero
      las de color \xFAnico solo suman puntos si las pisa ese color.\n\xA1No bloque\xE9is
      el paso, moveos r\xE1pido!"
    m_Metadata:
      m_Items: []
  - m_Id: 335182629023744
    m_Localized: "Algo se mueve bajo nuestros pies... \xA1cuidado!\n\xA1Viene un
      ataque de lengua!"
    m_Metadata:
      m_Items: []
  - m_Id: 335185439207424
    m_Localized: "La lengua destrozar\xE1 la plataforma central y bloquear\xE1 el
      camino.\nGritad todos el grito de equipo para que baje de nuevo y se repare
      el camino roto."
    m_Metadata:
      m_Items: []
  - m_Id: 335887280484352
    m_Localized: "\xA1Parece que est\xE1 haciendo ejercicio! De repente respira con
      m\xE1s fuerza.\n\xA1Viene viento! \xA1Subid a la baldosa correcta y aguantad!"
    m_Metadata:
      m_Items: []
  - m_Id: 335890795311104
    m_Localized: "Fiu... fiu... con un poco m\xE1s de aguante, parece que podremos
      salir con vida..."
    m_Metadata:
      m_Items: []
  - m_Id: 337052009345024
    m_Localized: "...La boca se ha quedado callada.\n\xBFSer\xE1 que por fin podemos
      escapar...?"
    m_Metadata:
      m_Items: []
  - m_Id: 337056501444608
    m_Localized: ".....(\xA1CRAC!)"
    m_Metadata:
      m_Items: []
  - m_Id: 337060553142272
    m_Localized: "No puede ser, \xA1nos est\xE1 tragando...!!"
    m_Metadata:
      m_Items: []
  - m_Id: 337070598500352
    m_Localized: "Nos trag\xF3 y acabamos en el es\xF3fago...\nAs\xED las cosas,
      no queda otra que bajar y escapar."
    m_Metadata:
      m_Items: []
  - m_Id: 337897539088384
    m_Localized: "El es\xF3fago se va a contraer a intervalos aleatorios.\nEn cuanto
      salga el aviso, \xA1gritad todos el grito de equipo para detenerlo!"
    m_Metadata:
      m_Items: []
  - m_Id: 337902496755712
    m_Localized: "Unas paredes de colores avanzar\xE1n desde los lados.\nSi una pared
      muestra tu color, ch\xF3cate contra ella sin miedo \u2014 retroceder\xE1."
    m_Metadata:
      m_Items: []
  - m_Id: 337904153505792
    m_Localized: "Memorizad solo las baldosas que brillan. Si pis\xE1is la equivocada,
      es muerte instant\xE1nea."
    m_Metadata:
      m_Items: []
  - m_Id: 337904874926080
    m_Localized: "Esta vez las va a mostrar por colores. \xA1Ten\xE9is que acertar
      con vuestro propio color!\nAunque el color sea el correcto, si est\xE1 en blanco
      y negro, mor\xEDs igual."
    m_Metadata:
      m_Items: []
  - m_Id: 337906154188800
    m_Localized: "Cada zona tiene un color asignado. \xA1El camino solo se vuelve
      seguro despu\xE9s de que pase primero ese color!\n\xA1Respetad el orden!"
    m_Metadata:
      m_Items: []
  - m_Id: 337906812694528
    m_Localized: "Id a atrapar a los gl\xF3bulos rojos que andan sueltos, a ver si
      le hacemos da\xF1o a este cuerpo.\n\xA1No podemos quedarnos solo aguantando
      golpes!"
    m_Metadata:
      m_Items: []
  - m_Id: 337907517337600
    m_Localized: "\xA1Al atrapar a los gl\xF3bulos rojos, los gl\xF3bulos blancos
      nos marcaron como enemigos!\n\xA1Corred y sobrevivid!"
    m_Metadata:
      m_Items: []
  - m_Id: 339357207212032
    m_Localized: "Este es el \xFAltimo tramo del es\xF3fago...\nAh\xED abajo tiene
      que estar lleno de \xE1cido del est\xF3mago. Bajar sin prepararnos es demasiado
      peligroso."
    m_Metadata:
      m_Items: []
  - m_Id: 339360646541312
    m_Localized: "El caramelo de antes est\xE1 bajando por el techo, y cada vez es
      m\xE1s grande.\nTenemos que construir suelo antes de que toque fondo.\nSi no,
      nos arrastrar\xE1 con \xE9l."
    m_Metadata:
      m_Items: []
  - m_Id: 339362018078720
    m_Localized: "Al superar cada tramo se genera parte del suelo. \xA1R\xE1pido,
      construidlo para detener a eso!"
    m_Metadata:
      m_Items: []
  - m_Id: 340094578438144
    m_Localized: "Fiu... por poco lo detenemos... ahora pensemos. C\xF3mo bajar de
      forma segura desde aqu\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 340096402960384
    m_Localized: "Glup... glup... \xBFqu\xE9 es ese sonido...?"
    m_Metadata:
      m_Items: []
  - m_Id: 340097782886400
    m_Localized: "\xA1Se le atasc\xF3 la garganta y se puso a beber agua! \xA1El
      caramelo est\xE1 rompiendo el suelo!!"
    m_Metadata:
      m_Items: []
  - m_Id: 335177390338048
    m_Localized: "Cuando aparezca tu color en el suelo, pulsa <color=#FFD24D><b>Space</b></color>.\nAl
      blanco puede darle cualquiera, \xA1pero al negro no le deis!\nEl negro pasar\xE1
      autom\xE1ticamente al siguiente turno despu\xE9s de 1 segundo."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000001
    m_Localized: "Dicen que hasta en la cueva del tigre se sobrevive si mantienes
      la cabeza fr\xEDa..!\nA partir de ahora, pensad solo en sobrevivir."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000002
    m_Localized: "Acordaos bien de d\xF3nde est\xE1n las bocas de colores de alrededor.\nSi
      pis\xE1is la palanca, la boca de ese color se alza y os rompe los dientes."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000003
    m_Localized: 'Solo sube un color cada vez.

      No sirve de nada pisarla todos
      a la vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000004
    m_Localized: "Si esto empieza a cerrarse... \xA1gritad todos el grito de equipo!\nSi
      no, os quedar\xE9is sin ver nada."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000005
    m_Localized: "\xA1Entrad en la zona segura que marca la pantalla!"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000006
    m_Localized: "\xBFHabr\xE1 comido algo picante antes de tragarme..?\nNo paran
      de salir babas del suelo."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000007
    m_Localized: "El suelo est\xE1 lleno de babas resbaladizas.\nGritad todos el
      grito de equipo para quitarlas."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000008
    m_Localized: "\xA1Ahora tambi\xE9n caen babas desde arriba!\nSeguro que ha comido
      algo picante y encima algo \xE1cido.\n\xA1Est\xE1 claro que quiere neutralizarlo
      con un KKUL-TTEOK!"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000009
    m_Localized: "Algunas de las babas que caen me apuntan a m\xED: pulsad <color=#FFD24D><b>Ctrl</b></color>
      para igualar el color del suelo con el vuestro y que se desactive el bloqueo."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000010
    m_Localized: "A partir de ahora solo se ver\xE1 una baldosa por delante.\n\xA1Memorizadla
      bien!"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000011
    m_Localized: "Aqu\xED tambi\xE9n hay algo que me apunta.\nPulsad <color=#FFD24D><b>Ctrl</b></color>
      para igualar el color del suelo con el vuestro y desactivar el bloqueo."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000012
    m_Localized: "Esta vez la lengua destrozar\xE1 todo el suelo de la izquierda
      o de la derecha.\nGritad el grito de equipo para bloquearla; si no lo hac\xE9is,
      se romper\xE1 sin m\xE1s."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000013
    m_Localized: "Solo se repara si grit\xE1is el grito de equipo mientras est\xE9
      activo el aviso.\nUna vez roto el suelo, no queda m\xE1s remedio que aguantar
      hasta el pr\xF3ximo aviso."
    m_Metadata:
      m_Items: []
  - m_Id: 12337130970394624
    m_Localized: "...\xBFese ruido de algo rodando?\n\xA1No me dig\xE1is que es el
      caramelo de antes!? \xA1Corred si no quer\xE9is quedar aplastados!!"
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531968
    m_Localized: "Se le atasc\xF3 un eructo en el es\xF3fago... est\xE1 empezando
      a acumularse el gas.\nSi se pone tan espeso que no se ve nada, gritad el grito
      de equipo para despejarlo."
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531969
    m_Localized: "Cuidado con el suelo. Debe tener reflujo \u2014 \xA1le est\xE1
      subiendo \xE1cido del est\xF3mago!"
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531970
    m_Localized: "Vendr\xE1n ataques de p\xFAas desde donde no se ve. Estad siempre
      alerta."
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531971
    m_Localized: "Las paredes de los lados se van a poner en blanco y negro.\n\xA1Igualad
      el color y chocad contra la pared para hacer retroceder la presi\xF3n!"
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531972
    m_Localized: "Debe ser una reacci\xF3n al\xE9rgica \u2014 le han salido bultos
      por todo el es\xF3fago.\nSi choc\xE1is con uno, saldr\xE9is despedidos."
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531973
    m_Localized: "Si choc\xE1is contra una pared, saldr\xE9is despedidos.\nPodr\xEDamos
      usar eso para escapar, \xBFno?"
    m_Metadata:
      m_Items: []
  - m_Id: 12337131037503488
    m_Localized: "\xA1AAAAAAAAAH...!!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
