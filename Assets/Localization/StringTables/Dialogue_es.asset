%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogue_es
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: 043bf15b2a6a41c48971e11c678f419c, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 472199573504
    m_Localized: "\xA1\xBFCon toda la fruta rica que hab\xEDa, por qu\xE9 me has
      comido a m\xED?!"
    m_Metadata:
      m_Items: []
  - m_Id: 334352332992512
    m_Localized: "Van a aparecer baldosas de colores en el suelo.\nQu\xE9date 2 segundos
      encima de una para sumar un punto."
    m_Metadata:
      m_Items: []
  - m_Id: 334425666203648
    m_Localized: "Las baldosas blancas y negras valen para cualquiera, pero las de
      color solo cuentan para ese color.\n\xA1No os estorb\xE9is y moveos r\xE1pido!"
    m_Metadata:
      m_Items: []
  - m_Id: 335182629023744
    m_Localized: "Algo se mueve bajo nuestros pies\u2026 \xA1cuidado!\n\xA1Ah\xED
      viene la lengua!"
    m_Metadata:
      m_Items: []
  - m_Id: 335185439207424
    m_Localized: "La lengua va a romper la plataforma del centro y cortar el paso.\nSi
      gritamos juntos el grito de equipo, bajar\xE1 y el camino roto volver\xE1 a
      estar como antes."
    m_Metadata:
      m_Items: []
  - m_Id: 335887280484352
    m_Localized: "\xBFEstar\xE1 haciendo ejercicio o qu\xE9? \xA1De repente respira
      con fuerza!"
    m_Metadata:
      m_Items: []
  - m_Id: 335890795311104
    m_Localized: "Uf\u2026 uf\u2026 un poco m\xE1s y a lo mejor salimos vivos de
      aqu\xED\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 337052009345024
    m_Localized: "\u2026Aqu\xED dentro se ha quedado todo en silencio.\n\xBFSer\xE1
      que por fin podemos escapar\u2026?"
    m_Metadata:
      m_Items: []
  - m_Id: 337056501444608
    m_Localized: "\u2026(\xA1CRAC!)"
    m_Metadata:
      m_Items: []
  - m_Id: 337060553142272
    m_Localized: "\xA1Oh, no, nos est\xE1 tragando\u2026!!"
    m_Metadata:
      m_Items: []
  - m_Id: 337070598500352
    m_Localized: "Nos ha tragado\u2026 ahora estamos en el es\xF3fago.\nNo queda
      otra: hay que bajar y buscar una salida."
    m_Metadata:
      m_Items: []
  - m_Id: 337897539088384
    m_Localized: "El es\xF3fago nos va a apretujar.\nCuando salga el aviso, \xA1gritad
      juntos el grito de equipo para pararlo!"
    m_Metadata:
      m_Items: []
  - m_Id: 337902496755712
    m_Localized: "Van a venir paredes de colores por los dos lados.\nSi una pared
      muestra mi color, emb\xEDstela de lleno: as\xED la har\xE1s retroceder."
    m_Metadata:
      m_Items: []
  - m_Id: 337904153505792
    m_Localized: "Creo que se est\xE1 acumulando gas en el es\xF3fago\u2026\nSi se
      pone tan denso que no se ve nada, \xA1gritad el grito de equipo para despejarlo!"
    m_Metadata:
      m_Items: []
  - m_Id: 337904874926080
    m_Localized: "\xA1Recuerda mi color y avanza por las baldosas que coincidan!"
    m_Metadata:
      m_Items: []
  - m_Id: 337906154188800
    m_Localized: "Primero tiene que pasar el color de la zona; despu\xE9s el camino
      ser\xE1 seguro. \xA1No os col\xE9is!"
    m_Metadata:
      m_Items: []
  - m_Id: 337906812694528
    m_Localized: "\xA1El es\xF3fago se ha sacudido de golpe y ha bloqueado el paso!"
    m_Metadata:
      m_Items: []
  - m_Id: 337907517337600
    m_Localized: "Uno corre abajo. \xA1Los dem\xE1s, pisad las placas de color para
      abrir las puertas!"
    m_Metadata:
      m_Items: []
  - m_Id: 339357207212032
    m_Localized: "Este es el final del es\xF3fago\u2026\nAh\xED abajo debe de estar
      lleno de \xE1cido. Bajar sin prepararse es peligroso."
    m_Metadata:
      m_Items: []
  - m_Id: 339360646541312
    m_Localized: "El caramelo de antes est\xE1 cayendo del techo.\n\xA1Hay que pararlo
      antes de que toque el suelo!"
    m_Metadata:
      m_Items: []
  - m_Id: 340094578438144
    m_Localized: "Uf\u2026 por los pelos\u2026\nAhora pensemos c\xF3mo bajar sin
      peligro."
    m_Metadata:
      m_Items: []
  - m_Id: 340096402960384
    m_Localized: "Glup\u2026 glup\u2026\n\xA1Se ha atragantado y se ha puesto a beber
      agua! \xA1El caramelo est\xE1 bajando!"
    m_Metadata:
      m_Items: []
  - m_Id: 335177390338048
    m_Localized: "Cuando salga tu color en el suelo, pulsa <color=#FFD24D><b>Space</b></color>.\nEl
      blanco lo puede pulsar cualquiera, \xA1pero el negro ni tocarlo!\nEl negro
      pasa solo al siguiente turno al cabo de 1 segundo."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000001
    m_Localized: A partir de ahora, pensad solo en sobrevivir.
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000002
    m_Localized: "Fijaos bien en d\xF3nde est\xE1n las bocas de colores.\nSi pis\xE1is
      la placa, la boca de ese color se alzar\xE1 y har\xE1 pedazos los dientes."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000003
    m_Localized: "Solo sube un color cada vez.\nNo sirve de nada que pis\xE9is todos
      a la vez."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000004
    m_Localized: "Cuando la boca gigante empiece a cerrarse, \xA1gritad todos el
      grito de equipo!\nSi no, todo se quedar\xE1 a oscuras."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000005
    m_Localized: "\xA1En cada zona tiene que haber tantos como KKUL-TTEOK! Cada uno
      solo ve los de su cartel, \xA1as\xED que avisaos!"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000006
    m_Localized: "\xBFHabr\xE1 comido algo picante antes de comerme\u2026?\nNo para
      de salir baba del suelo."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000007
    m_Localized: "Con tanta baba, el suelo va a resbalar.\n\xA1Si gritamos juntos
      el grito de equipo, podemos quitarla!"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000008
    m_Localized: "\xA1Ahora tambi\xE9n gotea desde arriba!\nSeguro que ha comido
      algo picante y \xE1cido."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000009
    m_Localized: "\xA1Algunas gotas me est\xE1n apuntando!\nIguala mi color con el
      del suelo con <color=#FFD24D><b>Ctrl</b></color> y me perder\xE1n de vista."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000010
    m_Localized: "A partir de ahora solo ver\xE1s la siguiente baldosa.\n\xA1Memor\xEDzala
      bien!"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000011
    m_Localized: "\xA1Aqu\xED tambi\xE9n hay algo apunt\xE1ndome!\nIguala mi color
      con el del suelo con <color=#FFD24D><b>Ctrl</b></color> y me perder\xE1 de
      vista."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000012
    m_Localized: "Esta vez la lengua va a destrozar todo el lado izquierdo o derecho
      del suelo.\nGritad el grito de equipo para pararla; si no, se romper\xE1."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000013
    m_Localized: "El suelo solo vuelve si grit\xE1is el grito de equipo mientras
      est\xE1 el aviso.\nSi ya se ha roto, tocar\xE1 aguantar hasta el siguiente
      aviso."
    m_Metadata:
      m_Items: []
  - m_Id: 12337130970394624
    m_Localized: "\xA1\xBFEso que viene rodando por detr\xE1s es un caramelo?! \xA1Corred
      si no quer\xE9is acabar aplastados!"
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531969
    m_Localized: "Parece reflujo\u2026 \xA1est\xE1 subiendo \xE1cido del est\xF3mago!\nSi
      no pasamos cada tramo antes de que se acabe el tiempo del cartel, \xA1acabaremos
      nadando en \xE9l!"
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531972
    m_Localized: "Debe de ser una reacci\xF3n al\xE9rgica\u2026 el es\xF3fago est\xE1
      todo hinchado."
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531973
    m_Localized: "Solo se abren las puertas de un color a la vez. \xA1Algo nos persigue,
      daos prisa!"
    m_Metadata:
      m_Items: []
  - m_Id: 13504475839442944
    m_Localized: "Se van a iluminar casillas de colores en el suelo.\nSi sale tu
      color, ponte solo en esa casilla.\nSi no, aguanta en la negra o la blanca,
      \xA1la que coincida contigo!"
    m_Metadata:
      m_Items: []
  - m_Id: 17908244660465664
    m_Localized: "Est\xE1 tan sensible que solo cabe uno por casilla.\nAlgunas casillas
      se rompen f\xE1cilmente, \xA1reaccionad r\xE1pido!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
