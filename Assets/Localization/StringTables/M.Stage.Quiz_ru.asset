  m_SharedData: {fileID: 11400000, guid: 05362dd87941b804c948c6c4f45df573, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 994491084800
    m_Localized: "\u0412\u0437\u0440\u043E\u0441\u043B\u044B\u0435 \u0432\u044B\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u044E\u0442
      \u0431\u043E\u043B\u044C\u0448\u0435 1 \u043B\u0438\u0442\u0440\u0430 \u0441\u043B\u044E\u043D\u044B
      \u043A\u0430\u0436\u0434\u044B\u0439 \u0434\u0435\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 994524639232
    m_Localized: "\u0412\u0437\u0440\u043E\u0441\u043B\u044B\u0435 \u0432\u044B\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u044E\u0442
      \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E \u043E\u0442 1 \u0434\u043E
      1,5 \u043B\u0438\u0442\u0440\u0430 \u0441\u043B\u044E\u043D\u044B \u0432 \u0434\u0435\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 994524639233
    m_Localized: "\u0420\u0430\u0437\u043D\u044B\u0435 \u0443\u0447\u0430\u0441\u0442\u043A\u0438
      \u044F\u0437\u044B\u043A\u0430 \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E\u0442
      \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D\u043D\u044B\u0435
      \u0432\u043A\u0443\u0441\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 994524639234
    m_Localized: "\u041B\u044E\u0431\u043E\u0439 \u0443\u0447\u0430\u0441\u0442\u043E\u043A
      \u044F\u0437\u044B\u043A\u0430 \u0441\u043F\u043E\u0441\u043E\u0431\u0435\u043D
      \u0440\u0430\u0441\u043F\u043E\u0437\u043D\u0430\u0432\u0430\u0442\u044C \u0432\u0441\u0435
      \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u0435 \u0432\u043A\u0443\u0441\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 994524639235
    m_Localized: "\u0423\u0437\u043E\u0440 \u044F\u0437\u044B\u043A\u0430 \u0443
      \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430
      \u0443\u043D\u0438\u043A\u0430\u043B\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 994524639236
    m_Localized: "\u0423\u0437\u043E\u0440 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438
      \u044F\u0437\u044B\u043A\u0430 \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E
      \u0443\u043D\u0438\u043A\u0430\u043B\u0435\u043D, \u0447\u0442\u043E \u0435\u0433\u043E
      \u0438\u0437\u0443\u0447\u0430\u044E\u0442 \u0434\u043B\u044F \u0431\u0438\u043E\u043C\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0445
      \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833536
    m_Localized: "\u041D\u0430 \u0433\u0443\u0431\u0430\u0445, \u0432 \u043E\u0442\u043B\u0438\u0447\u0438\u0435
      \u043E\u0442 \u043E\u0431\u044B\u0447\u043D\u043E\u0439 \u043A\u043E\u0436\u0438,
      \u043D\u0435\u0442 \u043F\u043E\u0442\u043E\u0432\u044B\u0445 \u0436\u0435\u043B\u0451\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833537
    m_Localized: "\u0413\u0443\u0431\u044B \u043B\u0435\u0433\u043A\u043E \u043F\u0435\u0440\u0435\u0441\u044B\u0445\u0430\u044E\u0442,
      \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0443 \u043D\u0438\u0445
      \u043D\u0435\u0442 \u043F\u043E\u0442\u043E\u0432\u044B\u0445 \u0438 \u0441\u0430\u043B\u044C\u043D\u044B\u0445
      \u0436\u0435\u043B\u0451\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833538
    m_Localized: "\u0421 \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u043E\u043C \u043B\u044E\u0434\u0438
      \u0447\u0430\u0441\u0442\u043E \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442
      \u043B\u0443\u0447\u0448\u0435 \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0438\u0442\u044C
      \u0433\u043E\u0440\u044C\u043A\u0443\u044E \u0435\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833539
    m_Localized: "\u042D\u0442\u043E \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442
      \u0438\u0437-\u0437\u0430 \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0439
      \u0432\u043A\u0443\u0441\u043E\u0432\u044B\u0445 \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u0439
      \u0438 \u043D\u0430\u043A\u043E\u043F\u043B\u0435\u043D\u043D\u043E\u0433\u043E
      \u043E\u043F\u044B\u0442\u0430 \u043F\u0438\u0442\u0430\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833540
    m_Localized: "\u0421\u0430\u043C\u044B\u0439 \u0434\u043B\u0438\u043D\u043D\u044B\u0439
      \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u0438\u0439 \u0437\u0443\u0431,
      \u0437\u0430\u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
      \u0432 \u041A\u043D\u0438\u0433\u0435 \u0440\u0435\u043A\u043E\u0440\u0434\u043E\u0432
      \u0413\u0438\u043D\u043D\u0435\u0441\u0441\u0430, \u0431\u044B\u043B \u0434\u043B\u0438\u043D\u043D\u0435\u0435
      4 \u0441\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833541
    m_Localized: "\u0421\u0430\u043C\u044B\u0439 \u0434\u043B\u0438\u043D\u043D\u044B\u0439
      \u0437\u0430\u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
      \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u0438\u0439 \u043A\u043B\u044B\u043A
      \u0431\u044B\u043B \u043E\u043A\u043E\u043B\u043E 3,67 \u0441\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833542
    m_Localized: "\u0412\u043E \u0440\u0442\u0443 \u0436\u0438\u0432\u0443\u0442
      \u043C\u0438\u043B\u043B\u0438\u0430\u0440\u0434\u044B \u0431\u0430\u043A\u0442\u0435\u0440\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833543
    m_Localized: "\u0414\u0430\u0436\u0435 \u043F\u043E\u0441\u043B\u0435 \u0447\u0438\u0441\u0442\u043A\u0438
      \u0437\u0443\u0431\u043E\u0432 \u0432\u043E \u0440\u0442\u0443 \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u043C\u043D\u043E\u0433\u043E \u0431\u0430\u043A\u0442\u0435\u0440\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833544
    m_Localized: "\u0412\u043E \u0432\u0440\u0435\u043C\u044F \u0441\u043D\u0430
      \u043B\u044E\u0434\u0438 \u0432\u044B\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u044E\u0442
      \u043D\u0430\u043C\u043D\u043E\u0433\u043E \u0431\u043E\u043B\u044C\u0448\u0435
      \u0441\u043B\u044E\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833545
    m_Localized: "\u0412\u043E \u0432\u0440\u0435\u043C\u044F \u0441\u043D\u0430
      \u0432\u044B\u0440\u0430\u0431\u043E\u0442\u043A\u0430 \u0441\u043B\u044E\u043D\u044B
      \u043F\u043E\u0447\u0442\u0438 \u043F\u0440\u0435\u043A\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F,
      \u0438\u0437-\u0437\u0430 \u0447\u0435\u0433\u043E \u0443\u0442\u0440\u043E\u043C
      \u043C\u043E\u0436\u0435\u0442 \u043F\u043E\u044F\u0432\u043B\u044F\u0442\u044C\u0441\u044F
      \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u043D\u044B\u0439 \u0437\u0430\u043F\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833546
    m_Localized: "\u042F\u0437\u044B\u043A \u0442\u043E\u0436\u0435 \u043C\u043E\u0436\u0435\u0442
      \u0443\u0441\u0442\u0430\u0432\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833547
    m_Localized: "\u042F\u0437\u044B\u043A \u0441\u043E\u0441\u0442\u043E\u0438\u0442
      \u0438\u0437 \u043C\u044B\u0448\u0446, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
      \u043C\u043E\u0436\u0435\u0442 \u0443\u0441\u0442\u0430\u0432\u0430\u0442\u044C
      \u043F\u043E\u0441\u043B\u0435 \u0441\u0438\u043B\u044C\u043D\u043E\u0439 \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833548
    m_Localized: "\u0423 \u0437\u0443\u0431\u043E\u0432 \u0438\u043D\u043E\u0435
      \u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435, \u0447\u0435\u043C \u0443
      \u043A\u043E\u0441\u0442\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833549
    m_Localized: "\u0412 \u043E\u0442\u043B\u0438\u0447\u0438\u0435 \u043E\u0442
      \u043A\u043E\u0441\u0442\u0435\u0439, \u0437\u0443\u0431\u044B \u043D\u0435
      \u043C\u043E\u0433\u0443\u0442 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E
      \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0442\u044C\u0441\u044F
      \u0441\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833550
    m_Localized: "\u0413\u0443\u0431\u044B \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430
      \u043A\u0430\u0436\u0443\u0442\u0441\u044F \u043A\u0440\u0430\u0441\u043D\u044B\u043C\u0438
      \u0438\u0437-\u0437\u0430 \u0431\u043E\u043B\u044C\u0448\u043E\u0433\u043E
      \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u043A\u0440\u0430\u0441\u043D\u043E\u0433\u043E
      \u043F\u0438\u0433\u043C\u0435\u043D\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833551
    m_Localized: "\u0413\u0443\u0431\u044B \u0442\u043E\u043D\u043A\u0438\u0435,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0441\u043A\u0432\u043E\u0437\u044C
      \u043D\u0438\u0445 \u043F\u0440\u043E\u0441\u0432\u0435\u0447\u0438\u0432\u0430\u0435\u0442
      \u0446\u0432\u0435\u0442 \u0441\u043E\u0441\u0443\u0434\u043E\u0432 \u043F\u043E\u0434
      \u043A\u043E\u0436\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833552
    m_Localized: "\u042F\u0437\u044B\u043A \u2014 \u043E\u0434\u043D\u0430 \u0438\u0437
      \u0441\u0430\u043C\u044B\u0445 \u0431\u044B\u0441\u0442\u0440\u043E \u0437\u0430\u0436\u0438\u0432\u0430\u044E\u0449\u0438\u0445
      \u0447\u0430\u0441\u0442\u0435\u0439 \u0442\u0435\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833553
    m_Localized: "\u042F\u0437\u044B\u043A \u0437\u0430\u0436\u0438\u0432\u0430\u0435\u0442
      \u0431\u044B\u0441\u0442\u0440\u043E \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F
      \u0441\u0438\u043B\u044C\u043D\u043E\u043C\u0443 \u043A\u0440\u043E\u0432\u043E\u0442\u043E\u043A\u0443
      \u0438 \u0431\u044B\u0441\u0442\u0440\u043E\u043C\u0443 \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044E
      \u043A\u043B\u0435\u0442\u043E\u043A."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
