%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: StageTip_es-419
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: es-419
  m_SharedData: {fileID: 11400000, guid: b434763c88cad514394ee69eedd290e7, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1141485568
    m_Localized: "\u2022 Solo sube la boca de un color a la vez.\n\u2022 Cualquiera
      puede usar las placas blancas y negras si iguala su color.\n\u2022 Cuando aparezca
      \"TEAMCHEER\" arriba, griten la palabra de equipo."
    m_Metadata:
      m_Items: []
  - m_Id: 1183428608
    m_Localized: "\u2022 Cada zona necesita tantos jugadores como KKUL-TTEOK haya
      bajo su letrero: ni m\xE1s ni menos.\n\u2022 Cada uno ve algo distinto. \xA1Compartan
      lo que ven!\n\u2022 Cuando aparezca \"TEAMCHEER\" arriba, griten la palabra
      de equipo.\n\u2022 La mejora de defensa tambi\xE9n bloquea el da\xF1o por fallar
      la ronda."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622912
    m_Localized: "\u2022 Presiona Ctrl para igualar tu color con el piso blanco o
      negro y que no te apunten."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622913
    m_Localized: "\u2022 Qu\xE9date 2 segundos en una baldosa para puntuar.\n\u2022
      Las de color solo cuentan para ese color; las blancas y negras, para cualquiera."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622914
    m_Localized: "\u2022 Presiona Space cuando salga tu color.\n\u2022 El blanco
      lo puede presionar cualquiera. El negro pasa al siguiente turno despu\xE9s
      de 1 segundo.\n\u2022 Durante el minijuego no puedes usar el buff de Space."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622915
    m_Localized: "\u2022 Solo ves la siguiente baldosa.\n\u2022 Memoriza cu\xE1l
      tienes que presionar."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622916
    m_Localized: "\u2022 Presiona Ctrl para igualar tu color con el piso y que no
      te apunten.\n\u2022 Griten la palabra de equipo mientras aparezca \"TEAMCHEER\"
      para reparar el piso.\n\u2022 Si ya se rompi\xF3, aguanta hasta la siguiente
      advertencia."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622917
    m_Localized: "\u2022 Si sale una casilla de tu color, ponte encima.\n\u2022 Si
      no, aguanta en una casilla negra o blanca.\n\u2022 Iguala tambi\xE9n el color
      de tu personaje con el del piso.\n\u2022 La mejora de defensa tambi\xE9n bloquea
      el da\xF1o por fallar la ronda."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622918
    m_Localized: "\u2022 Embiste las paredes de tu color."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622919
    m_Localized: "\u2022 Memoriza el camino."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622920
    m_Localized: "\u2022 Pisa solo las baldosas de tu color.\n\u2022 Iguala el color
      de tu personaje con el de las baldosas."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622921
    m_Localized: "\u2022 Primero pasa el color de la zona; despu\xE9s pueden seguirle
      los dem\xE1s."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622922
    m_Localized: "\u2022 Pasa cada tramo antes de que se acabe el tiempo del letrero
      o se va a inundar de \xE1cido.\n\u2022 Iguala el color de las paredes laterales
      y emb\xEDstelas para hacerlas retroceder."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622923
    m_Localized: "\u2022 Un jugador por casilla; si hay m\xE1s, se hunde.\n\u2022
      Algunas casillas se rompen.\n\u2022 Si tocas las paredes delantera y trasera
      o las hinchazones, vas a salir despedido."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622924
    m_Localized: "\u2022 Un corredor recorre el laberinto y los dem\xE1s lo gu\xEDan
      desde el segundo piso.\n\u2022 Al pisar una placa se abren solo las puertas
      de ese color y se cierran todas las dem\xE1s."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622926
    m_Localized: "\u2022 Llega a la meta.\n\n\u2022 Supera esta fase antes de que
      el dulce toque el piso."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622927
    m_Localized: "\u2022 Pisa las placas para abrir camino y luego llega a la meta.\n\n\u2022
      Supera esta fase antes de que el dulce toque el piso."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622928
    m_Localized: "\u2022 Un jugador por casilla segura; compartirla hace da\xF1o.\n\n\u2022
      Supera esta fase antes de que el dulce toque el piso."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622929
    m_Localized: "\u2022 Iguala el color de la pared y emb\xEDstela."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891662639104
    m_Localized: "\u2022 Solo sube la boca de un color a la vez.\n\u2022 Cualquiera
      puede usar las placas blancas y negras si iguala su color."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891696193536
    m_Localized: "\u2022 Cada uno ve algo distinto. \xA1Compartan lo que ven!\n\u2022
      La mejora de defensa tambi\xE9n bloquea el da\xF1o por fallar la ronda."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891696193537
    m_Localized: "\u2022 Presiona Ctrl para igualar tu color con el piso y que no
      te apunten."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891696193538
    m_Localized: "\u2022 Cuando se abra la boca, griten la palabra de equipo para
      reparar el piso roto."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
