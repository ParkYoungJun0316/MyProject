  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: StageTip_es-419
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: es-419
  m_SharedData: {fileID: 11400000, guid: b434763c88cad514394ee69eedd290e7, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1141485568
    m_Localized: 'Solo sube una boca de un color a la vez.

      Cualquiera puede
      igualar su color y pisar las plataformas en blanco y negro.

      Cuando aparezca
      "TEAMCHEER" arriba, griten el grito de equipo.'
    m_Metadata:
      m_Items: []
  - m_Id: 1183428608
    m_Localized: 'El color asignado tiene que estar en esa zona.

      Cuando aparezca
      "TEAMCHEER" arriba, griten el grito de equipo.'
    m_Metadata:
      m_Items: []
  - m_Id: 1187622912
    m_Localized: Presiona Ctrl para igualar el color de tu personaje al piso blanco
      o negro y quitar el lock-on.
    m_Metadata:
      m_Items: []
  - m_Id: 1187622913
    m_Localized: "Qu\xE9date 2 segundos en una loseta para puntuar.\nLas de color
      \xFAnico solo cuentan para ese color. El blanco y el negro las puede pisar
      cualquiera."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622914
    m_Localized: "Presiona Space cuando salga tu color.\nEl blanco lo puede presionar
      cualquiera. El negro pasa al siguiente turno despu\xE9s de 1 segundo.\nDurante
      el minijuego no puedes usar el buff de Space."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622915
    m_Localized: 'Solo se ve una casilla por delante.

      Memoriza las que hay
      que presionar.'
    m_Metadata:
      m_Items: []
  - m_Id: 1187622916
    m_Localized: "Presiona Ctrl para igualar el color de tu personaje al del piso
      y quitar el lock-on.\nGriten el grito de equipo mientras est\xE9 \"TEAMCHEER\"
      para reparar el piso.\nSi ya est\xE1 roto, aguanten hasta el siguiente aviso."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622917
    m_Localized: "Si sale una casilla de color \xFAnico, ponte encima.\nSi no, aguanta
      en blanco o negro.\nCambia tambi\xE9n el color de tu personaje al del piso."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622918
    m_Localized: Si chocas contra las paredes laterales cuando muestren tu color,
      retroceden.
    m_Metadata:
      m_Items: []
  - m_Id: 1187622919
    m_Localized: Memoriza el camino.
    m_Metadata:
      m_Items: []
  - m_Id: 1187622920
    m_Localized: "Pisa solo las casillas de tu color.\nAunque el color coincida,
      no vale si tu personaje est\xE1 en blanco y negro."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622921
    m_Localized: El color encargado tiene que pasar primero para que el resto pueda
      pisar ese piso.
    m_Metadata:
      m_Items: []
  - m_Id: 1187622922
    m_Localized: 'Iguala el color de las paredes laterales y choca: retroceden.'
    m_Metadata:
      m_Items: []
  - m_Id: 1187622923
    m_Localized: "Si tocas las paredes de adelante o atr\xE1s, o los bultos, te aventan."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622924
    m_Localized: "Usa el buff para atrapar los gl\xF3bulos rojos."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622925
    m_Localized: Choca contra los bultos verdes y usa el rebote para huir.
    m_Metadata:
      m_Items: []
  - m_Id: 1187622926
    m_Localized: 'El color asignado abre el camino; luego lleguen a la meta.


      Terminen
      este tramo antes de que el caramelo toque el piso.'
    m_Metadata:
      m_Items: []
  - m_Id: 1187622927
    m_Localized: 'Pisen las plataformas para hacer un camino y lleguen a la meta.


      Terminen
      este tramo antes de que el caramelo toque el piso.'
    m_Metadata:
      m_Items: []
  - m_Id: 1187622928
    m_Localized: 'Pisa la plataforma del centro, salta y choca contra el caramelo
      del color que toque.


      Termina este tramo antes de que el caramelo toque
      el piso.'
    m_Metadata:
      m_Items: []
  - m_Id: 1187622929
    m_Localized: Iguala el color de la pared y choca para empujarla.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
