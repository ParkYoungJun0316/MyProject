%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: StageTip_es-419
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: es-419
  m_SharedData: {fileID: 11400000, guid: b434763c88cad514394ee69eedd290e7, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1141485568
    m_Localized: "\u2022 Solo sube una boca de un color a la vez.\n\u2022 Cualquiera
      puede igualar su color y pisar las plataformas en blanco y negro.\n\u2022 Cuando
      aparezca \"TEAMCHEER\" arriba, griten la palabra de equipo."
    m_Metadata:
      m_Items: []
  - m_Id: 1183428608
    m_Localized: "\u2022 El color asignado tiene que estar en esa zona.\n\u2022 Cuando
      aparezca \"TEAMCHEER\" arriba, griten la palabra de equipo.\n\u2022 La mejora
      de defensa tambi\xE9n bloquea el da\xF1o por fallar la ronda."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622912
    m_Localized: "\u2022 Presiona Ctrl para igualar el color de tu personaje al piso
      blanco o negro y quitar el lock-on."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622913
    m_Localized: "\u2022 Qu\xE9date 2 segundos en una loseta para puntuar.\n\u2022
      Las de color \xFAnico solo cuentan para ese color. El blanco y el negro las
      puede pisar cualquiera."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622914
    m_Localized: "\u2022 Presiona Space cuando salga tu color.\n\u2022 El blanco
      lo puede presionar cualquiera. El negro pasa al siguiente turno despu\xE9s
      de 1 segundo.\n\u2022 Durante el minijuego no puedes usar el buff de Space."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622915
    m_Localized: "\u2022 Solo se ve una casilla por delante.\n\u2022 Memoriza las
      que hay que presionar."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622916
    m_Localized: "\u2022 Presiona Ctrl para igualar el color de tu personaje al del
      piso y quitar el lock-on.\n\u2022 Griten la palabra de equipo mientras est\xE9
      \"TEAMCHEER\" para reparar el piso.\n\u2022 Si ya est\xE1 roto, aguanten hasta
      el siguiente aviso."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622917
    m_Localized: "\u2022 Si sale una casilla de color \xFAnico, ponte encima.\n\u2022
      Si no, aguanta en blanco o negro.\n\u2022 Cambia tambi\xE9n el color de tu
      personaje al del piso.\n\u2022 La mejora de defensa tambi\xE9n bloquea el da\xF1o
      por fallar la ronda."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622918
    m_Localized: "\u2022 Si chocas contra las paredes laterales cuando muestren tu
      color, retroceden."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622919
    m_Localized: "\u2022 Memoriza el camino."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622920
    m_Localized: "\u2022 Pisa solo las casillas de tu color.\n\u2022 Aunque el color
      coincida, no vale si tu personaje est\xE1 en blanco y negro."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622921
    m_Localized: "\u2022 El color encargado tiene que pasar primero para que el resto
      pueda pisar ese piso."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622922
    m_Localized: "\u2022 Iguala el color de las paredes laterales y choca: retroceden."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622923
    m_Localized: "\u2022 Si tocas las paredes de adelante o atr\xE1s, o los bultos,
      te aventan."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622924
    m_Localized: "\u2022 Pisar un pad en cualquier parte abre y cierra las puertas.\n\u2022
      Cuando se abren las puertas negras, se cierran las blancas, y al rev\xE9s.\n\u2022
      Busquen primero el camino hacia el segundo piso."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622926
    m_Localized: "\u2022 El color asignado abre el camino; luego lleguen a la meta.\n\n\u2022
      Terminen este tramo antes de que el caramelo toque el piso."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622927
    m_Localized: "\u2022 Pisen las plataformas para hacer un camino y lleguen a la
      meta.\n\n\u2022 Terminen este tramo antes de que el caramelo toque el piso."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622928
    m_Localized: "\u2022 Pisa la plataforma del centro, salta y choca contra el caramelo
      del color que toque.\n\n\u2022 Termina este tramo antes de que el caramelo
      toque el piso."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622929
    m_Localized: "\u2022 Iguala el color de la pared y choca para empujarla."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891662639104
    m_Localized: "\u2022 Solo sube una boca de un color a la vez.\n\u2022 Cualquiera
      puede igualar su color y pisar las plataformas en blanco y negro."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891696193536
    m_Localized: "\u2022 La mejora de defensa tambi\xE9n bloquea el da\xF1o por fallar
      la ronda."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891696193537
    m_Localized: "\u2022 Presiona Ctrl para igualar el color de tu personaje al del
      piso y quitar el lock-on."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891696193538
    m_Localized: "\u2022 Cuando se abra la boca, griten la palabra de equipo para
      reparar el piso roto."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
