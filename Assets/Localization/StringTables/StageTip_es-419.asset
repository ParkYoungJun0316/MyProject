%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: StageTip_es-419
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: es-419
  m_SharedData: {fileID: 11400000, guid: b434763c88cad514394ee69eedd290e7, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1141485568
    m_Localized: "\u2022 Solo se eleva la boca de un color a la vez.\n\u2022 Cualquiera
      puede usar las plataformas negras y blancas al hacer coincidir su color.\n\u2022
      Cuando aparezca \xABTEAMCHEER\xBB en la parte superior, grita el grito de equipo."
    m_Metadata:
      m_Items: []
  - m_Id: 1183428608
    m_Localized: "\u2022 Cada zona necesita exactamente tantos jugadores como KKUL-TTEOK
      haya debajo de su se\xF1al. Ni uno m\xE1s ni uno menos.\n\u2022 Cada jugador
      ve algo diferente. \xA1Comparte lo que ves!\n\u2022 Cuando aparezca \xABTEAMCHEER\xBB
      en la parte superior, grita el grito de equipo.\n\u2022 El potenciador de defensa
      tambi\xE9n bloquea el da\xF1o por fallar la ronda."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622912
    m_Localized: "\u2022 Presiona Ctrl para hacer coincidir tu color con el piso
      negro o blanco y evitar ser el objetivo."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622913
    m_Localized: "\u2022 Qu\xE9date sobre una casilla durante 2 segundos para ganar
      puntos.\n\u2022 Las casillas de colores solo cuentan para los jugadores de
      ese color. Las casillas negras y blancas cuentan para cualquiera."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622914
    m_Localized: "\u2022 Presiona Space cuando se ilumine tu color.\n\u2022 Cualquiera
      puede golpear la casilla blanca. La negra pasa al siguiente turno despu\xE9s
      de 1 segundo.\n\u2022 No puedes usar tu potenciador de Space durante este minijuego."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622915
    m_Localized: "\u2022 Solo puedes ver la casilla que est\xE1 justo adelante.\n\u2022
      Memoriza qu\xE9 casilla debes presionar."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622916
    m_Localized: "\u2022 Presiona Ctrl para hacer coincidir tu color con el piso
      y evitar ser el objetivo.\n\u2022 Cuando aparezca \xABTEAMCHEER\xBB, grita
      el grito de equipo para reparar el piso.\n\u2022 Si ya est\xE1 roto, resiste
      hasta la siguiente advertencia."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622917
    m_Localized: "\u2022 Si aparece una casilla de tu color, p\xE1rate sobre ella.\n\u2022
      Si no, resiste sobre una casilla negra o blanca.\n\u2022 Haz coincidir tambi\xE9n
      el color de tu personaje con el del piso.\n\u2022 El potenciador de defensa
      tambi\xE9n bloquea el da\xF1o por fallar la ronda."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622918
    m_Localized: "\u2022 Embiste las paredes que coincidan con tu color."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622919
    m_Localized: "\u2022 Memoriza el camino."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622920
    m_Localized: "\u2022 Pisa solo las casillas de tu color.\n\u2022 Haz coincidir
      el color de tu personaje con el de las casillas."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622921
    m_Localized: "\u2022 El jugador del color de la zona va primero y los dem\xE1s
      pueden seguirlo."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622922
    m_Localized: "\u2022 Limpia cada secci\xF3n antes de que se acabe el temporizador
      de la se\xF1al o el \xE1cido inundar\xE1 la zona.\n\u2022 Haz coincidir el
      color de las paredes laterales y emb\xEDstelas para hacerlas retroceder."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622923
    m_Localized: "\u2022 Solo puede haber un jugador por casilla. Si hay m\xE1s,
      se hundir\xE1.\n\u2022 Algunas casillas pueden romperse.\n\u2022 Tocar las
      paredes del frente y de atr\xE1s o las protuberancias har\xE1 que retrocedas."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622924
    m_Localized: "\u2022 Un jugador atraviesa el laberinto mientras los dem\xE1s
      lo gu\xEDan desde el segundo piso.\n\u2022 Al pisar una plataforma, solo se
      abren las puertas de ese color y todas las dem\xE1s se cierran."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622926
    m_Localized: "\u2022 Llega a la meta.\n\n\u2022 Completa esta secci\xF3n antes
      de que el caramelo toque el suelo."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622927
    m_Localized: "\u2022 Pisa las plataformas para crear un camino y despu\xE9s llega
      a la meta.\n\n\u2022 Completa esta secci\xF3n antes de que el caramelo toque
      el suelo."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622928
    m_Localized: "\u2022 Solo puede haber un jugador por casilla segura. Si dos se
      juntan, recibir\xE1n da\xF1o.\n\n\u2022 Completa esta secci\xF3n antes de que
      el caramelo toque el suelo."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622929
    m_Localized: "\u2022 Haz coincidir tu color con el de la pared y emb\xEDstela."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891662639104
    m_Localized: "\u2022 Solo se eleva la boca de un color a la vez.\n\u2022 Cualquiera
      puede usar las plataformas negras y blancas al hacer coincidir su color."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891696193536
    m_Localized: "\u2022 Cada jugador ve algo diferente. \xA1Comparte lo que ves!\n\u2022
      El potenciador de defensa tambi\xE9n bloquea el da\xF1o por fallar la ronda."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891696193537
    m_Localized: "\u2022 Presiona Ctrl para hacer coincidir tu color con el piso
      y evitar ser el objetivo."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891696193538
    m_Localized: "\u2022 Cuando la boca se abra, grita el grito de equipo para reparar
      el piso roto."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
