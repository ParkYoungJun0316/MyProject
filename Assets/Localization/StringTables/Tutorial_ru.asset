  - m_Id: 53793073508352
    m_Localized: "\u0417\u0434\u0435\u0441\u044C \u043C\u043E\u0436\u043D\u043E \u0432
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0440\u0430\u0437 \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C
      \u0441\u0432\u043E\u0451 \u0438\u043C\u044F \u0438 \u043A\u043E\u043C\u0430\u043D\u0434\u043D\u043E\u0435
      \u0441\u043B\u043E\u0432\u043E.\n\u0415\u0441\u043B\u0438 \u0443\u043F\u0443\u0441\u0442\u0438\u0448\u044C
      \u044D\u0442\u043E\u0442 \u043C\u043E\u043C\u0435\u043D\u0442, \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C
      \u0438\u0445 \u0431\u0443\u0434\u0435\u0442 \u043D\u0435\u043B\u044C\u0437\u044F
      \u0434\u043E \u043A\u043E\u043D\u0446\u0430 \u043F\u0430\u0440\u0442\u0438\u0438,\n\u0442\u0430\u043A
      \u0447\u0442\u043E \u0435\u0441\u043B\u0438 \u0445\u043E\u0447\u0435\u0448\u044C
      \u0447\u0442\u043E-\u0442\u043E \u043F\u043E\u043C\u0435\u043D\u044F\u0442\u044C
      \u2014 \u0441\u0434\u0435\u043B\u0430\u0439 \u044D\u0442\u043E \u0441\u0435\u0439\u0447\u0430\u0441
      \u0443 \u0442\u0430\u0431\u043B\u0438\u0447\u043A\u0438."
