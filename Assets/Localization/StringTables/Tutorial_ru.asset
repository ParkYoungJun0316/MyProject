  - m_Id: 1086959616
    m_Localized: "\u0422\u043E\u043B\u0447\u043E\u043A (0 \u0443\u0440\u043E\u043D\u0430)"
    m_Metadata:
      m_Items: []
  - m_Id: 1086959617
    m_Localized: "\u0427\u0451\u0440\u043D\u043E-\u0431\u0435\u043B\u044B\u0439 \u0440\u0435\u0436\u0438\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 1086959618
    m_Localized: "\u0421\u0432\u043E\u0439 \u0446\u0432\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153920
    m_Localized: "\u0421\u043C\u0435\u043D\u0430 \u0431\u0430\u0444\u0444\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153921
    m_Localized: "\u041B\u0438\u0447\u043D\u0430\u044F \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153922
    m_Localized: "\u041F\u0440\u043E\u043A\u0440\u0438\u0447\u0438 \u0441\u0432\u043E\u0451
      \u0438\u043C\u044F, \u0447\u0442\u043E\u0431\u044B \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u0431\u0430\u0444\u0444.\n\u041D\u0430\u0436\u043C\u0438 E, \u0447\u0442\u043E\u0431\u044B
      \u0437\u0430\u0434\u0430\u0442\u044C \u043D\u0438\u043A\u043D\u0435\u0439\u043C.\n\u041E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E
      \u043F\u0440\u043E\u0432\u0435\u0440\u044C, \u043A\u0430\u043A \u044D\u0442\u043E
      \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442!"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153923
    m_Localized: "\u041A\u043E\u043C\u0430\u043D\u0434\u043D\u0430\u044F \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153924
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u043F\u043E\u044F\u0432\u0438\u0442\u0441\u044F
      \u0437\u043D\u0430\u0447\u043E\u043A \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F,
      \u043F\u0440\u043E\u043A\u0440\u0438\u0447\u0438\u0442\u0435 \u043A\u043E\u043C\u0430\u043D\u0434\u043D\u043E\u0435
      \u0441\u043B\u043E\u0432\u043E \u0432\u0441\u0435 \u0432\u043C\u0435\u0441\u0442\u0435.\n\u042D\u0442\u043E
      \u043E\u0442\u043C\u0435\u043D\u044F\u0435\u0442 \u0443\u0433\u0440\u043E\u0437\u0443,
      \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u0442\u043E\u043B\u044C\u043A\u043E
      \u0447\u0442\u043E \u0441\u043E\u0437\u0434\u0430\u043B\u0438 \u0440\u043E\u0442
      \u0438\u043B\u0438 \u043F\u0438\u0449\u0435\u0432\u043E\u0434.\n\u041A\u043E\u043C\u0430\u043D\u0434\u043D\u043E\u0435
      \u0441\u043B\u043E\u0432\u043E \u043C\u043E\u0436\u0435\u0442 \u0437\u0430\u0434\u0430\u0442\u044C
      \u0442\u043E\u043B\u044C\u043A\u043E \u0445\u043E\u0441\u0442 \u2014 \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0435\u0441\u044C
      \u0437\u0430\u0440\u0430\u043D\u0435\u0435 \u0432\u0441\u0435\u0439 \u043A\u043E\u043C\u0430\u043D\u0434\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 1091153925
    m_Localized: "\u0418\u043C\u044F \u0434\u043B\u044F \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153926
    m_Localized: "\u0418\u043C\u044F \u0434\u043B\u044F \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0438
      \u043C\u043E\u0436\u043D\u043E \u0432\u0432\u0435\u0441\u0442\u0438 \u0442\u043E\u043B\u044C\u043A\u043E
      \u043D\u0430 \u0430\u043D\u0433\u043B\u0438\u0439\u0441\u043A\u043E\u043C.\n\u0427\u0435\u043C
      \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u0435\u0435 \u0437\u0432\u0443\u0447\u0438\u0442
      \u0441\u043B\u043E\u0432\u043E, \u043A\u043E\u0433\u0434\u0430 \u0435\u0433\u043E
      \u043F\u0440\u043E\u0438\u0437\u043D\u043E\u0441\u0438\u0448\u044C, \u0442\u0435\u043C
      \u043B\u0443\u0447\u0448\u0435 \u043E\u043D\u043E \u0440\u0430\u0441\u043F\u043E\u0437\u043D\u0430\u0451\u0442\u0441\u044F!\n\u041D\u0435\u0442
      \u043C\u0438\u043A\u0440\u043E\u0444\u043E\u043D\u0430 \u0438\u043B\u0438 \u0440\u0430\u0441\u043F\u043E\u0437\u043D\u0430\u0432\u0430\u043D\u0438\u0435
      \u043D\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442? \u0412\u043A\u043B\u044E\u0447\u0438
      \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0443 \u0446\u0438\u0444\u0440\u043E\u0432\u044B\u043C\u0438
      \u043A\u043B\u0430\u0432\u0438\u0448\u0430\u043C\u0438 \u0432 \u043C\u0435\u043D\u044E
      ESC.\n(1 \u2014 \u043B\u0438\u0447\u043D\u0430\u044F \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0430,
      2 \u2014 \u043A\u043E\u043C\u0430\u043D\u0434\u043D\u0430\u044F, \u043D\u043E
      \u043A\u0440\u0438\u0447\u0430\u0442\u044C \u0433\u043E\u043B\u043E\u0441\u043E\u043C
      \u0433\u043E\u0440\u0430\u0437\u0434\u043E \u0432\u0435\u0441\u0435\u043B\u0435\u0435!)"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153927
    m_Localized: "\u0422\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043A\u0430 \u043A\u043E\u043C\u0430\u043D\u0434\u043D\u043E\u0439
      \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153928
    m_Localized: "\u041D\u0430\u0436\u043C\u0438 [E] \u2014 \u043F\u043E\u044F\u0432\u0438\u0442\u0441\u044F
      \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435,
      \u043A\u0430\u043A \u043E\u0442 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0439
      \u0443\u0433\u0440\u043E\u0437\u044B,\n\u0438 \u0440\u043E\u0442 \u043D\u0430\u0432\u0435\u0440\u0445\u0443
      \u0437\u0430\u043A\u0440\u043E\u0435\u0442\u0441\u044F.\n\u041F\u0440\u043E\u043A\u0440\u0438\u0447\u0438\u0442\u0435
      \u043A\u043E\u043C\u0430\u043D\u0434\u043D\u043E\u0435 \u0441\u043B\u043E\u0432\u043E
      \u0432\u0441\u0435 \u0432\u043C\u0435\u0441\u0442\u0435, \u0447\u0442\u043E\u0431\u044B
      \u0441\u043D\u043E\u0432\u0430 \u0435\u0433\u043E \u043E\u0442\u043A\u0440\u044B\u0442\u044C.\n\u041D\u0430\u0434
      \u0433\u043E\u043B\u043E\u0432\u043E\u0439 \u0442\u043E\u0433\u043E, \u043A\u0442\u043E
      \u043A\u0440\u0438\u0447\u0430\u043B, \u043F\u043E\u044F\u0432\u0438\u0442\u0441\u044F
      \u0441\u0435\u0440\u0434\u0435\u0447\u043A\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1091153929
    m_Localized: "\u041F\u043E\u0440\u0430 \u043D\u0430\u0447\u0438\u043D\u0430\u0442\u044C
      \u0438\u0433\u0440\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153930
    m_Localized: "\u0421\u0442\u0430\u0440\u0442\u043E\u0432\u0430\u044F \u0437\u043E\u043D\u0430
      \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u043D\u0430 \u0436\u0451\u043B\u0442\u043E\u043C
      \u043F\u043E\u043B\u0443.\n\u041A\u0430\u043A \u0442\u043E\u043B\u044C\u043A\u043E
      \u0432\u0441\u044F \u043A\u043E\u043C\u0430\u043D\u0434\u0430 \u0441\u043E\u0431\u0435\u0440\u0451\u0442\u0441\u044F
      \u0442\u0430\u043C, \u043D\u0430\u0447\u043D\u0451\u0442\u0441\u044F \u043E\u0442\u0441\u0447\u0451\u0442,
      \u0438 \u0438\u0433\u0440\u0430 \u0437\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u0441\u044F.\n\u0418\u043C\u044F
      \u0434\u043B\u044F \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0438 \u0444\u0438\u043A\u0441\u0438\u0440\u0443\u0435\u0442\u0441\u044F
      \u0432 \u0442\u043E\u0442 \u043C\u043E\u043C\u0435\u043D\u0442, \u043A\u043E\u0433\u0434\u0430
      \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u0441\u044F \u043E\u0442\u0441\u0447\u0451\u0442,\n\u0442\u0430\u043A
      \u0447\u0442\u043E \u0443\u0431\u0435\u0434\u0438\u0442\u0435\u0441\u044C,
      \u0447\u0442\u043E \u0432\u0441\u0435 \u0443\u0436\u0435 \u0432\u0441\u0451
      \u0432\u044B\u0431\u0440\u0430\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 24992255946752
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438 \u0441\u0432\u043E\u0451 \u0438\u043C\u044F
      \u0434\u043B\u044F \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 24992293695488
    m_Localized: "\u0422\u0430\u043A \u043D\u0435\u043B\u044C\u0437\u044F\n\xB7 \u0420\u0443\u0433\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430/\u0437\u0430\u043F\u0440\u0435\u0449\u0451\u043D\u043D\u044B\u0435
      \u0441\u043B\u043E\u0432\u0430 (\u043D\u0430\u043F\u0440.: fuck)\n\xB7 \u0417\u0430\u0440\u0435\u0437\u0435\u0440\u0432\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0435
      \u0441\u043B\u043E\u0432\u0430 (admin, host, cheer)\n\xB7 \u0426\u0438\u0444\u0440\u044B,
      \u0437\u043D\u0430\u043A \u043F\u043E\u0434\u0447\u0451\u0440\u043A\u0438\u0432\u0430\u043D\u0438\u044F
      (_), \u043A\u043E\u0440\u0435\u0439\u0441\u043A\u0438\u0435 \u0431\u0443\u043A\u0432\u044B,
      \u044D\u043C\u043E\u0434\u0437\u0438, \u043E\u0434\u043D\u0430 \u0431\u0443\u043A\u0432\u0430\n\xB7
      2\u201312 \u0441\u0438\u043C\u0432\u043E\u043B\u043E\u0432, \u0442\u043E\u043B\u044C\u043A\u043E
      \u0441\u0442\u0440\u043E\u0447\u043D\u044B\u0435 \u043B\u0430\u0442\u0438\u043D\u0441\u043A\u0438\u0435
      \u0431\u0443\u043A\u0432\u044B\n\n\u041F\u043E\u0441\u043B\u0435 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u044F
      \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E \u043F\u0440\u043E\u0432\u0435\u0440\u044C,
      \u0440\u0430\u0441\u043F\u043E\u0437\u043D\u0430\u0451\u0442\u0441\u044F \u043B\u0438
      \u0438\u043C\u044F \u043D\u0430 \u0441\u0430\u043C\u043E\u043C \u0434\u0435\u043B\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889792
    m_Localized: "\u043D\u0430\u043F\u0440.: happy"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889793
    m_Localized: "\u043D\u0430\u043F\u0440.: fighting"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889794
    m_Localized: "\u041F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889795
    m_Localized: "\u0417\u0430\u043A\u0440\u044B\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889796
    m_Localized: "\u0417\u0430\u0434\u0430\u0439\u0442\u0435 \u0441\u043B\u043E\u0432\u043E,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0432\u0441\u044F \u043A\u043E\u043C\u0430\u043D\u0434\u0430
      \u0431\u0443\u0434\u0435\u0442 \u043A\u0440\u0438\u0447\u0430\u0442\u044C \u0432\u043C\u0435\u0441\u0442\u0435
      (\u043F\u043E \u0443\u043C\u043E\u043B\u0447\u0430\u043D\u0438\u044E: FIGHTING)"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889797
    m_Localized: "\u041A\u043E\u043C\u0430\u043D\u0434\u043D\u043E\u0435 \u0441\u043B\u043E\u0432\u043E:
      {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647744
    m_Localized: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439 \u043E\u0442
      2 \u0434\u043E 12 \u0441\u0442\u0440\u043E\u0447\u043D\u044B\u0445 \u043B\u0430\u0442\u0438\u043D\u0441\u043A\u0438\u0445
      \u0431\u0443\u043A\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647745
    m_Localized: "\u042D\u0442\u043E \u0438\u043C\u044F \u2014 \u0437\u0430\u0440\u0435\u0437\u0435\u0440\u0432\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0435
      \u0441\u0438\u0441\u0442\u0435\u043C\u043D\u043E\u0435 \u0441\u043B\u043E\u0432\u043E,
      \u0435\u0433\u043E \u043D\u0435\u043B\u044C\u0437\u044F \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647746
    m_Localized: "\u042D\u0442\u043E \u0441\u043B\u043E\u0432\u043E \u2014 \u0437\u0430\u0440\u0435\u0437\u0435\u0440\u0432\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0435
      \u0441\u0438\u0441\u0442\u0435\u043C\u043D\u043E\u0435 \u0441\u043B\u043E\u0432\u043E,
      \u0435\u0433\u043E \u043D\u0435\u043B\u044C\u0437\u044F \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647747
    m_Localized: "\u0417\u0434\u0435\u0441\u044C \u0435\u0441\u0442\u044C \u0441\u043B\u043E\u0432\u043E,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u043D\u0435\u043B\u044C\u0437\u044F
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647748
    m_Localized: "\u042D\u0442\u043E \u0438\u043C\u044F \u0443\u0436\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442
      \u0434\u0440\u0443\u0433\u043E\u0439 \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A
      \u043A\u043E\u043C\u0430\u043D\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647749
    m_Localized: "\u041A\u0442\u043E-\u0442\u043E \u0438\u0437 \u043A\u043E\u043C\u0430\u043D\u0434\u044B
      \u0443\u0436\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442
      \u044D\u0442\u043E \u043A\u0430\u043A \u0438\u043C\u044F \u0434\u043B\u044F
