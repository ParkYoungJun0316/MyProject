    m_Localized: "\u0414\u0432\u0438\u0436\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1086959616
    m_Localized: "\u0422\u043E\u043B\u0447\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 1086959617
    m_Localized: "\u0421\u043C\u0435\u043D\u0430 \u0446\u0432\u0435\u0442\u0430 \u0447/\u0431"
    m_Metadata:
      m_Items: []
  - m_Id: 1086959618
    m_Localized: "\u0421\u043C\u0435\u043D\u0430 \u0446\u0432\u0435\u0442\u0430 \u0441\u0432\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153920
    m_Localized: "\u0421\u043C\u0435\u043D\u0430 \u0431\u0430\u0444\u0444\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153923
    m_Localized: "\u041A\u043E\u043C\u0430\u043D\u0434\u043D\u044B\u0439 \u043A\u043B\u0438\u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153924
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u043F\u043E\u044F\u0432\u0438\u0442\u0441\u044F
      \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435,
      \u043F\u0440\u043E\u043A\u0440\u0438\u0447\u0438\u0442\u0435 \u043A\u043E\u043C\u0430\u043D\u0434\u043D\u044B\u0439
      \u043A\u043B\u0438\u0447 \u0432\u0441\u0435 \u0432\u043C\u0435\u0441\u0442\u0435.\n\u041A\u0440\u0438\u0447\u0438
      \u0442\u0430\u043A \u0436\u0435, \u043A\u0430\u043A \u0437\u0430\u043F\u0438\u0441\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 1091153925
    m_Localized: "\u0417\u0430\u0434\u0430\u0442\u044C \u043A\u043E\u043C\u0430\u043D\u0434\u043D\u044B\u0439
      \u043A\u043B\u0438\u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153926
    m_Localized: "\u0425\u043E\u0441\u0442 \u0437\u0430\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442
      \u0437\u0432\u0443\u043A,\n\u0430 \u0432\u0441\u0435 \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u044E\u0442
      \u0435\u0433\u043E \u0434\u0432\u0430\u0436\u0434\u044B.\n\u041D\u0435\u0442
      \u043C\u0438\u043A\u0440\u043E\u0444\u043E\u043D\u0430? \u0412\u043A\u043B\u044E\u0447\u0438
      \xAB\u041F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0430 \u043A\u043B\u0430\u0432\u0438\u0448\u0435\u0439
      T\xBB \u0432 \u043E\u043F\u0446\u0438\u044F\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 24992255946752
    m_Localized: "\u041A\u043E\u043C\u0430\u043D\u0434\u043D\u044B\u0439 \u043A\u043B\u0438\u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889793
    m_Localized: "\u043D\u0430\u043F\u0440.: fighting"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889794
    m_Localized: "\u041F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889795
    m_Localized: "\u0417\u0430\u043A\u0440\u044B\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889796
    m_Localized: "\u0425\u043E\u0441\u0442: \u0437\u0430\u043F\u0438\u0448\u0438
      \u0437\u0432\u0443\u043A, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043A\u043E\u043C\u0430\u043D\u0434\u0430
      \u0431\u0443\u0434\u0435\u0442 \u043A\u0440\u0438\u0447\u0430\u0442\u044C.\n\u041F\u043E\u0434\u043E\u0439\u0434\u0451\u0442
      \u043B\u044E\u0431\u043E\u0435 \u0441\u043B\u043E\u0432\u043E \u0438\u043B\u0438
      \u0437\u0432\u0443\u043A (\u0437\u0432\u0443\u043A \u043E\u0442 0,5 \u0441,
      \u0437\u0430\u043F\u0438\u0441\u044C \u0434\u043E 3 \u0441)"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889797
    m_Localized: "\u041A\u043E\u043C\u0430\u043D\u0434\u043D\u044B\u0439 \u043A\u043B\u0438\u0447:
      {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647744
    m_Localized: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439 \u043E\u0442
      2 \u0434\u043E 12 \u0441\u0442\u0440\u043E\u0447\u043D\u044B\u0445 \u043B\u0430\u0442\u0438\u043D\u0441\u043A\u0438\u0445
      \u0431\u0443\u043A\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647746
    m_Localized: "\u042D\u0442\u043E \u0441\u043B\u043E\u0432\u043E \u2014 \u0437\u0430\u0440\u0435\u0437\u0435\u0440\u0432\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0435
      \u0441\u0438\u0441\u0442\u0435\u043C\u043D\u043E\u0435 \u0441\u043B\u043E\u0432\u043E,
      \u0435\u0433\u043E \u043D\u0435\u043B\u044C\u0437\u044F \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647747
    m_Localized: "\u0417\u0434\u0435\u0441\u044C \u0435\u0441\u0442\u044C \u0441\u043B\u043E\u0432\u043E,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u043D\u0435\u043B\u044C\u0437\u044F
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647751
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044C
      \u043A\u043E\u043C\u0430\u043D\u0434\u043D\u044B\u0439 \u043A\u043B\u0438\u0447."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647752
    m_Localized: "\u0422\u043E\u043B\u044C\u043A\u043E \u0445\u043E\u0441\u0442 \u043C\u043E\u0436\u0435\u0442
      \u0437\u0430\u0434\u0430\u0442\u044C \u043A\u043E\u043C\u0430\u043D\u0434\u043D\u044B\u0439
      \u043A\u043B\u0438\u0447."
    m_Metadata:
      m_Items: []
  - m_Id: 53793039953920
    m_Localized: "\u0418\u0437\u043C\u0435\u043D\u0438\u0442\u044C \u043A\u043E\u043C\u0430\u043D\u0434\u043D\u044B\u0439
      \u043A\u043B\u0438\u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 53793073508352
    m_Localized: "\u041A\u043E\u043C\u0430\u043D\u0434\u043D\u044B\u0439 \u043A\u043B\u0438\u0447
      \u043C\u043E\u0436\u043D\u043E \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C
      \u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0440\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 56930631004160
    m_Localized: "[E] \u0417\u0430\u043F\u0438\u0441\u0430\u0442\u044C \u043A\u043E\u043C\u0430\u043D\u0434\u043D\u044B\u0439
      \u043A\u043B\u0438\u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 56930635198464
    m_Localized: "[E] \u0422\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043A\u0430
      \u043A\u043B\u0438\u0447\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1395064700000001
    m_Localized: "\u041F\u043E\u043A\u0430\u0437\u0430\u0442\u044C Tip"
    m_Metadata:
      m_Items: []
  - m_Id: 3228654335799296
    m_Localized: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0431\u0430\u0444\u0444"
    m_Metadata:
      m_Items: []
  - m_Id: 3228654377742336
    m_Localized: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u044D\u043C\u043E\u0446\u0438\u044E (1-8)"
    m_Metadata:
      m_Items: []
  - m_Id: 3228654377742337
    m_Localized: "\u042D\u0442\u043E \u0438\u0433\u0440\u0430 \u0441 \u0440\u0430\u0441\u043F\u043E\u0437\u043D\u0430\u0432\u0430\u043D\u0438\u0435\u043C
      \u0433\u043E\u043B\u043E\u0441\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 9458308059082752
    m_Localized: "\u0420\u0430\u0441\u043F\u043E\u0437\u043D\u0430\u0432\u0430\u043D\u0438\u0435
      \u0433\u043E\u043B\u043E\u0441\u0430 \u043D\u0435 \u0437\u043D\u0430\u0435\u0442
      \u044D\u0442\u043E\u0433\u043E \u0441\u043B\u043E\u0432\u0430. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439
      \u0434\u0440\u0443\u0433\u043E\u0435 \u0430\u043D\u0433\u043B\u0438\u0439\u0441\u043A\u043E\u0435
      \u0441\u043B\u043E\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 9787340243972096
    m_Localized: "[E] \u041D\u0430\u0440\u044F\u0434\u0438\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884459483136
    m_Localized: "\u0417\u0430\u043F\u0438\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426176
    m_Localized: "\u0421\u0442\u043E\u043F ({0:0.0} \u0441)"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426177
    m_Localized: "\u0417\u0430\u043F\u0438\u0441\u044C 1"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426178
    m_Localized: "\u0417\u0430\u043F\u0438\u0441\u044C 2"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426179
    m_Localized: "\u041F\u0440\u043E\u0441\u043B\u0443\u0448\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426180
    m_Localized: "\u041F\u043E\u0441\u043B\u0443\u0448\u0430\u0442\u044C \u0445\u043E\u0441\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426181
    m_Localized: "\u0425\u043E\u0441\u0442 \u0435\u0449\u0451 \u043D\u0435 \u0437\u0430\u043F\u0438\u0441\u0430\u043B
      \u043A\u043E\u043C\u0430\u043D\u0434\u043D\u044B\u0439 \u043A\u043B\u0438\u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426182
    m_Localized: "\u041A\u043B\u0438\u0447 \u0433\u043E\u0442\u043E\u0432 ({1:0.0}
      \u0441)"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426183
    m_Localized: "\u0417\u0430\u043F\u0438\u0441\u0430\u043D\u043E. \u041F\u0440\u043E\u0441\u043B\u0443\u0448\u0430\u0439
      \u0438 \u043D\u0430\u0436\u043C\u0438 [\u041F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044C]"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426184
    m_Localized: "\u041F\u043E\u0441\u043B\u0443\u0448\u0430\u0439 \u0445\u043E\u0441\u0442\u0430
      \u0438 \u0441\u0434\u0435\u043B\u0430\u0439 [\u0417\u0430\u043F\u0438\u0441\u044C
      1] \u0442\u0430\u043A \u0436\u0435 (\u043E\u0442 0,5 \u0441)"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426185
    m_Localized: "\u0415\u0449\u0451 \u0440\u0430\u0437 \u0442\u0430\u043A \u0436\u0435:
      [\u0417\u0430\u043F\u0438\u0441\u044C 2]"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426186
    m_Localized: "\u0413\u043E\u0442\u043E\u0432\u043E! \u0422\u0435\u043F\u0435\u0440\u044C
      \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439 \u0443 \u0442\u0430\u0431\u043B\u0438\u0447\u043A\u0438
      \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426187
    m_Localized: "\u0425\u043E\u0441\u0442 \u043F\u0435\u0440\u0435\u0437\u0430\u043F\u0438\u0441\u0430\u043B
      \u043A\u043B\u0438\u0447. \u0417\u0430\u043F\u0438\u0448\u0438\u0441\u044C
      \u0437\u0430\u043D\u043E\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426188
    m_Localized: "\u041D\u0435\u0442 \u0437\u0432\u0443\u043A\u0430 \u0441 \u043C\u0438\u043A\u0440\u043E\u0444\u043E\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426189
    m_Localized: "\u0421\u043B\u0438\u0448\u043A\u043E\u043C \u0442\u0438\u0445\u043E.
      \u041A\u0440\u0438\u0447\u0438 \u0433\u0440\u043E\u043C\u0447\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426190
    m_Localized: "\u0421\u043B\u0438\u0448\u043A\u043E\u043C \u0433\u0440\u043E\u043C\u043A\u043E,
      \u0437\u0432\u0443\u043A \u0438\u0441\u043A\u0430\u0436\u0430\u0435\u0442\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426191
    m_Localized: "\u0421\u043B\u0438\u0448\u043A\u043E\u043C \u043A\u043E\u0440\u043E\u0442\u043A\u043E.
      \u0418\u0437\u0434\u0430\u0432\u0430\u0439 \u0437\u0432\u0443\u043A \u043D\u0435
      \u043C\u0435\u043D\u044C\u0448\u0435 0,5 \u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426192
    m_Localized: "\u0421\u043B\u0438\u0448\u043A\u043E\u043C \u0434\u043E\u043B\u0433\u043E
      (\u0434\u043E 3 \u0441)"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426193
    m_Localized: "\u0414\u0440\u0443\u0433\u043E\u0435 \u0447\u0438\u0441\u043B\u043E
      \u043F\u0430\u0443\u0437 (\u0445\u043E\u0441\u0442 {0}, \u0442\u044B {1})"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426194
    m_Localized: "\u0414\u0440\u0443\u0433\u0430\u044F \u0438\u043D\u0442\u043E\u043D\u0430\u0446\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426195
    m_Localized: "\u0417\u0432\u0443\u0447\u0438\u0442 \u0438\u043D\u0430\u0447\u0435.
      \u041F\u043E\u0441\u043B\u0443\u0448\u0430\u0439 \u0445\u043E\u0441\u0442\u0430
      \u0435\u0449\u0451 \u0440\u0430\u0437 \u0438 \u043F\u043E\u0432\u0442\u043E\u0440\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426196
    m_Localized: "\u041D\u0435 \u043F\u043E\u0445\u043E\u0436\u0435 \u043D\u0430
      \u0437\u0430\u043F\u0438\u0441\u044C 1. \u041A\u0440\u0438\u0447\u0438 \u0442\u0430\u043A
      \u0436\u0435, \u043A\u0430\u043A \u0432 \u0437\u0430\u043F\u0438\u0441\u0438
      1"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426197
    m_Localized: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426198
    m_Localized: "\u041A\u043B\u0438\u0447 \u0432\u044B\u0431\u0440\u0430\u043D!
      \u041E\u0442\u043F\u0440\u0430\u0432\u043B\u0435\u043D \u043A\u043E\u043C\u0430\u043D\u0434\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426199
    m_Localized: "\u0427\u0442\u043E\u0431\u044B \u043D\u0430\u0447\u0430\u0442\u044C,
      \u0445\u043E\u0441\u0442 \u0434\u043E\u043B\u0436\u0435\u043D \u0437\u0430\u043F\u0438\u0441\u0430\u0442\u044C
      \u043A\u043B\u0438\u0447"
    m_Metadata:
      m_Items: []
