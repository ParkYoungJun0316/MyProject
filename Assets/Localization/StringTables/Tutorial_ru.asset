  - m_Id: 1086959616
    m_Localized: "\u0422\u043E\u043B\u0447\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 1086959617
    m_Localized: "\u0421\u043C\u0435\u043D\u0430 \u0446\u0432\u0435\u0442\u0430 \u0447/\u0431"
    m_Metadata:
      m_Items: []
  - m_Id: 1086959618
    m_Localized: "\u0421\u043C\u0435\u043D\u0430 \u0446\u0432\u0435\u0442\u0430 \u0441\u0432\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153920
    m_Localized: "\u0421\u043C\u0435\u043D\u0430 \u0431\u0430\u0444\u0444\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153923
    m_Localized: "\u041A\u043E\u043C\u0430\u043D\u0434\u043D\u044B\u0439 \u043A\u043B\u0438\u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153924
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u043F\u043E\u044F\u0432\u0438\u0442\u0441\u044F
      \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435,
      \u043F\u0440\u043E\u043A\u0440\u0438\u0447\u0438\u0442\u0435 \u043A\u043E\u043C\u0430\u043D\u0434\u043D\u044B\u0439
      \u043A\u043B\u0438\u0447 \u0432\u0441\u0435 \u0432\u043C\u0435\u0441\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1091153925
    m_Localized: "\u0417\u0430\u0434\u0430\u0442\u044C \u043A\u043E\u043C\u0430\u043D\u0434\u043D\u044B\u0439
      \u043A\u043B\u0438\u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153926
    m_Localized: "\u0417\u0430\u0434\u0430\u0442\u044C \u0435\u0433\u043E \u043C\u043E\u0436\u0435\u0442
      \u0442\u043E\u043B\u044C\u043A\u043E \u0445\u043E\u0441\u0442.\n\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439
      \u0430\u043D\u0433\u043B\u0438\u0439\u0441\u043A\u043E\u0435 \u0441\u043B\u043E\u0432\u043E.\n\u041D\u0435\u0442
      \u043C\u0438\u043A\u0440\u043E\u0444\u043E\u043D\u0430? \u0412\u043A\u043B\u044E\u0447\u0438
      \xAB\u041F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0430\_\u043A\u043B\u0430\u0432\u0438\u0448\u0435\u0439\_T\xBB
      \u0432 \u043E\u043F\u0446\u0438\u044F\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 24992255946752
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438 \u043A\u043E\u043C\u0430\u043D\u0434\u043D\u044B\u0439
      \u043A\u043B\u0438\u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889793
    m_Localized: "\u043D\u0430\u043F\u0440.: fighting"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889794
    m_Localized: "\u041F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889795
    m_Localized: "\u0417\u0430\u043A\u0440\u044B\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889796
    m_Localized: "\u041C\u043E\u0436\u043D\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0442\u043E\u043B\u044C\u043A\u043E \u0430\u043D\u0433\u043B\u0438\u0439\u0441\u043A\u0438\u0435
      \u0441\u043B\u043E\u0432\u0430.\n\u0420\u0430\u0441\u043F\u043E\u0437\u043D\u0430\u044E\u0442\u0441\u044F
      \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0435
      \u0441\u043B\u043E\u0432\u0430. (\u043F\u043E \u0443\u043C\u043E\u043B\u0447\u0430\u043D\u0438\u044E:
      FIGHTING)"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889797
    m_Localized: "\u041A\u043E\u043C\u0430\u043D\u0434\u043D\u044B\u0439 \u043A\u043B\u0438\u0447:
      {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647744
    m_Localized: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439 \u043E\u0442
      2 \u0434\u043E 12 \u0441\u0442\u0440\u043E\u0447\u043D\u044B\u0445 \u043B\u0430\u0442\u0438\u043D\u0441\u043A\u0438\u0445
      \u0431\u0443\u043A\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647746
    m_Localized: "\u042D\u0442\u043E \u0441\u043B\u043E\u0432\u043E \u2014 \u0437\u0430\u0440\u0435\u0437\u0435\u0440\u0432\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0435
      \u0441\u0438\u0441\u0442\u0435\u043C\u043D\u043E\u0435 \u0441\u043B\u043E\u0432\u043E,
      \u0435\u0433\u043E \u043D\u0435\u043B\u044C\u0437\u044F \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647747
    m_Localized: "\u0417\u0434\u0435\u0441\u044C \u0435\u0441\u0442\u044C \u0441\u043B\u043E\u0432\u043E,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u043D\u0435\u043B\u044C\u0437\u044F
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647751
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044C
      \u043A\u043E\u043C\u0430\u043D\u0434\u043D\u044B\u0439 \u043A\u043B\u0438\u0447."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647752
    m_Localized: "\u0422\u043E\u043B\u044C\u043A\u043E \u0445\u043E\u0441\u0442 \u043C\u043E\u0436\u0435\u0442
      \u0437\u0430\u0434\u0430\u0442\u044C \u043A\u043E\u043C\u0430\u043D\u0434\u043D\u044B\u0439
      \u043A\u043B\u0438\u0447."
    m_Metadata:
      m_Items: []
  - m_Id: 53793039953920
    m_Localized: "\u0418\u0437\u043C\u0435\u043D\u0438\u0442\u044C \u043A\u043E\u043C\u0430\u043D\u0434\u043D\u044B\u0439
      \u043A\u043B\u0438\u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 53793073508352
    m_Localized: "\u041A\u043E\u043C\u0430\u043D\u0434\u043D\u044B\u0439 \u043A\u043B\u0438\u0447
      \u043C\u043E\u0436\u043D\u043E \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C
      \u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0440\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 56930631004160
    m_Localized: "[E] \u0417\u0430\u0434\u0430\u0442\u044C \u043A\u043E\u043C\u0430\u043D\u0434\u043D\u044B\u0439
      \u043A\u043B\u0438\u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 56930635198464
    m_Localized: "[E] \u041F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u043A\u043E\u043C\u0430\u043D\u0434\u043D\u044B\u0439
      \u043A\u043B\u0438\u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 1395064700000001
    m_Localized: "\u041F\u043E\u043A\u0430\u0437\u0430\u0442\u044C Tip"
    m_Metadata:
      m_Items: []
  - m_Id: 3228654335799296
    m_Localized: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0431\u0430\u0444\u0444"
    m_Metadata:
      m_Items: []
  - m_Id: 3228654377742336
    m_Localized: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u044D\u043C\u043E\u0446\u0438\u044E (1-8)"
    m_Metadata:
      m_Items: []
  - m_Id: 3228654377742337
    m_Localized: "\u042D\u0442\u043E \u0438\u0433\u0440\u0430 \u0441 \u0440\u0430\u0441\u043F\u043E\u0437\u043D\u0430\u0432\u0430\u043D\u0438\u0435\u043C
      \u0433\u043E\u043B\u043E\u0441\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 9458308059082752
    m_Localized: "\u0420\u0430\u0441\u043F\u043E\u0437\u043D\u0430\u0432\u0430\u043D\u0438\u0435
      \u0433\u043E\u043B\u043E\u0441\u0430 \u043D\u0435 \u0437\u043D\u0430\u0435\u0442
      \u044D\u0442\u043E\u0433\u043E \u0441\u043B\u043E\u0432\u0430. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439
      \u0434\u0440\u0443\u0433\u043E\u0435 \u0430\u043D\u0433\u043B\u0438\u0439\u0441\u043A\u043E\u0435
      \u0441\u043B\u043E\u0432\u043E."
    m_Metadata:
      m_Items: []
