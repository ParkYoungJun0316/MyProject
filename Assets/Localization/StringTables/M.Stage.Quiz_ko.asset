  m_SharedData: {fileID: 11400000, guid: 05362dd87941b804c948c6c4f45df573, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 994491084800
    m_Localized: "\uC131\uC778\uC740 \uD558\uB8E8\uC5D0 1\uB9AC\uD130 \uC774\uC0C1\uC758
      \uCE68\uC744 \uBD84\uBE44\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 994524639232
    m_Localized: "\uC131\uC778\uC740 \uD558\uB8E8\uC5D0 \uC57D 1~1.5\uB9AC\uD130\uC758
      \uCE68\uC744 \uBD84\uBE44\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 994524639233
    m_Localized: "\uD600\uC758 \uBD80\uC704\uB9C8\uB2E4 \uD2B9\uC815\uD55C \uB9DB\uB9CC
      \uB290\uB084 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 994524639234
    m_Localized: "\uD600\uC758 \uBAA8\uB4E0 \uBD80\uC704\uB294 \uAE30\uBCF8\uC801\uC778
      \uB9DB\uC744 \uC804\uBD80 \uAC10\uC9C0\uD560 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 994524639235
    m_Localized: "\uD600\uC758 \uBB34\uB2AC\uB294 \uC0AC\uB78C\uB9C8\uB2E4 \uB2E4\uB974\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 994524639236
    m_Localized: "\uD600 \uD45C\uBA74\uC758 \uBB34\uB2AC\uB294 \uC0DD\uCCB4 \uC778\uC2DD
      \uAE30\uC220\uB85C \uC5F0\uAD6C\uB420 \uB9CC\uD07C \uC0AC\uB78C\uB9C8\uB2E4
      \uACE0\uC720\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833536
    m_Localized: "\uC785\uC220\uC5D0\uB294 \uC77C\uBC18 \uD53C\uBD80\uC640 \uB2EC\uB9AC
      \uB540\uC0D8\uC774 \uC5C6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833537
    m_Localized: "\uC785\uC220\uC740 \uB540\uC0D8\uACFC \uAE30\uB984\uC0D8\uC774
      \uC5C6\uC5B4\uC11C \uC27D\uAC8C \uAC74\uC870\uD574\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833538
    m_Localized: "\uB098\uC774\uAC00 \uB4E4\uC218\uB85D \uC4F4 \uC74C\uC2DD\uC744
      \uB354 \uC798 \uBA39\uAC8C \uB418\uB294 \uACBD\uC6B0\uAC00 \uB9CE\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833539
    m_Localized: "\uBBF8\uAC01\uC758 \uBCC0\uD654\uC640 \uBC18\uBCF5\uB41C \uC74C\uC2DD
      \uACBD\uD5D8 \uB54C\uBB38\uC5D0 \uB098\uD0C0\uB098\uB294 \uD604\uC0C1\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833540
    m_Localized: "\uAE30\uB124\uC2A4 \uC138\uACC4 \uAE30\uB85D\uC5D0 \uC624\uB978
      \uAC00\uC7A5 \uAE34 \uC778\uAC04\uC758 \uCE58\uC544\uB294 4cm\uAC00 \uB118\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833541
    m_Localized: "\uAE30\uB85D\uC0C1 \uAC00\uC7A5 \uAE34 \uC778\uAC04\uC758 \uC1A1\uACF3\uB2C8\uB294
      \uC57D 3.67cm\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833542
    m_Localized: "\uC785 \uC548\uC5D0\uB294 \uC218\uC2ED\uC5B5 \uAC1C\uC758 \uC138\uADE0\uC774
      \uC0B4\uACE0 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833543
    m_Localized: "\uC591\uCE58\uC9C8\uC744 \uD574\uB3C4 \uC785 \uC548\uC5D0\uB294
      \uC5EC\uC804\uD788 \uB9CE\uC740 \uC138\uADE0\uC774 \uB0A8\uC544 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833544
    m_Localized: "\uC0AC\uB78C\uC740 \uC7A0\uC744 \uC790\uB294 \uB3D9\uC548 \uCE68\uC744
      \uD6E8\uC52C \uB354 \uB9CE\uC774 \uBD84\uBE44\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833545
    m_Localized: "\uC7A0\uC790\uB294 \uB3D9\uC548 \uCE68 \uBD84\uBE44\uB294 \uAC70\uC758
      \uBA48\uCD94\uB294\uB370, \uC774\uAC8C \uC544\uCE68 \uC785 \uB0C4\uC0C8\uC758
      \uC6D0\uC778\uC774 \uB420 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833546
    m_Localized: "\uD600\uB3C4 \uD53C\uB85C\uD574\uC9C8 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833547
    m_Localized: "\uD600\uB294 \uADFC\uC721\uC73C\uB85C \uC774\uB8E8\uC5B4\uC838
      \uC788\uC5B4\uC11C \uB9CE\uC774 \uC4F0\uBA74 \uD53C\uB85C\uD574\uC9C8 \uC218
      \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833548
    m_Localized: "\uCE58\uC544\uB294 \uBF08\uC640 \uAD6C\uC870\uAC00 \uB2E4\uB974\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833549
    m_Localized: "\uBF08\uC640 \uB2EC\uB9AC \uCE58\uC544\uB294 \uC2A4\uC2A4\uB85C
      \uC644\uC804\uD788 \uC7AC\uC0DD\uB418\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833550
    m_Localized: "\uC0AC\uB78C\uC758 \uC785\uC220\uC774 \uBD89\uC740 \uAC74 \uBD89\uC740
      \uC0C9\uC18C\uAC00 \uB9CE\uC544\uC11C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833551
    m_Localized: "\uC785\uC220\uC740 \uD53C\uBD80\uAC00 \uC587\uC544\uC11C \uADF8
      \uC544\uB798 \uD608\uAD00\uC758 \uC0C9\uC774 \uBE44\uCCD0 \uBCF4\uC774\uB294
      \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833552
    m_Localized: "\uD600\uB294 \uC2E0\uCCB4\uC5D0\uC11C \uAC00\uC7A5 \uBE68\uB9AC
      \uD68C\uBCF5\uB418\uB294 \uBD80\uC704 \uC911 \uD558\uB098\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833553
    m_Localized: "\uD600\uB294 \uD608\uB958\uAC00 \uD48D\uBD80\uD558\uACE0 \uC138\uD3EC
      \uC7AC\uC0DD\uC774 \uBE68\uB77C\uC11C \uBE60\uB974\uAC8C \uD68C\uBCF5\uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
