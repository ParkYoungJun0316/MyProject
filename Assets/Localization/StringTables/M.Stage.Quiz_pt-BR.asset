  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: M.Stage.Quiz_pt-BR
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: pt-BR
  m_SharedData: {fileID: 11400000, guid: 05362dd87941b804c948c6c4f45df573, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 994491084800
    m_Localized: Adultos produzem mais de 1 litro de saliva por dia.
    m_Metadata:
      m_Items: []
  - m_Id: 994524639232
    m_Localized: Adultos produzem entre 1 e 1,5 litro de saliva por dia.
    m_Metadata:
      m_Items: []
  - m_Id: 994524639233
    m_Localized: "Partes diferentes da l\xEDngua s\xF3 conseguem sentir certos sabores."
    m_Metadata:
      m_Items: []
  - m_Id: 994524639234
    m_Localized: "Todas as partes da l\xEDngua conseguem detectar todos os sabores
      b\xE1sicos."
    m_Metadata:
      m_Items: []
  - m_Id: 994524639235
    m_Localized: "Os padr\xF5es da l\xEDngua s\xE3o diferentes para cada pessoa."
    m_Metadata:
      m_Items: []
  - m_Id: 994524639236
    m_Localized: "Os padr\xF5es da superf\xEDcie da l\xEDngua s\xE3o \xFAnicos o
      suficiente para serem estudados em tecnologia biom\xE9trica."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833536
    m_Localized: "Os l\xE1bios n\xE3o t\xEAm gl\xE2ndulas sudor\xEDparas como a pele
      normal."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833537
    m_Localized: "Os l\xE1bios secam facilmente porque n\xE3o t\xEAm gl\xE2ndulas
      sudor\xEDparas nem seb\xE1ceas."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833538
    m_Localized: Com a idade, muitas pessoas passam a tolerar melhor comidas amargas.
    m_Metadata:
      m_Items: []
  - m_Id: 994528833539
    m_Localized: "Isso acontece por causa de mudan\xE7as no paladar e da experi\xEAncia
      repetida com alimentos."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833540
    m_Localized: O dente humano mais longo registrado no Guinness Book media mais
      de 4 cm.
    m_Metadata:
      m_Items: []
  - m_Id: 994528833541
    m_Localized: O maior canino humano registrado media cerca de 3,67 cm.
    m_Metadata:
      m_Items: []
  - m_Id: 994528833542
    m_Localized: "Existem bilh\xF5es de bact\xE9rias vivendo dentro da boca."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833543
    m_Localized: "Mesmo depois de escovar os dentes, muitas bact\xE9rias continuam
      na boca."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833544
    m_Localized: As pessoas produzem muito mais saliva enquanto dormem.
    m_Metadata:
      m_Items: []
  - m_Id: 994528833545
    m_Localized: "A produ\xE7\xE3o de saliva quase para durante o sono, o que pode
      causar mau h\xE1lito de manh\xE3."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833546
    m_Localized: "A l\xEDngua tamb\xE9m pode ficar cansada."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833547
    m_Localized: "A l\xEDngua \xE9 feita de m\xFAsculos, ent\xE3o pode ficar cansada
      depois de muito uso."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833548
    m_Localized: "Os dentes t\xEAm uma estrutura diferente da dos ossos."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833549
    m_Localized: "Diferente dos ossos, os dentes n\xE3o conseguem se reparar completamente."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833550
    m_Localized: "Os l\xE1bios humanos parecem vermelhos porque t\xEAm muito pigmento
      vermelho."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833551
    m_Localized: "Os l\xE1bios s\xE3o finos, ent\xE3o d\xE1 para ver a cor dos vasos
      sangu\xEDneos por baixo da pele."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833552
    m_Localized: "A l\xEDngua \xE9 uma das partes do corpo que cicatriza mais r\xE1pido."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833553
    m_Localized: "A l\xEDngua cicatriza r\xE1pido porque tem bastante fluxo sangu\xEDneo
      e renova\xE7\xE3o celular r\xE1pida."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
