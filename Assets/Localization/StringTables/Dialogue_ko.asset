%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogue_ko
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ko
  m_SharedData: {fileID: 11400000, guid: 043bf15b2a6a41c48971e11c678f419c, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 472199573504
    m_Localized: "\uC65C \uB9DB\uC788\uB294 \uACFC\uC77C\uB4E4\uC774\uB791 \uAD70\uAC83\uC9C8\uB4E4\uC744 \uBE7C\uACE0 \uAFC0\uB5A1\uC744 \uBA39\uC740 \uAC70\uC57C!!!"
    m_Metadata:
      m_Items: []
  - m_Id: 334352332992512
    m_Localized: "\uBC14\uB2E5\uC5D0 \uC0C9\uAE54 \uD0C0\uC77C\uC774 \uB730 \uAC70\uC57C.\n\uADF8 \uC704\uC5D0 2\uCD08\uAC04 \uC11C \uC788\uC73C\uBA74 \uC810\uC218\uAC00 \uC62C\uB77C\uAC00."
    m_Metadata:
      m_Items: []
  - m_Id: 334425666203648
    m_Localized: "\uD770\uC0C9\uC774\uB098 \uAC80\uC740\uC0C9 \uD0C0\uC77C\uC740 \uB204\uAD6C\uB4E0 \uBC1F\uC544\uB3C4 \uB418\uC9C0\uB9CC, \uACE0\uC720\uC0C9 \uD0C0\uC77C\uC740 \uADF8 \uC0C9\uB9CC \uBC1F\uC544\uC57C \uC810\uC218\uAC00 \uC62C\uB77C\uAC00.\n\uAE38 \uB9C9\uC9C0 \uB9D0\uACE0 \uBE68\uB9AC \uC6C0\uC9C1\uC5EC!"
    m_Metadata:
      m_Items: []
  - m_Id: 334428463804416
    m_Localized: ""
    m_Metadata:
      m_Items: []
  - m_Id: 335177390338048
    m_Localized: "\uB124 \uC0C9\uC774 \uBC14\uB2E5\uC5D0 \uB728\uBA74 <color=#FFD24D><b>Space</b></color>\uB97C \uB20C\uB7EC.\n\uD770\uC0C9\uC740 \uC544\uBB34\uB098 \uB20C\uB7EC\uB3C4 \uB418\uACE0, \uAC80\uC740\uC0C9\uC740 \uC808\uB300 \uB204\uB974\uBA74 \uC548 \uB3FC!\n1\uCD08 \uB4A4\uC5D0 \uC790\uB3D9\uC73C\uB85C \uB2E4\uC74C \uCC28\uB840\uB85C \uB118\uC5B4\uAC00."
    m_Metadata:
      m_Items: []
  - m_Id: 335182629023744
    m_Localized: "\uBC1C \uBC11\uC5D0\uC11C \uBB54\uAC00 \uC6C0\uC9C1\uC774\uACE0 \uC788\uC5B4..\uC870\uC2EC\uD574!\n\uD600 \uACF5\uACA9\uC774 \uB4E4\uC5B4\uC628\uB2E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 335185439207424
    m_Localized: "\uAC00\uC6B4\uB370\uC11C \uD600\uAC00 \uC19F\uC544\uC62C\uB77C\uC11C \uBC18\uB300\uD3B8\uC774 \uC548 \uBCF4\uC774\uAC8C \uAC00\uB9AC\uACE0 \uAE38\uC744 \uB9C9\uC744 \uAC70\uC57C.\n\uB2E4 \uAC19\uC774 \uD300 \uAD6C\uD638\uB97C \uC678\uCE58\uBA74 \uB2E4\uC2DC \uB0B4\uB824\uAC00\uACE0, \uBD80\uC11C\uC9C4 \uAE38\uB3C4 \uC6D0\uC0C1\uBCF5\uAD6C \uB420 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 335887280484352
    m_Localized: "\uC6B4\uB3D9\uD558\uACE0 \uC788\uB098 \uBD10!\n\uC228\uC774 \uAC11\uC790\uAE30 \uAC70\uCE60\uC5B4\uC84C\uC5B4.\n\uBC14\uB78C\uC774 \uBD88\uC5B4\uC628\uB2E4!\n\uB9DE\uB294 \uBC14\uB2E5 \uC704\uC5D0 \uC62C\uB77C\uAC00\uC11C \uBC84\uD168!"
    m_Metadata:
      m_Items: []
  - m_Id: 335890795311104
    m_Localized: "\uD6C4\uC544... \uD6C4\uC544... \uC870\uAE08\uB9CC \uB354 \uBC84\uD2F0\uBA74 \uC0B4\uC544\uC11C \uB098\uAC08 \uC218 \uC788\uC744 \uAC83 \uAC19\uC544..."
    m_Metadata:
      m_Items: []
  - m_Id: 335893903290368
    m_Localized: ""
    m_Metadata:
      m_Items: []
  - m_Id: 337052009345024
    m_Localized: "\uC774 \uC815\uC801... \uC785 \uC548\uC774 \uC870\uC6A9\uD574\uC84C\uB2E4.\n\uB4DC\uB514\uC5B4 \uD0C8\uCD9C\uD560 \uC218 \uC788\uB294 \uAC74\uAC00...?"
    m_Metadata:
      m_Items: []
  - m_Id: 337056501444608
    m_Localized: ".....(\uCF70\uC9C1!)"
    m_Metadata:
      m_Items: []
  - m_Id: 337060553142272
    m_Localized: "\uC774\uB7F0, \uC0BC\uCF1C\uC9C4\uB2E4...!!"
    m_Metadata:
      m_Items: []
  - m_Id: 337068631371776
    m_Localized: ""
    m_Metadata:
      m_Items: []
  - m_Id: 337070598500352
    m_Localized: "\uC2DD\uB3C4\uB85C \uB118\uC5B4\uC628 \uAC74\uAC00..."
    m_Metadata:
      m_Items: []
  - m_Id: 337897539088384
    m_Localized: "\uB4A4\uC5D0\uC11C \uBB54\uAC00 \uAD74\uB7EC\uC624\uB294 \uAC83
      \uAC19\uC740\uB370..."
    m_Metadata:
      m_Items: []
  - m_Id: 337902496755712
    m_Localized: "\uB2EC\uB824!!!"
    m_Metadata:
      m_Items: []
  - m_Id: 337904153505792
    m_Localized: "\uC798\uBABB \uBC1F\uC73C\uBA74 \uADF8\uB300\uB85C \uC989\uC0AC\uC57C.
      \uBE5B\uB098\uB294 \uCE78\uB9CC \uC678\uC6CC\uB46C."
    m_Metadata:
      m_Items: []
  - m_Id: 337904874926080
    m_Localized: "\uC0C9\uAE54\uBCC4\uB85C \uBCF4\uC5EC\uC904 \uAC70\uC57C. \uBC18\uB4DC\uC2DC
      \uB124 \uC0C9\uC5D0 \uB9DE\uCDB0!"
    m_Metadata:
      m_Items: []
  - m_Id: 337905520848896
    m_Localized: "\uC0C9\uC774 \uB9DE\uC544\uB3C4 \uD751\uBC31\uC774\uBA74 \uC8FD\uC744
      \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 337906154188800
    m_Localized: "\uAD6C\uC5ED\uB9C8\uB2E4 \uB2F4\uB2F9 \uC0C9\uC774 \uC788\uC5B4.
      \uB2F4\uB2F9\uC774 \uBA3C\uC800 \uC9C0\uB098\uAC00\uC57C \uAE38\uC774 \uC548\uC804\uD574\uC838."
    m_Metadata:
      m_Items: []
  - m_Id: 337906812694528
    m_Localized: "\uB3C4\uB9DD\uCE58\uB294 \uC801\uD608\uAD6C\uB4E4\uC744 \uC7A1\uC544!"
    m_Metadata:
      m_Items: []
  - m_Id: 337907517337600
    m_Localized: "\uD56D\uCCB4\uB85C\uBD80\uD130 \uB3C4\uB9DD\uCCD0\uC11C \uC0B4\uC544\uB0A8\uC544!"
    m_Metadata:
      m_Items: []
  - m_Id: 339357207212032
    m_Localized: "\uC2DD\uB3C4 \uB05D\uBD80\uBD84\uAE4C\uC9C0 \uC654\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 339360646541312
    m_Localized: "\uB9C8\uC9C0\uB9C9\uC774\uB77C\uC11C \uADF8\uB7F0\uAC00... \uC555\uBC15\uAC10\uC774
      \uB2E4\uB974\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 339362018078720
    m_Localized: "\uBA48\uCD94\uC9C0 \uB9D0\uACE0 \uC6C0\uC9C1\uC5EC!"
    m_Metadata:
      m_Items: []
  - m_Id: 340094578438144
    m_Localized: "\uC870\uC784\uC774 \uBA48\uCDC4\uB2E4. \uD6C4... \uACB0\uAD6D \uC0B4\uC558\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 340096402960384
    m_Localized: "\uADFC\uB370 \uBC14\uB2E5\uC774 \uC774\uC0C1\uD574..."
    m_Metadata:
      m_Items: []
  - m_Id: 340097782886400
    m_Localized: "\uBB34\uB108\uC9C0\uAE30 \uC2DC\uC791\uD55C\uB2E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000001
    m_Localized: "\uD638\uB791\uC774 \uAD74\uC5D0 \uB4E4\uC5B4\uAC00\uB3C4 \uC815\uC2E0\uB9CC \uCC28\uB9AC\uBA74 \uC0B4 \uC218 \uC788\uB2E4\uACE0 \uD588\uC5B4..!\n\uC774\uC81C\uBD80\uD130 \uC0DD\uC874\uB9CC \uC0DD\uAC01\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000002
    m_Localized: "\uC8FC\uC704\uC5D0 \uC788\uB294 \uC0C9\uAE54 \uC785\uB4E4 \uC704\uCE58\uB97C \uC798 \uAE30\uC5B5\uD574\uB46C.\n\uBC1C\uD310\uC744 \uBC1F\uC73C\uBA74 \uADF8 \uC0C9 \uC785\uC774 \uC19F\uC544\uC62C\uB77C\uC11C \uC774\uBE68\uC744 \uBD80\uC234\uC904 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000003
    m_Localized: "\uD55C \uBC88\uC5D0 \uD55C \uC0C9\uB9CC \uC62C\uB77C\uC640.\n\uB2E4 \uAC19\uC774 \uBC1F\uC544\uBD24\uC790 \uC18C\uC6A9\uC5C6\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000004
    m_Localized: "\uC5EC\uAE30\uAC00 \uB2EB\uD788\uB824\uACE0 \uD558\uBA74... \uB2E4 \uAC19\uC774 \uD300 \uAD6C\uD638\uB97C \uC678\uCCD0!\n\uC548 \uADF8\uB7EC\uBA74 \uC55E\uC774 \uC548 \uBCF4\uC774\uAC8C \uB420 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000005
    m_Localized: "\uD654\uBA74\uC5D0 \uD45C\uC2DC\uB41C \uB300\uB85C \uC548\uC804 \uAD6C\uC5ED\uC5D0 \uB4E4\uC5B4\uAC00\uBA74 \uB3FC!"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000006
    m_Localized: "\uB0A0 \uBA39\uAE30 \uC804\uC5D0 \uB9E4\uC6B4 \uAC78 \uBA39\uC5C8\uB098..?\n\uBC14\uB2E5\uC5D0 \uCE68\uB4E4\uC774 \uC790\uAFB8 \uC62C\uB77C\uC640."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000007
    m_Localized: "\uBC14\uB2E5\uC5D0 \uCE68\uC774 \uAE54\uB824 \uBBF8\uB044\uB7EC\uC6B8 \uAC70\uC57C.\n\uB2E4 \uAC19\uC774 \uD300 \uAD6C\uD638\uB97C \uC678\uCE58\uBA74 \uC5C6\uC568 \uC218 \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000008
    m_Localized: "\uC774\uC81C\uB294 \uC704\uC5D0\uC11C\uB3C4 \uCE68\uC774 \uB5A8\uC5B4\uC9C0\uC796\uC544!\n\uB9E4\uC6B4 \uC74C\uC2DD\uC744 \uBA39\uACE0 \uC2E0 \uC74C\uC2DD\uAE4C\uC9C0 \uBA39\uC740 \uAC8C \uBD84\uBA85\uD574.\n\uAFC0\uB5A1\uC73C\uB85C \uC911\uD654\uD558\uB824\uB294 \uAC70\uC57C, \uBD84\uBA85!"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000009
    m_Localized: "\uB5A8\uC5B4\uC9C0\uB294 \uCE68 \uC911\uC5D0 \uB0A0 \uC870\uC900\uD558\uB294 \uAC8C \uC788\uB294\uB370, <color=#FFD24D><b>Ctrl</b></color>\uB85C \uBC14\uB2E5 \uC0C9\uC774\uB791 \uB0B4 \uC0C9\uC744 \uB9DE\uCD94\uBA74 \uC870\uC900\uC774 \uD480\uB9B4 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000010
    m_Localized: "\uC774\uC81C\uBD80\uD130\uB294 \uD55C \uCE78 \uC55E \uBC14\uB2E5\uB9CC \uBCF4\uC5EC\uC904 \uAC70\uC57C.\n\uC798 \uAE30\uC5B5\uD574\uB46C!"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000011
    m_Localized: "\uC5EC\uAE30\uB3C4 \uB0A0 \uC870\uC900\uD558\uB294 \uAC8C \uC788\uC5B4.\n<color=#FFD24D><b>Ctrl</b></color>\uB85C \uBC14\uB2E5 \uC0C9\uC774\uB791 \uB0B4 \uC0C9\uC744 \uB9DE\uCD94\uBA74 \uC870\uC900\uC774 \uD480\uB824."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000012
    m_Localized: "\uC774\uBC88\uC5D4 \uD600\uAC00 \uC67C\uCABD\uC774\uB098 \uC624\uB978\uCABD \uBC14\uB2E5\uC744 \uD1B5\uC9F8\uB85C \uBD80\uC220 \uAC70\uC57C.\n\uD300 \uAD6C\uD638\uB97C \uC678\uCE58\uBA74 \uB9C9\uACE0, \uBABB \uC678\uCE58\uBA74 \uADF8\uB300\uB85C \uBD80\uC11C\uC838."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000013
    m_Localized: "\uACBD\uACE0\uAC00 \uB5A0 \uC788\uC744 \uB54C \uD300 \uAD6C\uD638\uB97C \uC678\uCCD0\uC57C\uB9CC \uC6D0\uC0C1\uBCF5\uAD6C\uAC00 \uB3FC.\n\uBC14\uB2E5\uC774 \uBD80\uC11C\uC9C0\uACE0 \uB098\uBA74, \uB2E4\uC74C \uACBD\uACE0\uAC00 \uB730 \uB54C\uAE4C\uC9C0\uB294 \uBC84\uD2F0\uB294 \uC218\uBC16\uC5D0 \uC5C6\uC5B4."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
