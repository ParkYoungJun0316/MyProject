  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogue_ko
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ko
  m_SharedData: {fileID: 11400000, guid: 043bf15b2a6a41c48971e11c678f419c, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 472199573504
    m_Localized: "\uC6B0\uB9AC, \uBA39\uD614\uC5B4. \uC774\uC81C\uBD80\uD130 \uC0B4\uC544\uB098\uAC00\uB294
      \uAC83\uB9CC \uC0DD\uAC01\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 334352332992512
    m_Localized: "\uC774\uC81C\uBD80\uD130 \uBC14\uB2E5\uC5D0 \uB124 \uC0C9\uC774\uB791
      \uB611\uAC19\uC740 \uD0C0\uC77C\uC774 \uBB34\uC791\uC704\uB85C \uB730 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 334425666203648
    m_Localized: "\uC81C\uD55C \uC2DC\uAC04 \uC548\uC5D0 \uADF8 \uC704\uB85C \uC62C\uB77C\uC11C\uC57C
      \uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 334428463804416
    m_Localized: "\uBABB \uC62C\uB77C\uC11C\uBA74... \uCC9C\uC7A5\uC758 \uC774\uBE68\uC774
      \uB5A8\uC5B4\uC9C0\uAE30 \uC2DC\uC791\uD560 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 335177390338048
    m_Localized: "\uB124 \uC0C9\uC774 \uBC14\uB2E5\uC5D0 \uB728\uBA74 <b><color=#FFC400>\uC2A4\uD398\uC774\uC2A4</color></b>\uB97C
      \uB20C\uB7EC."
    m_Metadata:
      m_Items: []
  - m_Id: 335182629023744
    m_Localized: "\uD770\uC0C9\uC740 \uC544\uBB34\uB098 \uB20C\uB7EC\uB3C4 \uB418\uACE0,
      \uAC80\uC740\uC0C9\uC740 \uC808\uB300 \uB204\uB974\uBA74 \uC548 \uB3FC!"
    m_Metadata:
      m_Items: []
  - m_Id: 335185439207424
    m_Localized: "\uC798\uBABB \uB204\uB974\uBA74 \uC2DC\uAC04\uC774 \uC904\uC5B4\uB4DC\uB2C8\uAE4C
      \uC870\uC2EC\uD574!"
    m_Metadata:
      m_Items: []
  - m_Id: 335887280484352
    m_Localized: "\uB124 \uC0C9 \uD0C0\uC77C \uC704\uC5D0 \uC62C\uB77C\uAC00\uC11C
      \uBC84\uD168!"
    m_Metadata:
      m_Items: []
  - m_Id: 335890795311104
    m_Localized: "\uC5EC\uAE30\uAC00 \uC785\uC5D0\uC11C \uB9C8\uC9C0\uB9C9\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 335893903290368
    m_Localized: "\uC870\uAE08\uB9CC \uBC84\uD2F0\uBA74 \uB098\uAC08 \uC218 \uC788\uC744
      \uAC83 \uAC19\uC544..."
    m_Metadata:
      m_Items: []
  - m_Id: 337052009345024
    m_Localized: "\uC785 \uC548\uC774 \uC870\uC6A9\uD574\uC84C\uB2E4... \uB2E4 \uBA48\uCD98
      \uAC74\uAC00."
    m_Metadata:
      m_Items: []
  - m_Id: 337056501444608
    m_Localized: "\uC774\uC81C \uD0C8\uCD9C\uD560 \uC218 \uC788\uB294 \uAC70\uC9C0...?"
    m_Metadata:
      m_Items: []
  - m_Id: 337060553142272
    m_Localized: "\u2026\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 337068631371776
    m_Localized: "\uC774\uB7F0, \uC0BC\uCF1C\uC9C4\uB2E4...!!"
    m_Metadata:
      m_Items: []
  - m_Id: 337070598500352
    m_Localized: "\uC2DD\uB3C4\uB85C \uB118\uC5B4\uC628 \uAC74\uAC00..."
    m_Metadata:
      m_Items: []
  - m_Id: 337897539088384
    m_Localized: "\uB4A4\uC5D0\uC11C \uBB54\uAC00 \uAD74\uB7EC\uC624\uB294 \uAC83
      \uAC19\uC740\uB370..."
    m_Metadata:
      m_Items: []
  - m_Id: 337902496755712
    m_Localized: "\uB2EC\uB824!!!"
    m_Metadata:
      m_Items: []
  - m_Id: 337904153505792
    m_Localized: "\uC798\uBABB \uBC1F\uC73C\uBA74 \uADF8\uB300\uB85C \uC989\uC0AC\uC57C.
      \uBE5B\uB098\uB294 \uCE78\uB9CC \uC678\uC6CC\uB46C."
    m_Metadata:
      m_Items: []
  - m_Id: 337904874926080
    m_Localized: "\uC0C9\uAE54\uBCC4\uB85C \uBCF4\uC5EC\uC904 \uAC70\uC57C. \uBC18\uB4DC\uC2DC
      \uB124 \uC0C9\uC5D0 \uB9DE\uCDB0!"
    m_Metadata:
      m_Items: []
  - m_Id: 337905520848896
    m_Localized: "\uC0C9\uC774 \uB9DE\uC544\uB3C4 \uD751\uBC31\uC774\uBA74 \uC8FD\uC744
      \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 337906154188800
    m_Localized: "\uAD6C\uC5ED\uB9C8\uB2E4 \uB2F4\uB2F9 \uC0C9\uC774 \uC788\uC5B4.
      \uB2F4\uB2F9\uC774 \uBA3C\uC800 \uC9C0\uB098\uAC00\uC57C \uAE38\uC774 \uC548\uC804\uD574\uC838."
    m_Metadata:
      m_Items: []
  - m_Id: 337906812694528
    m_Localized: "\uB3C4\uB9DD\uCE58\uB294 \uC801\uD608\uAD6C\uB4E4\uC744 \uC7A1\uC544!"
    m_Metadata:
      m_Items: []
  - m_Id: 337907517337600
    m_Localized: "\uD56D\uCCB4\uB85C\uBD80\uD130 \uB3C4\uB9DD\uCCD0\uC11C \uC0B4\uC544\uB0A8\uC544!"
    m_Metadata:
      m_Items: []
  - m_Id: 339357207212032
    m_Localized: "\uC2DD\uB3C4 \uB05D\uBD80\uBD84\uAE4C\uC9C0 \uC654\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 339360646541312
    m_Localized: "\uB9C8\uC9C0\uB9C9\uC774\uB77C\uC11C \uADF8\uB7F0\uAC00... \uC555\uBC15\uAC10\uC774
      \uB2E4\uB974\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 339362018078720
    m_Localized: "\uBA48\uCD94\uC9C0 \uB9D0\uACE0 \uC6C0\uC9C1\uC5EC!"
    m_Metadata:
      m_Items: []
  - m_Id: 340094578438144
    m_Localized: "\uC870\uC784\uC774 \uBA48\uCDC4\uB2E4. \uD6C4... \uACB0\uAD6D \uC0B4\uC558\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 340096402960384
    m_Localized: "\uADFC\uB370 \uBC14\uB2E5\uC774 \uC774\uC0C1\uD574..."
    m_Metadata:
      m_Items: []
  - m_Id: 340097782886400
    m_Localized: "\uBB34\uB108\uC9C0\uAE30 \uC2DC\uC791\uD55C\uB2E4!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
