  - m_Id: 1086959616
    m_Localized: "\uBC00\uCE58\uAE30 (\uD53C\uD574 \uC5C6\uC74C)"
    m_Metadata:
      m_Items: []
  - m_Id: 1086959617
    m_Localized: "\uC0C9 \uBCC0\uACBD \uD751/\uBC31"
    m_Metadata:
      m_Items: []
  - m_Id: 1086959618
    m_Localized: "\uC0C9 \uBCC0\uACBD \uACE0\uC720\uC0C9"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153920
    m_Localized: "\uBC84\uD504 \uAD50\uCCB4 (\uBC29\uC5B4 \u2194 \uC774\uC18D)"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153923
    m_Localized: "\uD300 \uC751\uC6D0"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153924
    m_Localized: "\uACBD\uACE0 \uC544\uC774\uCF58\uC774 \uB728\uBA74 \uD300 \uD0A4\uC6CC\uB4DC\uB97C
      \uB2E4\uAC19\uC774 \uC678\uCCD0\uC11C \uC704\uD611\uC744 \uB418\uB3CC\uB9AC\uC138\uC694.\n\uC5EC\uAE30\uC11C
      [E]\uB97C \uB204\uB974\uBA74 \uBC14\uB85C \uC5F0\uC2B5\uD560 \uC218 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1091153925
    m_Localized: "\uD300 \uD0A4\uC6CC\uB4DC"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153926
    m_Localized: "TeamCheerWord\uB294 host\uB9CC \uC124\uC815\uD560 \uC218 \uC788\uC5B4\uC694.\n\uC2E4\uC81C\uB85C
      \uC790\uC8FC \uC4F0\uB294 \uC601\uC5B4 \uB2E8\uC5B4\uC77C\uC218\uB85D \uC778\uC2DD\uC774
      \uC798 \uB3FC\uC694. (2~12\uC790, \uC601\uBB38 \uC18C\uBB38\uC790\uB9CC)\n\uB9C8\uC774\uD06C\uAC00
      \uC5C6\uAC70\uB098 \uC778\uC2DD\uC774 \uC548 \uB418\uBA74 ESC \u2192 \uC77C\uBC18
      \uD0ED \u2192 \"T\uD0A4\uB85C \uC751\uC6D0\uD558\uAE30\"\uB97C \uCF1C\uACE0,
      \uACBD\uACE0\uAC00 \uB728\uBA74 T\uD0A4\uB97C \uB204\uB974\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 24992255946752
    m_Localized: "\uD300 \uD0A4\uC6CC\uB4DC\uB97C \uC815\uD574\uC8FC\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889793
    m_Localized: "\uC608) fighting"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889794
    m_Localized: "\uD655\uC815"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889795
    m_Localized: "\uB2EB\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889796
    m_Localized: "\uD300 \uC804\uCCB4\uAC00 \uD568\uAED8 \uC678\uCE60 \uB2E8\uC5B4\uB97C
      \uC815\uD574\uC8FC\uC138\uC694 (\uAE30\uBCF8\uAC12: FIGHTING)"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889797
    m_Localized: "\uD300 \uD0A4\uC6CC\uB4DC: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647744
    m_Localized: "2~12\uC790, \uC601\uBB38 \uC18C\uBB38\uC790\uB9CC \uC0AC\uC6A9\uD560
      \uC218 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647746
    m_Localized: "\uC2DC\uC2A4\uD15C \uC608\uC57D\uC5B4\uB77C \uC0AC\uC6A9\uD560
      \uC218 \uC5C6\uB294 \uB2E8\uC5B4\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647747
    m_Localized: "\uC0AC\uC6A9\uD560 \uC218 \uC5C6\uB294 \uB2E8\uC5B4\uAC00 \uD3EC\uD568\uB418\uC5B4
      \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647751
    m_Localized: "\uD300 \uD0A4\uC6CC\uB4DC\uB97C \uD655\uC815\uD560 \uC218 \uC5C6\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647752
    m_Localized: "\uD638\uC2A4\uD2B8\uB9CC \uD300 \uD0A4\uC6CC\uB4DC\uB97C \uC815\uD560
      \uC218 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 53793039953920
    m_Localized: "\uD300 \uD0A4\uC6CC\uB4DC \uBC14\uAFB8\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 53793073508352
    m_Localized: "\uD300 \uD0A4\uC6CC\uB4DC\uB97C \uB9C8\uC9C0\uB9C9\uC73C\uB85C
      \uD55C \uBC88 \uB354 \uBC14\uAFC0 \uC218 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 56930631004160
    m_Localized: "[E] \uD300 \uD0A4\uC6CC\uB4DC \uC124\uC815"
    m_Metadata:
      m_Items: []
  - m_Id: 56930635198464
