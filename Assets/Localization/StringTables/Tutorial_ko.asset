  m_TableData:
  - m_Id: 1040822272
    m_Localized: "\uC774\uB3D9"
    m_Metadata:
      m_Items: []
  - m_Id: 1086959616
    m_Localized: "\uBC00\uCE58\uAE30 (\uB370\uBBF8\uC9C0 \uC5C6\uC74C)"
    m_Metadata:
      m_Items: []
  - m_Id: 1086959617
    m_Localized: "\uC0C9 \uBCC0\uACBD \uD751/\uBC31"
    m_Metadata:
      m_Items: []
  - m_Id: 1086959618
    m_Localized: "\uC0C9 \uBCC0\uACBD \uACE0\uC720\uC0C9"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153920
    m_Localized: "\uBC84\uD504 \uAD50\uCCB4(\uBC29\uC5B4\u2194\uC774\uC18D)"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153921
    m_Localized: "\uAC1C\uC778 \uC751\uC6D0"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153922
    m_Localized: "\uC790\uC2E0\uC758 \uC774\uB984\uC744 \uC678\uCE58\uBA74 \uBC84\uD504\uAC00
      \uCF1C\uC9D1\uB2C8\uB2E4.\nE\uB97C \uB20C\uB7EC \uAC1C\uC778 \uB2C9\uB124\uC784\uC744
      \uC124\uC815\uD558\uC138\uC694.\n\uD14C\uC2A4\uD2B8\uB97C \uAF2D \uD574\uBCF4\uC138\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153923
    m_Localized: "\uD300 \uC751\uC6D0"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153924
    m_Localized: "\uACBD\uACE0 \uC544\uC774\uCF58\uC774 \uB728\uBA74 \uD300 \uC751\uC6D0
      \uB2E8\uC5B4\uB97C \uB2E4\uAC19\uC774 \uC678\uCE58\uC138\uC694.\n\uC785\xB7\uC2DD\uB3C4\uC758
      \uC704\uD611\uC774 \uC6D0\uB798\uB300\uB85C \uB3CC\uC544\uAC11\uB2C8\uB2E4.\n\uD300
      \uC751\uC6D0 \uC774\uB984\uC740 host\uB9CC \uC815\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
      \uD300\uC6D0\uACFC \uBBF8\uB9AC \uC0C1\uC758\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1091153925
    m_Localized: "\uC751\uC6D0 \uC774\uB984"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153926
    m_Localized: "\uC751\uC6D0 \uC774\uB984\uC740 \uC601\uC5B4\uB85C\uB9CC \uC801\uC744
      \uC218 \uC788\uC5B4\uC694.\n\uC2E4\uC81C\uB85C \uC4F0\uB294 \uB2E8\uC5B4\uC77C\uC218\uB85D
      \uC778\uC2DD\uB960\uC774 \uC88B\uC544\uC694!\n\uB9C8\uC774\uD06C\uAC00 \uC5C6\uAC70\uB098
      \uC778\uC2DD\uC774 \uC548\uB420 \uACBD\uC6B0 ESC \uBA54\uB274\uC5D0\uC11C \uC22B\uC790\uD0A4
      \uC751\uC6D0\uC744 \uCF1C\uBCF4\uC138\uC694.\n(1\uC740 \uAC1C\uC778 \uC751\uC6D0
      2\uB294 \uD300 \uC751\uC6D0 \u2014 \uBAA9\uC18C\uB9AC \uC751\uC6D0 \uBC29\uC2DD\uC744
      \uCD94\uCC9C\uD569\uB2C8\uB2E4!)"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153927
    m_Localized: "\uD300 \uC751\uC6D0 \uC5F0\uC2B5"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153928
    m_Localized: "[E]\uB97C \uB204\uB974\uBA74 \uC785\xB7\uC2DD\uB3C4\uC758 \uC704\uD611
      \uACBD\uACE0\uAC00 \uB728\uACE0 \n\uC704\uC5D0 \uC788\uB294 \uC785\uC774 \uB2EB\uD799\uB2C8\uB2E4.\n\uD300
      \uC751\uC6D0 \uB2E8\uC5B4\uB97C \uB2E4\uAC19\uC774 \uC678\uCE58\uBA74 \uB2E4\uC2DC
      \uC5F4\uB9BD\uB2C8\uB2E4.\n\uC678\uCE5C \uC0AC\uB78C \uBA38\uB9AC \uC704\uC5D0
      \uD558\uD2B8\uAC00 \uB739\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1091153929
    m_Localized: "\uAC8C\uC784 \uC2DC\uC791\uD558\uB7EC \uAC00\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153930
    m_Localized: "\uB178\uB780\uC0C9 \uBC14\uB2E5\uC5D0 \uC2DC\uC791 \uC874\uC774
      \uC788\uC2B5\uB2C8\uB2E4.\n\uD300 \uC804\uC6D0\uC774 \uBAA8\uC774\uBA74 \uCE74\uC6B4\uD2B8\uB2E4\uC6B4
      \uD6C4 \uAC8C\uC784\uC774 \uC2DC\uC791\uB429\uB2C8\uB2E4.\n\uCE74\uC6B4\uD2B8\uB2E4\uC6B4\uC774
      \uB05D\uB098\uBA74 \uADF8 \uC21C\uAC04\uC758 \uC751\uC6D0 \uC774\uB984\uC73C\uB85C
      \uD655\uC815\uB418\uB2C8, \n\uBBF8\uB9AC \uB2E4 \uC815\uD588\uB294\uC9C0 \uD655\uC778\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 24992255946752
    m_Localized: "\uC751\uC6D0 \uC774\uB984\uC744 \uC815\uD574\uC8FC\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 24992293695488
    m_Localized: "\uC774\uB807\uAC8C\uB294 \uC548 \uB3FC\uC694\n\xB7 \uC695\uC124/\uAE08\uCE59\uC5B4
      (\uC608: fuck)\n\xB7 \uC608\uC57D\uC5B4 (admin, host, cheer)\n\xB7 \uC22B\uC790\xB7\uBC11\uC904(_)\xB7\uD55C\uAE00\xB7\uC774\uBAA8\uC9C0\xB71\uAE00\uC790\n\xB7
      2~12\uC790, \uC601\uBB38 \uC18C\uBB38\uC790\uB9CC \uAC00\uB2A5\n\n\uD655\uC815
      \uD6C4\uC5D0\uB294 \uC2E4\uC81C\uB85C \uC778\uC2DD\uB418\uB294\uC9C0 \uD655\uC778\uD574\uBCF4\uC138\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889792
    m_Localized: "\uC608) happy"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889793
    m_Localized: "\uC608) fighting"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889794
    m_Localized: "\uD655\uC815"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889795
    m_Localized: "\uB2EB\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889796
    m_Localized: "\uD300 \uC804\uCCB4\uAC00 \uD568\uAED8 \uC678\uCE60 \uB2E8\uC5B4\uB97C
      \uC815\uD574\uC8FC\uC138\uC694 (\uAE30\uBCF8\uAC12: FIGHTING)"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889797
    m_Localized: "\uD300 \uD0A4\uC6CC\uB4DC: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647744
    m_Localized: "2~12\uC790, \uC601\uBB38 \uC18C\uBB38\uC790\uB9CC \uC0AC\uC6A9\uD560
      \uC218 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647745
    m_Localized: "\uC2DC\uC2A4\uD15C \uC608\uC57D\uC5B4\uB77C \uC0AC\uC6A9\uD560
      \uC218 \uC5C6\uB294 \uC774\uB984\uC774\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647746
    m_Localized: "\uC2DC\uC2A4\uD15C \uC608\uC57D\uC5B4\uB77C \uC0AC\uC6A9\uD560
      \uC218 \uC5C6\uB294 \uB2E8\uC5B4\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647747
    m_Localized: "\uC0AC\uC6A9\uD560 \uC218 \uC5C6\uB294 \uB2E8\uC5B4\uAC00 \uD3EC\uD568\uB418\uC5B4
      \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647748
    m_Localized: "\uC774\uBBF8 \uB2E4\uB978 \uD300\uC6D0\uC774 \uC0AC\uC6A9 \uC911\uC778
      \uC774\uB984\uC774\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647749
    m_Localized: "\uC774\uBBF8 \uD300\uC6D0\uC774 \uC751\uC6D0 \uC774\uB984\uC73C\uB85C
      \uC4F0\uACE0 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647750
    m_Localized: "\uC774\uB984\uC744 \uD655\uC815\uD560 \uC218 \uC5C6\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647751
    m_Localized: "\uD300 \uD0A4\uC6CC\uB4DC\uB97C \uD655\uC815\uD560 \uC218 \uC5C6\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647752
    m_Localized: "\uD638\uC2A4\uD2B8\uB9CC \uD300 \uD0A4\uC6CC\uB4DC\uB97C \uC815\uD560
      \uC218 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647753
    m_Localized: "\uD655\uC778 \uC911..."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647754
    m_Localized: "\uC751\uB2F5\uC774 \uC5C6\uC5B4\uC694. \uB2E4\uC2DC \uC2DC\uB3C4\uD574
      \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 53793039953920
    m_Localized: "\uC774\uB984 \uBC14\uAFB8\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 53793073508352
    m_Localized: "\uAC1C\uC778 \uC774\uB984\uACFC \uD300 \uD0A4\uC6CC\uB4DC, \uB9C8\uC9C0\uB9C9\uC73C\uB85C
      \uD55C \uBC88 \uB354 \uBC14\uAFC0 \uC218 \uC788\uC5B4\uC694.\n\uC5EC\uAE30\uC11C
      \uB193\uCE58\uBA74 \uAC8C\uC784\uC774 \uB05D\uB0A0 \uB54C\uAE4C\uC9C0 \uBABB
      \uBC14\uAFB8\uB2C8,\n\uC6D0\uD558\uC2DC\uB294 \uBD84\uC740 \uBC1C\uD310\uC5D0\uC11C
      \uC9C0\uAE08 \uB2E4\uC2DC \uC815\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 56930631004160
    m_Localized: "[E] \uC774\uB984 \uC124\uC815"
    m_Metadata:
      m_Items: []
  - m_Id: 56930635198464
    m_Localized: "[E] \uD300 \uC751\uC6D0 \uD14C\uC2A4\uD2B8"
    m_Metadata:
      m_Items: []
  - m_Id: 1395064601948160
    m_Localized: "\uBC29\uC5B4\uB294 \uB77C\uC6B4\uB4DC \uB370\uBBF8\uC9C0\uB3C4
      \uB9C9\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1395064639696896
    m_Localized: "\uC790\uC2E0\uC758 \uC774\uB984\uC744 \uB9D0\uD558\uBA74 \uBC84\uD504\uAC00
      \uCF1C\uC9D1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  references:
