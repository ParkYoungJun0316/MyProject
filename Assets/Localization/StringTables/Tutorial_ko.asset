  m_TableData:
  - m_Id: 1040822272
    m_Localized: "\uC774\uB3D9"
    m_Metadata:
      m_Items: []
  - m_Id: 1086959616
    m_Localized: "\uBC00\uCE58\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1086959617
    m_Localized: "\uC0C9 \uBCC0\uACBD \uD751/\uBC31"
    m_Metadata:
      m_Items: []
  - m_Id: 1086959618
    m_Localized: "\uC0C9 \uBCC0\uACBD \uACE0\uC720\uC0C9"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153920
    m_Localized: "\uBC84\uD504 \uAD50\uCCB4"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153923
    m_Localized: "\uD300 \uAD6C\uD638"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153924
    m_Localized: "\uACBD\uACE0\uAC00 \uB728\uBA74\n\uB2E4 \uAC19\uC774 \uD300 \uAD6C\uD638\uB97C
      \uC678\uCE58\uC138\uC694.\n\uB179\uC74C\uD55C \uADF8\uB300\uB85C \uC678\uCCD0\uC57C
      \uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1091153925
    m_Localized: "\uD300 \uAD6C\uD638 \uC815\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153926
    m_Localized: "\uD638\uC2A4\uD2B8\uAC00 \uC18C\uB9AC\uB97C \uB179\uC74C\uD558\uBA74\n\uBAA8\uB450
      \uB611\uAC19\uC774 \uB450 \uBC88 \uB179\uC74C\uD574\uC694.\n\uB9C8\uC774\uD06C\uAC00
      \uC5C6\uC73C\uBA74\n\uC124\uC815\uC5D0\uC11C T\uD0A4 \uC751\uC6D0\uC744 \uCF1C\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 24992255946752
    m_Localized: "\uD300 \uAD6C\uD638 \uB4F1\uB85D"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889793
    m_Localized: "\uC608) fighting"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889794
    m_Localized: "\uD655\uC815"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889795
    m_Localized: "\uB2EB\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889796
    m_Localized: "\uD638\uC2A4\uD2B8: \uB2E4 \uAC19\uC774 \uC678\uCE60 \uC18C\uB9AC\uB97C
      \uB179\uC74C\uD558\uC138\uC694.\n\uC5B4\uB5A4 \uB9D0\uC774\uB098 \uC18C\uB9AC\uB3C4
      OK (\uC18C\uB9AC 0.5\uCD08 \uC774\uC0C1, \uB179\uC74C \uCD5C\uB300 3\uCD08)"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889797
    m_Localized: "\uD300 \uAD6C\uD638: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647744
    m_Localized: "2~12\uC790, \uC601\uBB38 \uC18C\uBB38\uC790\uB9CC \uC0AC\uC6A9\uD560
      \uC218 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647746
    m_Localized: "\uC2DC\uC2A4\uD15C \uC608\uC57D\uC5B4\uB77C \uC0AC\uC6A9\uD560
      \uC218 \uC5C6\uB294 \uB2E8\uC5B4\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647747
    m_Localized: "\uC0AC\uC6A9\uD560 \uC218 \uC5C6\uB294 \uB2E8\uC5B4\uAC00 \uD3EC\uD568\uB418\uC5B4
      \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647751
    m_Localized: "\uD300 \uAD6C\uD638\uB97C \uD655\uC815\uD560 \uC218 \uC5C6\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647752
    m_Localized: "\uD638\uC2A4\uD2B8\uB9CC \uD300 \uAD6C\uD638\uB97C \uC815\uD560
      \uC218 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 53793039953920
    m_Localized: "\uD300 \uAD6C\uD638 \uBC14\uAFB8\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 53793073508352
    m_Localized: "\uD300 \uAD6C\uD638\uB97C \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uD55C
      \uBC88 \uB354 \uBC14\uAFC0 \uC218 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 56930631004160
    m_Localized: "[E] \uD300 \uAD6C\uD638 \uB4F1\uB85D"
    m_Metadata:
      m_Items: []
  - m_Id: 56930635198464
    m_Localized: "[E] \uD300 \uAD6C\uD638 \uC5F0\uC2B5"
    m_Metadata:
      m_Items: []
  - m_Id: 1395064700000001
    m_Localized: "Tip \uBCF4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 3228654335799296
    m_Localized: "\uBC84\uD504 \uC0AC\uC6A9"
    m_Metadata:
      m_Items: []
  - m_Id: 3228654377742336
    m_Localized: "\uC774\uBAA8\uD2F0\uCF58 \uC0AC\uC6A9 (1~8)"
    m_Metadata:
      m_Items: []
  - m_Id: 3228654377742337
    m_Localized: "\uC74C\uC131 \uC778\uC2DD \uAC8C\uC784\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9458308059082752
    m_Localized: "\uC74C\uC131 \uC778\uC2DD\uC774 \uBAA8\uB974\uB294 \uB2E8\uC5B4\uC608\uC694.
      \uB2E4\uB978 \uC601\uC5B4 \uB2E8\uC5B4\uB97C \uC368\uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 9787340243972096
    m_Localized: "[E] \uAFB8\uBBF8\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884459483136
    m_Localized: "\uB179\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426176
    m_Localized: "\uC815\uC9C0 ({0:0.0}\uCD08)"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426177
    m_Localized: "1\uBC88 \uB179\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426178
    m_Localized: "2\uBC88 \uB179\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426179
    m_Localized: "\uB2E4\uC2DC \uB4E3\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426180
    m_Localized: "\uD638\uC2A4\uD2B8 \uC18C\uB9AC \uB4E3\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426181
    m_Localized: "\uD638\uC2A4\uD2B8\uAC00 \uC544\uC9C1 \uD300 \uAD6C\uD638\uB97C
      \uB179\uC74C\uD558\uC9C0 \uC54A\uC558\uC5B4\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426182
    m_Localized: "\uD300 \uAD6C\uD638 \uC900\uBE44 \uC644\uB8CC ({1:0.0}\uCD08)"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426183
    m_Localized: "\uB179\uC74C\uD588\uC5B4\uC694. \uB4E4\uC5B4 \uBCF4\uACE0 [\uD655\uC815]\uC744
      \uB204\uB974\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426184
    m_Localized: "\uD638\uC2A4\uD2B8 \uC18C\uB9AC\uB97C \uB4E3\uACE0, \uB611\uAC19\uC774
      [1\uBC88 \uB179\uC74C]\uC744 \uD558\uC138\uC694 (\uC18C\uB9AC 0.5\uCD08 \uC774\uC0C1)"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426185
    m_Localized: "\uD55C \uBC88 \uB354 \uB611\uAC19\uC774 [2\uBC88 \uB179\uC74C]\uC744
      \uD558\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426186
    m_Localized: "\uB4F1\uB85D \uC644\uB8CC! \uC774\uC81C \uC5F0\uC2B5 \uD45C\uC9C0\uD310\uC5D0\uC11C
      \uC678\uCCD0 \uBCF4\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426187
    m_Localized: "\uD638\uC2A4\uD2B8\uAC00 \uB2E4\uC2DC \uB179\uC74C\uD588\uC5B4\uC694.
      \uB2E4\uC2DC \uB4F1\uB85D\uD558\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426188
    m_Localized: "\uB9C8\uC774\uD06C \uC18C\uB9AC\uAC00 \uB4E4\uC5B4\uC624\uC9C0
      \uC54A\uC544\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426189
    m_Localized: "\uB108\uBB34 \uC791\uC544\uC694. \uD06C\uAC8C \uC678\uCCD0 \uC8FC\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426190
    m_Localized: "\uB108\uBB34 \uCEE4\uC11C \uC18C\uB9AC\uAC00 \uAE68\uC838\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426191
    m_Localized: "\uB108\uBB34 \uC9E7\uC544\uC694. \uCD5C\uC18C 0.5\uCD08 \uC774\uC0C1
      \uC18C\uB9AC\uB97C \uB0B4 \uC8FC\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426192
    m_Localized: "\uB108\uBB34 \uAE38\uC5B4\uC694 (\uCD5C\uB300 3\uCD08)"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426193
    m_Localized: "\uB04A\uB294 \uD69F\uC218\uAC00 \uB2EC\uB77C\uC694 (\uD638\uC2A4\uD2B8
      {0}\uBC88, \uB098 {1}\uBC88)"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426194
    m_Localized: "\uB192\uB0AE\uC774\uAC00 \uB2EC\uB77C\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426195
    m_Localized: "\uC18C\uB9AC\uAC00 \uB2EC\uB77C\uC694. \uD638\uC2A4\uD2B8 \uC18C\uB9AC\uB97C
      \uB2E4\uC2DC \uB4E3\uACE0 \uB530\uB77C \uD558\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426196
    m_Localized: "1\uBC88\uACFC \uB2E4\uB974\uAC8C \uB4E4\uB824\uC694. 1\uBC88 \uB179\uC74C
      \uB54C\uCC98\uB7FC \uC678\uCCD0 \uC8FC\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426197
    m_Localized: "\uC88B\uC544\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426198
    m_Localized: "\uD300 \uAD6C\uD638 \uD655\uC815! \uD300\uC6D0\uB4E4\uC5D0\uAC8C
      \uBCF4\uB0C8\uC5B4\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426199
    m_Localized: "\uD638\uC2A4\uD2B8\uAC00 \uD300 \uAD6C\uD638\uB97C \uB179\uC74C\uD574\uC57C
      \uC2DC\uC791\uD560 \uC218 \uC788\uC5B4\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426200
    m_Localized: "\uBAA8\uB450 \uD300 \uAD6C\uD638 \uC5F0\uC2B5\uC744 \uD1B5\uACFC\uD574\uC57C
      \uC2DC\uC791\uD574\uC694 ({0}/{1})"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426201
    m_Localized: "[R] \uD300 \uAD6C\uD638 \uB4E3\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 10576884501426202
    m_Localized: "\uC124\uC815\uC5D0\uC11C 'T\uD0A4\uB85C \uC751\uC6D0\uD558\uAE30'\uB97C
      \uCF1C\uBA74 T\uD0A4\uB85C\uB3C4 \uC751\uC6D0\uD560 \uC218 \uC788\uC5B4\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 10601490503282688
    m_Localized: "\uB9C8\uC774\uD06C\uAC00 \uC5C6\uC5B4\uC694 (T\uD0A4\uB85C \uC751\uC6D0)"
    m_Metadata:
      m_Items: []
  - m_Id: 10601490541031424
    m_Localized: "\uB9C8\uC774\uD06C \uC5C6\uC74C (\uD300 \uC804\uCCB4 T\uD0A4\uB85C
      \uC751\uC6D0)"
    m_Metadata:
      m_Items: []
  - m_Id: 10601490541031425
    m_Localized: "\uC774\uBC88 \uD310\uC740 \uB9C8\uC774\uD06C \uC5C6\uC774 T\uD0A4\uB85C
      \uC751\uC6D0\uD574\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 10601490541031426
    m_Localized: "T\uD0A4\uB85C \uC751\uC6D0\uD574\uC694. \uC5F0\uC2B5 \uB54C T\uD0A4\uB97C
      \uB204\uB974\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 10601490541031427
    m_Localized: "\uC544\uC9C1 \uC900\uBE44 \uC548 \uB41C \uC0AC\uB78C\uC774 \uC788\uC5B4\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 10601490541031428
    m_Localized: "\uC900\uBE44 \uC644\uB8CC"
    m_Metadata:
      m_Items: []
  - m_Id: 10601490541031429
    m_Localized: "1\xB72\uBC88 \uB179\uC74C \uD544\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 10601490541031430
    m_Localized: "1\uBC88 \uB179\uC74C \uD544\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 10601490541031431
    m_Localized: "2\uBC88 \uB179\uC74C \uD544\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 10601490541031432
    m_Localized: "\uC5F0\uC2B5 \uD544\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 10601490541031433
    m_Localized: "T\uD0A4"
    m_Metadata:
      m_Items: []
  - m_Id: 10601490541031434
    m_Localized: "\uC544\uC9C1 \uC900\uBE44 \uC548 \uB41C \uC0AC\uB78C\uC774 \uC788\uC5B4\uC694.
      Start \uAC04\uD310\uC744 \uD655\uC778\uD558\uC138\uC694"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
