--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: StageTip_en
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: b434763c88cad514394ee69eedd290e7, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1141485568
    m_Localized: "\u2022 Only one color of mouth comes up at a time.\n\u2022 Anyone
      can match their color and step on black-and-white pads.\n\u2022 When \"TEAMCHEER\"
      pops up at the top, shout your team cheer."
    m_Metadata:
      m_Items: []
  - m_Id: 1183428608
    m_Localized: "\u2022 The assigned color has to be in that zone.\n\u2022 When
      \"TEAMCHEER\" pops up at the top, shout your team cheer."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622912
    m_Localized: "\u2022 Press Ctrl to match your character to the black or white
      floor and break the lock-on."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622913
    m_Localized: "\u2022 Stand on a tile for 2 seconds to score.\n\u2022 Unique-color
      tiles only count for that color. Anyone can step on black or white."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622914
    m_Localized: "\u2022 Press Space when your color lights up.\n\u2022 Anyone can
      hit white. Black skips to the next turn after 1 second.\n\u2022 You can't use
      your Space buff during this minigame."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622915
    m_Localized: "\u2022 You only see one tile ahead.\n\u2022 Memorize which ones
      to press."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622916
    m_Localized: "\u2022 Press Ctrl to match your character to the floor color and
      break the lock-on.\n\u2022 Shout the team cheer while \"TEAMCHEER\" is up to
      repair the floor.\n\u2022 If it's already broken, hold out until the next warning."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622917
    m_Localized: "\u2022 If a unique-color tile appears, stand on it.\n\u2022 If
      it doesn't, hold out on black or white.\n\u2022 Match your character's color
      to the floor too."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622918
    m_Localized: "\u2022 Ram the side walls when they show your color \u2014 they'll
      get knocked back."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622919
    m_Localized: "\u2022 Memorize the path."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622920
    m_Localized: "\u2022 Only step on tiles of your color.\n\u2022 Even if the tile
      matches, don't do it while you're black or white."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622921
    m_Localized: "\u2022 The assigned color has to go first before anyone else can
      step on that floor."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622922
    m_Localized: "\u2022 Match the side walls' color and ram them \u2014 they'll
      get knocked back."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622923
    m_Localized: "\u2022 Touching the front or back walls, or the swellings, will
      bounce you."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622924
    m_Localized: "\u2022 Use your buff to catch the red blood cells."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622925
    m_Localized: "\u2022 Bounce off the green swellings to get away."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622926
    m_Localized: "\u2022 Have the assigned color open the path, then reach the goal.\n\n\u2022
      Finish this section before the candy hits the ground."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622927
    m_Localized: "\u2022 Step on the pads to make a path, then reach the goal.\n\n\u2022
      Finish this section before the candy hits the ground."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622928
    m_Localized: "\u2022 Step on the center pad, bounce up, and ram the candy in
      matching color.\n\n\u2022 Finish this section before the candy hits the ground."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622929
    m_Localized: "\u2022 Match the wall's color and ram it to push it back."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
