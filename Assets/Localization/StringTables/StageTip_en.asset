MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: StageTip_en
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: b434763c88cad514394ee69eedd290e7, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1141485568
    m_Localized: 'Only one color of mouth comes up at a time.

      Anyone can match
      their color and step on black-and-white pads.

      When "TEAMCHEER" pops
      up at the top, shout your team cheer.'
    m_Metadata:
      m_Items: []
  - m_Id: 1183428608
    m_Localized: 'The assigned color has to be in that zone.

      When "TEAMCHEER"
      pops up at the top, shout your team cheer.'
    m_Metadata:
      m_Items: []
  - m_Id: 1187622912
    m_Localized: Press Ctrl to match your character to the black or white floor and
      break the lock-on.
    m_Metadata:
      m_Items: []
  - m_Id: 1187622913
    m_Localized: 'Stand on a tile for 2 seconds to score.

      Unique-color tiles
      only count for that color. Anyone can step on black or white.'
    m_Metadata:
      m_Items: []
  - m_Id: 1187622914
    m_Localized: 'Press Space when your color lights up.

      Anyone can hit white.
      Black skips to the next turn after 1 second.

      You can''t use your Space
      buff during this minigame.'
    m_Metadata:
      m_Items: []
  - m_Id: 1187622915
    m_Localized: 'You only see one tile ahead.

      Memorize which ones to press.'
    m_Metadata:
      m_Items: []
  - m_Id: 1187622916
    m_Localized: 'Press Ctrl to match your character to the floor color and break
      the lock-on.

      Shout the team cheer while "TEAMCHEER" is up to repair
      the floor.

      If it''s already broken, hold out until the next warning.'
    m_Metadata:
      m_Items: []
  - m_Id: 1187622917
    m_Localized: 'If a unique-color tile appears, stand on it.

      If it doesn''t,
      hold out on black or white.

      Match your character''s color to the floor
      too.'
    m_Metadata:
      m_Items: []
  - m_Id: 1187622918
    m_Localized: "Ram the side walls when they show your color \u2014 they'll get
      knocked back."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622919
    m_Localized: Memorize the path.
    m_Metadata:
      m_Items: []
  - m_Id: 1187622920
    m_Localized: 'Only step on tiles of your color.

      Even if the tile matches,
      don''t do it while you''re black or white.'
    m_Metadata:
      m_Items: []
  - m_Id: 1187622921
    m_Localized: The assigned color has to go first before anyone else can step on
      that floor.
    m_Metadata:
      m_Items: []
  - m_Id: 1187622922
    m_Localized: "Match the side walls' color and ram them \u2014 they'll get knocked
      back."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622923
    m_Localized: Touching the front or back walls, or the swellings, will bounce
      you.
    m_Metadata:
      m_Items: []
  - m_Id: 1187622924
    m_Localized: Use your buff to catch the red blood cells.
    m_Metadata:
      m_Items: []
  - m_Id: 1187622925
    m_Localized: Bounce off the green swellings to get away.
    m_Metadata:
      m_Items: []
  - m_Id: 1187622926
    m_Localized: 'Have the assigned color open the path, then reach the goal.


      Finish
      this section before the candy hits the ground.'
    m_Metadata:
      m_Items: []
  - m_Id: 1187622927
    m_Localized: 'Step on the pads to make a path, then reach the goal.


      Finish
      this section before the candy hits the ground.'
    m_Metadata:
      m_Items: []
  - m_Id: 1187622928
    m_Localized: 'Step on the center pad, bounce up, and ram the candy in matching
      color.


      Finish this section before the candy hits the ground.'
    m_Metadata:
      m_Items: []
  - m_Id: 1187622929
    m_Localized: Match the wall's color and ram it to push it back.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
