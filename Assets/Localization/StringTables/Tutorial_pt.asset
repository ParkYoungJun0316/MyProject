  m_TableData:
  - m_Id: 1040822272
    m_Localized: Mover
    m_Metadata:
      m_Items: []
  - m_Id: 1086959616
    m_Localized: Empurrar (sem dano)
    m_Metadata:
      m_Items: []
  - m_Id: 1086959617
    m_Localized: Mudar cor P/B
    m_Metadata:
      m_Items: []
  - m_Id: 1086959618
    m_Localized: "Mudar cor pr\xF3pria"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153920
    m_Localized: "Trocar b\xF3nus (Defesa \u2194 Velocidade)"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153923
    m_Localized: Incentivo de equipa
    m_Metadata:
      m_Items: []
  - m_Id: 1091153924
    m_Localized: "Quando aparecer o \xEDcone de aviso, gritem todos juntos a palavra
      de equipa para anular a amea\xE7a.\nCarrega em [E] aqui para praticares j\xE1."
    m_Metadata:
      m_Items: []
  - m_Id: 1091153925
    m_Localized: Palavra de equipa
    m_Metadata:
      m_Items: []
  - m_Id: 1091153926
    m_Localized: "S\xF3 o anfitri\xE3o pode definir a TeamCheerWord.\nQuanto mais
      natural for a palavra ao diz\xEA-la, melhor \xE9 reconhecida. (2 a 12 letras,
      apenas min\xFAsculas em ingl\xEAs)\nSem microfone ou o reconhecimento n\xE3o
      funciona? Ativa o incentivo pela tecla T em Op\xE7\xF5es \u2192 Geral e carrega
      em T quando aparecer o aviso."
    m_Metadata:
      m_Items: []
  - m_Id: 24992255946752
    m_Localized: Escolhe a palavra de equipa
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889793
    m_Localized: 'ex.: fighting'
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889794
    m_Localized: Confirmar
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889795
    m_Localized: Fechar
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889796
    m_Localized: "Define a palavra que toda a equipa vai gritar em conjunto (predefini\xE7\xE3o:
      FIGHTING)"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889797
    m_Localized: 'Palavra de equipa: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647744
    m_Localized: "Usa apenas entre 2 e 12 letras min\xFAsculas em ingl\xEAs."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647746
    m_Localized: "Essa palavra \xE9 uma palavra reservada do sistema, por isso n\xE3o
      podes us\xE1-la."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647747
    m_Localized: "Cont\xE9m uma palavra que n\xE3o pode ser usada."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647751
    m_Localized: "N\xE3o foi poss\xEDvel confirmar a palavra de equipa."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647752
    m_Localized: "S\xF3 o anfitri\xE3o pode definir a palavra de equipa."
    m_Metadata:
      m_Items: []
  - m_Id: 53793039953920
    m_Localized: Mudar a palavra de equipa
    m_Metadata:
      m_Items: []
  - m_Id: 53793073508352
    m_Localized: "Aqui podem mudar a palavra de equipa pela \xFAltima vez.\nSe perderem
      esta oportunidade, fica fixa at\xE9 ao fim do jogo,\npor isso quem quiser mud\xE1-la,
      fa\xE7a-o agora no painel."
    m_Metadata:
      m_Items: []
  - m_Id: 56930631004160
    m_Localized: '[E] Definir palavra de equipa'
    m_Metadata:
      m_Items: []
  - m_Id: 56930635198464
    m_Localized: '[E] Teste de incentivo de equipa'
    m_Metadata:
      m_Items: []
  - m_Id: 1395064601948160
    m_Localized: "A defesa tamb\xE9m bloqueia o dano da ronda."
    m_Metadata:
      m_Items: []
  - m_Id: 1395064700000001
    m_Localized: "Reanimar (Mantenha premido junto a um colega de equipa ca\xEDdo)"
    m_Metadata:
      m_Items: []
  - m_Id: 3228654335799296
    m_Localized: "Usar b\xF3nus"
    m_Metadata:
      m_Items: []
  - m_Id: 3228654377742336
    m_Localized: Usar emote (1-8)
    m_Metadata:
      m_Items: []
  - m_Id: 3228654377742337
    m_Localized: "Este \xE9 um jogo de reconhecimento de voz. Siga as instru\xE7\xF5es
      no painel atr\xE1s de si."
    m_Metadata:
      m_Items: []
