  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Tutorial_pt
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: pt
  m_SharedData: {fileID: 11400000, guid: 240b9339ac6f60941bcab9ac03699409, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1040822272
    m_Localized: Mover
    m_Metadata:
      m_Items: []
  - m_Id: 1086959616
    m_Localized: "Empurr\xE3o (0 de dano)"
    m_Metadata:
      m_Items: []
  - m_Id: 1086959617
    m_Localized: Preto e branco
    m_Metadata:
      m_Items: []
  - m_Id: 1086959618
    m_Localized: A tua cor
    m_Metadata:
      m_Items: []
  - m_Id: 1091153920
    m_Localized: "Trocar de b\xF3nus"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153921
    m_Localized: Incentivo a solo
    m_Metadata:
      m_Items: []
  - m_Id: 1091153922
    m_Localized: "Grita o teu pr\xF3prio nome para ativares o teu b\xF3nus.\nCarrega
      em E para definires a tua alcunha.\nN\xE3o te esque\xE7as de testar!"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153923
    m_Localized: Incentivo de equipa
    m_Metadata:
      m_Items: []
  - m_Id: 1091153924
    m_Localized: "Quando aparecer o \xEDcone de aviso, gritem todos juntos a palavra
      de equipa.\nIsso anula a amea\xE7a que a boca ou o es\xF3fago acabaram de fazer.\nS\xF3
      o anfitri\xE3o pode definir a palavra de equipa \u2014 combinem isso antes
      com a equipa."
    m_Metadata:
      m_Items: []
  - m_Id: 1091153925
    m_Localized: Nome de incentivo
    m_Metadata:
      m_Items: []
  - m_Id: 1091153926
    m_Localized: "O nome de incentivo s\xF3 pode ser escrito em ingl\xEAs.\nQuanto
      mais natural for a palavra ao diz\xEA-la, melhor \xE9 reconhecida!\nSem microfone
      ou o reconhecimento n\xE3o funciona? Ativa o incentivo por teclas num\xE9ricas
      no menu ESC.\n(1 \xE9 incentivo a solo, 2 \xE9 incentivo de equipa \u2014 mas
      incentivar com a voz \xE9 muito mais divertido!)"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153927
    m_Localized: Treino de incentivo de equipa
    m_Metadata:
      m_Items: []
  - m_Id: 1091153928
    m_Localized: "Ao carregares em [E] aparece um aviso igual ao de uma amea\xE7a
      real\ne a boca ali em cima fecha-se.\nGritem todos juntos a palavra de equipa
      para a voltar a abrir.\nAparece um cora\xE7\xE3o por cima da cabe\xE7a de quem
      gritou."
    m_Metadata:
      m_Items: []
  - m_Id: 1091153929
    m_Localized: "Vamos come\xE7ar o jogo"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153930
    m_Localized: "A zona de in\xEDcio fica no ch\xE3o amarelo.\nQuando toda a equipa
      se juntar ali, come\xE7a uma contagem decrescente e o jogo arranca.\nO vosso
      nome de incentivo fica fixado no instante em que a contagem termina,\npor isso
      confirmem que j\xE1 est\xE1 tudo decidido antes disso."
    m_Metadata:
      m_Items: []
  - m_Id: 24992255946752
    m_Localized: Escolhe o teu nome de incentivo
    m_Metadata:
      m_Items: []
  - m_Id: 24992293695488
    m_Localized: "Isto n\xE3o pode\n\xB7 Palavr\xF5es/palavras proibidas (ex.: fuck)\n\xB7
      Palavras reservadas (admin, host, cheer)\n\xB7 N\xFAmeros, sublinhado (_),
      coreano, emojis, uma \xFAnica letra\n\xB7 2 a 12 carateres, apenas letras min\xFAsculas
      em ingl\xEAs\n\nDepois de confirmares, testa se \xE9 mesmo reconhecido!"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889792
    m_Localized: 'ex.: happy'
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889793
    m_Localized: 'ex.: fighting'
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889794
    m_Localized: Confirmar
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889795
    m_Localized: Fechar
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889796
    m_Localized: "Define a palavra que toda a equipa vai gritar em conjunto (predefini\xE7\xE3o:
      FIGHTING)"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889797
    m_Localized: 'Palavra de equipa: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647744
    m_Localized: "Usa apenas entre 2 e 12 letras min\xFAsculas em ingl\xEAs."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647745
    m_Localized: "Esse nome \xE9 uma palavra reservada do sistema, por isso n\xE3o
      podes us\xE1-lo."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647746
    m_Localized: "Essa palavra \xE9 uma palavra reservada do sistema, por isso n\xE3o
      podes us\xE1-la."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647747
    m_Localized: "Cont\xE9m uma palavra que n\xE3o pode ser usada."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647748
    m_Localized: "Esse nome j\xE1 est\xE1 a ser usado por outro colega de equipa."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647749
    m_Localized: "Um colega de equipa j\xE1 est\xE1 a usar isso como nome de incentivo."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647750
    m_Localized: "N\xE3o foi poss\xEDvel confirmar o nome."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647751
    m_Localized: "N\xE3o foi poss\xEDvel confirmar a palavra de equipa."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647752
    m_Localized: "S\xF3 o anfitri\xE3o pode definir a palavra de equipa."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647753
    m_Localized: "A verificar\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647754
    m_Localized: Sem resposta. Tenta novamente.
    m_Metadata:
      m_Items: []
  - m_Id: 53793039953920
    m_Localized: Mudar de nome
    m_Metadata:
      m_Items: []
  - m_Id: 53793073508352
    m_Localized: "Aqui podes mudar o teu nome e a palavra de equipa uma \xFAltima
      vez.\nSe perderes esta oportunidade, s\xF3 podes voltar a mud\xE1-los quando
      a partida acabar,\npor isso, se quiseres mudar, faz j\xE1 no letreiro."
    m_Metadata:
      m_Items: []
  - m_Id: 56930631004160
    m_Localized: '[E] Definir nome'
    m_Metadata:
      m_Items: []
  - m_Id: 56930635198464
    m_Localized: '[E] Teste de incentivo de equipa'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
