  m_SharedData: {fileID: 11400000, guid: 96adcc13da5290147bc44fb643567e28, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 895241269248
    m_Localized: "\uC74C\uC2DD\uC774 \uC2DD\uB3C4\uB85C \uB0B4\uB824\uAC00\uB294
      \uAC74 \uC911\uB825 \uB54C\uBB38\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240768
    m_Localized: "\uC2DD\uB3C4\uB294 \uADFC\uC721 \uC6B4\uB3D9\uC73C\uB85C \uC74C\uC2DD\uC744
      \uBC00\uC5B4\uB0B4\uB9AC\uAE30 \uB54C\uBB38\uC5D0, \uBAB8\uC774 \uB4A4\uC9D1\uD600
      \uC788\uC5B4\uB3C4 \uC0BC\uD0AC \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240769
    m_Localized: "\uC18C\uD654\uB294 \uC2DD\uB3C4\uC5D0\uC11C \uC77C\uC5B4\uB09C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240770
    m_Localized: "\uC2DD\uB3C4\uB294 \uC8FC\uB85C \uC74C\uC2DD\uC744 \uC704\uB85C
      \uC774\uB3D9\uC2DC\uD0A4\uB294 \uC5ED\uD560\uC744 \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240771
    m_Localized: "\uC2DD\uB3C4\uB294 \uD56D\uC0C1 \uC5F4\uB824 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240772
    m_Localized: "\uD3C9\uC18C\uC5D0\uB294 \uB2EB\uD600 \uC788\uACE0, \uC74C\uC2DD\uC774
      \uC9C0\uB098\uAC08 \uB54C\uB9CC \uC5F4\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240773
    m_Localized: "\uC2DD\uB3C4\uB294 \uC74C\uC2DD\uC744 \uC544\uB798\uCABD\uC73C\uB85C\uB9CC
      \uC774\uB3D9\uC2DC\uD0A8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240774
    m_Localized: "\uAD6C\uD1A0\uD560 \uB54C\uB294 \uBC18\uB300\uB85C \uC74C\uC2DD\uC774
      \uC704\uCABD\uC73C\uB85C \uC774\uB3D9\uD560 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240775
    m_Localized: "\uC2DD\uB3C4\uC640 \uC704 \uC0AC\uC774\uC5D0\uB294 \uC704\uC0B0
      \uC5ED\uB958\uB97C \uB9C9\uC544\uC8FC\uB294 \uADFC\uC721\uC774 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240776
    m_Localized: "\uD558\uBD80 \uC2DD\uB3C4 \uC870\uC784\uADFC\uC774 \uC704\uC0B0\uC774
      \uB2E4\uC2DC \uC62C\uB77C\uC624\uB294 \uAC83\uC744 \uB9C9\uC544\uC900\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240777
    m_Localized: "\uC2DD\uB3C4\uC554\uC740 \uCD08\uAE30\uC5D0 \uBC1C\uACAC\uD558\uAE30
      \uC27D\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240778
    m_Localized: "\uCD08\uAE30\uC5D0\uB294 \uC99D\uC0C1\uC774 \uAC70\uC758 \uC5C6\uC5B4\uC11C
      \uB2A6\uAC8C \uBC1C\uACAC\uB418\uB294 \uACBD\uC6B0\uAC00 \uB9CE\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240779
    m_Localized: "\uB538\uAFB9\uC9C8\uC740 \uC2DD\uB3C4 \uB54C\uBB38\uC5D0 \uC0DD\uAE34\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240780
    m_Localized: "\uB538\uAFB9\uC9C8\uC740 \uD6A1\uACA9\uB9C9\uC774 \uAC11\uC790\uAE30
      \uC218\uCD95\uD560 \uB54C \uC77C\uC5B4\uB09C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240781
    m_Localized: "\uC2DD\uB3C4\uB294 \uC548\uC5D0 \uC74C\uC2DD\uC774 \uC5C6\uC5B4\uB3C4
      \uC6C0\uC9C1\uC77C \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240782
    m_Localized: "\uC2DD\uB3C4\uC5D0\uC11C\uB294 \uC791\uC740 \uADFC\uC721 \uC6B4\uB3D9\uC774
      \uACC4\uC18D \uC77C\uC5B4\uB0A0 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240783
    m_Localized: "\uC2DD\uB3C4\uB294 \uACF5\uAE30\uB3C4 \uC774\uB3D9\uC2DC\uD0AC
      \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240784
    m_Localized: "\uD2B8\uB9BC\uC744 \uD560 \uB54C \uACF5\uAE30\uAC00 \uC2DD\uB3C4\uB97C
      \uD1B5\uD574 \uC774\uB3D9\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240785
    m_Localized: "\uBB3C\uC740 \uC2DD\uB3C4\uC5D0 \uC7A0\uAE50 \uBA38\uBB3C\uB7EC
      \uC788\uC744 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240786
    m_Localized: "\uBB3C\uB3C4 \uADFC\uC721 \uC6B4\uB3D9\uC744 \uD1B5\uD574 \uC544\uB798\uB85C
      \uC774\uB3D9\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240787
    m_Localized: "\uC2DD\uB3C4\uB294 \uC2A4\uC2A4\uB85C \uC5B8\uC81C \uC5F4\uACE0
      \uB2EB\uC744\uC9C0\uB97C \uC870\uC808\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240788
    m_Localized: "\uC2DD\uB3C4\uC758 \uC6C0\uC9C1\uC784\uC740 \uC2E0\uACBD\uACC4\uC5D0
      \uC758\uD574 \uC790\uB3D9\uC73C\uB85C \uC870\uC808\uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240789
    m_Localized: "\uC2DD\uB3C4\uB294 \uC74C\uC2DD \uB0C4\uC0C8\uB9CC \uB9E1\uC544\uB3C4
      \uC6C0\uC9C1\uC77C \uC900\uBE44\uB97C \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240790
    m_Localized: "\uB1CC\uB294 \uC74C\uC2DD\uC774 \uB4E4\uC5B4\uC62C \uAC83\uC744
      \uC608\uC0C1\uD558\uBA74 \uC18C\uD654\uAE30\uAD00\uC744 \uD65C\uC131\uD654\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240791
    m_Localized: "\uC57D\uC744 \uC0BC\uD0A8 \uB4A4\uC5D0\uB3C4 \uBAA9\uC5D0 \uAC78\uB9B0
      \uB290\uB08C\uC774 \uB4E4 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 895262240792
    m_Localized: "\uC2DD\uB3C4\uC758 \uC790\uADF9 \uB54C\uBB38\uC5D0 \uB1CC\uAC00
      \uC5EC\uC804\uD788 \uBB54\uAC00 \uB0A8\uC544 \uC788\uB2E4\uACE0 \uB290\uB084
      \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
