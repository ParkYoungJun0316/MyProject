      m_Items: []
  - m_Id: 1187622922
    m_Localized: "\u2022 \u770B\u677F\u306E\u30BF\u30A4\u30DE\u30FC\u304C\u5207\u308C\u308B\u524D\u306B\u533A\u9593\u3092\u629C\u3051\u3066\u304F\u3060\u3055\u3044\u3002\u9045\u308C\u308B\u3068\u80C3\u6DB2\u304C\u3042\u3075\u308C\u307E\u3059\u3002\n\u2022
