      m_Items: []
  - m_Id: 1187622917
    m_Localized: "\u2022 \u81EA\u5206\u306E\u8272\u306E\u30DE\u30B9\u304C\u51FA\u305F\u3089\u3001\u305D\u306E\u4E0A\u306B\u4E57\u3063\u3066\u304F\u3060\u3055\u3044\u3002\n\u2022
