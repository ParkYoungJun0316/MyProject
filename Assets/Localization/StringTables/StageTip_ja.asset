    m_Metadata:
      m_Items: []
  - m_Id: 1187622912
    m_Localized: "\u2022 Ctrl\u3092\u62BC\u3057\u3066\u81EA\u5206\u306E\u8272\u3092\u9ED2\u307E\u305F\u306F\u767D\u306E\u5E8A\u306B\u5408\u308F\u305B\u3001\u72D9\u308F\u308C\u308B\u306E\u3092\u907F\u3051\u307E\u3057\u3087\u3046\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622913
    m_Localized: "\u2022 \u30BF\u30A4\u30EB\u306E\u4E0A\u306B2\u79D2\u9593\u7ACB\u3064\u3068\u30B9\u30B3\u30A2\u3092\u7372\u5F97\u3057\u307E\u3059\u3002\n\u2022
      \u8272\u4ED8\u304D\u30BF\u30A4\u30EB\u306F\u3001\u305D\u306E\u8272\u306E\u30D7\u30EC\u30A4\u30E4\u30FC\u3060\u3051\u304C\u30AB\u30A6\u30F3\u30C8\u3055\u308C\u307E\u3059\u3002\u9ED2\u3068\u767D\u306E\u30BF\u30A4\u30EB\u306F\u8AB0\u3067\u3082\u30AB\u30A6\u30F3\u30C8\u3055\u308C\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622914
    m_Localized: "\u2022 \u81EA\u5206\u306E\u8272\u304C\u5149\u3063\u305F\u3089Space\u3092\u62BC\u3057\u307E\u3057\u3087\u3046\u3002\n\u2022
      \u767D\u306F\u8AB0\u3067\u3082\u53E9\u3051\u307E\u3059\u3002\u9ED2\u306F1\u79D2\u5F8C\u306B\u6B21\u306E\u30BF\u30FC\u30F3\u3078\u9032\u307F\u307E\u3059\u3002\n\u2022
      \u3053\u306E\u30DF\u30CB\u30B2\u30FC\u30E0\u4E2D\u306FSpace\u30D0\u30D5\u3092\u4F7F\u7528\u3067\u304D\u307E\u305B\u3093\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622915
    m_Localized: "\u2022 1\u3064\u5148\u306E\u30BF\u30A4\u30EB\u3057\u304B\u898B\u3048\u307E\u305B\u3093\u3002\n\u2022
