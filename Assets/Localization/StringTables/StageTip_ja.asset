      m_Items: []
  - m_Id: 1183428608
    m_Localized: "\u2022 \u5404\u30BE\u30FC\u30F3\u306B\u306F\u3001\u770B\u677F\u306E\u4E0B\u306B\u3042\u308BKKUL-TTEOK\u306E\u6570\u3068\u540C\u3058\u4EBA\u6570\u3092\u5165\u308C\u308B\u5FC5\u8981\u304C\u3042\u308A\u307E\u3059\u3002\u591A\u3059\u304E\u3066\u3082\u5C11\u306A\u3059\u304E\u3066\u3082\u30C0\u30E1\u3067\u3059\u3002\n\u2022
      \u5168\u54E1\u304C\u9055\u3046\u3082\u306E\u3092\u898B\u307E\u3059\u3002\u898B\u3048\u305F\u3082\u306E\u3092\u5171\u6709\u3057\u307E\u3057\u3087\u3046\uFF01\n\u2022
      \u4E0A\u306B\u300CTEAMCHEER\u300D\u304C\u51FA\u305F\u3089\u3001\u30C1\u30FC\u30E0\u306E\u639B\u3051\u58F0\u3092\u53EB\u3093\u3067\u304F\u3060\u3055\u3044\u3002\n\u2022
