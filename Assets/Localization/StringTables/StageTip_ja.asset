      m_Items: []
  - m_Id: 1187622921
    m_Localized: "\u2022 \u305D\u306E\u30A8\u30EA\u30A2\u306E\u8272\u306E\u4EBA\u304C\u5148\u306B\u901A\u308C\u3070\u3001\u307B\u304B\u306E\u4EBA\u3082\u7D9A\u3051\u307E\u3059\u3002"
