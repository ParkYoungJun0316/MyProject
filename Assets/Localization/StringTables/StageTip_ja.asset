    m_Metadata:
      m_Items: []
  - m_Id: 1187622912
    m_Localized: "\u2022 Ctrl\u3067\u81EA\u5206\u306E\u8272\u3092\u767D\u9ED2\u306E\u5E8A\u306B\u5408\u308F\u305B\u3066\u3001\u72D9\u308F\u308C\u306A\u3044\u3088\u3046\u306B\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622913
    m_Localized: "\u2022 \u30BF\u30A4\u30EB\u306B2\u79D2\u4E57\u308B\u3068\u5F97\u70B9\u3067\u3059\u3002\n\u2022
      \u8272\u4ED8\u304D\u306E\u30BF\u30A4\u30EB\u306F\u305D\u306E\u8272\u306E\u4EBA\u3060\u3051\u3001\u767D\u9ED2\u306E\u30BF\u30A4\u30EB\u306F\u8AB0\u3067\u3082\u5F97\u70B9\u306B\u306A\u308A\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622914
    m_Localized: "\u2022 \u81EA\u5206\u306E\u8272\u304C\u70B9\u706F\u3057\u305F\u3089Space\u3092\u62BC\u3057\u3066\u304F\u3060\u3055\u3044\u3002\n\u2022
      \u767D\u306F\u8AB0\u3067\u3082\u62BC\u305B\u307E\u3059\u3002\u9ED2\u306F1\u79D2\u5F8C\u306B\u81EA\u52D5\u3067\u6B21\u306B\u9032\u307F\u307E\u3059\u3002\n\u2022
      \u30DF\u30CB\u30B2\u30FC\u30E0\u4E2D\u306FSpace\u306E\u30D0\u30D5\u306F\u4F7F\u3048\u307E\u305B\u3093\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1187622915
    m_Localized: "\u2022 1\u30DE\u30B9\u5148\u306E\u5E8A\u3057\u304B\u898B\u3048\u307E\u305B\u3093\u3002\n\u2022
