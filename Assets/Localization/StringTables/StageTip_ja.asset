      m_Items: []
  - m_Id: 1187622922
    m_Localized: "\u2022 \u770B\u677F\u306E\u30BF\u30A4\u30DE\u30FC\u304C\u5207\u308C\u308B\u524D\u306B\u5404\u30A8\u30EA\u30A2\u3092\u30AF\u30EA\u30A2\u3057\u307E\u3057\u3087\u3046\u3002\u9593\u306B\u5408\u308F\u306A\u3044\u3068\u80C3\u6DB2\u304C\u6D41\u308C\u8FBC\u307F\u307E\u3059\u3002\n\u2022
