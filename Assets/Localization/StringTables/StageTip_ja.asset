  m_TableData:
  - m_Id: 1141485568
    m_Localized: "\u2022 \u4E00\u5EA6\u306B\u4E0A\u304C\u308B\u53E3\u306F\u4E00\u8272\u3060\u3051\u3067\u3059\u3002\n\u2022
      \u767D\u9ED2\u306E\u8DB3\u5834\u306F\u3001\u8272\u3092\u5408\u308F\u305B\u308C\u3070\u8AB0\u3067\u3082\u4F7F\u3048\u307E\u3059\u3002\n\u2022
      \u4E0A\u306B\u300CTEAMCHEER\u300D\u304C\u51FA\u305F\u3089\u3001\u30C1\u30FC\u30E0\u306E\u5408\u8A00\u8449\u3092\u53EB\u3093\u3067\u304F\u3060\u3055\u3044\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1183428608
    m_Localized: "\u2022 \u5404\u30BE\u30FC\u30F3\u306B\u306F\u3001\u770B\u677F\u306E\u4E0B\u306EKKUL-TTEOK\u3068\u540C\u3058\u4EBA\u6570\u304C\u5FC5\u8981\u3067\u3059\u3002\u591A\u304F\u3066\u3082\u5C11\u306A\u304F\u3066\u3082\u30C0\u30E1\u3067\u3059\u3002\n\u2022
      \u898B\u3048\u3066\u3044\u308B\u3082\u306E\u306F\u4EBA\u306B\u3088\u3063\u3066\u9055\u3044\u307E\u3059\u3002\u898B\u3048\u305F\u3082\u306E\u3092\u4F1D\u3048\u5408\u3063\u3066\u304F\u3060\u3055\u3044\u3002\n\u2022
      \u4E0A\u306B\u300CTEAMCHEER\u300D\u304C\u51FA\u305F\u3089\u3001\u30C1\u30FC\u30E0\u306E\u5408\u8A00\u8449\u3092\u53EB\u3093\u3067\u304F\u3060\u3055\u3044\u3002\n\u2022
