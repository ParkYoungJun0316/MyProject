  - m_Id: 1187622916
    m_Localized: "\u2022 Ctrl\u3092\u62BC\u3057\u3066\u81EA\u5206\u306E\u8272\u3092\u5E8A\u306B\u5408\u308F\u305B\u3001\u72D9\u308F\u308C\u308B\u306E\u3092\u907F\u3051\u307E\u3057\u3087\u3046\u3002\n\u2022
