%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogue_de
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: de
  m_SharedData: {fileID: 11400000, guid: 043bf15b2a6a41c48971e11c678f419c, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 472199573504
    m_Localized: "Warum hast du all die leckeren Fr\xFCchte und Snacks liegen lassen
      und stattdessen ein KKUL-TTEOK gegessen?!"
    m_Metadata:
      m_Items: []
  - m_Id: 334352332992512
    m_Localized: 'Auf dem Boden erscheinen bunte Kacheln.

      Steht 2 Sekunden
      darauf, dann steigt der Punktestand.'
    m_Metadata:
      m_Items: []
  - m_Id: 334425666203648
    m_Localized: "Wei\xDFe oder schwarze Kacheln darf jeder betreten, aber bei Kacheln
      mit einer eigenen Farbe z\xE4hlt nur diese Farbe.\nBlockiert den Weg nicht,
      bewegt euch schnell!"
    m_Metadata:
      m_Items: []
  - m_Id: 335182629023744
    m_Localized: "Unter unseren F\xFC\xDFen bewegt sich etwas... Vorsicht!\nEin Zungenangriff
      kommt!"
    m_Metadata:
      m_Items: []
  - m_Id: 335185439207424
    m_Localized: "Die Zunge zerst\xF6rt die Plattform in der Mitte und blockiert
      den Weg.\nRuft alle zusammen den Teamruf, damit sie wieder runtergeht und der
      zerst\xF6rte Weg repariert wird."
    m_Metadata:
      m_Items: []
  - m_Id: 335887280484352
    m_Localized: "Sieht aus, als w\xFCrde es trainieren! Der Atem ist pl\xF6tzlich
      schwerer geworden.\nDer Wind kommt! Stellt euch auf die passende Kachel und
      haltet durch!"
    m_Metadata:
      m_Items: []
  - m_Id: 335890795311104
    m_Localized: Haah... haah... noch ein bisschen durchhalten, dann schaffen wir
      es vielleicht lebend raus...
    m_Metadata:
      m_Items: []
  - m_Id: 337052009345024
    m_Localized: "...Es ist ruhig geworden hier drin.\nHei\xDFt das, wir k\xF6nnen
      endlich entkommen...?"
    m_Metadata:
      m_Items: []
  - m_Id: 337056501444608
    m_Localized: .....(KRACH!)
    m_Metadata:
      m_Items: []
  - m_Id: 337060553142272
    m_Localized: Oh nein, wir werden verschluckt...!!
    m_Metadata:
      m_Items: []
  - m_Id: 337070598500352
    m_Localized: "Wir wurden verschluckt und sind in der Speiser\xF6hre gelandet...\nSo
      wie die Dinge stehen, bleibt uns nur, nach unten zu gehen und zu entkommen."
    m_Metadata:
      m_Items: []
  - m_Id: 337897539088384
    m_Localized: "Die Speiser\xF6hre wird sich in zuf\xE4lligen Abst\xE4nden zusammenziehen.\nSobald
      die Warnung erscheint, ruft alle zusammen den Teamruf, um sie zu stoppen!"
    m_Metadata:
      m_Items: []
  - m_Id: 337902496755712
    m_Localized: "Von beiden Seiten dr\xE4ngen bunte W\xE4nde heran.\nZeigt eine
      Wand deine Farbe, ramm einfach direkt rein \u2014 dann wird sie zur\xFCckgesto\xDFen."
    m_Metadata:
      m_Items: []
  - m_Id: 337904153505792
    m_Localized: Merkt euch nur die aufleuchtenden Felder. Tretet ihr aufs falsche,
      ist es sofort vorbei.
    m_Metadata:
      m_Items: []
  - m_Id: 337904874926080
    m_Localized: "Diesmal wird es nach Farben angezeigt. Du musst unbedingt deine
      eigene Farbe treffen!\nSelbst wenn die Farbe stimmt, stirbst du trotzdem, wenn
      es schwarz-wei\xDF ist."
    m_Metadata:
      m_Items: []
  - m_Id: 337906154188800
    m_Localized: "Jede Zone hat eine zust\xE4ndige Farbe. Der Weg wird erst sicher,
      wenn diese Farbe zuerst durchgeht!\nHaltet unbedingt die Reihenfolge ein!"
    m_Metadata:
      m_Items: []
  - m_Id: 337906812694528
    m_Localized: "Fangt die roten Blutk\xF6rperchen, die hier herumlaufen \u2014
      lasst uns diesem K\xF6rper Schaden zuf\xFCgen.\nWir k\xF6nnen nicht einfach
      nur einstecken!"
    m_Metadata:
      m_Items: []
  - m_Id: 337907517337600
    m_Localized: "Weil wir die roten Blutk\xF6rperchen gefangen haben, halten uns
      die wei\xDFen Blutk\xF6rperchen jetzt f\xFCr Feinde!\nRennt und \xFCberlebt!"
    m_Metadata:
      m_Items: []
  - m_Id: 339357207212032
    m_Localized: "Das ist der letzte Abschnitt der Speiser\xF6hre...\nDa unten muss
      es voller Magens\xE4ure sein. Unvorbereitet runterzugehen ist viel zu riskant."
    m_Metadata:
      m_Items: []
  - m_Id: 339360646541312
    m_Localized: "Das Bonbon von vorhin kommt von der Decke herab und wird immer
      gr\xF6\xDFer.\nWir m\xFCssen einen Boden bauen, bevor es unten aufschl\xE4gt.\nSonst
      werden wir mit runtergerissen."
    m_Metadata:
      m_Items: []
  - m_Id: 339362018078720
    m_Localized: "Schafft man jeden Abschnitt, entsteht ein St\xFCck Boden. Schnell,
      baut ihn, um das Ding zu stoppen!"
    m_Metadata:
      m_Items: []
  - m_Id: 340094578438144
    m_Localized: "Puh... gerade noch geschafft, es zu stoppen... jetzt lasst uns
      \xFCberlegen, wie wir hier sicher runterkommen."
    m_Metadata:
      m_Items: []
  - m_Id: 340096402960384
    m_Localized: "Schluck... schluck... was ist das f\xFCr ein Ger\xE4usch...?"
    m_Metadata:
      m_Items: []
  - m_Id: 340097782886400
    m_Localized: "Sein Hals ist verstopft, und es f\xE4ngt an, Wasser zu trinken!
      Das Bonbon zerschmettert den Boden!!"
    m_Metadata:
      m_Items: []
  - m_Id: 335177390338048
    m_Localized: "Wenn deine Farbe auf dem Boden aufleuchtet, dr\xFCck <color=#FFD24D><b>Space</b></color>.\nBei
      Wei\xDF darf jeder dr\xFCcken, aber bei Schwarz nicht!\nBei Schwarz geht es
      nach 1 Sekunde automatisch zum n\xE4chsten Zug \xFCber."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000001
    m_Localized: "Man sagt, selbst in der H\xF6hle des Tigers \xFCberlebt man, wenn
      man einen k\xFChlen Kopf bewahrt..!\nVon jetzt an denken wir nur ans \xDCberleben."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000002
    m_Localized: "Merkt euch gut, wo die bunten M\xE4uler um euch herum sind.\nTretet
      auf das Pedal, dann f\xE4hrt das Maul dieser Farbe hoch und zertr\xFCmmert
      die Z\xE4hne."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000003
    m_Localized: "Es f\xE4hrt immer nur eine Farbe gleichzeitig hoch.\nEs bringt
      nichts, wenn ihr alle zusammen draufsteht."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000004
    m_Localized: "Wenn sich das hier zu schlie\xDFen beginnt... ruft alle zusammen
      den Teamruf!\nSonst seht ihr bald nichts mehr."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000005
    m_Localized: Geht in die Sicherheitszone, die auf dem Bildschirm angezeigt wird!
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000006
    m_Localized: "Hat es vor dem Verschlucken irgendwas Scharfes gegessen..?\nVom
      Boden steigt st\xE4ndig Speichel auf."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000007
    m_Localized: 'Der Boden ist voller rutschigem Speichel.

      Ruft alle zusammen
      den Teamruf, um ihn zu beseitigen.'
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000008
    m_Localized: 'Jetzt tropft es sogar von oben!

      Es hat bestimmt Scharfes
      und dazu noch Saures gegessen.

      Es will das eindeutig mit einem KKUL-TTEOK
      neutralisieren!'
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000009
    m_Localized: "Manche der herabfallenden Tropfen zielen auf mich \u2013 dr\xFCckt
      <color=#FFD24D><b>Ctrl</b></color>, um die Bodenfarbe an eure eigene anzupassen
      und die Zielerfassung zu l\xF6sen."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000010
    m_Localized: 'Von jetzt an wird nur noch eine Kachel im Voraus angezeigt.

      Merkt
      sie euch gut!'
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000011
    m_Localized: "Auch hier zielt etwas auf mich.\nDr\xFCckt <color=#FFD24D><b>Ctrl</b></color>,
      um die Bodenfarbe an eure eigene anzupassen und die Zielerfassung zu l\xF6sen."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000012
    m_Localized: "Diesmal zerst\xF6rt die Zunge den ganzen Boden links oder rechts.\nRuft
      den Teamruf, um sie zu blockieren \u2013 wenn nicht, bricht er einfach zusammen."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000013
    m_Localized: "Er wird nur repariert, wenn ihr den Teamruf ruft, w\xE4hrend die
      Warnung aktiv ist.\nIst der Boden erst zerst\xF6rt, m\xFCsst ihr bis zur n\xE4chsten
      Warnung durchhalten."
    m_Metadata:
      m_Items: []
  - m_Id: 12337130970394624
    m_Localized: "...dieses Rumpeln?\nSag blo\xDF, das ist das Bonbon von vorhin,
      das da angerollt kommt?! Rennt, wenn ihr nicht zerquetscht werden wollt!!"
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531968
    m_Localized: "Ein R\xFClpser blieb in der Speiser\xF6hre stecken... es sammelt
      sich langsam Gas an.\nWird es zu dicht, um noch etwas zu sehen, ruft den Teamruf,
      um es zu vertreiben."
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531969
    m_Localized: "Passt auf den Boden auf. Das sieht nach Reflux aus \u2014 da steigt
      Magens\xE4ure hoch!"
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531970
    m_Localized: Aus unsichtbaren Stellen kommen Stachelangriffe. Bleibt immer wachsam.
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531971
    m_Localized: "Die W\xE4nde an beiden Seiten werden schwarz-wei\xDF.\nPass die
      Farbe an und ramm gegen die Wand, um den Druck zur\xFCckzudr\xE4ngen!"
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531972
    m_Localized: "Sieht nach einer allergischen Reaktion aus \u2014 \xFCberall in
      der Speiser\xF6hre sind Schwellungen entstanden.\nBer\xFChrt ihr eine davon,
      werdet ihr zur\xFCckgeschleudert."
    m_Metadata:
      m_Items: []
  - m_Id: 12337131016531973
    m_Localized: "Ber\xFChrt ihr eine Wand, werdet ihr zur\xFCckgeschleudert.\nVielleicht
      k\xF6nnen wir das nutzen, um zu entkommen, was?"
    m_Metadata:
      m_Items: []
  - m_Id: 12337131037503488
    m_Localized: AAAAAAAAAH...!!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
