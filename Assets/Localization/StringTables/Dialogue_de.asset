--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogue_de
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: de
  m_SharedData: {fileID: 11400000, guid: 043bf15b2a6a41c48971e11c678f419c, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 472199573504
    m_Localized: "Wir wurden gefressen. Von jetzt an denk nur ans \xDCberleben."
    m_Metadata:
      m_Items: []
  - m_Id: 334352332992512
    m_Localized: "Von jetzt an erscheint zuf\xE4llig eine Kachel in deiner Farbe
      auf dem Boden."
    m_Metadata:
      m_Items: []
  - m_Id: 334425666203648
    m_Localized: Du musst rechtzeitig darauf steigen.
    m_Metadata:
      m_Items: []
  - m_Id: 334428463804416
    m_Localized: "Wenn du es nicht schaffst... fangen die Z\xE4hne von der Decke
      an zu fallen."
    m_Metadata:
      m_Items: []
  - m_Id: 335182629023744
    m_Localized: "Bei Wei\xDF darf jeder dr\xFCcken, aber bei Schwarz niemals dr\xFCcken!"
    m_Metadata:
      m_Items: []
  - m_Id: 335185439207424
    m_Localized: Ein falscher Tastendruck kostet Zeit, also pass auf!
    m_Metadata:
      m_Items: []
  - m_Id: 335887280484352
    m_Localized: Stell dich auf die Kachel deiner Farbe und halt durch!
    m_Metadata:
      m_Items: []
  - m_Id: 335890795311104
    m_Localized: "Das hier ist das letzte St\xFCck im Mund."
    m_Metadata:
      m_Items: []
  - m_Id: 335893903290368
    m_Localized: Wenn wir noch etwas durchhalten, kommen wir vielleicht raus...
    m_Metadata:
      m_Items: []
  - m_Id: 337052009345024
    m_Localized: "Es ist still geworden im Mund... hat alles aufgeh\xF6rt?"
    m_Metadata:
      m_Items: []
  - m_Id: 337056501444608
    m_Localized: "Hei\xDFt das, wir k\xF6nnen jetzt entkommen...?"
    m_Metadata:
      m_Items: []
  - m_Id: 337060553142272
    m_Localized: "\u2026\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 337068631371776
    m_Localized: Oh nein, wir werden wieder verschluckt...!!
    m_Metadata:
      m_Items: []
  - m_Id: 337070598500352
    m_Localized: "Sind wir in die Speiser\xF6hre gelangt...?"
    m_Metadata:
      m_Items: []
  - m_Id: 337897539088384
    m_Localized: "Es f\xFChlt sich an, als w\xFCrde etwas von hinten heranrollen..."
    m_Metadata:
      m_Items: []
  - m_Id: 337902496755712
    m_Localized: Lauf!!!
    m_Metadata:
      m_Items: []
  - m_Id: 337904153505792
    m_Localized: Ein falscher Schritt und es ist sofort vorbei. Merk dir nur die
      leuchtenden Felder.
    m_Metadata:
      m_Items: []
  - m_Id: 337904874926080
    m_Localized: Diesmal wird's nach Farben angezeigt. Achte unbedingt auf deine
      eigene Farbe!
    m_Metadata:
      m_Items: []
  - m_Id: 337905520848896
    m_Localized: "Selbst wenn die Farbe stimmt, bringt Schwarz-Wei\xDF dich um."
    m_Metadata:
      m_Items: []
  - m_Id: 337906154188800
    m_Localized: "Jede Zone hat eine zust\xE4ndige Farbe. Der Weg wird erst sicher,
      wenn diese Farbe zuerst durchgeht."
    m_Metadata:
      m_Items: []
  - m_Id: 337906812694528
    m_Localized: "Fang die fliehenden roten Blutk\xF6rperchen!"
    m_Metadata:
      m_Items: []
  - m_Id: 337907517337600
    m_Localized: "Flieh vor den Antik\xF6rpern und \xFCberlebe!"
    m_Metadata:
      m_Items: []
  - m_Id: 339357207212032
    m_Localized: "Wir sind am Ende der Speiser\xF6hre angekommen."
    m_Metadata:
      m_Items: []
  - m_Id: 339360646541312
    m_Localized: "Vielleicht weil es das letzte St\xFCck ist... der Druck f\xFChlt
      sich anders an."
    m_Metadata:
      m_Items: []
  - m_Id: 339362018078720
    m_Localized: Bleib nicht stehen, beweg dich weiter!
    m_Metadata:
      m_Items: []
  - m_Id: 340094578438144
    m_Localized: "Die Enge hat aufgeh\xF6rt. Puh... wir haben es am Ende doch \xFCberlebt."
    m_Metadata:
      m_Items: []
  - m_Id: 340096402960384
    m_Localized: Aber mit dem Boden stimmt etwas nicht...
    m_Metadata:
      m_Items: []
  - m_Id: 340097782886400
    m_Localized: "Er f\xE4ngt an einzust\xFCrzen!"
    m_Metadata:
      m_Items: []
  - m_Id: 335177390338048
    m_Localized: "Dr\xFCck <b><color=#FFC400>Leertaste</color></b>, wenn deine Farbe
      auf dem Boden erscheint."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
