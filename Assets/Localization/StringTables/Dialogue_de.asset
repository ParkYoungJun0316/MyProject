%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogue_de
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: de
  m_SharedData: {fileID: 11400000, guid: 043bf15b2a6a41c48971e11c678f419c, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 472199573504
    m_Localized: "Warum hast du all die leckeren Fr\u00FCchte und Snacks liegen lassen und stattdessen ein KKUL-TTEOK gegessen?!"
    m_Metadata:
      m_Items: []
  - m_Id: 334352332992512
    m_Localized: "Auf dem Boden erscheinen bunte Kacheln.\nSteht 2 Sekunden darauf, dann steigt der Punktestand."
    m_Metadata:
      m_Items: []
  - m_Id: 334425666203648
    m_Localized: "Wei\u00DFe oder schwarze Kacheln darf jeder betreten, aber bei Kacheln mit einer eigenen Farbe z\u00E4hlt nur diese Farbe.\nBlockiert den Weg nicht, bewegt euch schnell!"
    m_Metadata:
      m_Items: []
  - m_Id: 334428463804416
    m_Localized: ""
    m_Metadata:
      m_Items: []
  - m_Id: 335182629023744
    m_Localized: "Unter unseren F\u00FC\u00DFen bewegt sich etwas... Vorsicht!\nEin Zungenangriff kommt!"
    m_Metadata:
      m_Items: []
  - m_Id: 335185439207424
    m_Localized: "In der Mitte schie\u00DFt eine Zunge hoch, die die Sicht auf die andere Seite versperrt und den Weg blockiert.\nRuft alle zusammen den Teamruf, damit sie wieder runtergeht und der zerst\u00F6rte Weg repariert wird."
    m_Metadata:
      m_Items: []
  - m_Id: 335887280484352
    m_Localized: "Sieht aus, als w\u00FCrde es trainieren!\nDer Atem ist pl\u00F6tzlich schwerer geworden.\nDer Wind kommt!\nStellt euch auf die passende Kachel und haltet durch!"
    m_Metadata:
      m_Items: []
  - m_Id: 335890795311104
    m_Localized: "Haah... haah... noch ein bisschen durchhalten, dann schaffen wir es vielleicht lebend raus..."
    m_Metadata:
      m_Items: []
  - m_Id: 335893903290368
    m_Localized: ""
    m_Metadata:
      m_Items: []
  - m_Id: 337052009345024
    m_Localized: "Diese Stille... es ist ruhig geworden hier drin.\nHei\u00DFt das, wir k\u00F6nnen endlich entkommen...?"
    m_Metadata:
      m_Items: []
  - m_Id: 337056501444608
    m_Localized: ".....(KRACH!)"
    m_Metadata:
      m_Items: []
  - m_Id: 337060553142272
    m_Localized: "Oh nein, wir werden verschluckt...!!"
    m_Metadata:
      m_Items: []
  - m_Id: 337068631371776
    m_Localized: ""
    m_Metadata:
      m_Items: []
  - m_Id: 337070598500352
    m_Localized: "Sind wir in die Speiser\xF6hre gelangt...?"
    m_Metadata:
      m_Items: []
  - m_Id: 337897539088384
    m_Localized: "Es f\xFChlt sich an, als w\xFCrde etwas von hinten heranrollen..."
    m_Metadata:
      m_Items: []
  - m_Id: 337902496755712
    m_Localized: Lauf!!!
    m_Metadata:
      m_Items: []
  - m_Id: 337904153505792
    m_Localized: Ein falscher Schritt und es ist sofort vorbei. Merk dir nur die
      leuchtenden Felder.
    m_Metadata:
      m_Items: []
  - m_Id: 337904874926080
    m_Localized: Diesmal wird's nach Farben angezeigt. Achte unbedingt auf deine
      eigene Farbe!
    m_Metadata:
      m_Items: []
  - m_Id: 337905520848896
    m_Localized: "Selbst wenn die Farbe stimmt, bringt Schwarz-Wei\xDF dich um."
    m_Metadata:
      m_Items: []
  - m_Id: 337906154188800
    m_Localized: "Jede Zone hat eine zust\xE4ndige Farbe. Der Weg wird erst sicher,
      wenn diese Farbe zuerst durchgeht."
    m_Metadata:
      m_Items: []
  - m_Id: 337906812694528
    m_Localized: "Fang die fliehenden roten Blutk\xF6rperchen!"
    m_Metadata:
      m_Items: []
  - m_Id: 337907517337600
    m_Localized: "Flieh vor den Antik\xF6rpern und \xFCberlebe!"
    m_Metadata:
      m_Items: []
  - m_Id: 339357207212032
    m_Localized: "Wir sind am Ende der Speiser\xF6hre angekommen."
    m_Metadata:
      m_Items: []
  - m_Id: 339360646541312
    m_Localized: "Vielleicht weil es das letzte St\xFCck ist... der Druck f\xFChlt
      sich anders an."
    m_Metadata:
      m_Items: []
  - m_Id: 339362018078720
    m_Localized: Bleib nicht stehen, beweg dich weiter!
    m_Metadata:
      m_Items: []
  - m_Id: 340094578438144
    m_Localized: "Die Enge hat aufgeh\xF6rt. Puh... wir haben es am Ende doch \xFCberlebt."
    m_Metadata:
      m_Items: []
  - m_Id: 340096402960384
    m_Localized: Aber mit dem Boden stimmt etwas nicht...
    m_Metadata:
      m_Items: []
  - m_Id: 340097782886400
    m_Localized: "Er f\xE4ngt an einzust\xFCrzen!"
    m_Metadata:
      m_Items: []
  - m_Id: 335177390338048
    m_Localized: "Wenn deine Farbe auf dem Boden aufleuchtet, dr\u00FCck <color=#FFD24D><b>Space</b></color>.\nBei Wei\u00DF darf jeder dr\u00FCcken, aber bei Schwarz auf keinen Fall!\nNach 1 Sekunde geht es automatisch zum n\u00E4chsten Zug \u00FCber."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000001
    m_Localized: "Man sagt, selbst in der H\u00F6hle des Tigers \u00FCberlebt man, wenn man einen k\u00FChlen Kopf bewahrt..!\nVon jetzt an denken wir nur ans \u00DCberleben."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000002
    m_Localized: "Merkt euch gut, wo die bunten M\u00E4uler um euch herum sind.\nTretet auf das Pedal, dann f\u00E4hrt das Maul dieser Farbe hoch und zertr\u00FCmmert die Z\u00E4hne."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000003
    m_Localized: "Es f\u00E4hrt immer nur eine Farbe gleichzeitig hoch.\nEs bringt nichts, wenn ihr alle zusammen draufsteht."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000004
    m_Localized: "Wenn sich das hier zu schlie\u00DFen beginnt... ruft alle zusammen den Teamruf!\nSonst seht ihr bald nichts mehr."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000005
    m_Localized: "Geht in die Sicherheitszone, die auf dem Bildschirm angezeigt wird!"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000006
    m_Localized: "Hat es vor dem Verschlucken irgendwas Scharfes gegessen..?\nVom Boden steigt st\u00E4ndig Speichel auf."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000007
    m_Localized: "Der Boden ist voller rutschigem Speichel.\nRuft alle zusammen den Teamruf, um ihn zu beseitigen."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000008
    m_Localized: "Jetzt tropft es sogar von oben!\nEs hat bestimmt Scharfes und dazu noch Saures gegessen.\nEs will das eindeutig mit einem KKUL-TTEOK neutralisieren!"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000009
    m_Localized: "Manche der herabfallenden Tropfen zielen auf mich \u2013 dr\u00FCckt <color=#FFD24D><b>Ctrl</b></color>, um die Bodenfarbe an eure eigene anzupassen und die Zielerfassung zu l\u00F6sen."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000010
    m_Localized: "Von jetzt an wird nur noch eine Kachel im Voraus angezeigt.\nMerkt sie euch gut!"
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000011
    m_Localized: "Auch hier zielt etwas auf mich.\nDr\u00FCckt <color=#FFD24D><b>Ctrl</b></color>, um die Bodenfarbe an eure eigene anzupassen und die Zielerfassung zu l\u00F6sen."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000012
    m_Localized: "Diesmal zerst\u00F6rt die Zunge den ganzen Boden links oder rechts.\nRuft den Teamruf, um sie zu blockieren \u2013 wenn nicht, bricht er einfach zusammen."
    m_Metadata:
      m_Items: []
  - m_Id: 350000000000013
    m_Localized: "Er wird nur repariert, wenn ihr den Teamruf ruft, w\u00E4hrend die Warnung aktiv ist.\nIst der Boden erst zerst\u00F6rt, m\u00FCsst ihr bis zur n\u00E4chsten Warnung durchhalten."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
