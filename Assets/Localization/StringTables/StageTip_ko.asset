--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: StageTip_ko
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ko
  m_SharedData: {fileID: 11400000, guid: b434763c88cad514394ee69eedd290e7, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1141485568
    m_Localized: "\u2022 \uD55C \uBC88\uC5D0 \uD55C \uC0C9\uC758 \uC785\uB9CC \uC62C\uB77C\uC635\uB2C8\uB2E4.\n\u2022
      \uD751\uBC31 \uBC1C\uD310\uC740 \uB204\uAD6C\uB098 \uC0C9\uC744 \uB9DE\uCDB0
      \uBC1F\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\u2022 \uC0C1\uB2E8\uC5D0 \"TEAMCHEER\"
      \uACBD\uACE0\uAC00 \uB728\uBA74 \uD300 \uC751\uC6D0 \uC774\uB984\uC744 \uC678\uCE58\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1183428608
    m_Localized: "\u2022 \uC9C0\uC815\uB41C \uC0C9\uC740 \uADF8 \uAD6C\uC5ED\uC5D0
      \uBC18\uB4DC\uC2DC \uB4E4\uC5B4\uAC00\uC57C \uD569\uB2C8\uB2E4.\n\u2022 \uC0C1\uB2E8\uC5D0
      \"TEAMCHEER\" \uACBD\uACE0\uAC00 \uB728\uBA74 \uD300 \uC751\uC6D0 \uC774\uB984\uC744
      \uC678\uCE58\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622912
    m_Localized: "\u2022 Ctrl\uB85C \uD751/\uBC31 \uBC14\uB2E5 \uC0C9\uACFC \uCE90\uB9AD\uD130
      \uC0C9\uC744 \uB9DE\uCDB0 \uC870\uC900\uC744 \uD53C\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622913
    m_Localized: "\u2022 \uD0C0\uC77C\uC744 2\uCD08 \uB3D9\uC548 \uBC1F\uC544\uC57C
      \uC810\uC218\uAC00 \uC62C\uB77C\uAC11\uB2C8\uB2E4.\n\u2022 \uACE0\uC720\uC0C9
      \uD0C0\uC77C\uC740 \uADF8 \uC0C9\uB9CC, \uD751\uBC31 \uD0C0\uC77C\uC740 \uB204\uAD6C\uB4E0
      \uBC1F\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622914
    m_Localized: "\u2022 \uC790\uAE30 \uC0C9\uC774 \uB728\uBA74 Space\uB97C \uB204\uB974\uC138\uC694.\n\u2022
      \uD770\uC0C9\uC740 \uC544\uBB34\uB098 \uB20C\uB7EC\uB3C4 \uB418\uACE0, \uAC80\uC740\uC0C9\uC740
      1\uCD08 \uB4A4 \uC790\uB3D9\uC73C\uB85C \uB118\uC5B4\uAC11\uB2C8\uB2E4.\n\u2022
      \uBBF8\uB2C8\uAC8C\uC784 \uC911\uC5D0\uB294 Space \uBC84\uD504\uB97C \uC4F8
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622915
    m_Localized: "\u2022 \uD55C \uCE78 \uC55E\uC758 \uBC14\uB2E5\uB9CC \uBCF4\uC5EC
      \uC90D\uB2C8\uB2E4.\n\u2022 \uB204\uB97C \uCE78\uC744 \uBBF8\uB9AC \uC678\uC6CC
      \uB450\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622916
    m_Localized: "\u2022 Ctrl\uB85C \uBC14\uB2E5 \uC0C9\uACFC \uCE90\uB9AD\uD130
      \uC0C9\uC744 \uB9DE\uCDB0 \uC870\uC900\uC744 \uD53C\uD558\uC138\uC694.\n\u2022
      \"TEAMCHEER\" \uACBD\uACE0\uAC00 \uB730 \uB54C \uD300 \uC751\uC6D0 \uC774\uB984\uC744
      \uC678\uCE58\uBA74 \uBC14\uB2E5\uC774 \uBCF5\uAD6C\uB429\uB2C8\uB2E4.\n\u2022
      \uC774\uBBF8 \uBD80\uC11C\uC9C4 \uB4A4\uC5D0\uB294 \uB2E4\uC74C \uACBD\uACE0\uAE4C\uC9C0
      \uBC84\uD2F0\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622917
    m_Localized: "\u2022 \uACE0\uC720\uC0C9 \uCE78\uC774 \uB098\uC624\uBA74 \uADF8
      \uCE78 \uC704\uC5D0 \uC11C\uC57C \uD569\uB2C8\uB2E4.\n\u2022 \uACE0\uC720\uC0C9\uC774
      \uC5C6\uC73C\uBA74 \uD751\uBC31 \uCE78 \uC704\uC5D0\uC11C \uBC84\uD2F0\uC138\uC694.\n\u2022
      \uBC14\uB2E5 \uC0C9\uC5D0 \uB9DE\uCDB0 \uCE90\uB9AD\uD130 \uC0C9\uB3C4 \uBC14\uAFB8\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622918
    m_Localized: "\u2022 \uB0B4 \uC0C9\uC774 \uB72C \uC591\uC606 \uBCBD\uC5D0 \uBD80\uB52A\uD788\uBA74
      \uBCBD\uC774 \uB4A4\uB85C \uBB3C\uB7EC\uB0A9\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622919
    m_Localized: "\u2022 \uAE38\uC744 \uC678\uC6CC \uB450\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622920
    m_Localized: "\u2022 \uC790\uAE30 \uC0C9 \uCE78\uB9CC \uBC1F\uC73C\uC138\uC694.\n\u2022
      \uCE78 \uC0C9\uC774 \uB9DE\uC544\uB3C4 \uCE90\uB9AD\uD130\uAC00 \uD751\uBC31\uC774\uBA74
      \uC548 \uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622921
    m_Localized: "\u2022 \uB2F4\uB2F9 \uC0C9\uC774 \uBA3C\uC800 \uC9C0\uB098\uAC00\uC57C
      \uB2E4\uB978 \uD300\uC6D0\uB3C4 \uADF8 \uBC14\uB2E5\uC744 \uBC1F\uC744 \uC218
      \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622922
    m_Localized: "\u2022 \uC591\uC606 \uBCBD\uC5D0 \uC0C9\uC744 \uB9DE\uCDB0 \uBD80\uB52A\uD788\uBA74
      \uBCBD\uC774 \uB4A4\uB85C \uBB3C\uB7EC\uB0A9\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622923
    m_Localized: "\u2022 \uC55E\uB4A4 \uBCBD\uACFC \uBD80\uC885\uC5D0 \uB2FF\uC73C\uBA74
      \uD295\uACA8 \uB098\uAC11\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622924
    m_Localized: "\u2022 \uBC84\uD504\uB97C \uC368\uC11C \uC801\uD608\uAD6C\uB97C
      \uC7A1\uC73C\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622925
    m_Localized: "\u2022 \uCD08\uB85D \uBD80\uC885\uC5D0 \uBD80\uB52A\uD600 \uD295\uAE30\uBA70
      \uB3C4\uB9DD\uCE58\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622926
    m_Localized: "\u2022 \uC9C0\uC815\uB41C \uC0C9\uC774 \uAE38\uC744 \uC5F0 \uB4A4
      \uBAA9\uD45C\uAE4C\uC9C0 \uB3C4\uB2EC\uD558\uC138\uC694.\n\n\u2022 \uC0AC\uD0D5\uC774
      \uB545\uC5D0 \uB2FF\uAE30 \uC804\uC5D0 \uC774 \uAD6C\uAC04\uC744 \uB05D\uB0B4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622927
    m_Localized: "\u2022 \uBC1C\uD310\uC744 \uB20C\uB7EC \uAE38\uC744 \uB9CC\uB4E4\uACE0
      \uBAA9\uD45C\uAE4C\uC9C0 \uB3C4\uB2EC\uD558\uC138\uC694.\n\n\u2022 \uC0AC\uD0D5\uC774
      \uB545\uC5D0 \uB2FF\uAE30 \uC804\uC5D0 \uC774 \uAD6C\uAC04\uC744 \uB05D\uB0B4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622928
    m_Localized: "\u2022 \uAC00\uC6B4\uB370 \uBC1C\uD310\uC744 \uBC1F\uC544 \uD295\uACA8
      \uC62C\uB77C\uAC00 \uC0AC\uD0D5\uACFC \uC0C9\uC744 \uB9DE\uCDB0 \uBD80\uB52A\uD788\uC138\uC694.\n\n\u2022
      \uC0AC\uD0D5\uC774 \uB545\uC5D0 \uB2FF\uAE30 \uC804\uC5D0 \uC774 \uAD6C\uAC04\uC744
      \uB05D\uB0B4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622929
    m_Localized: "\u2022 \uC0C9\uC744 \uB9DE\uCDB0 \uBCBD\uC5D0 \uBD80\uB52A\uD600
      \uBC00\uC5B4\uB0B4\uC138\uC694."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
