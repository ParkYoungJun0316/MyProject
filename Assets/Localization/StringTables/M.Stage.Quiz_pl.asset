  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: M.Stage.Quiz_pl
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: pl
  m_SharedData: {fileID: 11400000, guid: 05362dd87941b804c948c6c4f45df573, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 994491084800
    m_Localized: "Doro\u015Bli wytwarzaj\u0105 ponad 1 litr \u015Bliny ka\u017Cdego
      dnia."
    m_Metadata:
      m_Items: []
  - m_Id: 994524639232
    m_Localized: "Doro\u015Bli wytwarzaj\u0105 dziennie oko\u0142o 1\u20131,5 litra
      \u015Bliny."
    m_Metadata:
      m_Items: []
  - m_Id: 994524639233
    m_Localized: "R\xF3\u017Cne cz\u0119\u015Bci j\u0119zyka mog\u0105 wyczuwa\u0107
      tylko okre\u015Blone smaki."
    m_Metadata:
      m_Items: []
  - m_Id: 994524639234
    m_Localized: "Ka\u017Cda cz\u0119\u015B\u0107 j\u0119zyka mo\u017Ce wykrywa\u0107
      wszystkie podstawowe smaki."
    m_Metadata:
      m_Items: []
  - m_Id: 994524639235
    m_Localized: "Wzory na j\u0119zyku s\u0105 inne u ka\u017Cdej osoby."
    m_Metadata:
      m_Items: []
  - m_Id: 994524639236
    m_Localized: "Wzory na powierzchni j\u0119zyka s\u0105 tak unikalne, \u017Ce
      s\u0105 badane w technologii biometrycznej."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833536
    m_Localized: "Wargi, w przeciwie\u0144stwie do zwyk\u0142ej sk\xF3ry, nie maj\u0105
      gruczo\u0142\xF3w potowych."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833537
    m_Localized: "Wargi \u0142atwo wysychaj\u0105, bo nie maj\u0105 gruczo\u0142\xF3w
      potowych ani \u0142ojowych."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833538
    m_Localized: "Z wiekiem ludzie cz\u0119sto zaczynaj\u0105 lepiej tolerowa\u0107
      gorzkie jedzenie."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833539
    m_Localized: "Dzieje si\u0119 to z powodu zmian w odczuwaniu smaku i powtarzanych
      do\u015Bwiadcze\u0144 z jedzeniem."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833540
    m_Localized: "Najd\u0142u\u017Cszy ludzki z\u0105b odnotowany w Ksi\u0119dze
      Rekord\xF3w Guinnessa mia\u0142 ponad 4 cm."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833541
    m_Localized: "Najd\u0142u\u017Cszy odnotowany ludzki kie\u0142 mia\u0142 oko\u0142o
      3,67 cm."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833542
    m_Localized: "W ustach \u017Cyj\u0105 miliardy bakterii."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833543
    m_Localized: "Nawet po myciu z\u0119b\xF3w wiele bakterii wci\u0105\u017C pozostaje
      w ustach."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833544
    m_Localized: "Podczas snu ludzie wytwarzaj\u0105 znacznie wi\u0119cej \u015Bliny."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833545
    m_Localized: "Podczas snu wytwarzanie \u015Bliny prawie zanika, co mo\u017Ce
      powodowa\u0107 nie\u015Bwie\u017Cy oddech rano."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833546
    m_Localized: "J\u0119zyk te\u017C mo\u017Ce si\u0119 zm\u0119czy\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833547
    m_Localized: "J\u0119zyk jest zbudowany z mi\u0119\u015Bni, wi\u0119c mo\u017Ce
      si\u0119 zm\u0119czy\u0107 po intensywnym u\u017Cyciu."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833548
    m_Localized: "Z\u0119by maj\u0105 inn\u0105 budow\u0119 ni\u017C ko\u015Bci."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833549
    m_Localized: "W przeciwie\u0144stwie do ko\u015Bci, z\u0119by nie mog\u0105 si\u0119
      w pe\u0142ni samodzielnie naprawi\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833550
    m_Localized: "Ludzkie wargi wydaj\u0105 si\u0119 czerwone, bo zawieraj\u0105
      du\u017Co czerwonego pigmentu."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833551
    m_Localized: "Wargi s\u0105 cienkie, dlatego wida\u0107 przez nie kolor naczy\u0144
      krwiono\u015Bnych pod sk\xF3r\u0105."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833552
    m_Localized: "J\u0119zyk jest jedn\u0105 z najszybciej goj\u0105cych si\u0119
      cz\u0119\u015Bci cia\u0142a."
    m_Metadata:
      m_Items: []
  - m_Id: 994528833553
    m_Localized: "J\u0119zyk goi si\u0119 szybko, bo ma silny przep\u0142yw krwi
      i szybk\u0105 odnow\u0119 kom\xF3rek."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
