--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: StageTip_pl
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: pl
  m_SharedData: {fileID: 11400000, guid: b434763c88cad514394ee69eedd290e7, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1141485568
    m_Localized: "\u2022 Naraz unosz\u0105 si\u0119 usta tylko jednego koloru.\n\u2022
      Z czarnych i bia\u0142ych p\u0142ytek mo\u017Ce korzysta\u0107 ka\u017Cdy,
      kto dopasuje kolor.\n\u2022 Gdy u g\xF3ry pojawi si\u0119 \u201ETEAMCHEER\u201D,
      wykrzycz has\u0142o dru\u017Cyny."
    m_Metadata:
      m_Items: []
  - m_Id: 1183428608
    m_Localized: "\u2022 W ka\u017Cdej strefie musi by\u0107 tylu graczy, ile KKUL-TTEOK
      jest pod jej tabliczk\u0105 \u2014 ani wi\u0119cej, ani mniej.\n\u2022 Ka\u017Cdy
      widzi co\u015B innego. M\xF3wcie, co widzicie!\n\u2022 Gdy u g\xF3ry pojawi
      si\u0119 \u201ETEAMCHEER\u201D, wykrzycz has\u0142o dru\u017Cyny.\n\u2022 Wzmocnienie
      obrony blokuje te\u017C obra\u017Cenia za przegran\u0105 rund\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622912
    m_Localized: "\u2022 Wci\u015Bnij Ctrl, \u017Ceby dopasowa\u0107 sw\xF3j kolor
      do czarnej lub bia\u0142ej pod\u0142ogi i nie by\u0107 na celowniku."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622913
    m_Localized: "\u2022 Post\xF3j 2 sekundy na kafelku, \u017Ceby zdoby\u0107 punkt.\n\u2022
      Kolorowe kafelki licz\u0105 si\u0119 tylko dla swojego koloru, czarne i bia\u0142e
      \u2014 dla ka\u017Cdego."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622914
    m_Localized: "\u2022 Wci\u015Bnij Space, gdy zapali si\u0119 tw\xF3j kolor.\n\u2022
      Bia\u0142y mo\u017Ce nacisn\u0105\u0107 ka\u017Cdy. Czarny po 1 sekundzie sam
      przechodzi dalej.\n\u2022 W minigrze nie u\u017Cyjesz buffa na Space."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622915
    m_Localized: "\u2022 Widzisz tylko jeden kafelek do przodu.\n\u2022 Zapami\u0119taj,
      kt\xF3ry trzeba wcisn\u0105\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622916
    m_Localized: "\u2022 Wci\u015Bnij Ctrl, \u017Ceby dopasowa\u0107 sw\xF3j kolor
      do pod\u0142ogi i nie by\u0107 na celowniku.\n\u2022 Wykrzycz has\u0142o dru\u017Cyny,
      p\xF3ki wida\u0107 \u201ETEAMCHEER\u201D, \u017Ceby naprawi\u0107 pod\u0142og\u0119.\n\u2022
      Je\u015Bli ju\u017C p\u0119k\u0142a, wytrzymaj do nast\u0119pnego ostrze\u017Cenia."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622917
    m_Localized: "\u2022 Je\u015Bli pojawi si\u0119 pole w twoim kolorze, sta\u0144
      na nim.\n\u2022 Je\u015Bli nie \u2014 wytrzymaj na czarnym albo bia\u0142ym
      polu.\n\u2022 Dopasuj te\u017C kolor postaci do pod\u0142ogi.\n\u2022 Wzmocnienie
      obrony blokuje te\u017C obra\u017Cenia za przegran\u0105 rund\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622918
    m_Localized: "\u2022 Taranuj \u015Bciany w swoim kolorze."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622919
    m_Localized: "\u2022 Zapami\u0119taj drog\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622920
    m_Localized: "\u2022 Stawaj tylko na polach w swoim kolorze.\n\u2022 Dopasuj
      kolor postaci do p\xF3l."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622921
    m_Localized: "\u2022 Najpierw idzie kolor strefy, potem reszta mo\u017Ce za nim."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622922
    m_Localized: "\u2022 Przejd\u017A odcinek, zanim sko\u0144czy si\u0119 czas na
      tabliczce, bo zaleje go kwas.\n\u2022 Dopasuj kolor do bocznych \u015Bcian
      i taranuj je, \u017Ceby je odepchn\u0105\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622923
    m_Localized: "\u2022 Jeden gracz na pole. Wi\u0119cej \u2014 i pole si\u0119
      zapada.\n\u2022 Niekt\xF3re pola p\u0119kaj\u0105.\n\u2022 Dotkni\u0119cie
      przedniej i tylnej \u015Bciany albo opuchlizny ci\u0119 odrzuci."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622924
    m_Localized: "\u2022 Jeden biegacz przemierza labirynt, a reszta prowadzi go
      z pi\u0119tra.\n\u2022 Nadepni\u0119cie p\u0142ytki otwiera tylko drzwi w jej
      kolorze i zamyka wszystkie inne."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622926
    m_Localized: "\u2022 Dotrzyj do celu.\n\n\u2022 Uko\u0144cz ten etap, zanim cukierek
      uderzy w ziemi\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622927
    m_Localized: "\u2022 Stawaj na p\u0142ytkach, \u017Ceby utworzy\u0107 drog\u0119,
      a potem dotrzyj do celu.\n\n\u2022 Uko\u0144cz ten etap, zanim cukierek uderzy
      w ziemi\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622928
    m_Localized: "\u2022 Jeden gracz na bezpieczne pole. T\u0142ok oznacza obra\u017Cenia.\n\n\u2022
      Uko\u0144cz ten etap, zanim cukierek uderzy w ziemi\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622929
    m_Localized: "\u2022 Dopasuj kolor do \u015Bciany i taranuj j\u0105."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891662639104
    m_Localized: "\u2022 Naraz unosz\u0105 si\u0119 usta tylko jednego koloru.\n\u2022
      Z czarnych i bia\u0142ych p\u0142ytek mo\u017Ce korzysta\u0107 ka\u017Cdy,
      kto dopasuje kolor."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891696193536
    m_Localized: "\u2022 Ka\u017Cdy widzi co\u015B innego. M\xF3wcie, co widzicie!\n\u2022
      Wzmocnienie obrony blokuje te\u017C obra\u017Cenia za przegran\u0105 rund\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891696193537
    m_Localized: "\u2022 Wci\u015Bnij Ctrl, \u017Ceby dopasowa\u0107 sw\xF3j kolor
      do pod\u0142ogi i nie by\u0107 na celowniku."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891696193538
    m_Localized: "\u2022 Gdy usta si\u0119 otworz\u0105, wykrzycz has\u0142o dru\u017Cyny,
      \u017Ceby naprawi\u0107 p\u0119kni\u0119t\u0105 pod\u0142og\u0119."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
