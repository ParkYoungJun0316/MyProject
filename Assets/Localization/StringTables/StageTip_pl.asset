--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: StageTip_pl
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: pl
  m_SharedData: {fileID: 11400000, guid: b434763c88cad514394ee69eedd290e7, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1141485568
    m_Localized: "\u2022 Za razem unosi si\u0119 usta tylko jednego koloru.\n\u2022
      Na czarno-bia\u0142e platformy mo\u017Ce wej\u015B\u0107 ka\u017Cdy, byle dopasowa\u0142
      kolor.\n\u2022 Gdy u g\xF3ry pojawi si\u0119 \u201ETEAMCHEER\u201D, wykrzycz
      has\u0142o dru\u017Cyny."
    m_Metadata:
      m_Items: []
  - m_Id: 1183428608
    m_Localized: "\u2022 Wyznaczony kolor musi by\u0107 w tej strefie.\n\u2022 Gdy
      u g\xF3ry pojawi si\u0119 \u201ETEAMCHEER\u201D, wykrzycz has\u0142o dru\u017Cyny.\n\u2022
      Wzmocnienie obrony blokuje te\u017C obra\u017Cenia za przegran\u0105 rund\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622912
    m_Localized: "\u2022 Wci\u015Bnij Ctrl, dopasuj kolor postaci do czarno-bia\u0142ej
      pod\u0142ogi i zrzu\u0107 namierzenie."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622913
    m_Localized: "\u2022 Sta\u0144 na kafelku 2 sekundy, \u017Ceby dosta\u0107 punkty.\n\u2022
      Kafelki unikalnego koloru licz\u0105 tylko dla tego koloru. Czarne i bia\u0142e
      mo\u017Ce st\u0105pa\u0107 ka\u017Cdy."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622914
    m_Localized: "\u2022 Wci\u015Bnij Space, gdy zapali si\u0119 tw\xF3j kolor.\n\u2022
      Bia\u0142y mo\u017Ce nacisn\u0105\u0107 ka\u017Cdy. Czarny po 1 sekundzie sam
      przechodzi dalej.\n\u2022 W minigrze nie u\u017Cyjesz buffa na Space."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622915
    m_Localized: "\u2022 Wida\u0107 tylko jeden kafelek do przodu.\n\u2022 Zapami\u0119taj,
      kt\xF3re wciska\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622916
    m_Localized: "\u2022 Wci\u015Bnij Ctrl, dopasuj kolor postaci do pod\u0142ogi
      i zrzu\u0107 namierzenie.\n\u2022 Wykrzycz has\u0142o dru\u017Cyny, gdy wisi
      \u201ETEAMCHEER\u201D \u2014 pod\u0142oga si\u0119 naprawi.\n\u2022 Je\u015Bli
      ju\u017C p\u0119k\u0142a, wytrzymaj do nast\u0119pnego ostrze\u017Cenia."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622917
    m_Localized: "\u2022 Je\u015Bli pojawi si\u0119 kafelek unikalnego koloru, sta\u0144
      na nim.\n\u2022 Je\u015Bli nie \u2014 wytrzymaj na czarnym albo bia\u0142ym.\n\u2022
      Dopasuj te\u017C kolor postaci do pod\u0142ogi.\n\u2022 Wzmocnienie obrony
      blokuje te\u017C obra\u017Cenia za przegran\u0105 rund\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622918
    m_Localized: "\u2022 Jak walniesz w boczne \u015Bciany w swoim kolorze, cofn\u0105
      si\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622919
    m_Localized: "\u2022 Zapami\u0119taj drog\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622920
    m_Localized: "\u2022 St\u0105paj tylko po kafelkach swojego koloru.\n\u2022 Nawet
      gdy kolor kafelka si\u0119 zgadza \u2014 na czarno-bia\u0142ym nie wolno."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622921
    m_Localized: "\u2022 Najpierw musi przej\u015B\u0107 przypisany kolor, inaczej
      reszta nie mo\u017Ce st\u0105pa\u0107 po tej pod\u0142odze."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622922
    m_Localized: "\u2022 Dopasuj kolor bocznych \u015Bcian i walnij \u2014 cofn\u0105
      si\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622923
    m_Localized: "\u2022 Kontakt z przednimi i tylnymi \u015Bcianami albo obrz\u0119kami
      ci\u0119 odbija."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622924
    m_Localized: "\u2022 Nadepni\u0119cie na p\u0142ytk\u0119 w dowolnym miejscu
      otwiera i zamyka drzwi.\n\u2022 Gdy otwieraj\u0105 si\u0119 czarne drzwi, bia\u0142e
      si\u0119 zamykaj\u0105, i na odwr\xF3t.\n\u2022 Najpierw znajd\u017Acie drog\u0119
      na drugie pi\u0119tro."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622926
    m_Localized: "\u2022 Wyznaczony kolor otwiera drog\u0119, potem dotrzyj do celu.\n\n\u2022
      Doko\u0144cz ten odcinek, zanim cukierek uderzy o ziemi\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622927
    m_Localized: "\u2022 Wdep\u0144 w p\u0142yty, zr\xF3b drog\u0119 i dotrzyj do
      celu.\n\n\u2022 Doko\u0144cz ten odcinek, zanim cukierek uderzy o ziemi\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622928
    m_Localized: "\u2022 Wdep\u0144 w \u015Brodkow\u0105 p\u0142yt\u0119, odbij si\u0119
      w g\xF3r\u0119 i walnij w cukierek w pasuj\u0105cym kolorze.\n\n\u2022 Doko\u0144cz
      ten odcinek, zanim cukierek uderzy o ziemi\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622929
    m_Localized: "\u2022 Dopasuj kolor \u015Bciany i walnij, \u017Ceby j\u0105 odepchn\u0105\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891662639104
    m_Localized: "\u2022 Za razem unosi si\u0119 usta tylko jednego koloru.\n\u2022
      Na czarno-bia\u0142e platformy mo\u017Ce wej\u015B\u0107 ka\u017Cdy, byle dopasowa\u0142
      kolor."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891696193536
    m_Localized: "\u2022 Wzmocnienie obrony blokuje te\u017C obra\u017Cenia za przegran\u0105
      rund\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891696193537
    m_Localized: "\u2022 Wci\u015Bnij Ctrl, dopasuj kolor postaci do pod\u0142ogi
      i zrzu\u0107 namierzenie."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891696193538
    m_Localized: "\u2022 Gdy usta si\u0119 otworz\u0105, wykrzycz has\u0142o dru\u017Cyny,
      \u017Ceby naprawi\u0107 p\u0119kni\u0119t\u0105 pod\u0142og\u0119."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
