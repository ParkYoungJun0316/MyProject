%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: StageTip_pl
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: pl
  m_SharedData: {fileID: 11400000, guid: b434763c88cad514394ee69eedd290e7, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1141485568
    m_Localized: "\u2022 Naraz unosz\u0105 si\u0119 usta tylko jednego koloru.\n\u2022
      Ka\u017Cdy mo\u017Ce korzysta\u0107 z czarnych i bia\u0142ych platform, dopasowuj\u0105c
      do nich sw\xF3j kolor.\n\u2022 Gdy u g\xF3ry pojawi si\u0119 \u201ETEAMCHEER\u201D,
      wykrzyczcie okrzyk dru\u017Cyny."
    m_Metadata:
      m_Items: []
  - m_Id: 1183428608
    m_Localized: "\u2022 W ka\u017Cdej strefie musi by\u0107 dok\u0142adnie tylu
      graczy, ile KKUL-TTEOK znajduje si\u0119 pod jej znakiem. Ani wi\u0119cej,
      ani mniej.\n\u2022 Ka\u017Cdy widzi co\u015B innego. Podzielcie si\u0119 tym,
      co widzicie!\n\u2022 Gdy u g\xF3ry pojawi si\u0119 \u201ETEAMCHEER\u201D, wykrzyczcie
      okrzyk dru\u017Cyny.\n\u2022 Wzmocnienie obrony chroni r\xF3wnie\u017C przed
      obra\u017Ceniami za nieudane uko\u0144czenie rundy."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622912
    m_Localized: "\u2022 Naci\u015Bnij Ctrl, aby dopasowa\u0107 sw\xF3j kolor do
      czarnej lub bia\u0142ej pod\u0142ogi i unikn\u0105\u0107 namierzenia."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622913
    m_Localized: "\u2022 Sta\u0144 na kafelku przez 2 sekundy, aby zdoby\u0107 punkty.\n\u2022
      Kolorowe kafelki licz\u0105 si\u0119 tylko dla graczy w danym kolorze. Czarne
      i bia\u0142e kafelki licz\u0105 si\u0119 dla ka\u017Cdego."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622914
    m_Localized: "\u2022 Naci\u015Bnij Space, gdy za\u015Bwieci si\u0119 tw\xF3j
      kolor.\n\u2022 Bia\u0142y mo\u017Ce nacisn\u0105\u0107 ka\u017Cdy. Czarny po
      1 sekundzie sam przechodzi dalej.\n\u2022 Podczas tej minigry nie mo\u017Cesz
      u\u017Cywa\u0107 wzmocnienia Space."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622915
    m_Localized: "\u2022 Widzisz tylko jeden kafelek przed sob\u0105.\n\u2022 Zapami\u0119taj,
      kt\xF3ry kafelek nacisn\u0105\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622916
    m_Localized: "\u2022 Naci\u015Bnij Ctrl, aby dopasowa\u0107 sw\xF3j kolor do
      pod\u0142ogi i unikn\u0105\u0107 namierzenia.\n\u2022 Gdy pojawi si\u0119 \u201ETEAMCHEER\u201D,
      wykrzycz okrzyk dru\u017Cyny, aby naprawi\u0107 pod\u0142og\u0119.\n\u2022
      Je\u015Bli pod\u0142oga jest ju\u017C zniszczona, wytrzymaj do nast\u0119pnego
      ostrze\u017Cenia."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622917
    m_Localized: "\u2022 Je\u015Bli pojawi si\u0119 kafelek w twoim kolorze, sta\u0144
      na nim.\n\u2022 Je\u015Bli go nie ma, wytrzymaj na czarnym lub bia\u0142ym
      kafelku.\n\u2022 Dopasuj r\xF3wnie\u017C kolor swojej postaci do koloru pod\u0142ogi.\n\u2022
      Wzmocnienie obrony chroni r\xF3wnie\u017C przed obra\u017Ceniami za nieudane
      uko\u0144czenie rundy."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622918
    m_Localized: "\u2022 Szar\u017Cuj w \u015Bciany pasuj\u0105ce do twojego koloru."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622919
    m_Localized: "\u2022 Zapami\u0119taj drog\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622920
    m_Localized: "\u2022 St\u0105paj tylko po kafelkach w swoim kolorze.\n\u2022
      Dopasuj kolor swojej postaci do koloru kafelk\xF3w."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622921
    m_Localized: "\u2022 Gracz w kolorze strefy przechodzi pierwszy, a reszta mo\u017Ce
      ruszy\u0107 za nim."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622922
    m_Localized: "\u2022 Uko\u0144cz ka\u017Cd\u0105 sekcj\u0119, zanim sko\u0144czy
      si\u0119 czas na znaku, inaczej zaleje j\u0105 kwas.\n\u2022 Dopasuj kolor
      bocznych \u015Bcian i szar\u017Cuj w nie, aby je odepchn\u0105\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622923
    m_Localized: "\u2022 Na ka\u017Cdym kafelku mo\u017Ce sta\u0107 tylko jeden gracz.
      Je\u015Bli b\u0119dzie ich wi\u0119cej, kafelek si\u0119 zapadnie.\n\u2022
      Niekt\xF3re kafelki mo\u017Cna zniszczy\u0107.\n\u2022 Dotkni\u0119cie przedniej
      lub tylnej \u015Bciany albo wybrzusze\u0144 odrzuci ci\u0119 do ty\u0142u."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622924
    m_Localized: "\u2022 Jeden gracz biegnie przez labirynt, a pozostali kieruj\u0105
      nim z drugiego pi\u0119tra.\n\u2022 Nadepni\u0119cie na platform\u0119 otwiera
      tylko drzwi w tym samym kolorze i zamyka wszystkie pozosta\u0142e."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622926
    m_Localized: "\u2022 Dotrzyj do celu.\n\n\u2022 Uko\u0144cz t\u0119 sekcj\u0119,
      zanim cukierek spadnie na ziemi\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622927
    m_Localized: "\u2022 Stawaj na platformach, aby utworzy\u0107 drog\u0119, a nast\u0119pnie
      dotrzyj do celu.\n\n\u2022 Uko\u0144cz t\u0119 sekcj\u0119, zanim cukierek
      spadnie na ziemi\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622928
    m_Localized: "\u2022 Na ka\u017Cdym bezpiecznym kafelku mo\u017Ce sta\u0107 tylko
      jeden gracz. Je\u015Bli stan\u0105 na nim dwie osoby, otrzymaj\u0105 obra\u017Cenia.\n\n\u2022
      Uko\u0144cz t\u0119 sekcj\u0119, zanim cukierek spadnie na ziemi\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 1187622929
    m_Localized: "\u2022 Dopasuj sw\xF3j kolor do koloru \u015Bciany i szar\u017Cuj
      w ni\u0105."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891662639104
    m_Localized: "\u2022 Naraz unosz\u0105 si\u0119 usta tylko jednego koloru.\n\u2022
      Ka\u017Cdy mo\u017Ce korzysta\u0107 z czarnych i bia\u0142ych platform, dopasowuj\u0105c
      do nich sw\xF3j kolor."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891696193536
    m_Localized: "\u2022 Ka\u017Cdy widzi co\u015B innego. Podzielcie si\u0119 tym,
      co widzicie!\n\u2022 Wzmocnienie obrony chroni r\xF3wnie\u017C przed obra\u017Ceniami
      za nieudane uko\u0144czenie rundy."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891696193537
    m_Localized: "\u2022 Naci\u015Bnij Ctrl, aby dopasowa\u0107 sw\xF3j kolor do
      pod\u0142ogi i unikn\u0105\u0107 namierzenia."
    m_Metadata:
      m_Items: []
  - m_Id: 1033891696193538
    m_Localized: "\u2022 Gdy usta si\u0119 otworz\u0105, wykrzycz okrzyk dru\u017Cyny,
      aby naprawi\u0107 zniszczon\u0105 pod\u0142og\u0119."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
