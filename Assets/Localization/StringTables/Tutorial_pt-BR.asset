  m_TableData:
  - m_Id: 1040822272
    m_Localized: Mover
    m_Metadata:
      m_Items: []
  - m_Id: 1086959616
    m_Localized: Empurrar (sem dano)
    m_Metadata:
      m_Items: []
  - m_Id: 1086959617
    m_Localized: Mudar cor P/B
    m_Metadata:
      m_Items: []
  - m_Id: 1086959618
    m_Localized: "Mudar cor pr\xF3pria"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153920
    m_Localized: "Trocar buff (Defesa \u2194 Velocidade)"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153923
    m_Localized: Torcida em equipe
    m_Metadata:
      m_Items: []
  - m_Id: 1091153924
    m_Localized: "Quando o \xEDcone de aviso aparecer, gritem juntos a palavra da
      equipe para desfazer a amea\xE7a.\nAperte [E] aqui para praticar agora mesmo."
    m_Metadata:
      m_Items: []
  - m_Id: 1091153925
    m_Localized: Palavra da equipe
    m_Metadata:
      m_Items: []
  - m_Id: 1091153926
    m_Localized: "S\xF3 o host pode definir a TeamCheerWord.\nQuanto mais natural
      for a palavra na hora de falar, melhor o reconhecimento. (2 a 12 letras, apenas
      min\xFAsculas em ingl\xEAs)\nSem microfone ou o reconhecimento n\xE3o est\xE1
      funcionando? Ative a torcida pela tecla T em Op\xE7\xF5es \u2192 Geral e aperte
      T quando o aviso aparecer."
    m_Metadata:
      m_Items: []
  - m_Id: 24992255946752
    m_Localized: Escolha a palavra da equipe
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889793
    m_Localized: 'ex.: fighting'
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889794
    m_Localized: Confirmar
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889795
    m_Localized: Fechar
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889796
    m_Localized: "Defina a palavra que todo o time vai gritar junto (padr\xE3o: FIGHTING)"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889797
    m_Localized: 'Palavra da equipe: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647744
    m_Localized: "Use apenas entre 2 e 12 letras min\xFAsculas em ingl\xEAs."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647746
    m_Localized: "Essa palavra \xE9 uma palavra reservada do sistema, ent\xE3o voc\xEA
      n\xE3o pode usar."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647747
    m_Localized: "Cont\xE9m uma palavra que n\xE3o pode ser usada."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647751
    m_Localized: "N\xE3o foi poss\xEDvel confirmar a palavra da equipe."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647752
    m_Localized: "S\xF3 o host pode definir a palavra da equipe."
    m_Metadata:
      m_Items: []
  - m_Id: 53793039953920
    m_Localized: Mudar a palavra da equipe
    m_Metadata:
      m_Items: []
  - m_Id: 53793073508352
    m_Localized: "Aqui voc\xEAs podem mudar a palavra da equipe pela \xFAltima vez.\nSe
      perderem essa chance, ela fica travada at\xE9 o fim do jogo,\nent\xE3o quem
      quiser mudar, fa\xE7a isso agora no painel."
    m_Metadata:
      m_Items: []
  - m_Id: 56930631004160
    m_Localized: '[E] Definir palavra da equipe'
    m_Metadata:
      m_Items: []
  - m_Id: 56930635198464
    m_Localized: '[E] Teste de torcida em equipe'
    m_Metadata:
      m_Items: []
  - m_Id: 1395064601948160
    m_Localized: "A defesa tamb\xE9m bloqueia o dano da rodada."
    m_Metadata:
      m_Items: []
  - m_Id: 1395064700000001
    m_Localized: "Reanimar (Segure perto de um companheiro ca\xEDdo)"
    m_Metadata:
      m_Items: []
  - m_Id: 3228654335799296
    m_Localized: Usar buff
    m_Metadata:
      m_Items: []
  - m_Id: 3228654377742336
    m_Localized: Usar emote (1-8)
    m_Metadata:
      m_Items: []
  - m_Id: 3228654377742337
    m_Localized: "Este \xE9 um jogo de reconhecimento de voz. Siga as instru\xE7\xF5es
      na placa atr\xE1s de voc\xEA."
    m_Metadata:
      m_Items: []
