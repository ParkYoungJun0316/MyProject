  m_Name: Tutorial_pt-BR
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: pt-BR
  m_SharedData: {fileID: 11400000, guid: 240b9339ac6f60941bcab9ac03699409, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1040822272
    m_Localized: Mover
    m_Metadata:
      m_Items: []
  - m_Id: 1086959616
    m_Localized: "Empurr\xE3o (0 de dano)"
    m_Metadata:
      m_Items: []
  - m_Id: 1086959617
    m_Localized: Preto e branco
    m_Metadata:
      m_Items: []
  - m_Id: 1086959618
    m_Localized: Sua cor
    m_Metadata:
      m_Items: []
  - m_Id: 1091153920
    m_Localized: Trocar de buff
    m_Metadata:
      m_Items: []
  - m_Id: 1091153921
    m_Localized: Torcida individual
    m_Metadata:
      m_Items: []
  - m_Id: 1091153922
    m_Localized: "Grite seu pr\xF3prio nome para ativar seu buff.\nAperte E para
      definir seu apelido.\nN\xE3o esque\xE7a de testar!"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153923
    m_Localized: Torcida em equipe
    m_Metadata:
      m_Items: []
  - m_Id: 1091153924
    m_Localized: "Quando o \xEDcone de aviso aparecer, gritem juntos a palavra da
      equipe.\nIsso desfaz a amea\xE7a que a boca ou o es\xF4fago acabaram de fazer.\nS\xF3
      o host pode definir a palavra da equipe \u2014 combinem isso com anteced\xEAncia."
    m_Metadata:
      m_Items: []
  - m_Id: 1091153925
    m_Localized: Nome de torcida
    m_Metadata:
      m_Items: []
  - m_Id: 1091153926
    m_Localized: "O nome de torcida s\xF3 pode ser digitado em ingl\xEAs.\nQuanto
      mais natural for a palavra na hora de falar, melhor o reconhecimento!\nSem
      microfone ou o reconhecimento n\xE3o est\xE1 funcionando? Ative a torcida por
      teclas num\xE9ricas no menu ESC.\n(1 \xE9 torcida individual, 2 \xE9 torcida
      em equipe \u2014 mas torcer com a voz \xE9 muito mais divertido!)"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153927
    m_Localized: Treino de torcida em equipe
    m_Metadata:
      m_Items: []
  - m_Id: 1091153928
    m_Localized: "Ao apertar [E], aparece um aviso igual ao de uma amea\xE7a de verdade\ne
      a boca l\xE1 em cima se fecha.\nGritem juntos a palavra da equipe para abri-la
      de novo.\nUm cora\xE7\xE3o aparece acima da cabe\xE7a de quem gritou."
    m_Metadata:
      m_Items: []
  - m_Id: 1091153929
    m_Localized: "Hora de come\xE7ar o jogo"
    m_Metadata:
      m_Items: []
  - m_Id: 1091153930
    m_Localized: "A zona de in\xEDcio fica no ch\xE3o amarelo.\nQuando todo o time
      se reunir l\xE1, come\xE7a uma contagem regressiva e o jogo come\xE7a.\nO nome
      de torcida de voc\xEAs \xE9 definido no exato momento em que a contagem termina,\nent\xE3o
      confiram se j\xE1 decidiram tudo antes disso."
    m_Metadata:
      m_Items: []
  - m_Id: 24992255946752
    m_Localized: Escolha seu nome de torcida
    m_Metadata:
      m_Items: []
  - m_Id: 24992293695488
    m_Localized: "Isso n\xE3o pode\n\xB7 Palavr\xF5es/palavras proibidas (ex.: fuck)\n\xB7
      Palavras reservadas (admin, host, cheer)\n\xB7 N\xFAmeros, sublinhado (_),
      coreano, emojis, uma \xFAnica letra\n\xB7 2 a 12 caracteres, apenas letras
      min\xFAsculas em ingl\xEAs\n\nDepois de confirmar, teste se realmente \xE9
      reconhecido!"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889792
    m_Localized: 'ex.: happy'
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889793
    m_Localized: 'ex.: fighting'
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889794
    m_Localized: Confirmar
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889795
    m_Localized: Fechar
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889796
    m_Localized: "Defina a palavra que todo o time vai gritar junto (padr\xE3o: FIGHTING)"
    m_Metadata:
      m_Items: []
  - m_Id: 24992297889797
    m_Localized: 'Palavra da equipe: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647744
    m_Localized: "Use apenas entre 2 e 12 letras min\xFAsculas em ingl\xEAs."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647745
    m_Localized: "Esse nome \xE9 uma palavra reservada do sistema, ent\xE3o voc\xEA
      n\xE3o pode usar."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647746
    m_Localized: "Essa palavra \xE9 uma palavra reservada do sistema, ent\xE3o voc\xEA
      n\xE3o pode usar."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647747
    m_Localized: "Cont\xE9m uma palavra que n\xE3o pode ser usada."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647748
    m_Localized: "Esse nome j\xE1 est\xE1 sendo usado por outro colega de equipe."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647749
    m_Localized: "Um colega de equipe j\xE1 est\xE1 usando isso como nome de torcida."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647750
    m_Localized: "N\xE3o foi poss\xEDvel confirmar o nome."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647751
    m_Localized: "N\xE3o foi poss\xEDvel confirmar a palavra da equipe."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647752
    m_Localized: "S\xF3 o host pode definir a palavra da equipe."
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647753
    m_Localized: "Verificando\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 25143871647754
    m_Localized: Sem resposta. Tente novamente.
    m_Metadata:
      m_Items: []
  - m_Id: 53793039953920
    m_Localized: Mudar de nome
    m_Metadata:
      m_Items: []
  - m_Id: 53793073508352
    m_Localized: "Aqui voc\xEA pode mudar seu nome e a palavra da equipe uma \xFAltima
      vez.\nSe perder essa chance, s\xF3 vai poder mudar de novo quando a partida
      acabar,\nent\xE3o, se quiser mudar, fa\xE7a agora na placa."
    m_Metadata:
      m_Items: []
  - m_Id: 56930631004160
    m_Localized: '[E] Definir nome'
    m_Metadata:
      m_Items: []
  - m_Id: 56930635198464
    m_Localized: '[E] Teste de torcida em equipe'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
